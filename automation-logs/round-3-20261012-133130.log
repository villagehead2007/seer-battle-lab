 function read(id){if(!/^\d{1,6}$/.test(String(id)))throw Error('精灵编号无效');const file=path.join(directory,Number(id)+'.json');if(!fs.existsSync(file))throw Error('本地尚未部署该精灵，请先完成资料与规则适配。');const record=JSON.parse(fs.readFileSync(file,'utf8'));if(record.schema!==1||record.snapshot?.id!==Number(id))throw Error('本地精灵文件格式无效');const errors=issues(record.snapshot);if(errors.length)throw Error('本地规则需重新核对：'+errors.join('；'));return record.snapshot;}
 function catalog(){if(!fs.existsSync(directory))return [];return fs.readdirSync(directory).filter(n=>/^\d+\.json$/.test(n)).map(n=>{try{const s=read(n.slice(0,-5));return {id:s.id,name:s.name,type:s.type,savedAt:s.source.savedAt};}catch{return null;}}).filter(Boolean).sort((a,b)=>a.id-b.id);}
 function search(q=''){q=String(q).trim();if(q.length>40)throw Error('查询过长');return {results:catalog().filter(p=>!q||String(p.id)===q||p.name.includes(q)).slice(0,50),limit:50};}
 function status(){const entries=catalog(),ids=entries.map(x=>x.id);let manifest={checked:[],skipped:[]};const file=path.join(directory,'..','adaptation.json');if(fs.existsSync(file))manifest=JSON.parse(fs.readFileSync(file,'utf8'));const saved=new Set(ids),skipped=(manifest.skipped??[]).filter(x=>!saved.has(x.id)),skipIds=new Set(skipped.map(x=>x.id));const checked=(manifest.checked??[]).filter(id=>saved.has(id)||skipIds.has(id));return {local:true,count:ids.length,coverage:{checkedRanges:ranges(checked),savedRanges:ranges(ids),skipped,checkedCount:checked.length,selectionMode:'specified'}};}
