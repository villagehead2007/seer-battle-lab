add(756,'afterHit',(c,p)=>{if(!ailments[p[1]])throw Error('异常类型尚未实现');if(roll(c,p[0]))c.ailment(c.t,ailments[p[1]],c.a);},[pct,[0,20]]);
add(585,'afterHit',(c,p)=>p.forEach((n,i)=>c.stage(c.a,n,[stats[i]])),Array(6).fill(stage));
add(861,'afterHit',(c,p)=>c.timed(c.a,'属性招扣PP',p[0],{pp:p[1]}),[turns,[0,100]]);
add(860,'afterHit',(c,p)=>c.energy(p[0]),[[0,6]]);
add(866,'afterHit',(c,p)=>c.energy(c.crit?p[0]:p[1]),[[0,6],[0,6]]);
for(const id of [867,868])add(id,'afterHit',(c,p)=>{if((id===867?c.clear(c.t):c.clearBoost(c.t)))c.timed(c.t,'id984',1,{amount:-p[0]},c.round+1);},[[0,10]]);
add(128,'afterHit',(c,p)=>c.timed(c.a,'攻击转治疗',p[0],{}),[turns]);
add(456,'afterHit',(c,p)=>{if(c.t.hp<p[0])c.hurt(c.t,c.t.hp,'低体力斩杀');});
add(58,'afterHit',(c,p)=>c.timed(c.a,'必定暴击',p[0],{},c.round+1),[turns]);
add(699,'beforeDamage',c=>{c.ignoreImmunity=true;});
add(697,'beforeDamage',c=>{c.ignoreLimit=true;});
add(864,'afterHit',(c,p)=>{if(c.t.hp>0)c.timed(c.a,'受击反弹',p[0],{fraction:1/p[1]},c.round+1);},[turns,[1,9999]]);
add(865,'afterHit',(c,p)=>{if(c.t.hp<=0)c.energy(p[0]);},[[0,6]]);
add(807,'afterHit',c=>c.hurt(c.t,c.t.lastAttackDamage??0,c.m.name,'fixed'));
add(862,'beforeDamage',(c,p)=>{const n=c.a.soulState.energy;c.power+=n*p[0];if(n<6)c.energy(-n);});
add(863,'afterHit',(c,p)=>{if(c.a.side!==c.first)c.timed(c.t,'attackBlock',p[0],{},c.round+1);},[turns]);
add(31,'beforeUse',(c,p)=>{c.hits=p[0]+Math.floor(c.random()*(p[1]-p[0]+1));},[[1,25],[1,25]]);
add(47,'afterHit',(c,p)=>c.timed(c.a,'免弱',p[0],{}),[turns]);
add(48,'afterHit',(c,p)=>c.timed(c.a,'免异常',p[0],{}),[turns]);
add(77,'afterHit',(c,p)=>c.timed(c.a,'用招定额回血',p[0],{amount:p[1]}),[turns]);
add(85,'afterHit',c=>c.steal(c.a,c.t,'技能'));
add(470,'afterHit',(c,p)=>c.timed(c.a,'攻击附加异常',p[0]+1,{chance:p[1],ailment:ailments[p[2]]}),[turns,pct,[0,20]]);
add(499,'afterHit',(c,p)=>{if(c.a.side!==c.first)c.timed(c.a,'id984',1,{amount:p[0]},c.round+1);},[[0,10]]);
add(507,'afterHit',(c,p)=>c.timed(c.a,'大伤回满',1,{threshold:p[0]},c.round+1));
add(521,'afterHit',c=>{for(const k of stats)if(c.a.stages[k]<0)c.a.stages[k]*=-1;});
add(693,'afterHit',(c,p)=>c.timed(c.a,'id913',p[0],{bonus:p[1]/100},c.round+1),[turns,[0,1000]]);
add(700,'afterHit',(c,p)=>{if(c.a.side===c.first)for(const k of c.t.moves)c.t.pp[k]=Math.max(0,c.t.pp[k]-p[0]);},[[0,100]]);
