function add(id,phase,execute,ranges=[],deferred,experimental){const e=metadata[id];if(!e)throw Error('Missing reviewed metadata '+id);registry[id]=Object.freeze({id,template:e.info,argsNum:e.args_num,instanceArgsNum:id===534||id===1103?1:e.args_num,direct:true,phase,execute,deferred,experimental,validate(args){if([31,450,683].includes(id)&&args[0]>args[1])throw Error('随机区间上下限颠倒');const enumIndex=({756:1,470:2,573:2,609:0,164:2,889:0,733:0,469:2})[id];if(enumIndex!==undefined&&![0,2,6,7,8,15,20,22].includes(args[enumIndex]))throw Error('异常类型未核对');if(id===599&&args[1]!==2)throw Error('伤害类型未核对');for(let i=0;i<args.length;i++){const [min,max]=ranges[i]??[0,9999];if(args[i]<min||args[i]>max)throw Error('参数超出规则范围');}}});}
const roll=(c,n)=>n>=100||(n>0&&c.random()<n/100);
const turns=[1,99],pct=[0,100],stage=[-6,6];
add(450,'afterHit',(c,p)=>c.heal(c.a,p[0]+Math.floor(c.random()*(p[1]-p[0]+1)),c.m.name));
add(749,'afterHit',(c,p)=>{if(roll(c,p[0]))c.stage(c.t,-p[1]);},[pct,[0,6]]);
add(756,'afterHit',(c,p)=>{if(!ailments[p[1]])throw Error('异常类型尚未实现');if(roll(c,p[0]))c.ailment(c.t,ailments[p[1]],c.a);},[pct,[0,20]]);
add(585,'afterHit',(c,p)=>p.forEach((n,i)=>c.stage(c.a,n,[stats[i]])),Array(6).fill(stage));
add(861,'afterHit',(c,p)=>c.timed(c.a,'属性招扣PP',p[0],{pp:p[1]}),[turns,[0,100]]);
add(860,'afterHit',(c,p)=>c.energy(p[0]),[[0,6]]);
add(866,'afterHit',(c,p)=>c.energy(c.crit?p[0]:p[1]),[[0,6],[0,6]]);
for(const id of [867,868])add(id,'afterHit',(c,p)=>{if((id===867?c.clear(c.t):c.clearBoost(c.t)))c.timed(c.t,'id984',1,{amount:-p[0]},c.round+1);},[[0,10]]);
add(128,'afterHit',(c,p)=>c.timed(c.a,'攻击转治疗',p[0],{}),[turns]);
add(456,'afterHit',(c,p)=>{if(c.t.hp<p[0])c.hurt(c.t,c.t.hp,'低体力斩杀');});
add(58,'afterHit',(c,p)=>c.timed(c.a,'必定暴击',p[0],{},c.round+1),[turns]);
add(699,'beforeDamage',c=>{c.ignoreImmunity=true;});
add(697,'beforeDamage',c=>{c.ignoreLimit=true;});
add(864,'afterHit',(c,p)=>{if(c.t.hp>0)c.timed(c.a,'受击反弹',p[0],{fraction:1/p[1]},c.round+1);},[turns,[1,9999]]);
add(865,'afterHit',(c,p)=>{if(c.t.hp<=0)c.energy(p[0]);},[[0,6]]);
add(807,'afterHit',c=>c.hurt(c.t,c.t.lastAttackDamage??0,c.m.name,'fixed'));
add(862,'beforeDamage',(c,p)=>{const n=c.a.soulState.energy;c.power+=n*p[0];if(n<6)c.energy(-n);});
add(863,'afterHit',(c,p)=>{if(c.a.side!==c.first)c.timed(c.t,'attackBlock',p[0],{},c.round+1);},[turns]);
add(31,'beforeUse',(c,p)=>{c.hits=p[0]+Math.floor(c.random()*(p[1]-p[0]+1));},[[1,25],[1,25]]);
add(47,'afterHit',(c,p)=>c.timed(c.a,'免弱',p[0],{}),[turns]);
add(48,'afterHit',(c,p)=>c.timed(c.a,'免异常',p[0],{}),[turns]);
add(77,'afterHit',(c,p)=>c.timed(c.a,'用招定额回血',p[0],{amount:p[1]}),[turns]);
add(85,'afterHit',c=>c.steal(c.a,c.t,'技能'));
add(470,'afterHit',(c,p)=>c.timed(c.a,'攻击附加异常',p[0]+1,{chance:p[1],ailment:ailments[p[2]]}),[turns,pct,[0,20]]);
add(499,'afterHit',(c,p)=>{if(c.a.side!==c.first)c.timed(c.a,'id984',1,{amount:p[0]},c.round+1);},[[0,10]]);
add(507,'afterHit',(c,p)=>c.timed(c.a,'大伤回满',1,{threshold:p[0]},c.round+1));
add(521,'afterHit',c=>{for(const k of stats)if(c.a.stages[k]<0)c.a.stages[k]*=-1;});
add(693,'afterHit',(c,p)=>c.timed(c.a,'id913',p[0],{bonus:p[1]/100},c.round+1),[turns,[0,1000]]);
add(700,'afterHit',(c,p)=>{if(c.a.side===c.first)for(const k of c.t.moves)c.t.pp[k]=Math.max(0,c.t.pp[k]-p[0]);},[[0,100]]);
add(870,'afterHit',(c,p)=>c.heal(c.a,c.hurt(c.t,p[0],c.m.name,'fixed'),c.m.name));

add(433,'afterHit',(c,p)=>c.timed(c.a,'每回合强化',p[0],{stages:p.slice(1)}),[turns,...Array(6).fill(stage)]);
add(622,'afterHit',(c,p)=>{const mult=roll(c,p[6])?2:1;p.slice(0,6).forEach((n,i)=>c.stage(c.a,n*mult,[stats[i]]));},[...Array(6).fill(stage),pct]);
add(776,'afterHit',(c,p)=>c.timed(c.a,'doubleDamage',p[0],{},c.round+1),[turns]);
add(843,'afterHit',(c,p)=>c.timed(c.a,'id984',p[0],{amount:p[1]},c.round+1),[turns,[0,10]]);
add(180,'afterHit',c=>c.clear(c.t));
add(15,'afterHit',(c,p)=>{if(roll(c,p[0]))c.ailment(c.t,'害怕',c.a);},[pct]);

add(833,'afterHit',(c,p)=>{if(c.t.hp>0)c.heal(c.a,c.hurt(c.t,c.t.stats.maxHp/p[0],c.m.name,'percent'),c.m.name);},[[1,9999]]);
add(869,'afterHit',(c,p)=>{const count=c.a.soulState.speedDamageUses??0;const ratio=Math.min(p[2],p[0]+count*p[1]);if(c.t.hp>0){c.hurt(c.t,c.effective(c.a,'spe')*ratio/100,c.m.name,'percent');c.a.soulState.speedDamageUses=count+1;}},[[0,1000],[0,1000],[0,1000]]);

add(12,'afterHit',(c,p)=>{if(roll(c,p[0]))c.ailment(c.t,'烧伤',c.a);},[pct]);
add(406,'afterHit',(c,p)=>c.timed(c.a,'受击回血',p[0],{chance:p[1],amount:p[2]}),[turns,pct]);
add(448,'afterHit',(c,p)=>c.timed(c.a,'每回合弱化对手',p[0],{stages:p.slice(1)}),[turns,...Array(6).fill(stage)]);
add(466,'afterHit',(c,p)=>c.heal(c.a,p[0],c.m.name));
add(506,'afterHit',(c,p)=>c.timed(c.a,'致命保留',1,{hp:p[0]},c.round+1),[[1,9999]]);

add(9,'beforeDamage',(c,p)=>{c.power=Math.min(p[1],c.power+Math.max(0,(c.a.consecutiveUses??1)-1)*p[0]);});
add(408,'afterHit',(c,p)=>c.timed(c.a,'伤害定额减免',p[0],{amount:p[1]}),[turns]);
add(573,'afterHit',(c,p)=>c.timed(c.a,'强化被清惩罚',p[0],{chance:p[1],ailment:ailments[p[2]],duration:p[3]}),[turns,pct,[0,20],turns]);

add(683,'afterHit',(c,p)=>c.hurt(c.t,p[0]+Math.floor(c.random()*(p[1]-p[0]+1)),c.m.name,'fixed'));
add(820,'afterHit',(c,p)=>{if(c.t.hp>0)c.timed(c.a,'id984',p[0],{amount:p[1]},c.round+1);},[turns,[0,10]]);
add(831,'afterHit',(c,p)=>c.hurt(c.t,c.a.stats.maxHp*p[0]/100,c.m.name,'percent'),[pct]);

add(40,'beforeDamage',c=>{if(c.a.side===c.first)c.power*=2;});
add(440,'afterHit',(c,p)=>c.timed(c.t,'PP消耗倍增',p[0],{multiple:p[1]}),[turns,[1,10]]);
add(583,'afterHit',(c,p)=>{const pool=c.t.moves.slice();for(let i=0;i<p[0]&&pool.length;i++){const k=pool.splice(Math.floor(c.random()*pool.length),1)[0];c.t.pp[k]=0;}},[[1,5]]);
add(599,'afterHit',(c,p)=>c.timed(c.a,'分类攻击减伤',p[0],{kind:p[1],fraction:p[2]/100}),[turns,[0,2],pct]);
add(612,'beforeUse',(c,p)=>{if(roll(c,p[0]))c.hits=p[1];},[pct,[1,10]]);
add(635,'afterHit',(c,p)=>{if(Object.values(c.t.stages).some(n=>n>0)){c.steal(c.a,c.t,'技能');c.timed(c.a,'id984',1,{amount:p[0]},c.round+1);}},[[0,10]]);
add(695,'afterHit',(c,p)=>c.timed(c.a,'对手属性失效',p[0],{chance:p[1]}),[turns,pct]);

add(97,'beforeDamage',c=>{if(c.t.ailments['冻伤']>=c.round)c.power*=2;});
add(534,'afterHit',c=>c.hurt(c.t,(c.effective(c.a,'def')+c.effective(c.a,'spd'))/10,c.m.name,'percent'),[[10,10]]);
add(797,'afterHit',(c,p)=>{if(c.clear(c.t))c.timed(c.t,'技能禁疗',p[0],{});},[turns]);

add(650,'afterHit',(c,p)=>{if(c.t.hp<=0)p.forEach((n,i)=>c.stage(c.a,n,[stats[i]]));},Array(6).fill(stage));
add(674,'afterAttack',(c,p)=>c.heal(c.a,p[0],c.m.name));

add(33,'afterHit',c=>c.clearBoost(c.t));
add(125,'afterHit',(c,p)=>c.timed(c.a,'攻击伤害上限',p[0],{amount:p[1]}),[turns]);
add(485,'afterHit',c=>{if(c.clearBoost(c.t))c.heal(c.a,c.a.stats.maxHp,c.m.name);});
add(645,'beforeDamage',(c,p)=>{if(c.a.hp<c.a.stats.maxHp/p[0])c.power*=p[1];},[[1,9999],[1,100]]);

add(407,'afterHit',(c,p)=>{const stages=stats.map((_,i)=>i===p[0]?p[1]:0);c.timed(c.a,'每回合强化',p[2],{stages},c.round+1);},[[0,5],stage,turns]);
