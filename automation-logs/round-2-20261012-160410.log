function add(id,phase,execute,ranges=[],deferred,experimental){const e=metadata[id];if(!e)throw Error('Missing reviewed metadata '+id);registry[id]=Object.freeze({id,template:e.info,argsNum:e.args_num,instanceArgsNum:id===534||id===1103?1:e.args_num,direct:true,phase,execute,deferred,experimental,validate(args){if([31,450,683].includes(id)&&args[0]>args[1])throw Error('随机区间上下限颠倒');const enumIndex=({756:1,470:2,573:2,609:0,164:2,889:0,733:0,469:2})[id];if(enumIndex!==undefined&&![0,2,6,7,8,15,20,22].includes(args[enumIndex]))throw Error('异常类型未核对');if(id===599&&args[1]!==2)throw Error('伤害类型未核对');for(let i=0;i<args.length;i++){const [min,max]=ranges[i]??[0,9999];if(args[i]<min||args[i]>max)throw Error('参数超出规则范围');}}});}
const roll=(c,n)=>n>=100||(n>0&&c.random()<n/100);
const turns=[1,99],pct=[0,100],stage=[-6,6];
add(450,'afterHit',(c,p)=>c.heal(c.a,p[0]+Math.floor(c.random()*(p[1]-p[0]+1)),c.m.name));
