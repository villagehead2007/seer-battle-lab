add(573,'afterHit',(c,p)=>c.timed(c.a,'强化被清惩罚',p[0],{chance:p[1],ailment:ailments[p[2]],duration:p[3]}),[turns,pct,[0,20],turns]);

add(683,'afterHit',(c,p)=>c.hurt(c.t,p[0]+Math.floor(c.random()*(p[1]-p[0]+1)),c.m.name,'fixed'));
add(820,'afterHit',(c,p)=>{if(c.t.hp>0)c.timed(c.a,'id984',p[0],{amount:p[1]},c.round+1);},[turns,[0,10]]);
add(831,'afterHit',(c,p)=>c.hurt(c.t,c.a.stats.maxHp*p[0]/100,c.m.name,'percent'),[pct]);

