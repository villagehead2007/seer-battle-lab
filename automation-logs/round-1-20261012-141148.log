const base='https://api.seerapi.com/v1/';
async function transport(url){const ctl=new AbortController(),timer=setTimeout(()=>ctl.abort(),30000);try{const r=await fetch(url,{signal:ctl.signal,headers:{'Accept':'application/json','User-Agent':'SeerBattleLab/0.8 (personal battle simulator; read-only data client)'}});let body=null;try{body=await r.json();}catch{throw new Error('SeerAPI 返回格式错误');}return {status:r.status,retryAfter:r.headers.get('retry-after')||'',body};}catch(e){if(e.name==='AbortError')throw new Error('SeerAPI 查询超时');throw new Error('SeerAPI 连接失败：'+e.message);}finally{clearTimeout(timer);}}
const client=require('./wiki-client.cjs').createClient(transport,{interval:1500,label:'SeerAPI',capacity:240});
function api(resource,id,params={}){if(!['pet','skill','skill_effect_type','element_type','element_type_combination','soulmark'].includes(resource)||id!=null&&!/^\d+$/.test(String(id)))throw new Error('资源请求无效');return client.request(base+resource+'/'+(id??'')+'?'+new URLSearchParams(params));}
async function list(resource,limit=100){const data=await api(resource,null,{limit,expand:true});if(!Array.isArray(data.results)||data.next||data.results.length!==data.count)throw new Error('SeerAPI 通用表不完整');return data;}
function int(n,label,min=0,max=999999){if(!Number.isInteger(n)||n<min||n>max)throw new Error('SeerAPI '+label+'无效');return n;}
function buildChart(data){const names=Object.fromEntries(data.results.map(t=>[t.id,t.name])),rows={},aliases={};for(const t of data.results){rows[t.name]={};aliases[t.name]=[t.name];for(const r of t.relations){if(!names[r.target_type.id]||!Number.isFinite(r.multiple)||r.multiple<0||r.multiple>4)throw new Error('属性关系无效');rows[t.name][names[r.target_type.id]]=r.multiple;}if(Object.keys(rows[t.name]).length!==data.count)throw new Error('属性行缺失');}return {rows,aliases,revision:'seerapi:'+data.hash,provider:'seerapi'};}
async function typeChart(){return buildChart(await list('element_type',30));}
function reviewedTargets(m){const entry={13224:['34257fc',3],14734:['7a6e4c8a',4],20444:['95dc4e3e',3],10961:['5866335a',3],10979:['f282522',2],11141:['194546e8',3],13533:['d6a4ddee',3],15423:['5bb55186',4],10759:['13a75776',3],14045:['d84245f6',3],14089:['a021d45c',3],11531:['ba1b7599',4],10175:['461bf54f',5],13870:['fc1058f4',3],16685:['2b38f1c8',4],12090:['dbd41c68',3]}[m.id];return !!entry&&m.hash===entry[0]&&m.atk_num===entry[1];}
