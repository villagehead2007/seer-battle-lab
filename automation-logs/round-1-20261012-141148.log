    73	  assert.equal(rule.issue,'');
    74	  const a=fighter(200,600),t=fighter(600,800);a.side=0;t.side=1;
    75	  const c={a,t,m:move,crit:true,round:1,heal:(f,n)=>{f.hp=Math.min(f.stats.maxHp,Math.floor(f.hp+n));},emit:()=>{}};
    76	  effects.run('afterHit',rule.operations,c); assert.equal(a.hp,1000);
    77	  a.hp=200;c.crit=false;effects.run('afterHit',rule.operations,c);assert.equal(a.hp,200);
    78	  a.hp=200;t.hp=0;c.crit=true;effects.run('afterHit',rule.operations,c);assert.equal(a.hp,200);
    79	});
    80	
    81	test('3575 效果 918 低伤害登记两次增伤并按引擎计数消费，边界不登记',()=>{
    82	  const source=require('../data/species/3575.json').snapshot;
    83	  const move=source.moves.find(m=>m.name==='暗黑灭世断');
    84	  const rule=effects.compileInstances(move.effectInstances.filter(x=>x.id===918),source.effects);
    85	  assert.equal(rule.issue,'');

