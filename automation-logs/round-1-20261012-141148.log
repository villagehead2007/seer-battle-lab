tests/range-rules.test.cjs:56:test('91同步实际能力变化，双方都有同步时不递归放大',()=>{let s=game(snap(99701,null,[[91,[5]]]),snap(99702,null,[[91,[5]],[585,[1,1,1,1,1,1]]]),[{overrides:{maxHp:9999,spe:999}},{overrides:{maxHp:9999}}]);s=E.resolveTurn(s,[key(99701,1),key(99702,1)]);assert.equal(s.fighters[0].stages.atk,1);assert.equal(s.fighters[1].stages.atk,1);s=E.resolveTurn(s,[key(99701,2),key(99702,1)]);assert.equal(s.fighters[0].stages.atk,2);assert.equal(s.fighters[1].stages.atk,2);});
tests/deployed-3011-3020.test.cjs:3:test('3011–3020全部独立本地存档且多精灵词条可见延期',()=>{assert.equal(all.length,10);for(const s of all){assert.deepEqual(store.issues(s),[]);assert.equal(s.source.storage,'local');}const m=all[1].moves.find(m=>m.id===19189);assert.ok(E.WIKI.compile(m,all[1]).deferred.some(x=>x.effectId===669));});
