diff --git a/tests/deployed-3575.test.cjs b/tests/deployed-3575.test.cjs
index e903f6ac1f658f9ad3f41f89d0a06c14c90784db..c3f4c426fae5cfaf6dbb85f56267a0af63511dc2
--- a/tests/deployed-3575.test.cjs
