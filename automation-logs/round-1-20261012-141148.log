const {test}=require('node:test'),assert=require('node:assert/strict'),E=require('../dist/engine.js'),R=E.WIKI.effectsEngine;
function snap(id,soul=null,ops=[]){return {id,name:'规则测试'+id,type:'普通',base:{maxHp:100,atk:100,def:100,spa:100,spd:100,spe:100},souls:soul?[{id:soul,hash:E.SOULS.registry[soul].sourceHash,description:'已核对规则测试'}]:[],source:{provider:'seerapi'},typeChart:{revision:'test',aliases:{普通:['普通']},rows:{普通:{普通:1}}},effects:ops.map(([id])=>({id,argsNum:R.registry[id].argsNum,template:R.registry[id].template})),missingEffects:[],moves:Array.from({length:4},(_,i)=>({id:id*10+i,name:'测试招'+i,provider:'seerapi',kind:i===0?'physical':'status',type:'普通',power:i===0?60:0,pp:30,priority:0,accuracy:100,alwaysHit:true,critical:'1/16',level:i,fifth:false,effectIds:i===1?ops.map(x=>x[0]):[],effectInstances:i===1?ops.map(([id,args])=>({id,args})):[],description:''}))};}
const key=(id,i)=>'wiki:'+(id*10+i);
function game(a,b=snap(99002),builds=[{},{}]){return E.createBattle({wikiSnapshots:[a,b],criticals:false,seed:'range-test',builds});}
test('两版神耀：能量分层、版本选择、清零与新局隔离',()=>{const a=snap(2987,574,[[860,[2]]]);a.souls.unshift({id:372,hash:E.SOULS.registry[372].sourceHash,description:'普通'});assert.equal(E.WIKI.profileFor(a).soul,574);a.selectedSoulId=372;assert.equal(E.WIKI.profileFor(a).soul,372);let s=game(a);for(let i=0;i<3;i++)s=E.resolveTurn(s,[key(2987,1),key(99002,1)]);assert.equal(s.fighters[0].soulState.energy,5);assert.equal(E.SOULS.trait(s.fighters[0],'ailmentImmune'),true);assert.equal(E.SOULS.trait(s.fighters[0],'attackPriority'),1);assert.equal(E.createBattle(s.initial).fighters[0].soulState.energy,0);a.selectedSoulId=574;s=game(a);for(let i=0;i<3;i++)s=E.resolveTurn(s,[key(2987,1),key(99002,1)]);assert.equal(s.fighters[0].soulState.energy,6);});
test('神耀第五消耗5层、强化6层不消耗，威力加成使用消耗前层数',()=>{for(const [soul,energy] of [[372,5],[574,6]]){const a=snap(2987,soul,[[862,[50]]]);a.moves[0].effectIds=[862];a.moves[0].effectInstances=[{id:862,args:[50]}];a.moves[1].effectIds=[];a.moves[1].effectInstances=[];let s=game(a,undefined,[{overrides:{maxHp:9999}},{overrides:{maxHp:9999}}]);s.fighters[0].soulState.energy=energy;s=E.resolveTurn(s,[key(2987,0),key(99002,1)]);assert.equal(s.fighters[0].soulState.energy,energy===6?6:0);assert.ok(s.turns[0].events.some(e=>e.detail.includes('威力 '+(60+energy*50))));}});
test('凡尔斯仅复制速度学习力和刻印到体力，覆盖最终值仍优先',()=>{const a=snap(2988,373);const s=game(a,undefined,[{evs:{spe:252},inscriptions:[{spe:20},{spe:30},{}]},{}]);assert.equal(s.fighters[0].stats.maxHp,454);const t=game(a,undefined,[{evs:{spe:252},inscriptions:[{spe:50}],overrides:{maxHp:500}},{}]);assert.equal(t.fighters[0].hp,500);});
test('魂印体力比较不把相等归入高低分支，回合开始状态固定',()=>{let s=game(snap(2988,373));s=E.resolveTurn(s,[key(2988,1),key(99002,1)]);assert.equal(s.fighters[0].soulState.highHp,false);assert.equal(s.fighters[0].soulState.lowHp,false);s.fighters[0].hp--;s=E.resolveTurn(s,[key(2988,1),key(99002,1)]);assert.equal(s.fighters[0].soulState.lowHp,true);});
test('斯洛斯受击增伤在下两回合生效并正常到期',()=>{let s=game(snap(2990,369));s=E.resolveTurn(s,[key(2990,1),key(99002,0)]);assert.deepEqual(s.fighters[0].effects.soul369,{start:2,end:3});for(let i=0;i<2;i++)s=E.resolveTurn(s,[key(2990,1),key(99002,1)]);assert.equal(s.fighters[0].effects.soul369,undefined);});
test('圣诞属性回血与千夜无强化吸取不重复结算',()=>{let s=game(snap(2992,368),snap(2999,375));s.fighters[0].hp=100;s.fighters[1].hp=100;s=E.resolveTurn(s,[key(2992,1),key(2999,1)]);assert.equal(s.fighters[0].hp,100);assert.equal(s.fighters[1].hp,300);});
test('多段攻击只扣一次PP，逐段伤害相加且止于击败',()=>{const a=snap(99100,null,[[31,[2,2]]]);a.moves[0].effectIds=[31];a.moves[0].effectInstances=[{id:31,args:[2,2]}];a.moves[1].effectIds=[];a.moves[1].effectInstances=[];let s=game(a,undefined,[{overrides:{maxHp:9999,spe:900}},{overrides:{maxHp:9999}}]);s=E.resolveTurn(s,[key(99100,0),key(99002,1)]);assert.equal(s.fighters[0].pp[key(99100,0)],29);assert.equal(s.turns[0].events.filter(e=>e.detail.includes('威力')).length,2);});
test('结构化回合参数470按已核对语义加一，未知魂印版本拒绝',()=>{const a=snap(99101,null,[[470,[3,30,0]]]);let s=game(a);s=E.resolveTurn(s,[key(99101,1),key(99002,1)]);assert.equal(s.fighters[0].effects['攻击附加异常'].end,4);a.souls=[{id:123456}];assert.equal(E.WIKI.assess(a).supported,false);});

test('先手免伤只限当回合，恢复PP不超过各招上限',()=>{let s=game(snap(99200,null,[[170,[8]],[444,[]]]),undefined,[{overrides:{spe:900}},{}]);s.fighters[0].hp=100;s=E.resolveTurn(s,[key(99200,1),key(99002,0)]);assert.equal(s.fighters[0].hp,100+Math.floor(s.fighters[0].stats.maxHp/8));assert.equal(s.fighters[0].pp[key(99200,1)],30);assert.equal(s.fighters[1].pp[key(99002,0)],28);assert.equal(s.fighters[0].effects['当回合免伤'],undefined);});
test('伤害吸血以实际伤害计算；禁强化阻止后手升能力',()=>{let s=game(snap(99201,null,[[417,[2,50]]]),undefined,[{overrides:{maxHp:9999,spe:900}},{overrides:{maxHp:9999}}]);s.fighters[0].hp=100;s=E.resolveTurn(s,[key(99201,1),key(99002,1)]);assert.equal(s.fighters[0].effects['攻击吸血'].end,3);s=E.resolveTurn(s,[key(99201,0),key(99002,1)]);assert.equal(s.fighters[0].hp,100+Math.floor(s.fighters[0].lastAttackDamage/2));let t=game(snap(99202,null,[[765,[3]]]),snap(99203,null,[[585,[1,1,1,1,1,1]]]),[{overrides:{spe:900}},{}]);t=E.resolveTurn(t,[key(99202,1),key(99203,1)]);assert.ok(Object.values(t.fighters[1].stages).every(n=>n===0));});

test('宙斯高体力命中清PP、后手回血固伤及先手减伤不跨回合残留',()=>{let s=game(snap(99301,376),undefined,[{overrides:{maxHp:800,spe:100}},{overrides:{maxHp:1000,spe:900}}]);s.fighters[0].hp=400;s=E.resolveTurn(s,[key(99301,1),key(99002,1)]);assert.equal(s.fighters[0].hp,600);assert.equal(s.fighters[1].hp,800);s.fighters[0].stats.spe=999;s=E.resolveTurn(s,[key(99301,1),key(99002,1)]);assert.equal(s.fighters[0].hp,600);assert.equal(s.fighters[0].soulState.zeusFirst,true);s.fighters[0].hp=800;s.fighters[1].hp=500;s=E.resolveTurn(s,[key(99301,1),key(99002,1)]);assert.equal(Object.values(s.fighters[1].pp).filter(n=>n===0).length,1);});
test('队伍牺牲词条整条延期，不消耗体力也不清对手状态',()=>{let s=game(snap(99302,null,[[574,[]],[873,[]],[67,[3]]]));s.fighters[1].stages.atk=2;const hp=s.fighters[0].hp;s=E.resolveTurn(s,[key(99302,1),key(99002,1)]);assert.equal(s.fighters[0].hp,hp);assert.equal(s.fighters[1].stages.atk,2);assert.equal(E.WIKI.compile(s.wikiSnapshots[0].moves[1],s.wikiSnapshots[0]).deferred.length,3);});

test('Miss回血只响应未命中，封招不触发；疲惫参数时长加一',()=>{const a=snap(99303,null,[[136,[4]]]);a.moves[1].alwaysHit=false;a.moves[1].accuracy=0;let s=game(a,undefined,[{overrides:{maxHp:800,spe:900}},{}]);s.fighters[0].hp=100;s=E.resolveTurn(s,[key(99303,1),key(99002,1)]);assert.equal(s.fighters[0].hp,300);s.fighters[0].effects.statusBlock={start:2,end:2};s=E.resolveTurn(s,[key(99303,1),key(99002,1)]);assert.equal(s.fighters[0].hp,300);let t=game(snap(99304,null,[[22,[100,1]]]),undefined,[{overrides:{spe:900}},{}]);t=E.resolveTurn(t,[key(99304,1),key(99002,1)]);assert.equal(t.fighters[1].ailments['疲惫'],2);});
test('混沌用招前无强化削血、有强化对应弱化；海拉双防只在回合末增长',()=>{let s=game(snap(99305,379),snap(99306,380),[{overrides:{maxHp:1000,spe:900}},{overrides:{maxHp:1000}}]);s=E.resolveTurn(s,[key(99305,1),key(99306,1)]);assert.equal(s.fighters[1].hp,750);assert.equal(s.fighters[1].stages.def,1);s.fighters[0].stages.atk=2;s=E.resolveTurn(s,[key(99305,1),key(99306,1)]);assert.equal(s.fighters[1].hp,750);assert.equal(s.fighters[1].stages.atk,-2);assert.equal(s.fighters[1].stages.def,2);});

test('递增连击按成功使用累计、封顶且重开清零',()=>{const a=snap(99307,null,[[484,[4,1,6]]]);a.moves[0].effectIds=[484];a.moves[0].effectInstances=[{id:484,args:[4,1,6]}];a.moves[1].effectIds=[];a.moves[1].effectInstances=[];let s=game(a,undefined,[{overrides:{maxHp:9999,spe:900,atk:1}},{overrides:{maxHp:9999,def:999}}]);for(const count of [4,5,6,6]){s=E.resolveTurn(s,[key(99307,0),key(99002,1)]);assert.equal(s.turns.at(-1).events.filter(e=>e.detail.includes('威力')).length,count);}assert.equal(E.createBattle(s.initial).fighters[0].soulState.hitGrowth,undefined);});
test('寄生以实际削血吸取，草系免疫；当前血量型粉伤不按最大HP计算',()=>{let s=game(snap(99308,null,[[13,[3]]]),undefined,[{overrides:{maxHp:800}},{overrides:{maxHp:800}}]);s.fighters[0].hp=100;s=E.resolveTurn(s,[key(99308,1),key(99002,1)]);assert.equal(s.fighters[0].hp,200);assert.equal(s.fighters[1].hp,700);const a=snap(99309,null,[[502,[2,4]]]);s=game(a,undefined,[{overrides:{maxHp:9999,spe:900,atk:1}},{overrides:{maxHp:9999,def:999}}]);s=E.resolveTurn(s,[key(99309,1),key(99002,1)]);s.fighters[1].hp=1000;s=E.resolveTurn(s,[key(99309,0),key(99002,1)]);const actual=s.fighters[0].lastAttackDamage;assert.equal(s.fighters[1].hp,1000-actual-Math.floor((1000-actual)/4));});

test('玄武致死反伤保留对手1HP，非致死受击正常反馈',()=>{let s=game(snap(99310,null),snap(99311,166),[{overrides:{maxHp:1000,atk:9999,spe:999}},{overrides:{maxHp:1000,def:1}}]);s.fighters[0].hp=40;s.fighters[1].hp=100;s=E.resolveTurn(s,[key(99310,0),key(99311,1)]);assert.equal(s.fighters[1].hp,0);assert.equal(s.fighters[0].hp,1);assert.equal(s.winner,0);});

test('纯队伍效果的零威力攻击不产生基础伤害',()=>{const a=snap(99312,null,[[873,[]]]);a.moves[0].power=0;a.moves[0].effectIds=[873];a.moves[0].effectInstances=[{id:873,args:[]}];a.moves[1].effectIds=[];a.moves[1].effectInstances=[];let s=game(a);const hp=s.fighters[1].hp;s=E.resolveTurn(s,[key(99312,0),key(99002,1)]);assert.equal(s.fighters[1].hp,hp);assert.equal(s.fighters[0].lastAttackDamage,0);});

test('时空魂印半血严格边界，低血属性技能也获得先制',()=>{let s=game(snap(99401,383),undefined,[{overrides:{maxHp:1000,spe:1}},{overrides:{spe:999}}]);s.fighters[0].hp=500;s=E.resolveTurn(s,[key(99401,1),key(99002,1)]);assert.equal(s.turns[0].first,1);assert.equal(s.fighters[0].soulState.halfLow,false);assert.equal(s.fighters[0].soulState.halfHigh,false);s.fighters[0].hp=499;s=E.resolveTurn(s,[key(99401,1),key(99002,1)]);assert.equal(s.turns[1].first,0);});
test('炽天使上回合受伤记录不受回血影响，当前回合不误用',()=>{let s=game(snap(99402,382),undefined,[{overrides:{maxHp:9999,spe:900}},{overrides:{maxHp:9999}}]);s=E.resolveTurn(s,[key(99402,1),key(99002,0)]);const taken=s.fighters[0].roundDamageTaken;assert.ok(taken>0);s=E.resolveTurn(s,[key(99402,0),key(99002,1)]);assert.equal(s.fighters[0].previousDamageTaken,taken);assert.ok(s.turns[1].events.some(e=>e.text.includes('炽天使魂印：损失 '+Math.floor(taken/2))));});


test('伤害回血以实际固伤计算，输出减伤只应用一次且对魂印伤害生效',()=>{let s=game(snap(99501,387,[[29,[200]]]),snap(99502,null,[[491,[3,50]]]),[{overrides:{maxHp:2000,spe:10}},{overrides:{maxHp:2000,spe:999}}]);s.fighters[0].hp=100;s=E.resolveTurn(s,[key(99501,1),key(99502,1)]);assert.equal(s.fighters[1].hp,1900);assert.equal(s.fighters[0].hp,160);assert.equal(s.fighters[0].stages.def,2);assert.equal(s.fighters[0].stages.spd,2);
const b=snap(99503,370);s=game(b,snap(99504,null,[[491,[2,50]]]),[{overrides:{maxHp:2000,spe:999}},{overrides:{maxHp:2000,spe:1}}]);s.fighters[0].effects['伤害输出降低']={start:1,end:1,fraction:.5};s=E.resolveTurn(s,[key(99503,1),key(99504,2)]);assert.equal(s.fighters[1].hp,1900);});
test('伊维特按回合递增40/50/60%吸血且新局重置；免疫粉伤时不吸血',()=>{let s=game(snap(99505,390,[[29,[100]]]),undefined,[{overrides:{maxHp:2000}},{overrides:{maxHp:2000}}]);s.fighters[0].hp=100;for(const hp of [140,190,250,310]){s=E.resolveTurn(s,[key(99505,1),key(99002,1)]);assert.equal(s.fighters[0].hp,hp);}let q=E.createBattle(s.initial);assert.equal(q.round,1);q.fighters[0].hp=100;q.fighters[1].effects['当回合免伤']={start:1,end:1};q=E.resolveTurn(q,[key(99505,1),key(99002,1)]);assert.equal(q.fighters[0].hp,100);});
test('全伤害吸血覆盖固定伤害，按剩余体力截断，技能禁疗仍有效',()=>{const a=snap(99506,null,[[89,[3,2]],[29,[200]]]);let s=game(a,undefined,[{overrides:{maxHp:2000,spe:999}},{overrides:{maxHp:2000}}]);s.fighters[0].hp=100;s.fighters[1].hp=60;s=E.resolveTurn(s,[key(99506,1),key(99002,1)]);assert.equal(s.fighters[0].hp,130);assert.equal(s.fighters[1].hp,0);s=game(a);s.fighters[0].hp=100;s.fighters[0].effects['技能禁疗']={start:1,end:3};s=E.resolveTurn(s,[key(99506,1),key(99002,1)]);assert.equal(s.fighters[0].hp,100);});
test('百鬼魂印严格伤害阈值，250同时满足，续触发不取消当前免疫',()=>{for(const [n,immune,power]of [[200,false,true],[201,true,true],[250,true,true],[300,true,false]]){let s=game(snap(99507,null,[[29,[n]]]),snap(99508,391),[{overrides:{maxHp:9999,spe:999}},{overrides:{maxHp:9999}}]);s=E.resolveTurn(s,[key(99507,1),key(99508,1)]);assert.equal(!!s.fighters[1].effects['鬼王攻击免疫'],immune);assert.equal(!!s.fighters[1].effects['鬼王威力翻倍'],power);if(immune){const hp=s.fighters[1].hp;s=E.resolveTurn(s,[key(99507,0),key(99508,1)]);assert.equal(s.fighters[1].hp,hp);}}
let s=game(snap(99509,null,[[31,[2,2]],[29,[250]]]),snap(99510,391),[{overrides:{maxHp:9999,spe:999}},{overrides:{maxHp:9999}}]);const a=s.wikiSnapshots[0];a.moves[0].effectIds=[31,29];a.moves[0].effectInstances=[{id:31,args:[2,2]},{id:29,args:[250]}];s=game(a,snap(99510,391),[{overrides:{maxHp:9999,spe:999}},{overrides:{maxHp:9999}}]);s.fighters[1].effects['鬼王攻击免疫']={start:1,end:1};s=E.resolveTurn(s,[key(99509,0),key(99510,1)]);assert.equal(s.fighters[1].hp,9499);assert.equal(s.fighters[1].effects['鬼王攻击免疫'].start,1);assert.equal(s.fighters[1].effects['鬼王攻击免疫'].end,2);});
test('800受对手属性触发的限伤下回合生效，覆盖攻击与固定伤害',()=>{let s=game(snap(99511,null,[[800,[3,2,250]]]),snap(99512,null,[[29,[600]]]),[{overrides:{maxHp:9999,spe:999}},{overrides:{maxHp:9999,atk:9999}}]);s=E.resolveTurn(s,[key(99511,1),key(99512,1)]);assert.equal(s.fighters[0].hp,9399);assert.deepEqual(s.fighters[0].effects['伤害上限'],{start:2,end:3,amount:250});s=E.resolveTurn(s,[key(99511,2),key(99512,1)]);assert.equal(s.fighters[0].hp,9149);s=E.resolveTurn(s,[key(99511,2),key(99512,0)]);assert.equal(s.fighters[0].hp,8899);});
