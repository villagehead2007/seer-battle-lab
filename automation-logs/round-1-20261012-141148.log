+// 3575 reviewed SeerAPI effects. Counters are consumed by the engine's
+// existing before-use path, so these bonuses apply only to the stated attacks.
+add(702,'afterHit',(c,p)=>{if(c.crit&&c.a.hp>0)c.heal(c.a,c.a.stats.maxHp,c.m.name);},[[1,99]]);
+add(918,'afterHit',(c,p)=>{if(c.dealt<p[0]){c.a.counts.nextAttackBoost=Math.max(c.a.counts.nextAttackBoost??0,p[1]);c.a.soulState.nextAttackBoostFraction=p[2]/100;}},[[0,99999],[1,99],[0,100]]);
+add(731,'afterHit',(c,p)=>{if(c.crit&&c.a.hp>0)c.a.counts.nextCrit=Math.max(c.a.counts.nextCrit??0,p[0]);},[[1,99]]);
 
 });
