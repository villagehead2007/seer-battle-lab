+test('3575 效果 702 暴击回满体力，非暴击与死亡目标不触发',()=>{
+  const source=require('../data/species/3575.json').snapshot;
+  const move=source.moves.find(m=>m.name==='毁灭迸发');
+  const rule=effects.compileInstances(move.effectInstances.filter(x=>x.id===702),source.effects);
+  assert.equal(rule.issue,'');
+  const a=fighter(200,600),t=fighter(600,800);a.side=0;t.side=1;
+  const c={a,t,m:move,crit:true,round:1,heal:(f,n)=>{f.hp=Math.min(f.stats.maxHp,Math.floor(f.hp+n));},emit:()=>{}};
+  effects.run('afterHit',rule.operations,c); assert.equal(a.hp,1000);
+  a.hp=200;c.crit=false;effects.run('afterHit',rule.operations,c);assert.equal(a.hp,200);
+  a.hp=0;t.hp=600;c.crit=true;effects.run('afterHit',rule.operations,c);assert.equal(a.hp,0);
+});
+
