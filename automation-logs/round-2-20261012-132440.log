31:function effectiveness(a,b,chart){const ap=chart.aliases[a],bp=chart.aliases[b];if(!ap||!bp)throw new Error('属性表未覆盖：'+a+' / '+b);const combine=(x,y)=>x===2&&y===2?4:x===0||y===0?(x+y)/4:(x+y)/2;const single=(x,y)=>{const n=chart.rows[x]?.[y];if(!Number.isFinite(n))throw new Error('属性数据不完整');return n;};const attack=y=>ap.length===1?single(ap[0],y):combine(single(ap[0],y),single(ap[1],y));return bp.length===1?attack(bp[0]):ap.length===1?combine(attack(bp[0]),attack(bp[1])):(attack(bp[0])+attack(bp[1]))/2;}
44:function mergeCharts(snapshots){const charts=snapshots.map(s=>s.typeChart).filter(Boolean);if(!charts.length)return null;const chart=JSON.parse(JSON.stringify(charts[0]));for(const other of charts.slice(1)){if(other.revision!==chart.revision||JSON.stringify(other.rows)!==JSON.stringify(chart.rows))throw new Error('双方属性表版本不同，请重新加载');for(const [name,parts]of Object.entries(other.aliases)){if(chart.aliases[name]&&JSON.stringify(chart.aliases[name])!==JSON.stringify(parts))throw new Error('属性映射冲突');chart.aliases[name]=parts;}}return chart;}

