diff --git a/dist/range-souls.js b/dist/range-souls.js
index 74d5a63bba2adaeb1430c72522d8f9b3790f0f18..8a333be648862de168846bd51b7cfcf4486067af
--- a/dist/range-souls.js
+++ b/dist/range-souls.js
@@ -301,5 +301,17 @@
 for(const [id,hash,chance,multiplier] of [[864,'8b107b1',.6,2],[912,'741d06d2',.7,2.5]])registry[id]={name:'霸'+(id===912?' · 强化':''),sourceHash:hash,traits:{skillPriority:f=>f.soulState.xiangPriority?1:0},hooks:{roundStart(c){const boosted=Object.values(c.t.stages).some(n=>n>0);c.a.soulState.xiangPriority=!boosted;if(boosted){c.clearBoost(c.t);if(c.random()<chance)c.ailment(c.t,'焚烬',c.a);}},beforeUse(c){c.a.soulState.xiangDouble=c.m.kind!=='status'&&c.random()<.4;},beforeDamage(c){if(c.a.soulState.xiangDouble)c.modifier*=multiplier;},afterAttack(c){if(!c.a.soulState.xiangDouble)c.timed(c.t,'statusBlock',2,{});}}};
 
 registry[870]={name:'圣地卡修斯',sourceHash:'9b9717ab',traits:{ailmentImmune:f=>f.soulState?.cassisImmuneRound===f.soulState?.currentRound,attackPriority:f=>f.suitState?.shield>0?1:0},hooks:{roundStart(c){const s=c.a.soulState;s.currentRound=c.round;if(!s.cassisEntered){s.cassisEntered=true;c.a.suitState.shield+=Math.floor(c.a.stats.maxHp/2);c.emit(c.name(c.a)+' 圣地卡修斯魂印：获得最大体力一半护盾。');}s.cassisImmuneRound=c.round;},roundEnd(c){}}};
+
+// 875 · 终末之灭·天邪龙王.  The conversion roll is made once at the
+// beginning of each round.  Attack damage is tracked separately from other
+// damage so fixed/percent follow-up effects are not converted or reflected.
+registry[875]={name:'终末之灭·天邪龙王',sourceHash:'ea9790b0',traits:{
+  attackPriority:f=>f.soulState?.endDragonHighRound===f.soulState?.currentRound?1:0,
+  damageMultiplier:f=>f.soulState?.endDragonHighRound===f.soulState?.currentRound?1.5:1
+},hooks:{
+  roundStart(c){const s=c.a.soulState;s.currentRound=c.round;s.endDragonHighRound=c.a.hp>c.t.hp?c.round:0;s.endDragonConvert=c.random()<.4;s.endDragonAttackTaken=0;c.emit(c.name(c.a)+' 终末之灭魂印：'+(s.endDragonHighRound===c.round?'体力较高，本回合攻击先制 +1、伤害提升 50%。':'体力比较未触发高体分支。')+(s.endDragonConvert?'触发 40% 受击转化。':'未触发 40% 受击转化。'));},
+  attackDamageTaken(c){const s=c.a.soulState;if(c.dealt<=0)return;s.endDragonAttackTaken=(s.endDragonAttackTaken??0)+c.dealt;if(s.endDragonConvert&&c.a.hp>0){c.heal(c.a,c.dealt,'终末之灭魂印受击转化');}else if(s.endDragonConvert&&c.a.hp<=0){c.a.hp=Math.min(c.a.stats.maxHp,c.dealt);c.emit(c.name(c.a)+' 终末之灭魂魂印将致死攻击伤害转化为体力。','heal');}},
+  roundEnd(c){const s=c.a.soulState;if(!s.endDragonConvert&&s.endDragonAttackTaken>0&&c.t.hp>0)c.hurt(c.t,s.endDragonAttackTaken,'终末之灭魂印反击','fixed');}
+}};
 
 });
diff --git a/tests/deployed-3575.test.cjs b/tests/deployed-3575.test.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..2f347bdb18499ffe5186f18b62c43acf33413418
--- /dev/null
+++ b/tests/deployed-3575.test.cjs
@@ -0,0 +1,46 @@
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const store=require('../local-species.cjs');
+const E=require('../dist/engine.js');
+
+const soul=E.SOULS.registry[875];
+function fighter(hp,oppHp){return {hp,stats:{maxHp:1000},soulState:{},stages:{atk:0,def:0,spa:0,spd:0,spe:0,acc:0},ailments:{},effects:{},counts:{},side:0};}
+function context(a,t,random){const events=[];return {a,t,round:1,random,emit:x=>events.push(x),name:f=>f===a?'A':'B',heal:(f,n)=>{f.hp=Math.min(f.stats.maxHp,f.hp+Math.floor(n));},hurt:(f,n)=>{const v=Math.min(f.hp,Math.floor(n));f.hp-=v;return v;},events};}
+
+test('3575 快照保留真实魂印资料并核对来源版本',()=>{
+  const source=require('../data/species/3575.json').snapshot;
+  assert.equal(source.souls[0].id,875);
+  assert.equal(source.souls[0].hash,'ea9790b0');
+  assert.equal(soul.sourceHash,source.souls[0].hash);
+});
+
+test('魂印875高体分支提供攻击先制和50%增伤，低体分支不提供',()=>{
+  const high=fighter(700,600),target=fighter(600,700);high.side=0;target.side=1;
+  soul.hooks.roundStart(context(high,target,()=>.99));
+  assert.equal(soul.traits.attackPriority(high),1);
+  assert.equal(soul.traits.damageMultiplier(high),1.5);
+  const low=fighter(600,700);low.side=0;soul.hooks.roundStart(context(low,target,()=>.99));
+  assert.equal(soul.traits.attackPriority(low),0);
+  assert.equal(soul.traits.damageMultiplier(low),1);
+});
+
+test('魂印875 40%受击转化分支将攻击伤害恢复，未触发分支在回合末等量固定反击',()=>{
+  const converted=fighter(500,600),target=fighter(700,700);converted.side=0;target.side=1;
+  const c=context(converted,target,()=>.1);soul.hooks.roundStart(c);
+  soul.hooks.attackDamageTaken({...c,dealt:120});
+  assert.equal(converted.hp,620);
+  assert.equal(converted.soulState.endDragonAttackTaken,120);
+  const failed=fighter(500,600),victim=fighter(700,700);failed.side=0;victim.side=1;
+  const fctx=context(failed,victim,()=>.9);soul.hooks.roundStart(fctx);
+  soul.hooks.attackDamageTaken({...fctx,dealt:120});
+  assert.equal(failed.hp,500);
+  soul.hooks.roundEnd(fctx);
+  assert.equal(victim.hp,580);
+});
+
+test('魂印875受击转化边界：致死攻击也恢复至至少本次伤害对应体力，零伤害不触发反击',()=>{
+  const a=fighter(0,600),t=fighter(700,700);a.side=0;t.side=1;
+  const c=context(a,t,()=>.1);soul.hooks.roundStart(c);soul.hooks.attackDamageTaken({...c,dealt:200});
+  assert.equal(a.hp,200);
+  const b=fighter(500,600),u=fighter(700,700);b.side=0;u.side=1;const d=context(b,u,()=>.9);soul.hooks.roundStart(d);soul.hooks.attackDamageTaken({...d,dealt:0});soul.hooks.roundEnd(d);assert.equal(u.hp,700);
+});

