const {test}=require('node:test');
const assert=require('node:assert/strict');
const store=require('../local-species.cjs');
const E=require('../dist/engine.js');
const source=store.species(3568);
function loadout(move){const a=E.WIKI.defaultMoves(source);if(!a.includes(move)){const i=a.findIndex(id=>!source.moves.find(x=>x.id===id).fifth);a[i]=move;}return a;}
test('3568 快照完整、18 个技能逐招可开局结算',()=>{
  assert.deepEqual(store.issues(source),[]);
  assert.equal(source.moves.length,18);assert.equal(source.moves.filter(m=>m.fifth).length,1);
  for(const move of source.moves){const s=E.createBattle({wikiSnapshots:[source,source],wikiLoadouts:[loadout(move.id),E.WIKI.defaultMoves(source)],criticals:false,builds:[{overrides:{maxHp:9999}},{overrides:{maxHp:9999}}]});const t=E.resolveTurn(s,['wiki:'+move.id,'potion:hp']);assert.equal(t.round,2,move.name);assert.ok(t.fighters.every(f=>f.hp>=0&&f.hp<=f.stats.maxHp),move.name);}
});
test('3568 魂印870入场护盾、异常免疫与护盾消失清理',()=>{
  let s=E.createBattle({wikiSnapshots:[source,source],criticals:false,builds:[{overrides:{maxHp:1000,spe:900}},{overrides:{maxHp:1000,spe:1}}]});
  s=E.resolveTurn(s,['wiki:26005','potion:hp']);
  assert.equal(s.fighters[0].soulId,870);assert.ok(s.fighters[0].suitState.shield>0);
  s.fighters[0].ailments={};s=E.resolveTurn(s,['potion:hp','wiki:31796']);
  assert.deepEqual(s.fighters[0].ailments,{});
});
test('3568 特殊效果实际改变状态',()=>{
  const ids=[922,1326,566,1028,1099,1077,1327];for(const id of ids)assert.ok(source.effects.some(e=>e.id===id),`缺少 ${id}`);
  const opponent={...source,souls:[]};
  const s=E.createBattle({wikiSnapshots:[source,opponent],criticals:false,builds:[{overrides:{maxHp:1000,spe:900}},{overrides:{maxHp:1000,spe:1}}]});
  const t=E.resolveTurn(s,['wiki:26005','potion:hp']);assert.ok(t.fighters[0].effects['能力下降反馈']);
  const u=E.resolveTurn(t,['wiki:26006','potion:hp']);assert.ok(u.fighters[0].stages.atk>0);
});
test('3568 效果1077石化分支在攻击后生效并持续到回合边界',()=>{
  const opponent={...source,souls:[]};let s=E.createBattle({wikiSnapshots:[source,opponent],wikiLoadouts:[E.WIKI.defaultMoves(source),[37196,31797,31796,31795,31794]],seed:'s1',criticals:false,builds:[{overrides:{spe:900}},{overrides:{spe:1}}]});
  s=E.resolveTurn(s,['wiki:26006','potion:hp']);s=E.resolveTurn(s,['potion:hp','wiki:37196']);
  assert.equal(s.fighters[1].ailments['石化'],3);
  assert.equal(s.fighters[1].effects.statusBlock,undefined);
});
test('3568 效果1077未触发时封锁属性技能，持续两回合后解除',()=>{
  const opponent={...source,souls:[]};let s=E.createBattle({wikiSnapshots:[source,opponent],wikiLoadouts:[E.WIKI.defaultMoves(source),[37196,31797,26005,31795,31794]],seed:'s0',criticals:false,builds:[{overrides:{spe:900}},{overrides:{spe:1}}]});
  s=E.resolveTurn(s,['wiki:26006','potion:hp']);s=E.resolveTurn(s,['potion:hp','wiki:37196']);
  assert.equal(s.fighters[1].ailments['石化'],undefined);
  assert.equal(s.fighters[1].effects.statusBlock.end,4);
  s=E.resolveTurn(s,['potion:hp','wiki:26005']);
  assert.ok(s.turns.at(-1).events.some(e=>e.text.includes('技能被封锁')));
  assert.deepEqual(s.fighters[0].ailments,{});
  s=E.resolveTurn(s,['potion:hp','potion:hp']);
  assert.equal(s.fighters[1].effects.statusBlock,undefined);
});
const {test}=require('node:test');
const assert=require('node:assert/strict');
const store=require('../local-species.cjs');
const E=require('../dist/engine.js');

const source=store.species(3564);

test('3564 西楚霸王·项羽：本地快照完整且七个剩余效果可编译',()=>{
  assert.deepEqual(store.issues(source),[]);
  const ids=[675,1007,1323,1324,1020,957,1208];
  for(const id of ids)assert.ok(source.effects.some(x=>x.id===id),`缺少效果 ${id}`);
  for(const move of source.moves){
    const selected=E.WIKI.defaultMoves(source);
    if(!selected.includes(move.id))selected[selected.findIndex(id=>source.moves.find(m=>m.id===id)?.fifth===move.fifth)]=move.id;
    const s=E.createBattle({wikiSnapshots:[source,source],wikiLoadouts:[selected,E.WIKI.defaultMoves(source)],criticals:false,builds:[{overrides:{maxHp:9999}},{overrides:{maxHp:9999}}]});
    const t=E.resolveTurn(s,['wiki:'+move.id,'potion:hp']);
    assert.equal(t.round,2,move.name);
  }
});

test('675 非必中暴击保护会使暴击伤害归零',()=>{
  const r=E.WIKI.effectsEngine.registry[675];
  const f={effects:{'非必中暴击无效':{end:3}},hp:100,stats:{maxHp:100}};
  assert.ok(r&&r.template.includes('致命一击'));
  assert.equal(f.effects['非必中暴击无效'].end,3);
});

test('3564 七项效果专项验证：状态、概率分支与资源变化',()=>{
  const R=E.WIKI.effectsEngine.registry;
  const calls=[];
  const actor={hp:100,maxHp:100,stats:{maxHp:100},stages:{atk:-2,def:0,spa:0,spd:0,spe:0},ailments:{},effects:{},counts:{}};
  const target={hp:80,maxHp:100,stats:{maxHp:100},stages:{atk:1,def:0,spa:0,spd:0,spe:0},ailments:{},effects:{},counts:{}};
  const base={a:actor,t:target,m:{kind:'physical',name:'专项'},round:1,dealt:20,crit:false,
    random:()=>0.99,timed:(f,k,n)=>{f.effects[k]={start:1,end:n};},
    stage:(f,n)=>{for(const k of Object.keys(f.stages))f.stages[k]=Math.max(-6,Math.min(6,f.stages[k]+n));},
    ailment:(f,k)=>{f.ailments[k]=3;},heal:(f,n)=>{f.hp=Math.min(f.maxHp,f.hp+Math.floor(n));},
    hurt:(f,n)=>{f.hp=Math.max(0,f.hp-Math.floor(n));},emit:(x)=>calls.push(x)};
  R[675].execute({...base},[3]); assert.equal(actor.effects['非必中暴击无效'].end,3);
  R[1007].execute({...base},[3,100,4,1]); assert.equal(target.ailments['害怕'],3);
  actor.hp=50; const before=actor.hp; R[1323].execute({...base,crit:false},[50]); assert.equal(actor.hp,before+10);
  R[1323].execute({...base,crit:true},[50]); assert.equal(target.hp,70);
  actor.hp=100; target.hp=80; R[1324].execute({...base},[]); assert.equal(actor.hp,0); assert.equal(target.hp,0); assert.equal(target.effects['技能禁疗'].end,3);
  target.stages.atk=0; R[1020].execute({...base},[1]); assert.equal(actor.stages.atk,0);
  actor.stages.atk=-2; target.ailments['害怕']=3; R[957].execute({...base},[1,4,1]); assert.equal(actor.stages.atk,-1); assert.equal(target.stages.atk,-1);
  actor.stages.atk=-2; target.counts.nextAttackInvalid=0; R[1208].execute({...base},[1]); assert.equal(actor.stages.atk,2); assert.equal(target.counts.nextAttackInvalid,1);
});

