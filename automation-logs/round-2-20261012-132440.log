'use strict';
const fs=require('node:fs'),path=require('node:path'),E=require('./dist/engine.js');
function ranges(ids){const out=[];for(const id of [...new Set(ids)].sort((a,b)=>a-b)){const last=out.at(-1);if(last&&id===last[1]+1)last[1]=id;else out.push([id,id]);}return out;}
function createStore(directory=path.join(__dirname,'data','species')){
 function issues(s){const out=[];if(!s||!Number.isInteger(s.id)||s.id<1||s.id>999999)return ['精灵编号无效'];if(!s.typeChart||s.typeChart.revision==='rule-audit-neutral')out.push('缺少真实属性克制表');try{if(!s.base||['maxHp','atk','def','spa','spd','spe'].some(k=>!Number.isInteger(s.base[k])||s.base[k]<1||s.base[k]>999))out.push('种族值无效');out.push(...E.WIKI.assess(s).issues);for(const soul of s.souls){if(s.source?.provider==='seerapi'&&E.SOULS.registry[soul.id]?.sourceHash!==soul.hash)out.push('魂印版本尚未核对 '+soul.id);}for(const m of s.moves){const issue=E.WIKI.moveIssue(m,s);if(issue)out.push(m.name+'：'+issue);}}catch(e){out.push(e.message);}return [...new Set(out)];}
 function save(snapshot){if(snapshot?.id>=3021&&Array.isArray(snapshot.souls)&&!snapshot.souls.length)return {saved:false,skipped:true,issues:['无魂印：按设置跳过本地存储']};const problems=issues(snapshot);if(problems.length)return {saved:false,issues:problems};fs.mkdirSync(directory,{recursive:true});const s=structuredClone(snapshot);s.deployment={scope:'single',deferredSouls:s.souls.flatMap(x=>(E.SOULS.registry[x.id]?.deferred??[]).map(description=>({soulId:x.id,description,status:'多精灵待实现'})))};s.source={...s.source,storage:'local',savedAt:new Date().toISOString()};const record={schema:1,engineVersion:E.VERSION,snapshot:s};const target=path.join(directory,s.id+'.json'),temp=target+'.tmp';fs.writeFileSync(temp,JSON.stringify(record,null,2),'utf8');fs.renameSync(temp,target);return {saved:true,snapshot:s};}
 function read(id){if(!/^\d{1,6}$/.test(String(id)))throw Error('精灵编号无效');const file=path.join(directory,Number(id)+'.json');if(!fs.existsSync(file))throw Error('本地尚未部署该精灵，请先完成资料与规则适配。');const record=JSON.parse(fs.readFileSync(file,'utf8'));if(record.schema!==1||record.snapshot?.id!==Number(id))throw Error('本地精灵文件格式无效');const errors=issues(record.snapshot);if(errors.length)throw Error('本地规则需重新核对：'+errors.join('；'));return record.snapshot;}
 function catalog(){if(!fs.existsSync(directory))return [];return fs.readdirSync(directory).filter(n=>/^\d+\.json$/.test(n)).map(n=>{try{const s=read(n.slice(0,-5));return {id:s.id,name:s.name,type:s.type,savedAt:s.source.savedAt};}catch{return null;}}).filter(Boolean).sort((a,b)=>a.id-b.id);}
 function search(q=''){q=String(q).trim();if(q.length>40)throw Error('查询过长');return {results:catalog().filter(p=>!q||String(p.id)===q||p.name.includes(q)).slice(0,50),limit:50};}
 function status(){const entries=catalog(),ids=entries.map(x=>x.id);let manifest={checked:[],skipped:[]};const file=path.join(directory,'..','adaptation.json');if(fs.existsSync(file))manifest=JSON.parse(fs.readFileSync(file,'utf8'));const saved=new Set(ids),skipped=(manifest.skipped??[]).filter(x=>!saved.has(x.id)),skipIds=new Set(skipped.map(x=>x.id));const checked=(manifest.checked??[]).filter(id=>saved.has(id)||skipIds.has(id));return {local:true,count:ids.length,coverage:{checkedRanges:ranges(checked),savedRanges:ranges(ids),skipped,checkedCount:checked.length,selectionMode:'specified'}};}
 return {save,species:read,search,status,issues};
}
module.exports={...createStore(),createStore};

