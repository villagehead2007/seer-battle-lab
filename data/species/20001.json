gueRounds"]},{"key":"wall.attack.reduce","source":"2.1；魂印2-1详解","trigger":"攻击伤害结算前","condition":"wall 存活；按主位状态取档","action":"先取该层减伤前的 x 并登记该层实际减掉的量。","params":["wall.reserveReduction","wall.leadReduction"]},{"key":"wall.attack.shield","source":"2.1；魂印2-1详解","trigger":"回合结束","condition":"有本回合的 wall.attack.reduce 记录","action":"按减少量授予该来源护盾，新增量至多为上限与当前同来源存量的非负差。","params":["wall.reserveShieldCap","wall.leadShieldCap"]},{"key":"wall.indirect.reduce","source":"2.1","trigger":"固定/百分比伤害结算前","condition":"wall 存活；按主位状态取档","action":"记录该层对两类伤害实际减少量。","params":["wall.reserveReduction","wall.leadReduction"]},{"key":"wall.indirect.cover","source":"2.1","trigger":"回合结束","condition":"有本回合的 wall.indirect.reduce 记录","action":"按减少量授予护罩。","params":[]},{"key":"wall.status.weak","source":"2.2.1","trigger":"异常负面效果求值","condition":"wall 主位效果","action":"保留弱化类异常本身，屏蔽其负面效果。","params":[]},{"key":"wall.status.control","source":"2.2.1","trigger":"行动许可检查","condition":"wall 主位效果且处于控制类异常","action":"允许行动。","params":[]},{"key":"wall.stats","source":"2.2.2","trigger":"接任主位时快照","condition":"wall 主位","action":"按护盾量增加 def、spd，各自以上限比率限制，持续至下次换主位。","params":["wall.statBonusCapPanelRatio"]},{"key":"wall.skill.heal","source":"2.2.2","trigger":"用招后","condition":"wall 主位效果","action":"按使用者当时护盾量回复体力。","params":[]},{"key":"wall.emergency","source":"2.2.3","trigger":"回合结束","condition":"wall 主位效果；存活；体力严格低于比例；本场次数未用","action":"回复并抵挡下回合受到的伤害，纳入固定及百分比伤害。","params":["wall.emergencyBelow","wall.emergencyHeal","wall.emergencyBattleUses","wall.emergencyGuardRounds"]},{"key":"swift.priority","source":"3.1","trigger":"计算先制","condition":"swift 存活","action":"加先制。","params":["swift.priority"]},{"key":"swift.mark","source":"3.1","trigger":"先出手","condition":"swift 存活","action":"目标获印记二；swift 非主位时新附加只刷新，不加层。","params":["mark2.gain","mark2.rounds","mark2.maxLayers"]},{"key":"swift.priority.cap","source":"3.2.1","trigger":"双方先制计算后比序","condition":"swift 主位效果","action":"对手最终先制上限为自身先制。","params":[]},{"key":"swift.mark.freeze","source":"3.2.1","trigger":"印记二扣回合时","condition":"swift 主位效果","action":"对手印记二的剩余回合暂停递减。","params":[]},{"key":"swift.stats","source":"3.2.2","trigger":"接任主位时快照","condition":"swift 主位","action":"按护盾量增加 spe，持续至下次换主位。","params":["swift.statBonusCapPanelRatio"]},{"key":"swift.first.fixed","source":"3.2.2","trigger":"先出手","condition":"swift 主位效果","action":"按自身速度附加固定伤害，并回复等量体力。","params":["swift.firstFixedSpeedRatio"]},{"key":"swift.first.mark1","source":"3.2.2","trigger":"swift.first.fixed 该段结算后","condition":"目标 HP 未因此减少；马尔修斯自身","action":"己方获得印记一，继承者不获得此奖励。","params":["mark1.gain"]},{"key":"swift.weaken.clear","source":"3.2.3","trigger":"自身被附加能力下降后立即","condition":"swift 主位效果","action":"尝试解除负等级。","params":[]},{"key":"swift.weaken.fallback","source":"3.2.3","trigger":"swift.weaken.clear 失败","condition":"实际已附加能力下降","action":"消除对手回合类效果，按最大体力比例汲取。","params":["swift.clearFailureTrueDrain"]},{"key":"ruin.attack.boost","source":"4.1","trigger":"攻击技能计算伤害","condition":"ruin 存活；按主位状态取档","action":"提高攻击技能伤害。","params":["ruin.reserveAttackBoost","ruin.leadAttackBoost"]},{"key":"ruin.status.damage","source":"4.1","trigger":"属性技能用招","condition":"ruin 存活；按主位状态取档","action":"附加机械系伤害。","params":["ruin.reserveStatusElementDamage","ruin.leadStatusElementDamage"]},{"key":"ruin.stats","source":"4.2.1","trigger":"接任主位时快照","condition":"ruin 主位","action":"按护盾量增加 spa，持续至下次换主位。","params":["ruin.statBonusCapPanelRatio"]},{"key":"ruin.skill.low","source":"4.2.1","trigger":"任意技能伤害后（含属性，仅计造成的红伤）","condition":"ruin 主位效果；低于门槛","action":"登记下一次增伤。","params":["ruin.lowDamageThreshold","ruin.nextDamageBoost"]},{"key":"ruin.skill.high","source":"4.2.1","trigger":"任意技能伤害后（含属性，仅计造成的红伤）","condition":"ruin 主位效果；达到门槛","action":"令对手下次属性技能无效。","params":["ruin.lowDamageThreshold"]},{"key":"ruin.kill.floor","source":"4.2.2","trigger":"自身出手时","condition":"ruin 主位效果；目标当前 HP 严格低于比例","action":"当次技能造成伤害至少达到对手当前 HP。","params":["ruin.lowTargetHpBelow"]},{"key":"ruin.receive.heal","source":"4.2.3","trigger":"逐段实际承受固定或百分比伤害后立即","condition":