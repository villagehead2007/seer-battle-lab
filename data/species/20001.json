alwaysHit":true,"priority":3,"critical":"1/16","fifth":true,"level":5,"provider":"user-original","revision":"draft-v1.4","hash":"795a3e020824a7e33d1186952d63a47f8a994f25c7446abe0dc5929e5a550e22","effectIds":[],"effectInstances":[],"deferredEffects":[],"description":"分支与第五技能本体绑定；仅可选存活形态；选择同主位仍能用招但不切主位。；当前主位承受自身最大 HP 比例真实伤害。；预约所选主位；自损击败当前主位后也保留预约；执行时目标已死则取消。；吸取对手最大体力比例。；下次技能必定命中且强制执行命中效果。；消除敌回合类效果；成功疲惫。；自身全属性提升。；免疫并反弹异常状态。；敌方无法通过自身技能回血。；延长已存在的禁疗；缺少禁疗时不创建。；附加护盾。；护盾数值短时不减少。；免疫下一次受到的攻击。；下一次使用技能消对手正强化及回合类效果；成功令其下次技能无效。；给对手加印记二。；按自身特攻附加固定伤害。；限制对手切换。；下次使用技能无视对手减伤。；下次技能增伤。"},{"id":2000102,"name":"王·三相裁决","type":"机械","kind":"special","power":150,"pp":5,"accuracy":100,"alwaysHit":true,"priority":0,"critical":"1/16","fifth":false,"level":4,"provider":"user-original","revision":"draft-v1.4","hash":"70b788bfd240c40e7c7d6e459db860b64b08f1318cd324a517902bb0116dc390","effectIds":[],"effectInstances":[],"deferredEffects":[],"description":"把微弱倍率提升到普通。；令属性技能无效；swift 主位延长。；给自身先制加成。；威力初始提升，命中推进；封顶无视对手能力提升。；该招伤害以自身护盾值为下限。；忽略对手伤害免疫与伤害限制。"},{"id":2000103,"name":"极速·掣电截击","type":"机械","kind":"special","power":90,"pp":20,"accuracy":100,"alwaysHit":true,"priority":3,"critical":"1/16","fifth":false,"level":3,"provider":"user-original","revision":"draft-v1.4","hash":"5bf2862a8539106ff62541d2573d5692d6e26df84cd14cf755758182c004cb3c","effectIds":[],"effectInstances":[],"deferredEffects":[],"description":"额外先制，基础先制见 moves.intercept。；成功使敌下次技能无效；失败尝试解除。；登记一次额外旧主位保留，不叠加。；尝试疲惫；成功清印记二并禁附加，按清除层数延长疲惫。；以对手最大 HP 算吸取；swift 每次接任后的首次该招改为汲取。；消除对手正强化及回合类效果。"},{"id":2000104,"name":"毁灭·熔核过载","type":"属性","kind":"status","power":0,"pp":5,"accuracy":100,"alwaysHit":true,"priority":0,"critical":"1/16","fifth":false,"level":2,"provider":"user-original","revision":"draft-v1.4","hash":"7c6b9cff66647e7f99764de2455f32b5d8076711dddb492fab5e83b8bf593b97","effectIds":[],"effectInstances":[],"deferredEffects":[],"description":"按对手最大 HP 吸取。；减伤。；增加先制。；增强攻击伤害，按通则命中消费。；短时同时启用三个主位效果，含已死形态；数值增加按激活回合开始的护盾快照。"},{"id":2000105,"name":"坚壁·永固壁垒","type":"属性","kind":"status","power":0,"pp":5,"accuracy":100,"alwaysHit":true,"priority":0,"critical":"1/16","fifth":false,"level":1,"provider":"user-original","revision":"draft-v1.4","hash":"05c99560a6561b393d13d0651a13964cb0bf25da37bd90064fdd8abf7e3c539a","effectIds":[],"effectInstances":[],"deferredEffects":[],"description":"防止消除自身回合类效果。；减伤。；定量吸取。；附加护盾；wall 主位时短时护盾数值不改变。；恢复全部 HP 及 PP。；立即回复；登记下次受伤减伤。"}],"souls":[{"id":20001,"hash":"52a98c968378fe1370f87349a33a149827f4ff1980c91a7c278e2408cb9b3d13","args":[],"description":"1.马尔修斯为团体精灵，中切登场时根据对手的行动决定自身主位，首发登场或死切登场默认由坚壁形态担任主位\n    1.1 中切登场时获得200点护盾，当回合对手实际使用属性技能、攻击技能，分别由极速、坚壁形态担任主位；若对手未使用技能则由毁灭形态担任主位，同时己方获得一层印记一\n    1.2马尔修斯切换主位精灵后仍保留原主位的效果一回合，若因死亡切换则切换后消除对手能力提升于回合类效果，并使其疲惫\n\n2.坚壁形态\n    2.1 坚壁形态存活时，马尔修斯受到的攻击伤害减少20%（坚壁形态担任主位时40%），回合结束时为自身附加等同于减少量的护盾（该来源的护盾最高300点，坚壁形态担任主位时最高400点）；自身受到的固定伤害、百分比伤害减少20%（坚壁形态担任主位时40%），回合结束时获得等同于减少量的护罩\n    2.2.1由坚壁形态担任主位时，马尔修斯处于弱化类异常状态时免疫其带来的负面效果，并且处于控制类异常状态时可以行动\n    2.2.2由坚壁形态担任主位时，自身双防数值增加x（x为切换主位时的护盾量，持续至下次切换主位，最高不超过面板数值的100%），使用技能后恢复等同于护盾量的体力\n    2.2.3 回合结束时若体力低于1/3，每场战斗仅一次恢复最大体力的1/3同时下回合抵挡受到的伤害（死亡不回复，包括固定伤害，百分比伤害）\n\n3.极速形态\n    3.1极速形态存活时，自身先制加一；先出手时为对手附加一层印记二（极速形态不担任主位时印记二无法叠加，新附加后刷新持续时间）\n    3.2.1极速形态担任主位时，对手先制无法高于自身，同时对手印记二的回合数在此期间不会减少\n    3.2.2极速形态担任主位时，自身速度数值增加x（x为切换主位时的护盾量 ，持续至下次切换主位，最高不超过面板数值的100%）；马尔修斯先出手时时附加速度值50%的固定伤害并恢复等量体力，对手体力未因此减少则为己方附加一层印记一\n    3.2.3极速形态担任主位时，自身被附加能力下降后立刻解除，若解除失败则消除对手回合类效果并汲取对手1/3最大体力\n\n4毁灭形态\n    4.1毁灭形态存活时，使用攻击技能时造成伤害提高25%（毁灭形态担任主位时50%），使用属性技能附加125点（毁灭形态担任主位时250点）机械系伤害\n    4.2.1毁灭形态担任主位时，特攻能力值增加x（x为切换主位时的护盾量 ，持续至下次切换主位，最高不超过面板数值的100%），使用任意技能（包括属性技能）后造成伤害低于250则下一次造成伤害提高100%，反之使对手下次属性技能无效\n    4.2.2毁灭形态担任主位时，自身出手时若对手体力若低于最大体力的1/4，则当次所有技能造成伤害不低于对手当前体力\n    4.2.3毁灭形态担任主位时，自身受到固定伤害与百分比伤害时立刻恢复该伤害99%的体力（致死也恢复）；自身造成伤害后恢复等同于造成伤害50%的体力\n\n5.马尔修斯拥有三种第五技能，效果不同，使用后下回合开始时分别由坚壁、极速、毁灭担任主位，点击第五技能后可从三种中选择其一使用（主位与原先相同则不切换主位），若选择切换主位，则立刻受到自身最大体力1/4的真实伤害，切换后吸取对手最大体力的1/3，下次技能必定命中且强制执行命中效果；技能无效时，魂印中效果仍触发\n\n使用第五技能切换至坚壁形态时\n不触发技能效果中免疫并反弹异常状态效果\n自身护盾值不高于200时为自身附加300点护盾\n自身护盾值高于200时一回合内护盾数值不减少\n若原本就是坚壁形态，则免疫下一次受到的攻击\n\n使用第五技能切换至极速形态时\n下一次使用技能时消除对手能力提升效果与回合类效果，消除成功任意一项使其下一次技能无效\n对手无法通过技能恢复体力效果延长一回合\n若原本就是极速形态，则为对手附加1层印记二\n\n使用第五技能切换至毁灭形态时\n附加自身特攻值70%的固定伤害\n两回合内对手无法切换精灵\n下一次使用技能无视对手伤害减少类效果\n若原本就是毁灭形态，则下一次使用技能时造成伤害提高100%\n\n印记一效果：马尔修斯下场后为下一只精灵保留主位精灵效果（数值增加不传递，仅一次触发效果不传递），每回合结束时减少一层，减少为零后效果结束，最多叠加3层\n\t\t\t\t坚壁形态时传递效果：1.弱化类异常状态时免疫其带来的负面效果，并且处于控制类异常状态时可以行动\n\t\t\t\t\t\t\t\t2.使用技能后恢复等同于护盾量的体力\n\n\t\t\t\t极速形态时传递效果：1.对手先制无法高于自身，同时对手印记二的回合数在此期间不会减少\n\t\t\t\t\t\t\t\t2.先出手时时附加速度值50%的固定伤害并恢复等量体力\n\t\t\t\t\t\t\t\t3.自身被附加能力下降后立刻解除，若解除失败则消除对手回合类效果并汲取对手1/3最大体力\n\n\t\t\t\t毁灭形态时传递效果：1.使用任意技能（包括属性技能）后造成伤害低于250则下一次造成伤害提高100%，反之使对手下次属性技能无效\n\t\t\t\t\t\t\t\t2.自身出手时若对手体力若低于最大体力的1/4，则当次所有技能造成伤害不低于对手当前体力\n\t\t\t\t\t\t\t\t3.自身受到固定伤害与百分比伤害时立刻恢复该伤害99%的体力（致死也恢复）；自身造成伤害后恢复等同于造成伤害50%的体力\n\n印记二效果：自身数值上视为全属性减一（具有属性减一的数值减少效果，不能被“对手处于能力下降”“自身处于能力下降”等词条响应），持续2回合，最多叠加2层\n#魂印2-1详解：自身受到伤害前，记录该伤害数值为x，自身实际只受到0.8x的伤害（坚壁形态担任主位时为0.6x），回合结束时获得等同于0.2x（坚壁形态担任主位时为0.4x）的护盾"}],"effects":[],"missingEffects":[],"originalSpec":{"schema":1,"revision":"draft-v1.4","author":"用户原创","sourceFile":"design-v1.txt","status":"仅草稿","species":{"id":20001,"name":"SP马尔修斯","type":"机械","baseTotal":790,"base":{"atk":80,"spa":150,"def":121,"spd":121,"spe":136,"maxHp":182},"forms":["wall","swift","ruin"],"defaultLead":"wall"},"ids":{"prefix":"custom.sp-mars-20001","soul":"soul","numericMoveIds":null,"numericSoulId":null,"numericEffectIds":null},"moves":{"fifth":{"name":"王·异甲同心","element":null,"category":"status","power":0,"pp":5,"alwaysHit":true,"priority":3,"choices":["wall","swift","ruin"]},"verdict":{"name":"王·三相裁决","element":"机械","category":"special","power":150,"pp":5,"alwaysHit":true},"intercept":{"name":"极速·掣电截击","element":"机械","category":"special","power":90,"pp":20,"alwaysHit":true,"priority":3},"overdrive":{"name":"毁灭·熔核过载","element":null,"category":"status","power":0,"pp":5,"alwaysHit":true},"rampart":{"name":"坚壁·永固壁垒","element":null,"category":"status","power":0,"pp":5,"alwaysHit":