'use strict';require('./preload.cjs');const test=require('node:test'),assert=require('node:assert/strict'),H=require('./battle.cjs'),{make,pick,turn,timer,key}=H,e=id=>pick(id)[0],sum=(s,type='attack',side=1)=>(s.damageEvents??[]).filter(x=>x.round===s.round-1&&x.type===type&&x.targetSide===side&&x.sourceSide!==side).reduce((n,x)=>n+x.settledDamage,0);
function qualified(s,work,m=s.auditMoveId,enemy=20456,side=0){const old=H.E.SOULS;let done=false;H.E.SOULS={...old,run(ev,c){old.run(ev,c);if(!done&&ev==='roundStart'&&c.a.side===side){done=true;work(c);}}};try{return turn(s,m,enemy);}finally{H.E.SOULS=old;}}
function enemyMove(s,id,index=-1){const m=H.source.moves.find(m=>m.id===id),k=key(id);s.moveDefinitions[k]={...structuredClone(m),id:k,wikiId:id,operations:H.independentOperations(m,index)};s.fighters[1].moves[2]=k;s.fighters[1].pp[k]=m.pp;return id;}
test("4663基础10001 撞击真实HP/PP/控制/零PP/末次PP",()=>{const z=turn(make({moveId:10001,index:-1}));assert.equal(z.fighters[0].pp[key(10001)],34);assert.equal(sum(z)>0,true);const b=make({moveId:10001,index:-1});b.fighters[0].ailments['疲惫']=3;turn(b);assert.equal(b.fighters[0].pp[key(10001)],35);const p=make({moveId:10001,index:-1});p.fighters[0].pp[key(10001)]=0;assert.throws(()=>turn(p),/PP|技能/);p.fighters[0].pp[key(10001)]=1;turn(p);assert.equal(p.fighters[0].pp[key(10001)],0);});
