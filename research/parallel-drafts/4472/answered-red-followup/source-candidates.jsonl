{"species":4270,"id":22999,"hash":"5ab26b56","index":0,"e":{"id":140,"args":[5,2],"description":"随机降低对手1/5至1/2的当前体力值"},"code":"(c,p)=>{const lo=Math.min(p[0],p[1]),hi=Math.max(p[0],p[1]);const n=Math.floor(c.t.hp*(1/lo-(1/lo-1/hi)*c.random()));c.hurt(c.t,n,c.m.name,'percent');}"}
