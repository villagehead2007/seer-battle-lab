{"species":4408,"id":28052,"hash":"537cc6a9","index":1,"e":{"id":479,"args":[500,500,500,1],"description":"损失自身500点体力，给对手造成500点固定伤害，若自身体力不足500则剩下1点体力"},"code":"(c,p)=>{const cost=c.a.hp<p[2]?Math.max(0,c.a.hp-p[3]):p[0];c.hurt(c.a,cost,c.m.name+'自身体力损失','direct',true);c.hurt(c.t,p[1],c.m.name+'自损追加','fixed');}"}
{"species":4421,"id":28088,"hash":"ec0c7445","index":2,"e":{"id":1858,"args":[50],"description":"自身每处于一种能力提升、能力下降、异常状态则附加50点固定伤害，自身每有1层龙胆视为自身至少处于一种"},"code":"(c,p)=>{const stages=Object.values(c.a.stages),abnormal=Object.values(c.a.ailments).some(end=>end>=c.round),gall=c.a.soulState.dragonGall??0,count=Math.max(gall,Number(stages.some(n=>n>0))+Number(stages.some(n=>n<0))+Number(abnormal));if(count>0&&c.t.hp>0)c.hurt(c.t,count*p[0],c.m.name+'状态种类附伤','fix"}
{"species":4432,"id":28115,"hash":"d53063a","index":1,"e":{"id":1276,"args":[2],"description":"消耗自身全部体力，给对手附加消耗体力1/2等量的百分比伤害"},"code":"(c,p)=>{const n=c.hurt(c.a,c.a.hp,c.m.name+'自身体力消耗','direct',true);if(c.t.hp>0)c.hurt(c.t,n/p[0],c.m.name+'消耗体力追加','percent');}"}
{"species":4432,"id":28116,"hash":"cb36124c","index":3,"e":{"id":1537,"args":[350],"description":"消耗自身所有护罩并造成等量固定伤害，若当前护罩值低于350则造成的固定伤害翻倍"},"code":"(c,p)=>{const n=c.consumeBarrier(c.a);c.hurt(c.t,n*(n<p[0]?2:1),c.m.name+'护罩消耗','fixed');}"}
{"species":4432,"id":28117,"hash":"57ecdcc5","index":3,"e":{"id":1662,"args":[],"description":"消耗自身所有护盾值并附加等量固定伤害，若对手体力未变化则恢复自身等量体力值"},"code":"c=>{const n=c.consumeShields(c.a,c.t);if(n>0&&c.t.hp>0&&c.hurt(c.t,n,c.m.name+'护盾转伤','fixed')===0)c.heal(c.a,n,c.m.name+'护盾转伤失败');}"}
{"species":4445,"id":28146,"hash":"53b86079","index":0,"e":{"id":1387,"args":[240,240],"description":"获得240点护盾，护盾消失时附加240点固定伤害"},"code":"(c,p)=>{const st=c.a.soulState,source='1387:'+c.m.id+':'+c.round+':'+((st.senyaShieldSerial??0)+1);st.senyaShieldSerial=(st.senyaShieldSerial??0)+1;c.addShield(c.a,p[0],source);st.sourceShieldReactions??={};st.sourceShieldReactions[source]={kind:'fixed',amount:p[1]};}"}
{"species":4450,"id":28164,"hash":"26ad69ae","index":0,"e":{"id":1908,"args":[0,2,100,2],"description":"0%概率受到自身最大体力1/2的百分比伤害，剩下100%概率附加自身最大体力1/2的百分比伤害"},"code":"(c,p)=>{const x=c.random()*100;if(x<p[0])c.hurt(c.a,c.a.stats.maxHp/p[1],c.m.name+'自身百分比','percent');else if(x<p[0]+p[2])c.hurt(c.t,c.a.stats.maxHp/p[3],c.m.name+'对手百分比','percent');}"}
{"species":4450,"id":28166,"hash":"c78c3497","index":1,"e":{"id":1889,"args":[100,7,200],"description":"100%使对手疲惫，未触发则附加200点真实伤害，技能无效时100%使对手疲惫并附加400点真实伤害"},"code":"(c,p)=>{if(!(statusRoll(c,p[0])&&c.ailment(c.t,ailments[p[1]],c.a)))c.hurt(c.t,p[2],c.m.name+'疲惫未触发','true');}"}
