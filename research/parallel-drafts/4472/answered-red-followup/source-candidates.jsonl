{"species":4186,"id":29187,"hash":"198bdafa","index":1,"e":{"id":2360,"args":[50],"description":"消除双方能力提升状态、能力下降状态、护盾、护罩，消除成功时附加对手最大体力50%的百分比伤害且免疫下次对手攻击的伤害并附加免疫量的真实伤害"},"code":"(c,p)=>{let changed=false;for(const f of [c.a,c.t]){const pos=c.clearBoost(f),neg=c.clearNegative(f),shield=c.consumeShields(f,c.a,false),barrier=c.consumeBarrier(f);changed ||=pos||neg||shield>0||barrier>0;}if(changed){if(c.t.hp>0)c.hurt(c.t,c.t.stats.maxHp*p[0]/100,c.m.name+'清除追加','percent');if(c."}
