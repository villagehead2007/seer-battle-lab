{"species":4247,"id":27654,"hash":"499eb2af","index":1,"e":{"id":1387,"args":[400,200],"description":"获得400点护盾，护盾消失时附加200点固定伤害"},"code":"(c,p)=>{const st=c.a.soulState,source='1387:'+c.m.id+':'+c.round+':'+((st.senyaShieldSerial??0)+1);st.senyaShieldSerial=(st.senyaShieldSerial??0)+1;c.addShield(c.a,p[0],source);st.sourceShieldReactions??={};st.sourceShieldReactions[source]={kind:'fixed',amount:p[1]};}"}
