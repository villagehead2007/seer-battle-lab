test('4658全17招34原实例完整成功/控制未用/整招无效矩阵，明确研究隔离未答原政策',()=>{for(const m of source.moves){const ok=make(m.id,null,{whole:true,hp:4000,policies});turn(ok);assert.equal(ok.fighters[0].pp[key(m.id)],m.pp-1);assert.ok(ok.fighters[0].hp>0);const ctl=make(m.id,null,{whole:true,hp:4000,policies});ctl.fighters[0].ailments['疲惫']=3;turn(ctl);assert.equal(ctl.fighters[0].pp[key(m.id)],m.pp);assert.equal(dmg(ctl),0);assert.equal(ctl.fighters[0].hp,4000);assert.equal(ctl.fighters[1].hp,9000);const inv=make(m.id,null,{whole:true,hp:4000,policies});inv.fighters[0].counts.nextSkillInvalid=1;turn(inv);assert.equal(inv.fighters[0].pp[key(m.id)],m.pp-1);assert.equal(dmg(inv),0);if(m.id!==28767&&m.id!==37439){assert.equal(inv.fighters[0].hp,4000);assert.equal(inv.fighters[1].hp,9000);}}});
test('1860真实初始敌1797登场烧伤通过原准入后转3沉默并保留首条记录',()=>{const s=make(10086,null,{fullSoul:true,entryBurn:true,omit:true});assert.deepEqual(soulState(s).records.map(x=>x.name),['烧伤']);assert.equal(s.fighters[0].ailments['烧伤'],undefined);assert.equal(s.fighters[0].ailments['沉默'],3);assert.equal(soulState(s).entryRound,1);});
test('1860原麻痹准入成功直接转沉默3，免控制副作用并记录，末DOT1125后回复1350',()=>{const s=make(10086,null,{fullSoul:true,omit:true,hp:4000});trigger(s,c=>{assert.equal(c.ailment(c.a,'麻痹',c.t,false,false,2),true);assert.equal(c.a.ailments['麻痹'],undefined);assert.equal(c.a.ailments['沉默'],3);});assert.equal(s.fighters[0].hp,4225);assert.deepEqual(soulState(s).records.map(x=>x.name),['麻痹']);assert.equal(s.fighters[0].pp[key(10086)],34);});
test('1860原异常被次数免疫失败不转换不记录且真实消费1次',()=>{const s=make(10086,null,{fullSoul:true,omit:true});s.fighters[0].counts.immune=1;trigger(s,c=>assert.equal(c.ailment(c.a,'烧伤',c.t,false,false,2),false));assert.equal(s.fighters[0].counts.immune,0);assert.equal(soulState(s).records.length,0);assert.equal(s.fighters[0].ailments['沉默'],undefined);assert.equal(s.fighters[0].hp,9000);});
test('1860转换沉默跳过新沉默单项免疫，原流血准入仍成功且不保留流血DOT',()=>{const s=make(10086,null,{fullSoul:true,omit:true,hp:4000});s.fighters[0].build.resistance={major:'沉默',minor:null};trigger(s,c=>assert.equal(c.ailment(c.a,'流血',c.t,false,false,3),true));assert.equal(s.fighters[0].ailments['流血'],undefined);assert.equal(s.fighters[0].ailments['沉默'],3);assert.equal(dmg(s,'fixed',0),0);assert.equal(soulState(s).records.length,1);});
test('1860狂信准入改沉默前不创建狂信来源或禁止当前实际出手',()=>{const s=make(10086,null,{fullSoul:true,omit:true});trigger(s,c=>assert.equal(c.ailment(c.a,'狂信',c.t,false,false,2),true));assert.equal(s.fighters[0].statusState.faithSourceSide,undefined);assert.equal(s.fighters[0].ailments['狂信'],undefined);assert.equal(s.fighters[0].pp[key(10086)],34);assert.ok(dmg(s)>0);});
test('1860四次不同原异常FIFO记录cap4，第5次仍转沉默且不加层',()=>{const s=make(10086,null,{fullSoul:true,omit:true});trigger(s,c=>{for(const k of ['烧伤','流血','中毒','麻痹','害怕'])assert.equal(c.ailment(c.a,k,c.t,false,false,2),true);assert.equal(c.a.ailments['沉默'],3);});assert.deepEqual(soulState(s).records.map(x=>x.name),['烧伤','流血','中毒','麻痹']);assert.equal(soulState(s).conversions.length,5);});
test('1860同一非沉默原异常转走后再次真实进入逐次记而非仅记种类',()=>{const s=make(10086,null,{fullSoul:true,omit:true});trigger(s,c=>{c.ailment(c.a,'流血',c.t,false,false,2);c.ailment(c.a,'流血',c.t,false,false,2);});assert.deepEqual(soulState(s).records.map(x=>x.name),['流血','流血']);});
test('1860记录攻击红增30%不加固定和独立属性红，同次原HP与PP真实变化',()=>{const base=make(10086,null,{omit:true}),s=make(10086,null,{fullSoul:true,omit:true});trigger(s,c=>c.ailment(c.a,'流血',c.t,false,false,2));turn(base);assert.ok(dmg(s)>dmg(base));const before=s.fighters[1].hp;trigger(s,c=>c.hurt(c.t,200,'明确固定对照','fixed'));assert.equal(dmg(s,'fixed'),200);assert.ok(s.fighters[1].hp<before);});
test('1860第3轮仍转换，第4轮攻击使用后FIFO消费首条并粉3000理论回血，末按剩余记录',()=>{const s=make(10086,null,{fullSoul:true,omit:true,hp:4000});trigger(s,c=>{c.ailment(c.a,'流血',c.t,false,false,2);c.ailment(c.a,'烧伤',c.t,false,false,2);});turn(s,20030);let r3;trigger(s,c=>{r3=c.ailment(c.a,'中毒',c.t,false,false,2);});assert.equal(r3,true);assert.equal(soulState(s).records.length,3);let after;turn(s,10086,null,{after(ev,c){if(ev==='afterUse'&&c.a.side===0)after={hp:c.a.hp,target:c.t.hp,records:c.a.soulState.memory1860.records.map(x=>x.name)};}});assert.deepEqual(after.records,['烧伤','中毒']);assert.equal(dmg(s,'percent'),3000);assert.equal(soulState(s).records.length,2);assert.equal(s.fighters[0].pp[key(10086)],32);});
test('1860第4轮新异常正常进入原种类无转换无新记录，属性招不消费',()=>{const s=make(10086,null,{fullSoul:true,omit:true});turn(s,20030);turn(s,20030);turn(s,20030);trigger(s,c=>assert.equal(c.ailment(c.a,'流血',c.t,false,false,2),true),20030);assert.equal(soulState(s).records.length,0);assert.equal(s.fighters[0].ailments['流血'],5);assert.equal(dmg(s,'fixed',0),80);});
test('1860无记录第4轮实际攻击不吸取；控制未使用不消费已有记录',()=>{const s=make(10086,null,{fullSoul:true,omit:true});for(let i=0;i<3;i++)turn(s,20030);turn(s);assert.equal(dmg(s,'percent'),0);const t=make(10086,null,{fullSoul:true,omit:true});trigger(t,c=>c.ailment(c.a,'烧伤',c.t,false,false,2));turn(t,20030);turn(t,20030);t.fighters[0].ailments['疲惫']=6;turn(t);assert.equal(soulState(t).records.length,1);assert.equal(t.fighters[0].pp[key(10086)],34);});
test('1860记录沉默已在场的自然刷新精确001诊断不冒称记录已定，显式两模型改变层及回血',()=>{const s=make(10086,null,{fullSoul:true,omit:true});let live;assert.throws(()=>trigger(s,c=>{live=c;c.ailment(c.a,'沉默',c.t,false,false,2);c.ailment(c.a,'沉默',c.t,false,false,2);}),/Q-N50-4658-001/);assert.equal(live.a.pp[key(10086)],34);assert.equal(live.a.soulState.memory1860.records.length,1);for(const p of ['record','no-record']){const t=make(10086,null,{fullSoul:true,omit:true,hp:4000,policies:{qualifiedSilenceRefresh1860:p}});trigger(t,c=>{c.ailment(c.a,'沉默',c.t,false,false,2);c.ailment(c.a,'沉默',c.t,false,false,2);});assert.equal(soulState(t).records.length,p==='record'?2:1);assert.equal(t.fighters[0].hp,p==='record'?5575:4225);}});

test('20030与20088真实速度1攻击2，免强化失败及能力+6边界',()=>{const a=make(20030);turn(a);assert.equal(a.fighters[0].stages.spe,1);const b=make(20088);turn(b);assert.equal(b.fighters[0].stages.atk,2);const c=make(20088);c.fighters[0].stages.atk=5;turn(c);assert.equal(c.fighters[0].stages.atk,6);const x=make(20088);timed(x.fighters[0],'禁强化');turn(x);assert.equal(x.fighters[0].stages.atk,0);});
test('33072真实88概率3三倍红，未触发基准和实际HP/PP',()=>{const a=make(33072),b=make(33072,null,{omit:true});let seen;turn(a,33072,null,{beforeEffect(p,c){if(p==='beforeDamage')c.random=()=>0;},afterEffect(p,c){if(p==='beforeDamage')seen=c.modifier;}});turn(b);assert.ok(seen>=3);assert.ok(dmg(a)>dmg(b));assert.equal(a.fighters[1].hp,9000-dmg(a));assert.equal(a.fighters[0].pp[key(33072)],39);});
test('33073敌真实负级追加固定80，零级不追加且免固0保持真实红',()=>{const a=make(33073);a.fighters[1].stages.def=-1;turn(a);assert.equal(dmg(a,'fixed'),80);const b=make(33073);turn(b);assert.equal(dmg(b,'fixed'),0);const c=make(33073);c.fighters[1].stages.def=-1;timed(c.fighters[1],'固定百分比免疫');turn(c);assert.equal(dmg(c,'fixed'),0);assert.ok(dmg(c)>0);});
test('37433解除并转移真实流血3并封本轮命中效果，原异常免疫失败仍按解除成功',()=>{for(const immune of[false,true]){const s=make(37433,0);s.fighters[0].ailments['流血']=3;if(immune)s.fighters[1].counts.immune=1;turn(s);assert.equal(s.fighters[0].ailments['流血'],undefined);assert.equal(s.fighters[1].ailments['流血'],immune?undefined:3);assert.equal(active(s,1,'技能命中效果失效'),true);assert.equal(s.fighters[0].pp[key(37433)],19);}});
test('37433吸取并反转敌攻击2特攻1，原负速度不扩大，零正级无变化',()=>{const s=make(37433,1);Object.assign(s.fighters[1].stages,{atk:2,spa:1,spe:-1});turn(s);assert.equal(s.fighters[0].stages.atk,2);assert.equal(s.fighters[0].stages.spa,1);assert.equal(s.fighters[1].stages.atk,-2);assert.equal(s.fighters[1].stages.spa,-1);assert.equal(s.fighters[1].stages.spe,-1);});
test('37433低于300完整红授下2次先制2，属性实际使用消费而被控不消费',()=>{const s=make(37433,2,{aStats:{atk:30}});turn(s);assert.ok(dmg(s)<300);assert.equal(s.fighters[0].counts.nextSkillPriority,2);let p;turn(s,20030,null,{after(ev,c){if(ev==='priority'&&c.a.side===0)p=c.priority;}});assert.equal(s.fighters[0].counts.nextSkillPriority,1);s.fighters[0].ailments['疲惫']=5;turn(s,20030);assert.equal(s.fighters[0].counts.nextSkillPriority,1);});
test('33075混乱10概率成功时长2或3，免异真实消费且不补抽',()=>{const s=make(33075);turn(s,33075,null,{beforeEffect(p,c){if(p==='afterHit')c.random=()=>0;}});assert.ok([2,3].includes(s.fighters[1].ailments['混乱']));const t=make(33075);t.fighters[1].counts.immune=1;turn(t,33075,null,{beforeEffect(p,c){if(p==='afterHit')c.random=()=>0;}});assert.equal(t.fighters[1].counts.immune,0);assert.equal(t.fighters[1].ailments['混乱'],undefined);});
test('26625两回合要害概率加1/8与下2轮无视敌强化，真实红伤及结束恢复',()=>{const s=make(26625),b=make(10086,null,{omit:true});s.fighters[1].stages.def=4;b.fighters[1].stages.def=4;turn(s);assert.equal(s.fighters[0].effects['要害概率增加'].chance,1/8);assert.equal(s.fighters[0].effects['无视对手强化'].start,2);assert.equal(s.fighters[0].effects['无视对手强化'].end,3);turn(s,10086);turn(b);assert.ok(dmg(s)>dmg(b));turn(s,20030);turn(s,10086);assert.equal(active(s,0,'无视对手强化'),false);});
test('37434三回合攻击5%秒杀明确失败仍红伤，明确成功真实HP归0',()=>{const a=make(37434);turn(a,37434,null,{beforeEffect(p,c){if(p==='afterHit')c.random=()=>.9;}});assert.equal(a.fighters[0].effects['攻击附加秒杀概率'].chance,5);assert.ok(a.fighters[1].hp>0);const b=make(37434);turn(b,37434,null,{beforeEffect(p,c){if(p==='afterHit')c.random=()=>0;}});turn(b,10086,null,{before(ev,c){if(ev==='beforeUse'&&c.a.side===0)c.random=()=>0;}});assert.ok(b.fighters[1].hp<9000);});
test('37435复制敌正并免异1，六项正类每种威力20而非级数总和',()=>{const a=make(37435,null,{whole:true});Object.assign(a.fighters[1].stages,{atk:2,spa:1});let power;turn(a,37435,null,{afterEffect(p,c){if(p==='beforeDamage')power=c.power;}});assert.equal(a.fighters[0].stages.atk,2);assert.equal(a.fighters[0].stages.spa,1);assert.equal(a.fighters[0].counts.immune,1);assert.equal(power,130);const b=make(37435,1);Object.assign(b.fighters[0].stages,{atk:2,spa:1});turn(b,37435,null,{afterEffect(p,c){if(p==='beforeDamage')power=c.power;}});assert.equal(power,170);});
test('28767固有复制概率未触发自然回复半HP与敌全负1，禁疗仍独立弱化',()=>{for(const ban of[false,true]){const s=make(28767,null,{hp:1000});if(ban)timed(s.fighters[0],'技能禁疗');turn(s,28767,null,{beforeEffect(p,c){if(p==='copy1619')c.random=()=>.9;}});assert.equal(s.fighters[0].hp,ban?1000:5500);assert.deepEqual(stats.map(k=>s.fighters[1].stages[k]),Array(6).fill(-1));assert.equal(s.fighters[0].pp[key(28767)],9);}});
test('28767复制成功生命周期自然010诊断保留已扣PP，明确组件研究复制真实敌攻击HP',()=>{const s=make(28767,null,{aStats:{spe:30}});let live;assert.throws(()=>turn(s,28767,10086,{beforeEffect(p,c){if(p==='copy1619'){live=c;c.random=()=>0;}}}),/Q-N50-4658-010/);assert.equal(live.a.pp[key(28767)],9);assert.ok(live.a.hp<9000);const t=make(28767,null,{aStats:{spe:30},policies:{qualifiedCopy16194658:'component'}});turn(t,28767,10086,{beforeEffect(p,c){if(p==='copy1619')c.random=()=>0;}});assert.ok(dmg(t)>0);assert.equal(t.fighters[0].pp[key(28767)],9);assert.equal(t.fighters[1].pp[key(10086)],34);});
test('37436反馈失败明确清除自身负阶，正常移交研究模型与目标非零公共002保护',()=>{const f=make(37436,0);f.fighters[0].stages.atk=-2;timed(f.fighters[1],'免弱');turn(f);assert.equal(f.fighters[0].stages.atk,0);assert.equal(f.fighters[1].stages.atk,0);const s=make(37436,0,{policies:{qualified1192Feedback4658:{target:'add',self:'transfer'}}});s.fighters[0].stages.atk=-2;turn(s);assert.equal(s.fighters[0].stages.atk,0);assert.equal(s.fighters[1].stages.atk,-2);const n=make(37436,0);n.fighters[0].stages.atk=-2;n.fighters[1].stages.atk=1;assert.throws(()=>turn(n),/Q-N50-4600-002/);});
test('37436敌负级威力翻倍，不把魂1860记录的攻击增伤当威力',()=>{const a=make(37436,1),b=make(37436,1);a.fighters[1].stages.atk=-1;let p1,p2;turn(a,37436,null,{afterEffect(p,c){if(p==='beforeDamage')p1=c.power;}});turn(b,37436,null,{afterEffect(p,c){if(p==='beforeDamage')p2=c.power;}});assert.equal(p1,260);assert.equal(p2,130);assert.ok(dmg(a)>dmg(b));});
test('28768回合反弹异常4轮与清回合成功敌属性封2轮，失败不伪授',()=>{const a=make(28768,0);turn(a);assert.equal(a.fighters[0].effects.reflect.end,4);const b=make(28768,1);timed(b.fighters[1],'强化效果');turn(b);assert.equal(active(b,1,'statusBlock'),true);assert.equal(b.fighters[1].pp[key(20030)],34);const c=make(28768,1);turn(c);assert.equal(c.fighters[1].effects.statusBlock,undefined);});
test('28768护盾400真实承伤消失对敌诅咒并消费免异，已有盾仅005诊断',()=>{const s=make(28768,2);turn(s);assert.equal(s.fighters[0].suitState.shield,400);s.fighters[1].counts.immune=1;turn(s,10086,10086,{before(ev,c){if(ev==='beforeUse'&&c.a.side===1)c.hurt(c.t,400,'明确固定破盾','fixed');}});assert.equal(s.fighters[0].suitState.shield,0);assert.equal(s.fighters[1].counts.immune,0);assert.equal(s.fighters[1].ailments['诅咒'],undefined);const t=make(28768,2);t.fighters[0].suitState.shield=1;assert.throws(()=>turn(t),/Q-N50-4600-005/);});
test('28768两纯多宠实例不凭空恢复当前HP/授当前免攻，真实PP消费',()=>{for(const index of[3,4]){const s=make(28768,index,{hp:4000});turn(s);assert.equal(s.fighters[0].hp,4000);assert.equal(s.fighters[1].hp,9000);assert.equal(s.fighters[0].counts.attackImmune??0,0);assert.equal(s.fighters[0].pp[key(28768)],4);}});
test('37437敌回复效果减70%真实恢复300，后手封下1轮属性不倒改当前PP',()=>{const s=make(37437,0);turn(s);trigger(s,c=>{const hp=c.t.hp;c.heal(c.t,1000,'真实回复检验','skill');assert.equal(c.t.hp-hp,300);},20030);const t=make(37437,1,{aStats:{spe:30}});turn(t);assert.equal(t.fighters[1].effects.statusBlock.start,2);assert.equal(t.fighters[1].effects.statusBlock.end,2);assert.equal(t.fighters[1].pp[key(20030)],34);});
test('28769任意方异常全属性翻倍，免强化失败及六项cap，原无异常全1',()=>{for(const abnormal of[false,true]){const s=make(28769,0);if(abnormal)s.fighters[1].ailments['流血']=2;turn(s);assert.deepEqual(stats.map(k=>s.fighters[0].stages[k]),Array(6).fill(abnormal?2:1));}const s=make(28769,0);timed(s.fighters[0],'禁强化');turn(s);assert.deepEqual(stats.map(k=>s.fighters[0].stages[k]),Array(6).fill(0));});
test('28769四回合用招比例3000伤害只在回复时低半翻6000，禁疗不消去粉伤',()=>{for(const ban of[false,true]){const s=make(28769,1,{hp:1000,policies:{qualifiedFirst7174658:'next-use'}});if(ban)timed(s.fighters[0],'技能禁疗');turn(s);assert.equal(dmg(s,'percent'),0);turn(s,20030);assert.equal(dmg(s,'percent'),3000);assert.equal(s.fighters[0].hp,ban?1000:7000);assert.equal(s.fighters[0].pp[key(20030)],34);}});
test('28769下2轮攻击增100%与敌先制减2真实顺序/伤害，到期恢复',()=>{const a=make(28769,2),b=make(10086,null,{omit:true});turn(a);turn(a,10086);turn(b);assert.ok(dmg(a)>dmg(b));const s=make(28769,3);turn(s);let p;turn(s,20030,20030,{after(ev,c){if(ev==='priority'&&c.a.side===1)p=c.priority;}});assert.equal(p,-2);assert.equal(s.fighters[1].effects['次回合先制降低'].end,3);});
test('37438必中基础69清双方回合任一成功授下1攻倍伤，无成功不授',()=>{const a=make(37438,1);timed(a.fighters[0],'要害概率增加',{chance:.1});timed(a.fighters[1],'强化效果');turn(a);assert.equal(a.fighters[0].counts.nextAttackBoost,1);assert.equal(a.fighters[0].effects['要害概率增加'],undefined);assert.equal(a.fighters[1].effects['强化效果'],undefined);const b=make(37438,1);turn(b);assert.equal(b.fighters[0].counts.nextAttackBoost??0,0);});
test('37438双方流血成功无额外诅咒，敌免异失败则额外诅咒真实消费',()=>{const a=make(37438,2);turn(a);assert.ok(a.fighters[0].ailments['流血']>=1);assert.ok(a.fighters[1].ailments['流血']>=1);assert.equal(a.fighters[1].ailments['诅咒'],undefined);const b=make(37438,2);b.fighters[1].counts.immune=1;turn(b);assert.equal(b.fighters[1].counts.immune,0);assert.equal(b.fighters[1].ailments['流血'],undefined);assert.ok(b.fighters[1].ailments['诅咒']>=1);});
test('37439自身异常先制3且真实控未用不扣PP，零异常先制0',()=>{let p;const s=make(37439,0);s.fighters[0].ailments['流血']=2;turn(s,37439,null,{after(ev,c){if(ev==='priority'&&c.a.side===0)p=c.priority;}});assert.equal(p,3);assert.equal(s.fighters[0].pp[key(37439)],4);const t=make(37439,0);t.fighters[0].ailments['疲惫']=2;turn(t);assert.equal(t.fighters[0].pp[key(37439)],5);});
test('37439敌用属性触发下2轮限伤共同单次200，非用招控制不授',()=>{const s=make(37439,1);turn(s);assert.equal(s.fighters[0].effects['伤害上限'].start,2);assert.equal(s.fighters[0].effects['伤害上限'].end,3);trigger(s,c=>c.hurt(c.a,100,'共同低于上限','fixed'),20030);assert.equal(dmg(s,'fixed',0),100);});
test('37439真实回合被清消费敌下一次命中失效，整招无效回半并下次攻击减半',()=>{const a=make(37439,2);turn(a);trigger(a,c=>c.clear(c.a),20030);assert.equal(a.fighters[1].counts.nextAttackHitInvalid,1);const b=make(37439,3,{hp:1000});b.fighters[0].counts.nextSkillInvalid=1;turn(b);assert.equal(b.fighters[0].hp,5500);assert.equal(b.fighters[0].counts.nextAttackReductionUses,1);assert.equal(b.fighters[0].soulState.nextAttackReductionFraction,.5);});

test('37439/800自然第二次伤害额度分歧精确保护，已扣实际属性PP与第一笔HP不回滚',()=>{const s=make(37439,1);turn(s);let c1;assert.throws(()=>trigger(s,c=>{c1=c;c.hurt(c.a,200,'第一笔共同上限','fixed');c.hurt(c.a,10,'第二笔额度分歧','fixed');},20030),/Q-N50-4633-001/);assert.equal(c1.a.hp,8800);assert.equal(c1.a.pp[key(20030)],34);});
test('37439/800明确各事件与整回合结算模型真实HP差200，盾前后研究真实容量与HP差',()=>{for(const unit of['event','round-settled']){const s=make(37439,1,{policies:{qualified800Unit4658:unit}});turn(s);trigger(s,c=>{c.hurt(c.a,500,'第一笔','fixed');c.hurt(c.a,500,'第二笔','fixed');},20030);assert.equal(s.fighters[0].hp,unit==='event'?8600:8800);}for(const order of['before','after']){const s=make(37439,1,{policies:{qualified800Unit4658:'event',qualified800Shield4658:order}});turn(s);s.fighters[0].suitState.shield=300;trigger(s,c=>c.hurt(c.a,500,'明确顺序一次','fixed'),20030);assert.equal(s.fighters[0].suitState.shield,order==='before'?100:0);assert.equal(s.fighters[0].hp,order==='before'?9000:8800);}});
test('1860第4轮比例吸取遇敌百分免疫仍理论3000回复，禁疗与回复倍率保持公共链',()=>{for(const mode of['immune','blocked','multiplier']){const s=make(10086,null,{fullSoul:true,omit:true,hp:1000});trigger(s,c=>c.ailment(c.a,'烧伤',c.t,false,false,2));turn(s,20030);turn(s,20030);s.fighters[0].hp=1000;if(mode==='immune')timed(s.fighters[1],'固定百分比免疫');if(mode==='blocked')timed(s.fighters[0],'哀目黑子禁止回复');if(mode==='multiplier')s.fighters[0].ailments['星赎']=5;let observed;turn(s,10086,null,{after(ev,c){if(ev==='afterUse'&&c.a.side===0)observed=c.a.hp;}});assert.equal(soulState(s).records.length,0);assert.equal(dmg(s,'percent'),mode==='immune'?0:3000);assert.equal(observed,mode==='blocked'?1000:mode==='multiplier'?4900:4000);}});
