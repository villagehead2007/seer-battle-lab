'use strict';require('./preload-production.cjs');const test=require('node:test'),assert=require('node:assert/strict'),{E,source,key,stats,make,turn,timed,dmg,active}=require('./4658-battle.cjs');
const policies={qualifiedCopy16194658:'component',qualifiedNoReleased16194658:'fallback',qualifiedFirst7174658:'next-use',qualified1203Basis4658:'attack',qualified1192Feedback4658:{target:'add',self:'transfer'}};
function soulState(s){return s.fighters[0].soulState.memory1860;}
function trigger(s,callback,move=10086){return turn(s,move,null,{before(ev,c){if(ev==='beforeUse'&&c.a.side===0)callback(c);}});}

test("10086 冲顶 真实基础physical威力40PP35第五false",()=>{const s=make(10086,null,{omit:true});assert.equal(s.moveDefinitions[key(10086)].power,40);assert.equal(s.moveDefinitions[key(10086)].alwaysHit,false);assert.equal(s.moveDefinitions[key(10086)].fifth,false);turn(s);assert.equal(s.fighters[0].pp[key(10086)],34);assert.ok(dmg(s)>0);assert.equal(s.fighters[1].hp,9000-dmg(s));});

