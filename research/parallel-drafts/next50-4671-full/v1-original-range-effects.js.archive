function nextRound4671(c){const e=c.a.soulState.clawNextAilments4671;if(!e||e.round!==c.round)return;delete c.a.soulState.clawNextAilments4671;if(c.t.hp<=0)return;const pool=['烧伤','冻伤','中毒'];for(let i=0;i<e.count;i++){const k=pool.splice(Math.floor(c.random()*pool.length),1)[0],n=c.random()<.5?2:3;c.ailment(c.t,k,c.a,false,false,n);}}
