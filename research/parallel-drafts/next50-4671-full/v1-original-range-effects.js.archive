function listenerAfter4671(c){c.a.soulState.clawListenerResolving4671={round:c.round,move:c.m.id};try{for(const name of ['库拉塔克用招固定吸取','库拉塔克用招烧伤失败粉伤','库拉塔克用招弱化失败增伤']){if(!c.on(c.a,name))continue;const e=c.a.effects[name];if(!firstListener4671(c,e))continue;if(c.a.hp<=0)throw Error('Q-N50-4654-012：4671自身HP0的实际用招后载荷资格待确认');if(e.id4671===1927){const n=e.amount*(c.a.hp<c.a.stats.maxHp/e.denominator?2:1);healthRules.drainFixed(c,n,'库拉塔克已授用招固定吸取');}if(e.id4671===1255){if(!(statusRoll(c,e.chance)&&c.ailment(c.t,'烧伤',c.a,false,false,null,{probabilityPercent:e.chance})))c.hurt(c.t,c.t.stats.maxHp/e.denominator,'库拉塔克烧伤未触发','percent');}if(e.id4671===2161){let changed=false;for(let i=0;i<stats.length;i++)if(e.stages[i]){const before=c.actualStage(c.t,stats[i]);c.stage(c.t,e.stages[i],[stats[i]]);changed||=before!==c.actualStage(c.t,stats[i]);}if(!changed){if((c.a.counts.nextAttackBoost??0)>0)throw Error('Q-N50-4511-006：4671下次攻击增伤未消费重授待确认');c.a.counts.nextAttackBoost=e.count;c.a.soulState.nextAttackBoostFraction=e.fraction;}}}}finally{delete c.a.soulState.clawListenerResolving4671;}}
function listenerBefore4671(c){if(!c.on(c.a,'库拉塔克用招前降防速'))return;const e=c.a.effects['库拉塔克用招前降防速'];if(!firstListener4671(c,e))return;const before=[c.actualStage(c.t,'def'),c.actualStage(c.t,'spe')];c.stage(c.t,-e.def,['def']);c.stage(c.t,-e.spe,['spe']);if(before[0]===c.actualStage(c.t,'def')&&before[1]===c.actualStage(c.t,'spe'))c.hurt(c.t,c.t.stats.maxHp/e.denominator,'库拉塔克降防速未触发','percent');}
registry[1927]=Object.freeze({...registry[1927],listenerAfter4671});registry[1393]=Object.freeze({...registry[1393],listenerBefore4671});
