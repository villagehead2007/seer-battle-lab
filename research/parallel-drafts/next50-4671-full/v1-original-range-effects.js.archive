add4671(2023,'beforeDamage',(c,p)=>{const missing=f=>f.moves.reduce((n,k)=>n+Math.max(0,c.maxPP(k)-f.pp[k]),0);c.modifier*=1+Math.floor((missing(c.a)+missing(c.t))/p[0])*p[1]/100;});
add4671(2071,'afterHit',(c,p)=>{c.a.soulState.clawDeathHealCut4671={count:p[0],fraction:p[1]/100,move:c.m.id,hash:'23ca72e0'};});
add4671(1108,'beforeUse',(c,p)=>{c.hits=1+stats.filter(k=>c.a.stages[k]>0).length*p[0]+stats.filter(k=>c.actualStage(c.t,k)<0).length*p[1];});
add4671(1159,'afterHit',(c,p)=>{const before=Object.fromEntries(stats.map(k=>[k,c.actualStage(c.t,k)]));c.steal(c.a,c.t,'技能');if(stats.some(k=>before[k]>0&&c.actualStage(c.t,k)<before[k])){if((c.a.counts.immune??0)>0)throw Error('Q-N50-4511-006：4671吸强成功后免异重授待确认');c.a.counts.immune=p[0];c.a.soulState.clawImmune4671=p[0];}});
function grantListener4671(c,p,name,id,data){if(c.on(c.a,name))throw Error('Q-N50-4511-006：4671同名持续载荷重授待确认');c.timed(c.a,name,p[0],{...data,id4671:id,grantRound:c.round,grantMove:c.m.id,grantUse:c.effectUseCount()});}
function firstListener4671(c,e){const same=e.grantRound===c.round&&e.grantMove===c.m.id&&e.grantUse===c.effectUseCount();if(!same)return true;const q=c.a.soulState.qualifiedFirst4671?.[e.id4671];if(!['immediate','next-use'].includes(q))throw Error('Q-N50-4625-011：4671持续载荷首授当次是否触发待确认');return q==='immediate';}
