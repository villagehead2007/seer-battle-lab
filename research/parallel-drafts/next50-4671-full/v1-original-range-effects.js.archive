function exact4671(m,i,b,p){return !!m&&(m.wikiId??m.id)===b.moveId&&(m.hash===b.hash||m.revision==='seerapi:'+b.hash)&&i===b.index&&JSON.stringify(p)===JSON.stringify(b.args);}
function sourced4671(c,id){return bindings4671.some(b=>b.id===id&&exact4671(c.m,c.effectInstanceIndex,b,b.args));}
function add4671(id,phase,fn,hooks){const old=registry[id];add(id,phase,fn,[],undefined,undefined,hooks);const fresh=registry[id];registry[id]=Object.freeze({...old,...fresh,execute(c,p){if(sourced4671(c,id))return fresh.execute(c,p);if(old?.execute)return old.execute(c,p);throw Error('4671 exact source required '+id);},validate(p,m,i){if(bindings4671.some(b=>b.id===id&&exact4671(m,i,b,p)))return;if(bindings4671.some(b=>b.id===id&&b.moveId===(m?.wikiId??m?.id)))throw Error('4671 source mismatch '+id);return old?.validate?.(p,m,i);},hooks:Object.fromEntries([...new Set([...Object.keys(old?.hooks??{}),...Object.keys(fresh.hooks??{})])].map(k=>[k,(c,p)=>sourced4671(c,id)?fresh.hooks?.[k]?.(c,p):old?.hooks?.[k]?.(c,p)]))});}
add4671(914,'afterHit',(c,p)=>{if(c.t.ailments['烧伤']>=c.round)c.timed(c.t,'skillBlock',p[1],{});});
add4671(2189,'afterHit',(c,p)=>{const total=f=>f.moves.reduce((n,k)=>n+f.pp[k],0);if(total(c.a)>total(c.t)&&statusRoll(c,p[0]))c.ailment(c.t,'焚烬',c.a,false,false,null,{probabilityPercent:p[0]});});
add4671(2068,'afterHit',(c,p)=>{if(!(statusRoll(c,p[0])&&c.ailment(c.t,'烧伤',c.a,false,false,null,{probabilityPercent:p[0]})))c.timed(c.t,'回合结束后消回合',1,{});});
add4671(2117,'afterHit',c=>{if(!(c.t.ailments['烧伤']>=c.round))return;const n=c.a.soulState.qualifiedConversionDuration4671;if(!Number.isInteger(n)||n<1)throw Error('Q-N50-4618-001：4671烧伤转焚烬的新状态时长待确认');c.convertAilment(c.t,'烧伤','焚烬',n);});
