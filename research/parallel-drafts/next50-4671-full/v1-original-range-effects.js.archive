for(const id of [...new Set(bindings4671.map(b=>b.id))]){const old=registry[id];if(!old)throw Error('4671 reviewed effect lacks implementation '+id);registry[id]=Object.freeze({...old,validate(p,m,i){if(bindings4671.some(b=>b.id===id&&exact4671(m,i,b,p)))return;if(bindings4671.some(b=>b.id===id&&b.moveId===(m?.wikiId??m?.id)))throw Error('4671 source mismatch '+id);return old.validate?.(p,m,i);}});}
