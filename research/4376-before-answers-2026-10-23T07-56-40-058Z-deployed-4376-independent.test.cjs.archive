'use strict';const test=require('node:test'),assert=require('node:assert/strict'),H=require('./helpers/4376-battle.cjs'),{make,pick,turn,timer,key}=H;const events=(s,type='attack',side=1)=>(s.damageEvents??[]).filter(e=>e.targetSide===side&&e.type===type),sum=(s,type='attack',side=1)=>events(s,type,side).reduce((n,e)=>n+e.settledDamage,0);
test('4376全部22真实技能基础物特伤害PP与控制未用及逐实例生产编译',()=>{for(const m of H.source.moves){const s=make({moveId:m.id,index:null},{omit:true}),pp=s.fighters[0].pp[key(m.id)],o=turn(s);assert.equal(o.fighters[0].pp[key(m.id)],pp-1);assert.equal(o.fighters[1].hp<9000,m.kind!=='status');const q=make({moveId:m.id,index:null},{omit:true});q.fighters[0].ailments['疲惫']=2;assert.equal(turn(q).fighters[0].pp[key(m.id)],pp);H.independentOperations(m);}});
test('4376魂印免弱与不消耗PP但0PP不能用，外部清PP不被免消耗伪退款',()=>{const s=make({moveId:10001,index:null},{soul:1600});s.fighters[0].pp[key(10001)]=1;H.op(s,5,[0,100,-1]);const o=turn(s,10001,920042);assert.equal(o.fighters[0].pp[key(10001)],1);assert.equal(o.fighters[0].stages.atk,0);const q=make({moveId:10001,index:null},{soul:1600});q.fighters[0].pp[key(10001)]=0;assert.throws(()=>turn(q),/有 PP/);});
test('4376魂印所有攻击获本系1.5加成而未使用不产生回合真伤',()=>{const a=turn(make({moveId:10001,index:null},{soul:1600})),b=turn(make({moveId:10001,index:null}));assert.ok(Math.abs(sum(a)-sum(b)*1.5)<=2);assert.equal(sum(a,'true'),100);const q=make({moveId:10001,index:null},{soul:1600});q.fighters[0].ailments['疲惫']=2;assert.equal(sum(turn(q),'true'),0);});
test('4376非本系双方解释交集：双方都非本系免攻击不免固定，双方都本系不免；归属不一致明确拒绝',()=>{for(const type of ['火','普通']){const s=make({moveId:10001,index:null},{soul:1600});s.fighters[0].type='普通';s.fighters[1].type='普通';s.moveDefinitions[key(920040)].type=type;const o=turn(s,920031,920040);assert.equal(sum(o,'attack',0)>0,type==='普通');}const q=make({moveId:10001,index:null},{soul:1600});q.fighters[0].type='普通';q.fighters[1].type='火';q.moveDefinitions[key(920040)].type='火';assert.throws(()=>turn(q,920031,920040),/Q-N20-4376-001/);});
test('4376连续两次实际攻击睡眠，失败消回合吸300理论值，首次无链战斗末真伤100',()=>{for(const immune of [false,true]){let s=make({moveId:10001,index:null},{soul:1600,hp:1000});s=turn(s);if(immune)timer(s,1,'免异常');const before=s.fighters[1].hp;s=turn(s,920030);assert.equal(!!s.fighters[1].ailments['睡眠'],!immune);assert.equal(sum(s,'true'),100);if(immune){assert.equal(s.fighters[0].hp,1300);assert.equal(s.fighters[1].effects['免异常'],undefined);assert.ok(s.fighters[1].hp<before-300);}}});
test('4376连续属性下回合攻击固定百分比各减50先制1，不减真伤且持续只下一回合',()=>{let s=make({moveId:10001,index:null},{soul:1600});s.fighters[0].type=s.fighters[1].type='普通';s=turn(s,920031);s=turn(s,920032);assert.equal(s.fighters[0].soulState.holyWindReduceRound,3);H.op(s,683,[200,200]);const o=turn(s,920030,920042);assert.equal(sum(o,'fixed',0),100);const q=make({moveId:10001,index:null},{soul:1600});q.fighters[0].type=q.fighters[1].type='普通';q.fighters[0].soulState.holyWindReduceRound=1;H.op(q,683,[200,200]);assert.equal(sum(turn(q,920031,920042),'fixed',0),100);});
test('4376状态攻击交替仅无链战斗末100真伤，药剂不当作使用技能',()=>{let s=make({moveId:10001,index:null},{soul:1600});s=turn(s,920031);assert.equal(sum(s,'true'),100);s=turn(s,920030);assert.equal(sum(s,'true'),200);const q=make({moveId:10001,index:null},{soul:1600});assert.equal(sum(H.E.resolveTurn(q,['potion:hp',key(920041)]),'true'),0);});
test('4376 1810真实属性克制天敌才先制3，不以ID或种族值猜测',()=>{for(const type of ['火','普通']){const s=make(pick(1810)[0],{aStats:{spe:10},bStats:{spe:1000},targetHp:1});s.fighters[0].type='草';s.fighters[1].type=type;s.moveDefinitions[key(920040)].type='普通';const o=turn(s,s.auditMoveId,920040);assert.equal(o.fighters[0].hp===9000,type==='火');}});
test('4376 1811未击败不给免断，击败即时获得3回合protect，晚期击败有回合末通用结算',()=>{for(const hp of [9000,1]){const s=make(pick(1811)[0],{targetHp:hp}),o=turn(s);assert.equal(!!o.fighters[0].effects.protect,hp===1);if(hp===1)assert.equal(o.fighters[0].effects.protect.end,3);}const q=make(pick(1811)[0],{targetHp:1000});q.fighters[1].ailments['中毒']=3;q.fighters[1].hp=700;const o=turn(q);assert.equal(o.fighters[1].hp,0);assert.ok(o.fighters[0].effects.protect);});
test('4376 1053真实睡眠8：对手攻击后睡眠，免疫时己方回最大三分一且禁疗生效',()=>{for(const immune of [false,true]){const s=make(pick(1053)[0],{hp:1000});if(immune)timer(s,1,'免异常');const o=turn(s,s.auditMoveId,920040);assert.equal(!!o.fighters[1].ailments['睡眠'],!immune);assert.equal(o.fighters[0].hp>1000,immune);}});
test('4376 853当前面板HP速度基数忽略能力正负，20/25/30递增封顶',()=>{for(const grade of [-6,0,6]){let s=make(pick(853)[0]);s.fighters[0].stages.spe=grade;for(const p of [20,25,30,30]){const before=sum(s,'percent');s=turn(s);assert.equal(sum(s,'percent')-before,9500*p/100);if(s.fighters[1].hp<=0)break;}}});
test('4376全部4能力实例有真实概率成功失败与六级封顶',()=>{for(const e of pick(4)){let successes=0,failures=0;for(let seed=0;seed<20;seed++){const s=make(e,{seed}),o=turn(s),v=o.fighters[0].stages[H.keys[e.params[0]]];if(v===e.params[2])successes++;else{assert.equal(v,0);failures++;}}assert.ok(successes>0);if(e.params[1]<100)assert.ok(failures>0);const q=make(e);q.fighters[0].stages[H.keys[e.params[0]]]=6;assert.equal(turn(q).fighters[0].stages[H.keys[e.params[0]]],6);}});
test('4376 1454真实6到12段与20%逐段固定50、击败停止和PP一次',()=>{const e=pick(1454)[0],s=make(e),o=turn(s);assert.ok(events(o).length>=6&&events(o).length<=12);assert.ok(events(o,'fixed').every(x=>x.settledDamage===50));assert.equal(o.fighters[0].pp[key(e.moveId)],s.fighters[0].pp[key(e.moveId)]-1);assert.equal(events(turn(make(e,{targetHp:1}))).length,1);});
test('4376 736消强化成功禁属性2回合，保护和零强化不禁；1099成功给一次免异常且消费',()=>{for(const e of [pick(736)[0],pick(1099)[0]]){for(const boost of [0,2]){const s=make(e);s.fighters[1].stages.atk=boost;const o=turn(s);assert.equal(o.fighters[1].stages.atk,0);if(e.id===736)assert.equal(!!o.fighters[1].effects.statusBlock,boost>0);else{H.op(o,22,[100,2]);const x=turn(o,920031,920042);assert.equal(!!x.fighters[0].ailments['疲惫'],boost===0);}}}});
test('4376 47免弱3、191反弹4、58及681暴击命中2、843及481下一回合先制',()=>{for(const [id,field]of [[47,'免弱'],[191,'reflect'],[58,'必定暴击'],[681,'攻击必中'],[843,'id984'],[481,'攻击先制']]){const s=make(pick(id)[0],{hit:false}),o=turn(s);assert.ok(o.fighters[0].effects[field],id+' '+JSON.stringify(o.fighters[0].effects));}});
test('4376 52先手真实整体封锁对手技能，980先手属性无效，919后手次回合属性无效',()=>{const e=pick(52)[0],o=turn(make(e),e.moveId,920040);assert.equal(sum(o,'attack',0),0);const z=make(pick(980)[0]);H.op(z,4,[0,100,1]);const za=turn(z,z.auditMoveId,920042);assert.equal(za.fighters[1].stages.atk,0);assert.equal(za.fighters[1].pp[key(920042)],98);const s=make(pick(919)[0],{aStats:{spe:1},bStats:{spe:1000}}),x=turn(s);assert.equal(x.fighters[1].effects.statusBlock.start,2);});
test('4376 598概率恢复PP成功失败和上限，656无放回2槽归0遵守PP保护',()=>{let yes=0,no=0;for(let seed=0;seed<20;seed++){const s=make(pick(598)[0],{seed});s.fighters[0].pp[key(920031)]=1;const o=turn(s);if(o.fighters[0].pp[key(920031)]===2)yes++;else no++;}assert.ok(yes&&no);for(const protect of [false,true]){let seen=false;for(let seed=0;seed<20;seed++){const s=make(pick(656)[0],{seed});if(protect)timer(s,1,'PP保护');const o=turn(s),zeros=Object.values(o.fighters[1].pp).filter(n=>n===0).length;assert.ok(protect?zeros===0:[0,2].includes(zeros));seen ||= zeros===2;}if(!protect)assert.ok(seen);}});
test('4376 468开局弱化时威力翻倍并解除，锁定弱化不可解除不能伪造等级清空',()=>{for(const neg of [false,true]){const s=make(pick(468)[0]);if(neg)s.fighters[0].stages.def=-1;const o=turn(s);assert.equal(o.fighters[0].stages.def,0);if(neg){const q=make(pick(468)[0],{omit:true});q.moveDefinitions[key(q.auditMoveId)].power*=2;assert.equal(sum(o),sum(turn(q)));}}});
test('4376 597和971每用招实际吸取，低于半血翻倍、等于半血不翻、满血仍伤害',()=>{for(const id of [597,971])for(const hp of [9000,4500,4000]){const s=make(pick(id)[0],{hp}),o=turn(s);assert.equal(sum(o,'percent'),id===971&&hp<4500?6000:3000);assert.equal(o.fighters[0].hp,Math.min(9000,hp+sum(o,'percent')));}});
test('4376 1001敌异常强化翻倍，962自身无强化翻倍，已强化不翻倍，禁强化不生效',()=>{for(const id of [1001,962])for(const active of [false,true]){const s=make(pick(id)[0]);if(active){if(id===1001)s.fighters[1].ailments['中毒']=3;else s.fighters[0].stages.atk=1;}const o=turn(s);assert.equal(o.fighters[0].stages.def,id===1001?(active?2:1):(active?1:2));}});
test('4376 1774对方选择攻击才额外先制1、769无异常双倍攻伤、有异常不翻倍',()=>{const s=make(pick(769)[0]),q=make(pick(769)[0]);q.fighters[1].ailments['中毒']=3;assert.ok(Math.abs(sum(turn(s))-sum(turn(q))*2)<=3);for(const attack of [false,true]){const s=make(pick(1774)[0],{aStats:{spe:1},bStats:{spe:1000},targetHp:1}),o=turn(s,s.auditMoveId,attack?920040:920041);if(attack)assert.equal(o.fighters[0].hp,9000);}});
test('4376 861持续扣属性使用者全PP2遵守PP保护且不影响攻击，1167解除弱化才满回复',()=>{for(const protect of [false,true]){let s=turn(make(pick(861)[0]));if(protect)timer(s,1,'PP保护');const before=s.fighters[1].pp[key(920040)];s=turn(s,920031,920041);assert.equal(s.fighters[1].pp[key(920040)],before-(protect?0:2));}for(const neg of [false,true]){const s=make(pick(1167)[0],{hp:1000});if(neg)s.fighters[0].stages.def=-1;assert.equal(turn(s).fighters[0].hp,neg?9000:1000);}});
test('4376 854下一次威力严格大于120才整体无效与消费，1672非满血吸200理论值',()=>{let s=turn(make(pick(854)[0]));s.moveDefinitions[key(920040)].power=120;const a=turn(s,920031,920040);assert.ok(sum(a,'attack',0)>0);s.moveDefinitions[key(920040)].power=121;assert.equal(sum(turn(s,920031,920040),'attack',0),0);for(const hp of [9000,1000]){const o=turn(make(pick(1672)[0],{hp}));assert.equal(sum(o,'fixed'),hp===9000?0:200);assert.equal(o.fighters[0].hp,hp===9000?9000:1200);}});
test('4376 699无视真实攻击免疫但不免固定免疫，942清回合成功才吸取，478属性无效2回合',()=>{const s=make(pick(699)[0]);timer(s,1,'攻击伤害免疫');assert.ok(sum(turn(s))>0);for(const effect of [false,true]){const q=make(pick(942)[0],{hp:1000});if(effect)timer(q,1,'免异常');assert.equal(sum(turn(q),'percent'),effect?3000:0);}assert.ok(turn(make(pick(478)[0])).fighters[1].effects.statusBlock);});
test('4376 1040普通未击败睡眠、免疫则自身全属性1，已击败不触发；晚期击败时序关联待确认',()=>{for(const immune of [false,true]){const s=make(pick(1040)[0]);if(immune)timer(s,1,'免异常');const o=turn(s);assert.equal(!!o.fighters[1].ailments['睡眠'],!immune);assert.equal(o.fighters[0].stages.atk,immune?1:0);}const o=turn(make(pick(1040)[0],{targetHp:1}));assert.equal(o.fighters[0].stages.atk,0);});
test('4376 853临时面板速度0与2500真实生效但能力等级正负不参与基数，保护不影响自身面板计量',()=>{for(const speed of [0,2500])for(const grade of [-6,0,6]){const s=make(pick(853)[0]);s.fighters[0].stages.spe=grade;timer(s,0,'面板数值设定',{values:{spe:speed}},1,2);const o=turn(s);assert.equal(sum(o,'percent'),(9000+speed)*.2);assert.equal(H.E.panelStat(o.fighters[0],'spe'),speed);}});
