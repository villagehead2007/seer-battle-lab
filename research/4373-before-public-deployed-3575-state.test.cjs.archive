'use strict';
const sourceStab=require('./helpers/source-stab.cjs');
const {test}=require('node:test');
const assert=require('node:assert/strict');
const H=require('./helpers/3575-battle.cjs');
const {source,keys,key,IDLE,WAIT,HIT,FEAR,make,turn,wait,timer,allStages,pick,seedCase}=H;

test('3575 魂印875固伤和百分比伤害不得当作攻击伤害转化或反击',()=>{
  for(const seed of [8067,6936]){
    const e={moveId:10234,index:null};
    const fixed=make(e,{soul:true,hp:5000,seed,opponentEffect:pick(1004)[0]});
    timer(fixed,1,'攻击必中');
    const a=turn(fixed,IDLE,900023);assert.equal(a.fighters[0].hp,4700);assert.equal(a.fighters[1].hp,9000);assert.equal(a.fighters[0].soulState.endDragonAttackTaken,0);
    const percent=make(e,{soul:true,hp:5000,targetHp:1000,seed,opponentEffect:pick(1005)[0]});
    const b=turn(percent,IDLE,900023);assert.equal(b.fighters[0].hp,500);assert.equal(b.fighters[1].hp,5500);assert.equal(b.fighters[0].soulState.endDragonAttackTaken,0);
  }
});

test('3575 概率20、40、70、80与魂印40在固定随机阈值两侧改变实际状态',()=>{
  // These seeds straddle each probability within 0.001. They use the real RNG;
  // the second draw follows the attack's damage roll, the soul uses the first draw.
  const checks=[
    [pick(4).find(e=>e.params[1]===20),9280,3406,'acc',false],
    [pick(15)[0],4201,2038,'害怕',false],
    [pick(1003).find(e=>e.params[0]===80),787,6928,'害怕',false],
    [pick(968)[0],236,188,'诅咒',true],
    [pick(968)[0],787,6928,'诅咒',false]
  ];
  for(const [e,low,high,state,slow] of checks)for(const [seed,success] of [[low,true],[high,false]]){
    const s=make(e,{seed});if(slow)timer(s,1,'id984',{amount:2});const o=turn(s);
    if(state==='acc')assert.equal(o.fighters[0].stages.acc,success?1:0,e.key);
    else assert.equal(!!o.fighters[1].ailments[state],success,e.key);
    if(e.id===1003)assert.equal(o.fighters[1].stages.atk,success?0:-1);
  }
  for(const [seed,success] of [[8067,true],[6936,false]]){
    const s=make({moveId:10234,index:null},{seed,soul:true,hp:5000}),o=turn(s,IDLE,HIT),damage=o.fighters[1].lastAttackDamage;
    assert.equal(o.fighters[0].hp,success?5000:5000-damage);assert.equal(o.fighters[1].hp,success?9000:9000-damage);
  }
});
test('3575 基础攻击暴击率六点二五阈值两侧具有真实双倍伤害',()=>{
  for(const m of source.moves.filter(m=>m.kind!=='status'))for(const [seed,crit] of [[5832,true],[8788,false]]){
    const e={moveId:m.id,index:null},s=make(e,{omit:true,seed,criticals:true});
    const c=make(e,{omit:true,seed:(seed+0x6D2B79F5)>>>0});if(crit)timer(c,0,'必定暴击');
    const o=turn(s),expected=turn(c);assert.equal(o.fighters[1].hp,expected.fighters[1].hp,String(m.id));assert.equal(o.fighters[0].lastAttackDamage,expected.fighters[0].lastAttackDamage);
  }
});
test('3575 混合642只验证当前在场者50概率反击150、状态招与三回合到期',()=>{
  const e=pick(642)[0];for(const [seed,damage] of [[114,150],[7846,0]]){const o=turn(make(e,{seed}),e.moveId,HIT);assert.equal(o.fighters[1].hp,9000-damage);assert.equal(o.fighters[0].hp,9000-o.fighters[1].lastAttackDamage);}
  assert.equal(turn(make(e)).fighters[1].hp,9000);
  let s=turn(make(e));s=wait(s);s=wait(s);s.rng=114;assert.equal(turn(s,IDLE,HIT).fighters[1].hp,9000);
  const miss=make(e);timer(miss,1,'攻击必失');assert.equal(turn(miss,e.moveId,FEAR).fighters[1].hp,9000);
});

test('3575 触发918实际299才登记下次双倍、300与301不触发且属性不消耗',()=>{
  const e=pick(918)[0];for(const damage of [299,300,301]){
    const s=make(e,{aStats:{atk:2000}});timer(s,1,'伤害上限',{amount:damage},1);const o=turn(s);
    assert.equal(o.fighters[0].lastAttackDamage,damage);assert.equal(o.fighters[0].counts.nextAttackBoost??0,damage<300?1:0);
    const w=wait(o);assert.equal(w.fighters[0].counts.nextAttackBoost??0,damage<300?1:0);
    const control=structuredClone(w);control.fighters[0].counts.nextAttackBoost=0;const x=turn(w,10234),y=turn(control,10234);
    if(damage<300)assert.ok(x.fighters[0].lastAttackDamage>=2*y.fighters[0].lastAttackDamage&&x.fighters[0].lastAttackDamage<=2*y.fighters[0].lastAttackDamage+1);else assert.equal(x.fighters[0].lastAttackDamage,y.fighters[0].lastAttackDamage);
    assert.equal(x.fighters[0].counts.nextAttackBoost??0,0);
  }
});
test('3575 龙鳞2462消耗零至四层顺序补齐且下一次真实攻击穿透减伤',()=>{
  const e=pick(2462)[0];for(const n of [0,1,2,3,4]){
    const s=make(e);s.fighters[0].soulState.dragonEaterStacks=n;let o=turn(s);assert.equal(o.fighters[0].soulState.dragonEaterStacks,0);
    assert.deepEqual(['blue','gold','black'].map(k=>!!o.fighters[0].soulState.dragonScales[k]),[n>=1,n>=2,n>=3]);
    o=wait(o);timer(o,1,'全伤害减半');const c=structuredClone(o);delete c.fighters[0].counts.nextDamageReductionIgnore;
    const x=turn(o,10234),y=turn(c,10234),ratio=1+Math.min(n,3)*.25,d=y.fighters[0].lastAttackDamage;
    assert.ok(Math.abs(x.fighters[0].lastAttackDamage-d*ratio)<2);assert.equal(o.fighters[1].hp-x.fighters[1].hp,x.fighters[0].lastAttackDamage);assert.equal(x.fighters[0].counts.nextDamageReductionIgnore,undefined);
    const next=structuredClone(x);delete next.fighters[0].soulState.currentDamageReductionIgnore;assert.equal(turn(x,10234).fighters[1].hp,turn(next,10234).fighters[1].hp);
  }
  const s=make(e);s.fighters[0].soulState.dragonScales={blue:true,gold:false,black:false};s.fighters[0].soulState.dragonEaterStacks=1;const o=turn(s);assert.deepEqual(o.fighters[0].soulState.dragonScales,{blue:true,gold:true,black:false});
});
test('3575 属性849后续随机三项转移、六级界限、免弱禁强和第三回合到期',()=>{
  const e=pick(849)[0];let s=turn(make(e));const initial=s.fighters.map(f=>({...f.stages}));
  assert.equal(Object.values(initial[0]).reduce((a,b)=>a+b,0),3);assert.equal(Object.values(initial[1]).reduce((a,b)=>a+b,0),-3);
  s=wait(s);assert.equal(keys.filter(k=>s.fighters[0].stages[k]-initial[0][k]===1).length,3);assert.equal(keys.filter(k=>s.fighters[1].stages[k]-initial[1][k]===-1).length,3);
  assert.equal(Object.values(s.fighters[0].stages).reduce((a,b)=>a+b,0),6);assert.equal(Object.values(s.fighters[1].stages).reduce((a,b)=>a+b,0),-6);
  for(const k of keys)assert.equal(s.fighters[0].stages[k]+s.fighters[1].stages[k],0);
  s=wait(s);const before=structuredClone(s.fighters.map(f=>f.stages));s=wait(s);assert.deepEqual(s.fighters.map(f=>f.stages),before);
  const cap=turn(make(e));allStages(cap,0,6);allStages(cap,1,-6);const c=wait(cap);assert.deepEqual(Object.values(c.fighters[0].stages),[6,6,6,6,6,6]);assert.deepEqual(Object.values(c.fighters[1].stages),[-6,-6,-6,-6,-6,-6]);
  const blocked=make(e);timer(blocked,0,'禁强化');timer(blocked,1,'免弱');const b=wait(turn(blocked));assert.deepEqual(Object.values(b.fighters[0].stages),[0,0,0,0,0,0]);assert.deepEqual(Object.values(b.fighters[1].stages),[0,0,0,0,0,0]);
});
test('3575 属性849施放当回合使用技能也应在伤害前吸取三项',()=>{
  const e=pick(849)[0],o=turn(make(e));assert.equal(Object.values(o.fighters[0].stages).filter(n=>n===1).length,3,'原文3回合内每回合使用技能，包含施放当回合');
  assert.equal(Object.values(o.fighters[1].stages).filter(n=>n===-1).length,3);
});
test('3575 回合927实际低体回复与等量粉伤、半血等值、满血和到期',()=>{
  const e=pick(927)[0];for(const [hp,damage,healed] of [[4499,4500,4500],[4500,0,4500],[8000,0,1000],[9000,0,0]]){const o=turn(make(e,{hp}));assert.equal(o.fighters[0].hp,hp+healed);assert.equal(o.fighters[1].hp,9000-damage);}
  let s=turn(make(e,{hp:4500}));for(let r=2;r<=3;r++){s.fighters[0].hp=4500;s=wait(s);assert.equal(s.fighters[0].hp,9000);}s.fighters[0].hp=4500;s=wait(s);assert.equal(s.fighters[0].hp,4500);
});
test('3575 回合927禁疗未恢复体力时不得造成虚构等量回复伤害',()=>{
  const e=pick(927)[0],s=make(e,{hp:1000});timer(s,0,'技能禁疗');const o=turn(s);assert.equal(o.fighters[0].hp,1000);assert.equal(o.fighters[1].hp,9000,'等量应来自实际恢复体力0');
});
test('3575 回合60五回合每回合附加120包括属性回合、到期和免伤',()=>{
  const e=pick(60)[0];let s=turn(make(e));const hp=[s.fighters[1].hp];
  for(let r=2;r<=6;r++){s=wait(s);hp.push(s.fighters[1].hp);}
  const imm=make(e);timer(imm,1,'当回合免伤');assert.equal(turn(imm).fighters[1].hp,9000);
  assert.deepEqual(hp,[8880,8760,8640,8520,8400,8400],'五回合内每回合附加120，第六回合到期');
});
test('3575 回合702下两回合真实暴击应回满体力',()=>{
  const e=pick(702)[0],hp=[];for(const delay of [0,1]){
    let s=turn(make(e,{hp:1000}));if(delay)s=wait(s);timer(s,0,'必定暴击',{},s.round);const o=turn(s,10234);
    assert.ok(o.fighters[0].lastAttackDamage>0);hp.push(o.fighters[0].hp);
  }
  assert.deepEqual(hp,[9000,9000],'原文下2回合暴击回血，而非只检查属性招施放时');
});
test('3575 回合702非暴击不回血、过期暴击不回血及禁疗',()=>{
  const e=pick(702)[0],s=turn(make(e,{hp:1000}));assert.equal(turn(s,10234).fighters[0].hp,1000);
  let expired=wait(wait(s));timer(expired,0,'必定暴击');assert.equal(turn(expired,10234).fighters[0].hp,1000);
  const blocked=structuredClone(s);timer(blocked,0,'必定暴击');timer(blocked,0,'技能禁疗');assert.equal(turn(blocked,10234).fighters[0].hp,1000);
});
test('3575 触发1006伤害301后下一回合必须免疫真实恐惧',()=>{
  const e=pick(1006)[0],s=make(e,{aStats:{atk:2000}});timer(s,1,'伤害上限',{amount:301},1);let o=turn(s);assert.equal(o.fighters[0].lastAttackDamage,301);
  o.rng=1;const x=turn(o,IDLE,FEAR);assert.deepEqual(x.fighters[0].ailments,{},'下1回合免疫不能在触发当回合就到期');
  assert.equal(x.fighters[0].stages.atk,-1,'恐惧被免疫后1003进入失败弱化分支');
});
test('3575 触发1006伤害300不触发、下一回合结束后免疫失效',()=>{
  const e=pick(1006)[0];for(const damage of [299,300,301]){
    const s=make(e,{aStats:{atk:2000}});timer(s,1,'伤害上限',{amount:damage},1);let o=turn(s);assert.equal(o.fighters[0].lastAttackDamage,damage);
    if(damage===301)o=wait(o);o.rng=1;const x=turn(o,IDLE,FEAR);assert.ok(x.fighters[0].ailments['害怕']>=x.round,'非触发/到期后恐惧应可施加');
  }
});
test('3575 触发731暴击后其他攻击必暴、非暴击不触发',()=>{
  const e=pick(731)[0],s=make(e);timer(s,0,'必定暴击',{},1);const o=turn(s);const c=structuredClone(o);c.fighters[0].counts.nextCrit=0;
  const x=turn(o,10234),y=turn(c,10234);assert.ok(x.fighters[0].lastAttackDamage>=2*y.fighters[0].lastAttackDamage);assert.equal(x.fighters[0].counts.nextCrit,0);
  assert.equal(turn(make(e)).fighters[0].counts.nextCrit??0,0);
});
test('3575 触发731不得强化同技能且只在下一回合有效',()=>{
  const e=pick(731)[0],s=make(e);timer(s,0,'必定暴击',{},1);const o=turn(s),c=structuredClone(o);c.fighters[0].counts.nextCrit=0;
  assert.equal(turn(o).fighters[0].lastAttackDamage,turn(c).fighters[0].lastAttackDamage,'其他攻击技能应排除同技能');
});
test('3575 触发731下一回合未使用攻击则必暴到期不能跨回合保存',()=>{
  const e=pick(731)[0],s=make(e);timer(s,0,'必定暴击',{},1);const o=wait(turn(s)),c=structuredClone(o);c.fighters[0].counts.nextCrit=0;
  assert.equal(turn(o,10234).fighters[0].lastAttackDamage,turn(c,10234).fighters[0].lastAttackDamage,'下1回合结束后不再必暴');
});
test('3575 魂印875真实高体增伤与优先、相等低体不触发且只提升攻击先制',()=>{
  const e={moveId:10234,index:null};for(const [hp,targetHp,high] of [[9000,8000,true],[8000,8000,false],[7000,8000,false]]){
    const s=make(e,{soul:true,hp,targetHp,aStats:{spe:1},bStats:{spe:999}}),c=make(e,{hp,targetHp,seed:0x6D2B79F5,aStats:{spe:1},bStats:{spe:999}});
    const x=turn(s),y=turn(c),d=y.fighters[0].lastAttackDamage;assert.equal(x.turns[0].first,high?0:1);if(high)assert.ok(x.fighters[0].lastAttackDamage>=Math.floor(d*1.5)&&x.fighters[0].lastAttackDamage<=Math.floor(d*1.5)+1);else assert.equal(x.fighters[0].lastAttackDamage,d);
    assert.equal(targetHp-x.fighters[1].hp,x.fighters[0].lastAttackDamage);
  }
  const s=make(e,{soul:true,hp:9000,targetHp:8000,aStats:{spe:1},bStats:{spe:999}});assert.equal(turn(s,IDLE).turns[0].first,1);
});
test('3575 魂印875真实受击转化与未触发等量反击、零伤害与致死转化',()=>{
  const e={moveId:10234,index:null};let convert=0,reflect=0;
  for(let seed=0;seed<64;seed++){
    const s=make(e,{soul:true,hp:5000,seed}),o=turn(s,IDLE,HIT),d=o.fighters[1].lastAttackDamage;assert.ok(d>0);
    if(o.fighters[0].soulState.endDragonConvert){convert++;assert.equal(o.fighters[0].hp,5000);assert.equal(o.fighters[1].hp,9000);}
    else{reflect++;assert.equal(o.fighters[0].hp,5000-d);assert.equal(o.fighters[1].hp,9000-d);}
    const imm=make(e,{soul:true,hp:5000,seed});timer(imm,0,'当回合免伤');const x=turn(imm,IDLE,HIT);assert.equal(x.fighters[0].hp,5000);assert.equal(x.fighters[1].hp,9000);
    if(o.fighters[0].soulState.endDragonConvert){const z=turn(make(e,{soul:true,hp:1,seed}),IDLE,HIT);assert.equal(z.fighters[0].hp,Math.min(z.fighters[0].stats.maxHp,z.damageEvents.find(d=>d.type==='attack'&&d.targetSide===0).settledDamage));assert.ok(z.fighters[0].hp>1);assert.equal(z.finished,false);}
  }
  assert.ok(convert>0&&reflect>0);
});
test('3575 邪龙1329观察三回合受攻击获得两层、属性不获层与到期',()=>{
  const e=pick(1329)[0];let s=turn(make(e),e.moveId,HIT);assert.equal(s.fighters[0].soulState.dragonEaterStacks,2);s=turn(s,IDLE,HIT);assert.equal(s.fighters[0].soulState.dragonEaterStacks,4);s=turn(s,IDLE,HIT);assert.equal(s.fighters[0].soulState.dragonEaterStacks,6);s=turn(s,IDLE,HIT);assert.equal(s.fighters[0].soulState.dragonEaterStacks,6);
  assert.equal(turn(make(e)).fighters[0].soulState.dragonEaterStacks??0,0);
});
test('3575 邪龙1329对手使用攻击即使失误也应获得两层',()=>{
  const e=pick(1329)[0],s=make(e);timer(s,1,'攻击必失');const o=turn(s,e.moveId,FEAR);assert.deepEqual(o.fighters[0].ailments,{});assert.equal(o.fighters[0].soulState.dragonEaterStacks,2,'原文使用攻击技能，不限命中');
});
test('3575 邪龙1330两实例与1331击败条件真实获得层数且封招不获得',()=>{
  for(const e of pick(1330)){
    const s=make(e,{hp:1000});s.fighters[0].soulState.dragonEaterStacks=3;const o=turn(s);assert.equal(o.fighters[0].soulState.dragonEaterStacks,4,'原有3道，本次攻击消费1道，再获得2道');
    const drained=9000-o.fighters[1].hp-o.fighters[0].lastAttackDamage;assert.ok(drained>=150&&drained<=300);assert.equal(o.fighters[0].hp,1000+drained);
    const b=make(e);timer(b,0,'skillBlock');assert.equal(turn(b).fighters[0].soulState.dragonEaterStacks??0,0);
  }
  const e=pick(1331)[0];const no=turn(make(e));assert.equal(no.fighters[0].soulState.dragonEaterStacks??0,0);
  const s=make(e,{targetHp:1});s.fighters[0].soulState.dragonEaterStacks=3;const o=turn(s);assert.equal(o.fighters[1].hp,0);assert.equal(o.winner,0);assert.equal(o.fighters[0].soulState.dragonEaterStacks,4,'攻击消费1道，击败再获得2道');
  const blocked=make(e,{targetHp:1});timer(blocked,0,'skillBlock');const b=turn(blocked);assert.equal(b.fighters[1].hp,1);assert.equal(b.fighters[0].soulState.dragonEaterStacks??0,0);
});
test('3575 邪龙1330与1329附着攻击应实际吸取150至300体力',()=>{
  const actual=[],expected=[];
  for(const e of [...pick(1330),...pick(1329)]){
    const start=make(e,{hp:1000,soul:true}),s=turn(start,e.moveId,e.id===1329?HIT:WAIT),hp=s.fighters[0].hp,enemy=s.fighters[1].hp;
    assert.equal(s.fighters[0].soulState.dragonEaterStacks,2,e.key);const o=turn(s,10234),drain=enemy-o.fighters[1].hp-o.fighters[0].lastAttackDamage;
    assert.equal(o.fighters[0].hp,hp+drain);actual.push({key:e.key,hasSourceDrain:drain>=150&&drain<=600});expected.push({key:e.key,hasSourceDrain:true});
  }
  // A one-layer boundary fixture tests the literal 150–300 interval without
  // guessing whether two acquired layers are consumed together or sequentially.
  const one=make({moveId:10234,index:null},{soul:true,hp:1000});one.fighters[0].soulState.dragonEaterStacks=1;
  const used=turn(one),drained=9000-used.fighters[1].hp-used.fighters[0].lastAttackDamage;
  assert.equal(used.fighters[0].hp,1000+drained);
  actual.push({key:'3575:soul:875:one-layer-boundary',hasSourceDrain:drained>=150&&drained<=300});expected.push({key:'3575:soul:875:one-layer-boundary',hasSourceDrain:true});
  assert.deepEqual(actual,expected,'两道附着至少应有一次150–300的实际吸取；没有假定两道同时消费');
});
test('3575 邪龙1330与1329附着攻击应获得先制1而属性招不获得',()=>{
  const actual=[],expected=[];
  for(const e of [...pick(1330),...pick(1329)]){
    const s=turn(make(e,{soul:true,hp:1000,aStats:{spe:1},bStats:{spe:999}}),e.moveId,e.id===1329?HIT:WAIT);
    assert.equal(turn(s,IDLE).turns.at(-1).first,1);actual.push({key:e.key,first:turn(s,10234).turns.at(-1).first});expected.push({key:e.key,first:0});
  }
  assert.deepEqual(actual,expected,'邪龙之噬的攻击先制+1必须改变实际行动顺序');
});

test('3575 基础30招原始威力分类实测伤害、必暴倍数、必中与必失交互',()=>{
  for(const m of source.moves){
    const e={moveId:m.id,index:null},s=make(e,{omit:true}),o=turn(s);
    // Fixed seed 0's first damage roll is 89%; these stat overrides deliberately have no stage or gear modifiers.
    const base=Math.floor(Math.floor(42*m.power*180/300)/50)+2;
    const affinity=H.E.typeEffectiveness(m.type,s.fighters[1].type,s.typeChart),stab=sourceStab(m.type,s.fighters[0].type,s.typeChart);
    const expected=m.kind==='status'||m.power===0?0:Math.floor(base*affinity*stab*.89);
    assert.equal(9000-o.fighters[1].hp,expected,String(m.id));
    if(m.kind!=='status'){
      const crit=make(e,{omit:true});timer(crit,0,'必定暴击');assert.equal(9000-turn(crit).fighters[1].hp,m.power===0?0:Math.floor(base*affinity*stab*2*.89),String(m.id));
      const forced=make(e,{omit:true,hit:false});timer(forced,0,'攻击必失');const out=turn(forced);assert.equal(out.fighters[0].pp[key(m.id)],m.pp-1);
      assert.equal(out.fighters[1].hp,m.alwaysHit?9000-expected:9000,String(m.id));
      if(m.power>0){const wrongStat=make(e,{omit:true,aStats:m.kind==='physical'?{spa:900}:{atk:900}});assert.equal(turn(wrongStat).fighters[0].lastAttackDamage,expected,String(m.id));}
    }
  }
});

test('3575 回合77三次用招回复200、到期、未行动与禁疗',()=>{
