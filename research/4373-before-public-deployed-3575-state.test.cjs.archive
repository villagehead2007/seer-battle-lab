test('3575 回合54实际攻击减半持续三回合、到期及封招',()=>{
  const e=pick(54)[0];let s=make(e);for(let r=1;r<=4;r++){
    const c=structuredClone(s);delete c.fighters[1].effects['伤害输出降低'];
    const a=turn(s,r===1?e.moveId:IDLE,HIT),b=turn(c,IDLE,HIT);
    const x=a.fighters[1].lastAttackDamage,y=b.fighters[1].lastAttackDamage;
    // The initial zero-power special still rolls damage; align comparison RNG with an omitted instance.
    const control=r===1?turn(make(e,{omit:true}),e.moveId,HIT):b;
    const d=control.fighters[1].lastAttackDamage;
    if(r<=3)assert.ok(x===Math.floor(d/2)||x===Math.ceil(d/2));else assert.equal(x,y);
    assert.equal(s.fighters[0].hp-a.fighters[0].hp,x);s=a;
  }
  const blocked=make(e);timer(blocked,0,'skillBlock');assert.equal(turn(blocked).fighters[1].effects['伤害输出降低'],undefined);
});
