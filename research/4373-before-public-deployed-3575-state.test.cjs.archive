    s=turn(s,IDLE,HIT);assert.equal(s.fighters[0].hp,hp);assert.equal(s.fighters[1].lastAttackDamage,0);assert.equal(s.fighters[1].pp[key(HIT)],98);
    s=turn(s,IDLE,FEAR);assert.deepEqual(s.fighters[0].ailments,{});assert.equal(s.fighters[0].stages.atk,0);
    s=turn(s,IDLE,HIT);assert.ok(s.fighters[0].hp<hp);
    let no=turn(make(e),e.moveId,HIT);const h=no.fighters[0].hp;no=turn(no,IDLE,HIT);assert.ok(no.fighters[0].hp<h);
    let expired=turn(make(e),e.moveId,HIT);expired=turn(expired,IDLE,HIT);expired=turn(expired,IDLE,HIT);expired=wait(expired);const before=expired.fighters[0].hp;expired=turn(expired,IDLE,HIT);assert.ok(expired.fighters[0].hp<before);
  }
});
