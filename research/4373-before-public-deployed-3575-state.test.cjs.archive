});
test('3575 先制619与843逐实例只作用下两回合且包含属性招',()=>{
  for(const id of [619,843])for(const e of pick(id)){
    let s=turn(make(e,{aStats:{spe:1},bStats:{spe:999}}));
    assert.equal(s.turns[0].first,source.moves.find(m=>m.id===e.moveId).priority>0?0:1);
    s=wait(s);assert.equal(s.turns[1].first,0);assert.equal(s.fighters[0].pp[key(IDLE)],98);
    s=turn(s,10234);assert.equal(s.turns[2].first,0);assert.ok(s.fighters[0].lastAttackDamage>0);
    s=wait(s);assert.equal(s.turns[3].first,1);
    const blocked=make(e,{aStats:{spe:1},bStats:{spe:999}});timer(blocked,0,'skillBlock',{},1);const no=wait(turn(blocked));assert.equal(no.turns[1].first,1);
    let stronger=turn(make(e,{aStats:{spe:1},bStats:{spe:999}}));timer(stronger,1,'priority');const x=wait(stronger);assert.equal(x.turns[1].first,1,'对手更高/相同先制时仍遵守先制与速度');
  }
});
test('3575 回合58逐实例下两回合实际双倍暴击、到期与封招',()=>{
  for(const e of pick(58)){
    let s=turn(make(e));for(let r=2;r<=4;r++){
      const c=structuredClone(s);delete c.fighters[0].effects['必定暴击'];const a=turn(s,10234),b=turn(c,10234);
      const x=a.fighters[0].lastAttackDamage,y=b.fighters[0].lastAttackDamage;
      if(r<=3)assert.ok(x>=2*y&&x<=2*y+1);else assert.equal(x,y);assert.equal(s.fighters[1].hp-a.fighters[1].hp,x);s=a;
    }
    const b=make(e);timer(b,0,'skillBlock',{},1);const no=turn(b);assert.equal(no.fighters[0].effects['必定暴击'],undefined);
  }
});
