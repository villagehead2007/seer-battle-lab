  assert.equal(turn(make(e)).fighters[0].counts.immune??0,0);const b=make(e);timer(b,1,'免弱');timer(b,1,'protect');const y=turn(b);assert.equal(y.fighters[0].counts.immune??0,0);assert.ok(y.fighters[1].effects['免弱']);
});
