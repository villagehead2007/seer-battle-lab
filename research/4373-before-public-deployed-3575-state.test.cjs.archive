test('3575 伤害1063仅来源指定王战联增伤50、非匹配与免伤',()=>{
  const e=pick(1063)[0],plain=turn(make(e)),d=plain.fighters[0].lastAttackDamage;
  for(const name of ['王·雷伊','王·盖亚','王·卡修斯','王·布莱克','王·缪斯']){const s=make(e);s.fighters[1].name=name;const o=turn(s);assert.ok(o.fighters[0].lastAttackDamage>=Math.floor(d*1.5)&&o.fighters[0].lastAttackDamage<=Math.floor(d*1.5)+1);assert.equal(9000-o.fighters[1].hp,o.fighters[0].lastAttackDamage);}
  for(const name of ['雷伊','王·雷伊额外','终末之灭·天邪龙王']){const s=make(e);s.fighters[1].name=name;assert.equal(turn(s).fighters[0].lastAttackDamage,d);}
  const imm=make(e);imm.fighters[1].name='王·雷伊';timer(imm,1,'当回合免伤');assert.equal(turn(imm).fighters[1].hp,9000);
});

test('3575 异常15真实恐惧阻止行动、概率失败、免疫及到期',()=>{
  const e=pick(15)[0];let success=false,failure=false;
  for(let seed=0;seed<64;seed++){
    const s=make(e,{seed}),o=turn(s);
    const blocked=o.fighters[1].pp[key(WAIT)]===99;
    if(blocked){success=true;assert.equal(o.fighters[1].hp,9000);}
    else{failure=true;assert.equal(o.fighters[1].pp[key(WAIT)],98);}
    const imm=make(e,{seed});timer(imm,1,'免异常');const x=turn(imm);
    assert.equal(x.fighters[1].pp[key(WAIT)],98);assert.deepEqual(x.fighters[1].ailments,{});
    if(o.fighters[1].ailments['害怕']){let x=o;for(let i=0;i<3;i++)x=wait(x);assert.equal(x.fighters[1].ailments['害怕'],undefined);assert.ok(x.fighters[1].pp[key(WAIT)]<99);}
  }
  assert.ok(success&&failure);
});
test('3575 异常1003逐实例成功恐惧、失败六项弱化、免弱和下限',()=>{
  for(const e of pick(1003)){
    const {out}=seedCase(e,o=>o.fighters[1].pp[key(WAIT)]===99);
    assert.deepEqual(Object.values(out.fighters[1].stages),[0,0,0,0,0,0]);
    for(const immuneWeak of [false,true]){
      const s=make(e);timer(s,1,'免异常');if(immuneWeak)timer(s,1,'免弱');
      const o=turn(s);assert.deepEqual(o.fighters[1].ailments,{});
      for(const k of keys)assert.equal(o.fighters[1].stages[k],immuneWeak?0:-1);
    }
    const cap=allStages(make(e),1,-6);timer(cap,1,'免异常');assert.deepEqual(Object.values(turn(cap).fighters[1].stages),[-6,-6,-6,-6,-6,-6]);
    if(e.params[0]<100){const {out:o}=seedCase(e,o=>o.fighters[1].stages.atk===-1);assert.equal(o.fighters[1].pp[key(WAIT)],98);}
  }
});
test('3575 异常968先手80与后手40的真实诅咒分支、免疫和到期',()=>{
  const e=pick(968)[0];let firstOnly=0,neither=0,both=0;
  for(let seed=0;seed<128;seed++){
    const a=make(e,{seed}),b=make(e,{seed});timer(b,1,'id984',{amount:2});
    const x=turn(a),y=turn(b),cx=!!x.fighters[1].ailments['诅咒'],cy=!!y.fighters[1].ailments['诅咒'];
    assert.equal(x.turns[0].first,0);assert.equal(y.turns[0].first,1);
    assert.ok(!cy||cx,'相同随机数的40%命中必须落在80%范围内');
    if(cx&&!cy)firstOnly++;if(!cx)neither++;if(cy)both++;
    if(x.fighters[1].ailments['诅咒']){let z=x;for(let i=0;i<3;i++)z=wait(z);assert.equal(z.fighters[1].ailments['诅咒'],undefined);}
  }
  assert.ok(firstOnly&&neither&&both);
  const imm=make(e);timer(imm,1,'免异常');const o=turn(imm);assert.equal(o.fighters[1].hp,9000-o.fighters[0].lastAttackDamage);assert.deepEqual(o.fighters[1].ailments,{});
});
test('3575 异常1030两种原始枚举反馈、无弱化失败、免疫与六级边界',()=>{
  for(const e of pick(1030)){
    const expected=e.params[0]===6?'害怕':'诅咒';let found=false;
    for(let seed=0;seed<32&&!found;seed++){
      const s=make(e,{seed});s.fighters[0].stages.atk=-2;s.fighters[0].stages.def=2;
      const o=turn(s);assert.equal(o.fighters[0].stages.atk,0);assert.equal(o.fighters[0].stages.def,2);assert.equal(o.fighters[1].stages.atk,-2);
      if(o.fighters[1].ailments[expected]){found=true;assert.ok(o.fighters[1].ailments[expected]>=2);}
    }
    assert.ok(found,e.key);const none=turn(make(e));assert.deepEqual(none.fighters[1].ailments,{});assert.equal(none.fighters[1].stages.atk,0);
    const s=make(e);s.fighters[0].stages.atk=-6;s.fighters[1].stages.atk=-6;timer(s,1,'免异常');const o=turn(s);
    assert.equal(o.fighters[0].stages.atk,0);assert.equal(o.fighters[1].stages.atk,-6);assert.deepEqual(o.fighters[1].ailments,{});
  }
});
test('3575 异常1864消强虚弱诅咒、消强成功异常失败狂暴、保留弱化与免疫',()=>{
  const e=pick(1864)[0];let enemy=false,self=false;
  for(let seed=0;seed<32;seed++){
    const s=make(e,{seed});s.fighters[1].stages.atk=6;s.fighters[1].stages.def=-2;
    const o=turn(s);assert.equal(o.fighters[1].stages.atk,0);assert.equal(o.fighters[1].stages.def,-2);
    if(o.fighters[1].ailments['虚弱诅咒'])enemy=true;
    const empty=turn(make(e,{seed}));assert.equal(empty.fighters[0].ailments['狂暴'],undefined);const blocked=make(e,{seed});blocked.fighters[1].stages.atk=1;timer(blocked,1,'免异常');const x=turn(blocked);if(x.fighters[0].ailments['狂暴'])self=true;
    const imm=make(e,{seed});imm.fighters[1].stages.atk=1;timer(imm,1,'免异常');assert.deepEqual(turn(imm).fighters[1].ailments,{});
  }
  assert.ok(enemy&&self);
});
test('3575 异常1355暴击叠加一次免疫、非暴击无效、消耗及免疫优先级',()=>{
  const e=pick(1355)[0];const s=make(e);timer(s,0,'必定暴击',{},1);
  const o=turn(s);assert.equal(o.fighters[0].counts.immune,1);
  const x=turn(o,IDLE,FEAR);assert.equal(x.fighters[0].counts.immune,0);assert.deepEqual(x.fighters[0].ailments,{});
  assert.equal(turn(make(e)).fighters[0].counts.immune??0,0);
  const add=make(e);add.fighters[0].counts.immune=1;timer(add,0,'必定暴击',{},1);const two=turn(add);assert.equal(two.fighters[0].counts.immune,2);
  timer(two,0,'免异常');const protectedOut=turn(two,IDLE,FEAR);assert.equal(protectedOut.fighters[0].counts.immune,2);assert.deepEqual(protectedOut.fighters[0].ailments,{});
});
test('3575 回合191逐实例免疫反弹、双反弹终止与五回合到期',()=>{
  for(const e of pick(191)){
    let seen=false;
    for(let seed=0;seed<24;seed++){
      const o=turn(make(e,{seed}),e.moveId,FEAR);assert.deepEqual(o.fighters[0].ailments,{});
      if(o.fighters[1].ailments['害怕'])seen=true;
      const both=make(e,{seed});timer(both,1,'reflect');const x=turn(both,e.moveId,FEAR);assert.deepEqual(x.fighters[0].ailments,{});assert.deepEqual(x.fighters[1].ailments,{});
    }
    assert.ok(seen,e.key);let s=turn(make(e));for(let r=2;r<=5;r++){s=turn(s,IDLE,FEAR);assert.deepEqual(s.fighters[0].ailments,{});}
    assert.equal(s.fighters[0].effects.reflect,undefined);
    let caught=false;for(let seed=0;seed<24;seed++){const copy=structuredClone(s);copy.rng=seed;copy.fighters[1].ailments={};const x=turn(copy,IDLE,FEAR);if(x.fighters[0].ailments['害怕'])caught=true;}assert.ok(caught);
  }
});
test('3575 回复466定额250、满血截断、禁疗和封招',()=>{
  const e=pick(466)[0];assert.equal(turn(make(e,{hp:1000})).fighters[0].hp,1250);
  assert.equal(turn(make(e,{hp:8900})).fighters[0].hp,9000);assert.equal(turn(make(e)).fighters[0].hp,9000);
  for(const block of ['技能禁疗','skillBlock']){const s=make(e,{hp:1000});timer(s,0,block);assert.equal(turn(s).fighters[0].hp,1000);}
});
test('3575 回复1005等量实际回血转伤、满血零伤、禁疗与残血截断',()=>{
  const e=pick(1005)[0];for(const hp of [1000,8000,9000]){const o=turn(make(e,{hp})),n=Math.min(4500,9000-hp);assert.equal(o.fighters[0].hp,hp+n);assert.equal(o.fighters[1].hp,9000-n);}
  const s=make(e,{hp:1000});timer(s,0,'技能禁疗');const o=turn(s);assert.equal(o.fighters[0].hp,1000);assert.equal(o.fighters[1].hp,9000);
  const ko=turn(make(e,{hp:1000,targetHp:100}));assert.equal(ko.fighters[1].hp,0);assert.equal(ko.fighters[0].hp,5500);
});
test('3575 回复101按实际攻击伤害回血、致死截断、满血和禁疗',()=>{
  const e=pick(101)[0];for(const targetHp of [9000,10]){const o=turn(make(e,{hp:1000,targetHp}));assert.equal(o.fighters[0].hp,1000+o.fighters[0].lastAttackDamage);assert.equal(o.fighters[1].hp,targetHp-o.fighters[0].lastAttackDamage);}
  assert.equal(turn(make(e)).fighters[0].hp,9000);
  const s=make(e,{hp:1000});timer(s,0,'技能禁疗');assert.equal(turn(s).fighters[0].hp,1000);
});
test('3575 回复833未击败吸取三分之一、已击败不吸、残血和禁疗',()=>{
  const e=pick(833)[0],o=turn(make(e,{hp:1000}));assert.equal(o.fighters[0].hp,4000);assert.equal(o.fighters[1].hp,6000-o.fighters[0].lastAttackDamage);
  const ko=turn(make(e,{hp:1000,targetHp:1}));assert.equal(ko.fighters[0].hp,1000);assert.equal(ko.fighters[1].hp,0);
  const low=turn(make(e,{hp:1000,targetHp:1000}));assert.equal(low.fighters[1].hp,0);assert.equal(low.fighters[0].hp,4000);
  const s=make(e,{hp:1000});timer(s,0,'技能禁疗');const x=turn(s);assert.equal(x.fighters[0].hp,1000);assert.equal(x.fighters[1].hp,6000-x.fighters[0].lastAttackDamage);
});
test('3575 回复1709追加三分之一且存活才回血、击败与禁疗',()=>{
  const e=pick(1709)[0],o=turn(make(e,{hp:1000}));assert.equal(o.fighters[0].hp,4000);assert.equal(o.fighters[1].hp,6000-o.fighters[0].lastAttackDamage);
  for(const targetHp of [1,1000]){const x=turn(make(e,{hp:1000,targetHp}));assert.equal(x.fighters[1].hp,0);assert.equal(x.fighters[0].hp,1000);}
  const s=make(e,{hp:1000});timer(s,0,'技能禁疗');assert.equal(turn(s).fighters[0].hp,1000);
  assert.equal(turn(make(e,{hp:8900})).fighters[0].hp,9000);
});
test('3575 清回合180与942成功、空目标、免断及实际吸取边界',()=>{
  for(const id of [180,942])for(const e of pick(id)){
    const s=make(e,{hp:1000});timer(s,1,'免弱');s.fighters[1].stages.def=2;s.fighters[1].counts.immune=1;
    const o=turn(s);assert.equal(o.fighters[1].effects['免弱'],undefined);assert.equal(o.fighters[1].stages.def,2);assert.equal(o.fighters[1].counts.immune,1);
    const n=id===942?4500:0;assert.equal(o.fighters[0].hp,1000+n);assert.equal(o.fighters[1].hp,9000-o.fighters[0].lastAttackDamage-n);
    const empty=turn(make(e,{hp:1000}));assert.equal(empty.fighters[0].hp,1000);
    const protectedState=make(e,{hp:1000});timer(protectedState,1,'免弱');timer(protectedState,1,'protect');const x=turn(protectedState);assert.ok(x.fighters[1].effects['免弱']);assert.equal(x.fighters[0].hp,1000);
    if(id===942){const low=make(e,{hp:8900,targetHp:100});timer(low,1,'免弱');const z=turn(low);assert.equal(z.fighters[1].hp,0);assert.equal(z.fighters[0].hp,9000);const noheal=make(e,{hp:1000});timer(noheal,1,'免弱');timer(noheal,0,'技能禁疗');assert.equal(turn(noheal).fighters[0].hp,1000);}
  }
});

test('3575 基础30招真实用招扣PP、伤害与零PP拒绝',()=>{
  for(const m of source.moves){
    const entry={moveId:m.id,index:null},s=make(entry),out=turn(s);
    assert.equal(out.fighters[0].pp[key(m.id)],m.pp-1,String(m.id));
    if(m.kind!=='status'&&m.power>0)assert.ok(out.fighters[0].lastAttackDamage>0,String(m.id));
    assert.ok(out.fighters.every(f=>f.hp>=0&&f.hp<=f.stats.maxHp));
    const empty=make(entry);empty.fighters[0].pp[key(m.id)]=0;const before=structuredClone(empty);
    assert.throws(()=>turn(empty));assert.deepEqual(empty,before);
  }
});
test('3575 基础30招控制不扣PP、封招扣PP但不执行效果',()=>{
  for(const m of source.moves){
    const e={moveId:m.id,index:null},s=make(e);s.fighters[0].ailments['疲惫']=2;
    const stopped=turn(s);assert.equal(stopped.fighters[0].pp[key(m.id)],m.pp);
    assert.equal(stopped.fighters[1].hp,9000);
    const blocked=make(e);timer(blocked,0,'skillBlock');const out=turn(blocked);
    assert.equal(out.fighters[0].pp[key(m.id)],m.pp-1);
    assert.equal(out.fighters[1].hp,9000);
    assert.deepEqual(out.fighters[0].stages,blocked.fighters[0].stages);
    assert.deepEqual(out.fighters[1].stages,blocked.fighters[1].stages);
  }
});
test('3575 基础30招原始先制决定行动顺序，非必中可失误且仍扣PP',()=>{
  for(const m of source.moves){
    const e={moveId:m.id,index:null};
    const s=make(e,{aStats:{spe:m.priority>0?1:999},bStats:{spe:m.priority>0?999:1}});
    const out=turn(s);assert.equal(out.turns[0].first,m.priority<0?1:0,String(m.id));
    if(!m.alwaysHit){
      let seen=false;
      for(let seed=0;seed<32&&!seen;seed++){
        const miss=make(e,{seed,hit:false});miss.fighters[0].stages.acc=-6;
        const result=turn(miss);
        if(result.turns[0].events.some(x=>x.kind==='miss'&&x.text.startsWith('A 方'))){
          seen=true;assert.equal(result.fighters[0].pp[key(m.id)],m.pp-1);assert.equal(result.fighters[1].hp,9000);
        }
      }
      assert.equal(seen,true,String(m.id));
    }
  }
});

test('3575 属性4和5逐实例概率、对象、六级边界及免弱禁强化',()=>{
  for(const e of [...pick(4),...pick(5)]){
    const side=e.id===4?0:1,stat=keys[e.params[0]],amount=e.params[2];
    const success=seedCase(e,o=>o.fighters[side].stages[stat]===amount);
    assert.equal(success.out.fighters[side].stages[stat],amount,e.key);
    for(const k of keys.filter(k=>k!==stat))assert.equal(success.out.fighters[side].stages[k],0,e.key);
    if(e.params[1]<100){const failure=seedCase(e,o=>o.fighters[side].stages[stat]===0);assert.equal(failure.out.fighters[side].stages[stat],0);}
    const cap=make(e,{seed:success.seed});cap.fighters[side].stages[stat]=amount>0?6:-6;
    assert.equal(turn(cap).fighters[side].stages[stat],amount>0?6:-6);
    const immune=make(e,{seed:success.seed});timer(immune,side,amount>0?'禁强化':'免弱');
    assert.equal(turn(immune).fighters[side].stages[stat],0);
    const blocked=make(e,{seed:success.seed});timer(blocked,0,'skillBlock');
    assert.equal(turn(blocked).fighters[side].stages[stat],0);
  }
});
test('3575 属性3与33清除相应符号，保留另一符号和无变化分支',()=>{
  for(const e of [...pick(3),...pick(33)]){
    const side=e.id===3?0:1,s=make(e);s.fighters[side].stages.atk=-2;s.fighters[side].stages.def=3;
    const out=turn(s);assert.equal(out.fighters[side].stages.atk,e.id===3?0:-2);assert.equal(out.fighters[side].stages.def,e.id===33?0:3);
    const empty=turn(make(e));assert.deepEqual(empty.fighters[side].stages,{atk:0,def:0,spa:0,spd:0,spe:0,acc:0});
    const extreme=make(e);allStages(extreme,side,e.id===3?-6:6);timer(extreme,side,'免弱');
    assert.ok(Object.values(turn(extreme).fighters[side].stages).every(n=>n===0));
    const blocked=make(e);allStages(blocked,side,e.id===3?-2:2);timer(blocked,0,'skillBlock');
    assert.ok(Object.values(turn(blocked).fighters[side].stages).every(n=>n===(e.id===3?-2:2)));
  }
});
test('3575 属性63反馈双方状态、无弱化、下限及免弱交互',()=>{
  for(const e of pick(63)){
    const s=make(e);s.fighters[0].stages.atk=-2;s.fighters[0].stages.def=2;
    const out=turn(s);assert.equal(out.fighters[0].stages.atk,0);assert.equal(out.fighters[1].stages.atk,-2);assert.equal(out.fighters[0].stages.def,2);
    const empty=turn(make(e));assert.equal(empty.fighters[1].stages.atk,0);
    const cap=make(e);cap.fighters[0].stages.atk=-2;cap.fighters[1].stages.atk=-6;assert.equal(turn(cap).fighters[1].stages.atk,-6);
    const immune=make(e);immune.fighters[0].stages.atk=-2;timer(immune,1,'免弱');
    assert.equal(turn(immune).fighters[1].stages.atk,0);
  }
});
test('3575 属性85吸取强化、上限、无强化和禁强化',()=>{
  for(const e of pick(85)){
    const s=make(e);s.fighters[1].stages.atk=2;s.fighters[1].stages.def=-2;s.fighters[0].stages.atk=5;
    const out=turn(s);assert.equal(out.fighters[0].stages.atk,6);assert.equal(out.fighters[1].stages.atk,0);assert.equal(out.fighters[1].stages.def,-2);
    const empty=turn(make(e));assert.equal(empty.fighters[0].stages.atk,0);
    const blocked=make(e);blocked.fighters[1].stages.atk=2;timer(blocked,0,'禁强化');
    const no=turn(blocked);assert.equal(no.fighters[1].stages.atk,2);assert.equal(no.fighters[0].stages.atk,0);
  }
});
test('3575 属性585与1001六项增幅、异常条件、封顶和禁强化',()=>{
  for(const e of [...pick(585),...pick(1001)]){
    const normal=turn(make(e));assert.deepEqual(Object.values(normal.fighters[0].stages),[1,1,1,1,1,1]);
    const active=make(e);active.fighters[1].ailments['烧伤']=1;
    assert.ok(Object.values(turn(active).fighters[0].stages).every(n=>n===(e.id===1001?2:1)));
    const expired=make(e);expired.fighters[1].ailments['烧伤']=0;assert.ok(Object.values(turn(expired).fighters[0].stages).every(n=>n===1));
    const cap=allStages(make(e),0,6);assert.ok(Object.values(turn(cap).fighters[0].stages).every(n=>n===6));
    const blocked=timer(make(e),0,'禁强化');assert.ok(Object.values(turn(blocked).fighters[0].stages).every(n=>n===0));
  }
});
test('3575 属性626随机两项不重复、上限和禁强化',()=>{
  for(const e of pick(626))for(const seed of [0,1,2,7,31]){
    const out=turn(make(e,{seed}));assert.equal(Object.values(out.fighters[0].stages).filter(n=>n===1).length,2);assert.equal(Object.values(out.fighters[0].stages).filter(n=>n===0).length,4);
    assert.ok(Object.values(turn(allStages(make(e,{seed}),0,6)).fighters[0].stages).every(n=>n===6));
    assert.ok(Object.values(turn(timer(make(e,{seed}),0,'禁强化')).fighters[0].stages).every(n=>n===0));
  }
});
test('3575 属性732暴击不强化、非暴击加攻、封顶与禁强化',()=>{
  for(const e of pick(732)){
    assert.equal(turn(make(e)).fighters[0].stages.atk,2);
    assert.equal(turn(timer(make(e),0,'必定暴击')).fighters[0].stages.atk,0);
    const cap=make(e);cap.fighters[0].stages.atk=5;assert.equal(turn(cap).fighters[0].stages.atk,6);
    assert.equal(turn(timer(make(e),0,'禁强化')).fighters[0].stages.atk,0);
  }
});
