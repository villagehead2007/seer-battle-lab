'use strict';const test=require('node:test'),assert=require('node:assert/strict'),H=require('./helpers/4239-battle.cjs'),{make,pick,turn,timer,key,keys,E}=H,ev=(o,type='attack',side=1)=>(o.damageEvents??[]).filter(e=>e.type===type&&e.targetSide===side),sum=(o,type='attack',side=1)=>ev(o,type,side).reduce((n,e)=>n+e.settledDamage,0),seed=i=>Math.imul(i+1,2654435761)>>>0;
test('4239全部18招真实有据链、唯一第五与普通伙伴技能、PP和被控未用',()=>{assert.equal(H.source.moves.length,18);assert.deepEqual(H.source.moves.filter(m=>m.fifth).map(m=>m.id),[35182]);assert.equal(H.source.moves.find(m=>m.id===29012).sourceFlags.is_special,true);for(const m of H.source.moves){const s=make({moveId:m.id,index:null}),o=turn(s);assert.equal(o.fighters[0].pp[key(m.id)],m.pp-1);if(m.kind!=='status'&&m.power>0)assert.ok(sum(o)>0);const z=make({moveId:m.id,index:null});z.fighters[0].ailments['疲惫']=3;assert.equal(turn(z).fighters[0].pp[key(m.id)],m.pp);const p=make({moveId:m.id,index:null});p.fighters[0].pp[key(m.id)]=0;assert.throws(()=>turn(p),/PP/);}});
test('4239魂印已存在盾时获得不叠加护罩与对方全PP减少，PP保护和已有护罩按标准刷新',()=>{for(const mode of ['normal','existing','protected']){const s=make({moveId:10004,index:null},{soul:1458});s.fighters[0].suitState.shield=100;if(mode==='existing')s.fighters[0].suitState.barrier=500;if(mode==='protected')timer(s,1,'PP保护');const o=turn(s,920031);assert.equal(o.fighters[0].suitState.shield,100);assert.equal(o.fighters[0].suitState.barrier,3000);assert.equal(o.fighters[1].pp[key(920040)],mode==='protected'?99:98);assert.equal(o.fighters[0].counts.immune??0,0);}});
test('4239魂印无盾按回合初快照互斥，仅建盾回PP不同时建罩减PP',()=>{const s=make({moveId:10004,index:null},{soul:1458});s.fighters[0].pp[key(10004)]=1;const o=turn(s,920031);assert.equal(o.fighters[0].suitState.shield,3000);assert.equal(o.fighters[0].pp[key(10004)],2);assert.equal(o.fighters[0].suitState.barrier,0);assert.equal(o.fighters[1].pp[key(920040)],99);assert.equal(o.fighters[0].counts.immune??0,0);});
test('4239魂印明确盾罩消失且战阶仍缺失时一次免异常和下回合潮，下回合潮真实执行',()=>{const s=make({moveId:10004,index:null},{soul:1458});s.fighters[0].suitState.shield=100;s.moveDefinitions[key(920040)].power=20000;const o=turn(s,920031,920040);assert.ok(o.fighters[0].hp>0);assert.equal(o.fighters[0].suitState.shield,0);assert.equal(o.fighters[0].suitState.barrier,3000);assert.equal(o.fighters[0].counts.immune,1);assert.equal(o.fighters[0].soulState.oceanTideNextRound,2);const next=turn(o,920030);assert.ok(next.damageEvents.some(e=>e.round===2&&e.type==='percent'&&e.settledDamage===1500));assert.equal(next.fighters[0].soulState.oceanTideThis,undefined);});
test('4239 4和5全部原实例真实能力改变、免弱不补降',()=>{for(const e of pick(4)){const o=turn(make(e));assert.equal(o.fighters[0].stages[keys[e.params[0]]],e.params[2]);}for(const e of pick(5)){let s=make(e);assert.equal(turn(s).fighters[1].stages[keys[e.params[0]]],e.params[2]);s=make(e);timer(s,1,'免弱');assert.equal(turn(s).fighters[1].stages[keys[e.params[0]]],0);}});
test('4239 14冻伤10%成功失败及免疫，31两三段真实伤害各段完整记录',()=>{let yes=0,no=0;for(let i=0;i<90;i++){const s=make(pick(14)[0],{seed:seed(i)}),o=turn(s);if(o.fighters[1].ailments['冻伤'])yes++;else no++;}assert.ok(yes>0&&no>0);const s=make(pick(14)[0]);s.fighters[1].counts.immune=1;assert.equal(turn(s).fighters[1].ailments['冻伤'],undefined);const counts=new Set;for(let i=0;i<15;i++){const o=turn(make(pick(31)[0],{seed:seed(i)}));counts.add(ev(o).length);assert.equal(9000-o.fighters[1].hp,sum(o));}assert.deepEqual([...counts].sort(),[2,3]);});
test('4239 945真实清回合成功回满而保护或无效果不回，43半体回复与禁疗',()=>{for(const mode of ['normal','none','protected']){const s=make(pick(945)[0],{hp:1000});if(mode!=='none')timer(s,1,'测试回合');if(mode==='protected')timer(s,1,'protect');assert.equal(turn(s).fighters[0].hp,mode==='normal'?9000:1000);}let s=make(pick(43)[0],{hp:1000});assert.equal(turn(s).fighters[0].hp,5500);timer(s,0,'技能禁疗');assert.equal(turn(s).fighters[0].hp,1000);});
test('4239 1697真实百分比免疫与条件免疫补等量真伤，护罩/减免/臣服/保留1HP零损失不误判免疫',()=>{const o=require('./helpers/assert-1697-actual-immunity.cjs')(4239);assert.equal(o.fighters[1].soulState.illusionReverseUsed,true);});
test('4239 140按造成攻击后当前HP随机八分一至五分一，不按最大体力或攻击前体力',()=>{const values=new Set;for(let i=0;i<30;i++){const o=turn(make(pick(140)[0],{seed:seed(i),targetHp:4000})),remaining=4000-sum(o),n=sum(o,'percent');assert.ok(n>=Math.floor(remaining/8)&&n<=Math.floor(remaining/5));values.add(n);}assert.ok(values.size>5);});
test('4239 741大于280攻击免疫严格边界及三回合期满，固定伤害不被攻击免疫',()=>{let s=turn(make(pick(741)[0]));s.moveDefinitions[key(920040)].power=5000;const o=turn(s,920031,920040);assert.equal(sum(o,'attack',0),0);const plain=structuredClone(s);delete plain.fighters[0].effects['大额攻击免疫'];assert.ok(sum(turn(plain,920031,920040),'attack',0)>280);s.round=4;assert.ok(sum(turn(s,920031,920040),'attack',0)>280);const z=turn(make(pick(741)[0]));H.op(z,29,[300],920042);assert.equal(sum(turn(z,920031,920042),'fixed',0),300);});
test('4239 1500无盾连击5至8、有盾连击5至10，所有命中逐段入真实伤害',()=>{for(const shield of [0,500]){const ns=new Set;for(let i=0;i<45;i++){const s=make(pick(1500)[0],{seed:seed(i)});s.fighters[0].suitState.shield=shield;const o=turn(s),n=ev(o).length;assert.ok(n>=5&&n<=(shield?10:8));assert.equal(9000-o.fighters[1].hp,sum(o));ns.add(n);}assert.ok(ns.has(5)&&ns.has(shield?10:8));}});
test('4239 191两实例异常反弹与免疫消费，922回合结束解除反馈负强并尊重弱锁',()=>{for(const e of pick(191)){const s=make(e);H.op(s,10,[100]);const o=turn(s,undefined,920042);assert.equal(o.fighters[0].ailments['麻痹'],undefined);assert.ok(o.fighters[1].ailments['麻痹']);}for(const lock of [false,true]){const s=make(pick(922)[0]);s.fighters[0].stages.atk=-2;if(lock)timer(s,0,'弱化不可解除反转');const o=turn(s);assert.equal(o.fighters[0].stages.atk,lock?-2:0);assert.equal(o.fighters[1].stages.atk,-2);}});
test('4239 1602当前在场自身半体回复完整实现、满体不虚构场下队友，726两实例仅次两回合对手先手攻击失效',()=>{let s=make(pick(1602)[0],{hp:1000}),o=turn(s);assert.equal(o.fighters[0].hp,5500);o=turn(o,920031);assert.equal(o.fighters[0].hp,9000);timer(s,0,'技能禁疗');assert.equal(turn(s).fighters[0].hp,1000);for(const e of pick(726)){const z=make(e,{aStats:{spe:1}}),p=turn(z);assert.equal(p.fighters[0].effects['对手先手攻击无效'].start,2);const q=turn(p,920031,920040);assert.equal(sum(q,'attack',0),0);p.round=4;assert.ok(sum(turn(p,920031,920040),'attack',0)>0);}});
test('4239 645严格低半体威力翻倍，885严格HP高于才全强翻倍，843次两回合先制',()=>{const ds=[];for(const hp of [4499,4500])ds.push(sum(turn(make(pick(645)[0],{hp}))));assert.ok(ds[0]>ds[1]);for(const hp of [8999,9000]){const o=turn(make(pick(885)[0],{targetHp:hp}));for(const k of keys)assert.equal(o.fighters[0].stages[k],hp<9000?2:1);}const o=turn(make(pick(843)[0]));assert.equal(o.fighters[0].effects.id984.start,2);assert.equal(o.fighters[0].effects.id984.end,3);assert.equal(o.fighters[0].effects.id984.amount,2);});
test('4239 1752每个真实来源盾分别反应、其他盾残留仍触发自身已消失来源，PP保护及百分比免疫理论回复',()=>{const o=require('./helpers/assert-1752-source-shield.cjs')(4239);assert.equal(Object.keys(o.fighters[0].soulState.sourceShieldReactions).length,0);});
test('4239 1698消耗全部体力不受保命限制，冰封成功不补百分比，失败补半最大HP和三回合技能禁疗',()=>{for(const immune of [false,true]){const s=make(pick(1698)[0],{hp:200});timer(s,0,'致命保留',{hp:1});if(immune)s.fighters[1].counts.immune=1;const o=turn(s);assert.equal(o.fighters[0].hp,0);assert.equal(!!o.fighters[1].ailments['冰封'],!immune);assert.equal(sum(o,'percent'),immune?4500:0);assert.equal(!!o.fighters[1].effects['技能禁疗'],immune);if(immune)assert.equal(o.fighters[1].effects['技能禁疗'].end,3);}});
test('4239 2283无场下仍有自身独立消耗、严格800边界、双方盾罩消除和按当前上限累计50%临时上限不等于回复',()=>{for(const n of [0,800,801]){const s=make(pick(2283)[0]);s.fighters[0].suitState.shield=n;s.fighters[1].suitState.barrier=1000;const o=turn(s);assert.equal(o.fighters[0].hp,9000-n);assert.equal(o.fighters[0].suitState.shield,n>800?0:n);assert.equal(o.fighters[1].suitState.barrier,n>800?0:1000);assert.equal(o.fighters[0].stats.maxHp,n>800?9900:9000);}let s=make(pick(2283)[0]);s.fighters[0].suitState.shield=1000;s.fighters[1].suitState.shield=9000;s=turn(s);assert.equal(s.fighters[0].stats.maxHp,13500);assert.equal(s.fighters[0].hp,8000);s.fighters[0].suitState.shield=1000;s.fighters[1].suitState.shield=9000;const o=turn(s);assert.equal(o.fighters[0].stats.maxHp,15750);assert.equal(o.fighters[0].hp,7000);});
test('4239 2283不足或恰好HP保留1、实际消耗判800与动态当前上限交互',()=>{const changed=make(pick(2283)[0]);changed.fighters[0].stats.maxHp+=1000;changed.fighters[0].suitState.shield=1000;assert.equal(turn(changed).fighters[0].stats.maxHp,10500);for(const hp of [1,500,801,802,1000]){const s=make(pick(2283)[0],{hp});s.fighters[0].suitState.shield=1000;const o=turn(s);assert.equal(o.fighters[0].hp,1);assert.equal(o.fighters[0].suitState.shield,hp>801?0:1000);assert.equal(o.fighters[0].stats.maxHp,hp>801?9500:9000);const loss=o.healthLossEvents.at(-1);assert.equal(loss.hpLoss,hp-1);}let s=make(pick(2283)[0]);s.fighters[0].suitState.shield=1000;s=turn(s);s.fighters[0].stats.maxHp++;s.fighters[0].suitState.shield=1000;assert.equal(turn(s).fighters[0].stats.maxHp,10001);});
test('4239 2282原子实际回复等量百分比、一二蛊不扣附伤，满体/禁疗不冒充有效恢复',()=>{for(const mode of ['normal','one-gu','two-gu','full','ban']){const s=make(pick(2282)[0],{hp:mode==='full'?9000:1000});if(mode.includes('gu'))s.fighters[0].soulState.soulGu=Array.from({length:mode==='two-gu'?2:1},()=>({sourceSide:1,usedRound:0}));if(mode==='ban')timer(s,0,'技能禁疗');const o=turn(s),heal=['full','ban'].includes(mode)?0:3000;assert.equal(sum(o,'percent'),heal);assert.equal(o.fighters[0].hp,(mode==='full'?9000:1000)+heal-(mode==='one-gu'?40:mode==='two-gu'?80:0));}});
test('4239 2282静态免粉独立补25%真伤含零回复，实际条件免疫补真，盾挡/全减免不补且每招仅一次',()=>{for(const mode of ['immune','full-immune','ban-immune','shield','reduction','conditional']){const s=make(pick(2282)[0],{hp:mode==='full-immune'?9000:1000});if(mode.includes('immune'))timer(s,1,'固定百分比免疫');if(mode==='ban-immune')timer(s,0,'技能禁疗');if(mode==='shield')s.fighters[1].suitState.barrier=4000;if(mode==='reduction')timer(s,1,'固定百分比减伤',{fraction:1});if(mode==='conditional')timer(s,1,'低伤免疫返还',{threshold:3001});const o=turn(s);if(mode.includes('immune'))assert.equal(sum(o,'true'),2250);else if(mode==='conditional')assert.deepEqual(ev(o,'fixed',0).map(e=>e.settledDamage),[3000,2250]);else assert.equal(sum(o,'true'),0);}let s=turn(make(pick(2282)[0],{hp:1000}));s.fighters[0].hp=1000;const m=s.moveDefinitions[key(920030)],r=E.WIKI.effectsEngine.registry[31],c=E.WIKI.effectsEngine.compileInstances([{id:31,args:[3,3],description:r.template}],[{id:31,argsNum:2,template:r.template}],m);m.operations=c.operations;const o=turn(s,920030);assert.equal(ev(o,'attack').length,3);assert.equal(ev(o,'percent').filter(e=>e.round===o.round-1).reduce((n,e)=>n+e.settledDamage,0),3000);});
test('4239 1699只建立真实下次攻击充能、状态技不耗，实际使用时执行消费，1220消强成功次两回合必暴',()=>{let s=turn(make(pick(1699)[0]));assert.equal(s.fighters[0].soulState.oceanTideNext,1);s=turn(s,920031);assert.equal(s.fighters[0].soulState.oceanTideNext,1);const used=turn(s,920030);assert.equal(used.fighters[0].soulState.oceanTideNext,0);for(const mode of ['none','boost','protect']){const z=make(pick(1220)[0]);if(mode!=='none')z.fighters[1].stages.atk=2;if(mode==='protect')timer(z,1,'强化保护');const o=turn(z);assert.equal(!!o.fighters[0].effects['必定暴击'],mode==='boost');if(mode==='boost'){assert.equal(o.fighters[0].effects['必定暴击'].start,2);assert.equal(o.fighters[0].effects['必定暴击'].end,3);}}});
test('4239 1570仅出手高HP才冰封、免疫失败三分一百分比，1086仅低HP伤害翻倍',()=>{for(const mode of ['high','equal','immune']){const s=make(pick(1570)[0],{targetHp:mode==='equal'?9000:8000});if(mode==='immune')s.fighters[1].counts.immune=1;const o=turn(s);assert.equal(!!o.fighters[1].ailments['冰封'],mode==='high');assert.equal(sum(o,'percent'),mode==='immune'?3000:0);}const a=sum(turn(make(pick(1086)[0],{hp:8999}))),b=sum(turn(make(pick(1086)[0],{hp:9000})));assert.ok(a===b*2||a===b*2+1);});
