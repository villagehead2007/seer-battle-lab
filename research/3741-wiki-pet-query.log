{"parse":{"title":"精灵:3741","pageid":28388,"revid":361142,"text":{"*":"<div class=\"mw-parser-output\"><p><br /> \n</p>\n<div style=\"display:none;\"><script>\n(window.RLQ = window.RLQ || []).push(['jquery', () => {\n    $(document).ready(function () {\n$('div[data-type=\"canvas\"]').each(function () {\n    let $div = $(this);\n    let html = $div.text('')[0].outerHTML;\n    html = html.replace('<div', \"<canvas \")\n        .replace('></div>', ' />');\n\n    let $hex = $(html);\n    $hex[0].height = $hex.data('height') || 200;\n    $hex[0].width = $hex.data('width') || 225;\n\n    $div.replaceWith($hex);\n\n    let ability_value = [];\n    let ability_name = [];\n    let stagesNum = $div.data('stages');\n    let canvasInfo = $div.data('value').split('|');\n    $.each(canvasInfo, function (i, val) {\n        let data = val.split('_');\n        ability_value.push(data[0] || 0);\n        ability_name.push(data[1]);\n    });\n    let sourceValue = $div.data('source');\n    let correctionValue = 0;\n    switch (sourceValue) {\n        case 'Monster':\n            correctionValue=200;\n            break;\n        case 'MintMark':\n            correctionValue=150;\n            break;\n        default :\n            break;\n\n    }\n    polygon($hex[0], canvasInfo.length, stagesNum, ability_value, ability_name, correctionValue/5);\n});\n\n// 绘制多边形图\nfunction polygon(obj, side, part, ability_value, ability_name, correctionValue) {\n    let ability = obj.getContext('2d');\n    ability.canvas.width = obj.width;\n    ability.canvas.height = obj.height;\n    let width = obj.width;\n    let height = obj.height;\n    let xCenter = width * 0.5;\n    let yCenter = height * 0.5;\n    let radius = width * 0.3;\n    let space = radius / part;\n    let theta = Math.PI * 2 / side;\n\n    //绘制渐变多边形底层\n    for (let j = part; j >= 1; j--) {\n        ability.beginPath();\n        for (let i = 0; i <= side; i++) {\n            ability.lineTo(Math.cos(i * theta) * space * j + xCenter, -Math.sin(i * theta) * space * j + yCenter);\n        }\n        ability.lineWidth = 1;\n        //边线\n        ability.strokeStyle = \"rgba(0,255,255,0.2)\";\n        ability.stroke();\n        // ability.fillStyle = \"rgba(\" + r + \",\" + g + \",\" + b + \",\" + a + \")\";\n        ability.fillStyle = \"rgba(11,124,211,0.4)\"\n        ability.fill();\n        ability.closePath();\n        for (let i = 0; i <= side; i++) {\n            ability.beginPath();\n            ability.moveTo(xCenter, yCenter);\n            ability.lineTo(Math.cos(i * theta) * space * j + xCenter, -Math.sin(i * theta) * space * j + yCenter);\n            ability.stroke();\n            ability.closePath();\n        }\n    }\n\n    //绘制能力多边形\n    ability.beginPath();\n    for (let i = 0; i <= side; i++) {\n        let x = Math.cos(i * theta) * radius * (ability_value[i % side] / part / correctionValue) + xCenter;\n        let y = -Math.sin(i * theta) * radius * (ability_value[i % side] / part / correctionValue) + yCenter;\n        ability.lineTo(x, y);\n    }\n    ability.closePath();\n    ability.fillStyle = \"rgba(119,241,255,0.5)\";\n    ability.fill();\n\n\n    //绘制字体\n    for (let i = 0; i < side; i++) {\n        ability.fillStyle = \"rgba(255,255,255,1)\";\n        ability.font = \"normal 15px Microsoft Yahei\";\n        let x;\n        if (Math.cos(i * theta) * radius > 0) {\n            if (i === 0) {\n                ability.textAlign = 'left'\n                x = Math.cos(i * theta) * radius + xCenter + 3;\n            } else {\n                ability.textAlign = 'center'\n                x = Math.cos(i * theta) * radius + xCenter + 3;\n            }\n        } else {\n            ability.textAlign = 'left'\n            x = Math.cos(i * theta) * radius * 1.5 + xCenter;\n        }\n        let y = -Math.sin(i * theta) * radius * 1.3 + yCenter;\n        ability.fillText(ability_name[i], x, y + 6);\n    }\n}\n})\n}]);\n</script>\n<p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p>\n<div style=\"display:none;\"><Script>\n(window.RLQ=window.RLQ||[]).push([ [\"jquery\"], function(){\n$(function(){\n$('.resourceLoader').each(function () {\n  var $x = $(this);\n  var text = $.trim($x.text());\n\n  if (!text) return;\n\n  //加载模块\n  if ($x.data('isModule') === true)\n    return mw.loader.load(text);\n\n  //自动补充MediaWiki命名空间\n  var ns = text.match('^.*?:');\n  if (!ns) text = 'MediaWiki:' + text;\n\n  //加载CSS样式表\n  var mime = ($x.data('mime') || \"text/javascript\").toLowerCase();\n  if (mime == \"text/css\") {\n    if (text.slice(-4).toLowerCase() !== '.css') text = text + '.css';\n    //if ($x.data('debug') !== true) text = text + '&debug=false';\n    return mw.loader.load(\"//wiki.biligame.com/\" + mw.config.get(\"wgGameName\") + \"/index.php?title=\" + text + \"&action=raw&ctype=text/css\", \"text/css\");\n  }\n\n  //加载JS脚本\n  if (ns && ns[0].toLowerCase() !== 'mediawiki:') {\n    return console.log('ResourceLoader: 不允许加载MediaWiki以外的js脚本');\n  }\n  if (text.slice(-3).toLowerCase() !== '.js') text = text + '.js';\n  //if ($x.data('debug') !== true) text = text + '&debug=false';\n  return mw.loader.load(\"//wiki.biligame.com/\" + mw.config.get(\"wgGameName\") + \"/index.php?title=\" + text + \"&action=raw&ctype=text/javascript\", \"text/javascript\");\n});\n})\n}]);\n</Script>\n</div><div class=\"resourceLoader\" style=\"display:none\" data-is-module=\"false\" data-mime=\"\">Imageshowtools.js</div>\n<p><br />\n</p><p><br />\n</p><p><br />\n</p>\n</div>\n<style type=\"text/css\"> @media screen and (min-width: 1160px) {.qnzl_character_bg{top: -123px; left: 230px;} } @media screen and (max-width: 1160px) {.qnzl_character_bg{top: {{{移动端背景图顶部偏移}}}; right:{{{移动端背景图右侧偏移}}};} } .qnzl_character_talent_tab_btn_active {border-bottom: white solid 2px;}@media screen and (max-width: 600px) {.skill-tab ul.resp-tabs-list.clearfix li.bili-list-style {display: none!important;} } ></style>\n<div class=\"crumb navigation-not-searchable\"><div><a href=\"/seer/%E9%A6%96%E9%A1%B5\" title=\"首页\"><span class=\"glyphicon glyphicon-home\"></span></a><span> &gt; <a href=\"/seer/%E7%B2%BE%E7%81%B5%E5%9B%BE%E9%89%B4\" title=\"精灵图鉴\">精灵图鉴</a></span> &gt; <span style=\"color:#880088; font-weight:bold;\"><b><a class=\"mw-selflink selflink\">精灵:3741</a></b></span></div><div><small title=\"短网址，按右键复制链接地址\"><a rel=\"nofollow\" class=\"external text\" href=\"https://wiki.biligame.com/seer/?curid=28388\">短</a></small>&#8226;<small title=\"清除这个页面的缓存\"><a rel=\"nofollow\" class=\"external text\" href=\"https://wiki.biligame.com/seer/index.php?title=%E7%B2%BE%E7%81%B5:3741&amp;action=purge\">刷</a></small>&#8226;<small title=\"查看这个页面\"><a rel=\"nofollow\" class=\"external text\" href=\"https://wiki.biligame.com/seer/%E7%B2%BE%E7%81%B5:3741\">阅</a></small>&#8226;<small title=\"编辑这个页面\"><a rel=\"nofollow\" class=\"external text\" href=\"https://wiki.biligame.com/seer/index.php?title=%E7%B2%BE%E7%81%B5:3741&amp;action=edit\">编</a></small>&#8226;<small title=\"查看这个页面的编辑历史\"><a rel=\"nofollow\" class=\"external text\" href=\"https://wiki.biligame.com/seer/index.php?title=%E7%B2%BE%E7%81%B5:3741&amp;action=history\">历</a></small></div></div><style type=\"text/css\"> .crumb{display:flex;justify-content:space-between;padding:5px 10px;margin:10px 0;border:1px solid #0088FF;border-left-width:5px;border-radius:3px;background:#F7F7F7;}.crumb .external{background:unset!important;padding:0 0.5em!important;}.crumb .dropdown{display:inline-block;cursor:pointer;}.crumb .dropdown-menu{max-height:250px;overflow-x:hidden;padding:5px 0;margin:0;}.crumb .dropdown:hover .dropdown-menu,.crumb .dropdown-menu:hover{display:block;}.crumb.navigation-not-searchable {color: #000000;}a.mw-selflink.selflink {color: #000000;}></style><div class=\"resourceLoader\" style=\"display:none\" data-is-module=\"false\" data-mime=\"\">MediaWiki:Info.js</div>\n<p><br />\n<script>  \ndocument.addEventListener('DOMContentLoaded', function() {  \n    // 获取所有的.bwiki-tabs-a元素  \n    const tabsContainers = document.querySelectorAll('.bwiki-tabs-a');  \n  \n    tabsContainers.forEach(container => {  \n        // 获取当前容器内的所有.bwiki-tabs和.bwiki-tabs-container  \n        const tabs = container.querySelectorAll('.bwiki-tabs');  \n        const tabContents = container.querySelectorAll('.bwiki-tabs-container');  \n  \n        // 移除所有.bwiki-tabs的active类  \n        tabs.forEach(tab => tab.classList.remove('active'));  \n  \n        // 移除所有.bwiki-tabs-container的active类，并隐藏所有内容  \n        tabContents.forEach(tc => {  \n            tc.classList.remove('active');  \n            tc.style.display = 'none';  \n        });  \n  \n        // 只为每个容器中的第一个.bwiki-tabs和.bwiki-tabs-container添加active类  \n        if (tabs.length > 0) {  \n            tabs[0].classList.add('active');  \n            if (tabContents.length > 0) {  \n                tabContents[0].classList.add('active');  \n                tabContents[0].style.display = 'block';  \n            }  \n        }  \n      \n      \n      \n        // 为每个标签添加点击事件  \n        tabs.forEach((tab, index) => {  \n            tab.addEventListener('click', () => {  \n                // 移除所有标签的active类  \n                tabs.forEach(t => t.classList.remove('active'));  \n  \n                // 隐藏所有内容  \n                tabContents.forEach(tc => {  \n                    tc.style.display = 'none';  \n                    tc.classList.remove('active');  \n                });  \n  \n                // 为当前标签和内容添加active类  \n                tab.classList.add('active');  \n  \n                // 显示对应的内容  \n                const selectedTabContent = tabContents[index];  \n                if (selectedTabContent) {  \n                    selectedTabContent.style.display = 'block';  \n                    selectedTabContent.classList.add('active');  \n                }  \n            });  \n        });  \n    });  \n});  \n</script>\n</p>\n<div class=\"bwiki-tabs-a\"><div class=\"bwiki-tabs-c\" style=\"display: flex;flex-wrap: wrap;justify-content:center;background-color: rgba(23, 21, 23, 0.8);border-radius: 10px 10px 0px 0px;box-shadow: 0px 0px 5px rgba(0,0,0,0.7);\">\n<div class=\"bwiki-tabs\" style=\"\">角色立绘</div>\n<div class=\"bwiki-tabs\" style=\"\">动态立绘</div>\n</div>\n<div id=\"tabContent1\" class=\"bwiki-tabs-container\" style=\"max-height:504px;overflow: hidden;box-shadow: 0px 0px 5px rgba(0,0,0,0.7);\"><div class=\"person-bg\">\n<div class=\"person-picture\" style=\"transform: translate(-50%, -50%);\">\n<p><img alt=\"立绘-3741.png\" src=\"https://patchwiki.biligame.com/images/seer/8/8a/jfqjsbivwg2ionoch2s6eor25xeui59.png\" decoding=\"async\" loading=\"lazy\" width=\"2992\" height=\"2288\" class=\"seer-cover\" data-file-width=\"2992\" data-file-height=\"2288\" />\n</p>\n</div>\n<p><a class=\"gonglue\" href=\"攻略?title=上古魔尊·库贝萨\" target=\"_blank\"></a>\n<style type=\"text/css\"> \nimg.\\\"gonglue\\\"{z-index:2;position:sticky;}\na.gonglue {background: url(https://patchwiki.biligame.com/images/seer/5/5a/ff60z2z07ikv1hm5ibxa011zs16mpxp.png);width: 87px;height: 74px;display: block;position: sticky;z-index: 2;}\n></style>\n</p>\n<div class=\"side-tabs\"><div class=\"tab-btn\"><div class=\"\"><div><a href=\"#基础信息\" title=\"#基础信息\"><img alt=\"精灵 icon.png\" src=\"https://patchwiki.biligame.com/images/seer/thumb/a/a5/8f50oww7v2vo7aajc0608xwu6kqn3kc.png/38px-%E7%B2%BE%E7%81%B5_icon.png\" decoding=\"async\" loading=\"lazy\" width=\"38\" height=\"38\" srcset=\"https://patchwiki.biligame.com/images/seer/thumb/a/a5/8f50oww7v2vo7aajc0608xwu6kqn3kc.png/57px-%E7%B2%BE%E7%81%B5_icon.png 1.5x, https://patchwiki.biligame.com/images/seer/a/a5/8f50oww7v2vo7aajc0608xwu6kqn3kc.png 2x\" data-file-width=\"68\" data-file-height=\"68\" /></a></div><a class=\"title1\" href=\"#基础信息\">简介</a></div></div><div class=\"tab-btn\"><div class=\"\"><div><a href=\"#专属魂印\" title=\"#专属魂印\"><img alt=\"魂印 icon.png\" src=\"https://patchwiki.biligame.com/images/seer/thumb/7/77/6a4vz4mfe42fvp5jq8l