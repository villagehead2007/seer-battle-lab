gm4k98bxzpe.png/30px-%E5%B1%9E%E6%80%A7.png\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" srcset=\"https://patchwiki.biligame.com/images/seer/thumb/0/0f/bgoweya0wzruguug42a0gm4k98bxzpe.png/45px-%E5%B1%9E%E6%80%A7.png 1.5x, https://patchwiki.biligame.com/images/seer/thumb/0/0f/bgoweya0wzruguug42a0gm4k98bxzpe.png/60px-%E5%B1%9E%E6%80%A7.png 2x\" data-file-width=\"318\" data-file-height=\"318\" />\n</td>\n<td style=\"font-size: 19px;\"><div class=\"jnm1\"><a href=\"/seer/%E6%8A%80%E8%83%BD:24751\" title=\"技能:24751\">爆裂强断</a>&#160;&#160;</div><div style=\"display:none;\">24751</div>\n</td>\n<td style=\"text-align: right;\">（学习等级：69）\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"padding-left: calc(7px + 2em);font-size: smaller;padding-bottom: 3px;padding-top: 3px;\">先制：0&#160;&#160;&#160;&#160;威力：0&#160;&#160;&#160;&#160;PP：5&#160;&#160;&#160;&#160;命中：必中（100%）&#160;&#160;&#160;&#160;暴击：--&#160;&#160;&#160;&#160;<span style=\"border-radius: 12px;padding: 1px 10px;background: #6ec435\">属性攻击</span><br />ID：24751&#160;&#160;&#160;&#160;效果ID：<a href=\"/seer/%E6%95%88%E6%9E%9C:585\" title=\"效果:585\">585</a><span style=\"display:none;\">585</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:48\" title=\"效果:48\">48</a><span style=\"display:none;\">48</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:478\" title=\"效果:478\">478</a><span style=\"display:none;\">478</span></td></tr><tr><td colspan=\"3\"><span class=\"jntag\" id=\"免疫异常\">免疫异常</span><span class=\"jntag\" id=\"效果无效\">效果无效</span></td></tr><tr><td colspan=\"3\" style=\"padding-left: 7px;padding-right: 7px;padding-top: 3px;padding-bottom: 5px;\">技能使用成功时，攻击+1、 防御+1、 特攻+1、 特防+1、 速度+1、 命中+1；5回合内免疫所有受到的异常状态；4回合内令对手使用的属性<span class=\"smw-highlighter\" data-title=\"技能无效\" style=\"border-bottom:1px solid;color:#FFEB3B;\">技能无效<span class=\"smwttcontent\">无效的技能不会计为命中、取消技能原本的伤害值、无法触发命中效果</span></span></td></tr> \n</tbody></table><br /><div style=\"display:none;\">\n<p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p>\n</div>\n<table style=\"width:100%;border: 1px solid;color: #ffffff;border-collapse: collapse;\">\n<tbody><tr>\n<td style=\"width: 31px;padding-left: 5px;padding-top: 5px;\"><a href=\"/seer/%E8%BF%9C%E5%8F%A4%E7%B3%BB%E7%B3%BB\" title=\"远古系系\"><img alt=\"远古系.png\" src=\"https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/30px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" srcset=\"https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/45px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png 1.5x, https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/60px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png 2x\" data-file-width=\"318\" data-file-height=\"318\" /></a>\n</td>\n<td style=\"font-size: 19px;\"><div class=\"jnm1\"><a href=\"/seer/%E6%8A%80%E8%83%BD:19311\" title=\"技能:19311\">裂天苍穹断</a>&#160;&#160;</div><div style=\"display:none;\">19311</div>\n</td>\n<td style=\"text-align: right;\">（学习等级：70）\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"padding-left: calc(7px + 2em);font-size: smaller;padding-bottom: 3px;padding-top: 3px;\">先制：0&#160;&#160;&#160;&#160;威力：150&#160;&#160;&#160;&#160;PP：5&#160;&#160;&#160;&#160;命中：95%&#160;&#160;&#160;&#160;暴击：6.25%（1/16）&#160;&#160;&#160;&#160;<span style=\"border-radius: 12px;padding: 1px 10px;background: #ff5c14\">物理攻击</span><br />ID：19311&#160;&#160;&#160;&#160;效果ID：<a href=\"/seer/%E6%95%88%E6%9E%9C:447\" title=\"效果:447\">447</a><span style=\"display:none;\">447</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:101\" title=\"效果:101\">101</a><span style=\"display:none;\">101</span></td></tr><tr><td colspan=\"3\"><span class=\"jntag\" id=\"伤害限制\">伤害限制</span><span class=\"jntag\" id=\"恢复\">恢复</span></td></tr><tr><td colspan=\"3\" style=\"padding-left: 7px;padding-right: 7px;padding-top: 3px;padding-bottom: 5px;\">造成的伤害不少于300；给对手造成伤害时，伤害数值的100%恢复自身体力</td></tr> \n</tbody></table><br /><div style=\"display:none;\">\n<p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p>\n</div>\n<table style=\"width:100%;border: 1px solid;color: #ffffff;border-collapse: collapse;\">\n<tbody><tr>\n<td style=\"width: 31px;padding-left: 5px;padding-top: 5px;\"><a href=\"/seer/%E8%BF%9C%E5%8F%A4%E7%B3%BB%E7%B3%BB\" title=\"远古系系\"><img alt=\"远古系.png\" src=\"https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/30px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" srcset=\"https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/45px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png 1.5x, https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/60px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png 2x\" data-file-width=\"318\" data-file-height=\"318\" /></a>\n</td>\n<td style=\"font-size: 19px;\"><div class=\"jnm1\"><a href=\"/seer/%E6%8A%80%E8%83%BD:32670\" title=\"技能:32670\">横扫大荒</a>&#160;&#160;</div><div style=\"display:none;\">32670</div>\n</td>\n<td style=\"text-align: right;\">（学习等级：72）\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"padding-left: calc(7px + 2em);font-size: smaller;padding-bottom: 3px;padding-top: 3px;\">先制：3&#160;&#160;&#160;&#160;威力：85&#160;&#160;&#160;&#160;PP：20&#160;&#160;&#160;&#160;命中：95%&#160;&#160;&#160;&#160;暴击：6.25%（1/16）&#160;&#160;&#160;&#160;<span style=\"border-radius: 12px;padding: 1px 10px;background: #ff5c14\">物理攻击</span><br />ID：32670&#160;&#160;&#160;&#160;效果ID：<a href=\"/seer/%E6%95%88%E6%9E%9C:1180\" title=\"效果:1180\">1180</a><span style=\"display:none;\">1180</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:1239\" title=\"效果:1239\">1239</a><span style=\"display:none;\">1239</span></td></tr><tr><td colspan=\"3\"><span class=\"jntag\" id=\"先制\">先制</span><span class=\"jntag\" id=\"吸强\">吸强</span><span class=\"jntag\" id=\"恢复\">恢复</span><span class=\"jntag\" id=\"致命一击\">致命一击</span><span class=\"jntag\" id=\"附加伤害\">附加伤害</span></td></tr><tr><td colspan=\"3\" style=\"padding-left: 7px;padding-right: 7px;padding-top: 3px;padding-bottom: 5px;\"><span class=\"smw-highlighter\" data-title=\"吸取\" style=\"border-bottom:1px solid;color:#FFEB3B;\">吸取<span class=\"smwttcontent\">对对手附加一定的伤害，然后恢复一定的体力，数值由后续搭配的数值决定，当搭配的数值为固定点数时伤害类型为固定伤害，当搭配的数值为比例时伤害类型为百分比伤害，</span></span>对手能力提升状态，<span class=\"smw-highlighter\" data-title=\"吸取\" style=\"border-bottom:1px solid;color:#FFEB3B;\">吸取<span class=\"smwttcontent\">对对手附加一定的伤害，然后恢复一定的体力，数值由后续搭配的数值决定，当搭配的数值为固定点数时伤害类型为固定伤害，当搭配的数值为比例时伤害类型为百分比伤害，</span></span>成功则自身下2回合必定<span class=\"smw-highlighter\" data-title=\"致命一击\" style=\"border-bottom:1px solid;color:#FFEB3B;\">致命一击<span class=\"smwttcontent\">造成的伤害提升，同时重置对手对应的防御强化效果</span></span>；恢复自身最大体力的1/2，自身体力低于1/2时造成等量<span class=\"smw-highlighter\" data-title=\"百分比伤害\" style=\"border-bottom:1px solid;color:#FFEB3B;\">百分比伤害<span class=\"smwttcontent\">以分数、百分数表示的一种伤害的类型</span></span></td></tr> \n</tbody></table><br /><div style=\"display:none;\">\n<p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p>\n</div>\n<table style=\"width:100%;border: 1px solid;color: #ffffff;border-collapse: collapse;\">\n<tbody><tr>\n<td style=\"width: 31px;padding-left: 5px;padding-top: 5px;\"><img alt=\"属性.png\" src=\"https://patchwiki.biligame.com/images/seer/thumb/0/0f/bgoweya0wzruguug42a0gm4k98bxzpe.png/30px-%E5%B1%9E%E6%80%A7.png\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" srcset=\"https://patchwiki.biligame.com/images/seer/thumb/0/0f/bgoweya0wzruguug42a0gm4k98bxzpe.png/45px-%E5%B1%9E%E6%80%A7.png 1.5x, https://patchwiki.biligame.com/images/seer/thumb/0/0f/bgoweya0wzruguug42a0gm4k98bxzpe.png/60px-%E5%B1%9E%E6%80%A7.png 2x\" data-file-width=\"318\" data-file-height=\"318\" />\n</td>\n<td style=\"font-size: 19px;\"><div class=\"jnm1\"><a href=\"/seer/%E6%8A%80%E8%83%BD:26429\" title=\"技能:26429\">恒古噬灵</a>&#160;&#160;</div><div style=\"display:none;\">26429</div>\n</td>\n<td style=\"text-align: right;\">（学习等级：74）\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"padding-left: calc(7px + 2em);font-size: smaller;padding-bottom: 3px;padding-top: 3px;\">先制：0&#160;&#160;&#160;&#160;威力：0&#160;&#160;&#160;&#160;PP：5&#160;&#160;&#160;&#160;命中：必中（100%）&#160;&#160;&#160;&#160;暴击：--&#160;&#160;&#160;&#160;<span style=\"border-radius: 12px;padding: 1px 10px;background: #6ec435\">属性攻击</span><br />ID：26429&#160;&#160;&#160;&#160;效果ID：<a href=\"/seer/%E6%95%88%E6%9E%9C:479\" title=\"效果:479\">479</a><span style=\"display:none;\">479</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:191\" title=\"效果:191\">191</a><span style=\"display:none;\">191</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:1394\" title=\"效果:1394\">1394</a><span style=\"display:none;\">1394</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:1151\" title=\"效果:1151\">1151</a><span style=\"display:none;\">1151</span></td></tr><tr><td colspan=\"3\"><span class=\"jntag\" id=\"免疫异常\">免疫异常</span><span class=\"jntag\" id=\"强化\">强化</span><span class=\"jntag\" id=\"附加伤害\">附加伤害</span></td></tr><tr><td colspan=\"3\" style=\"padding-left: 7px;padding-right: 7px;padding-top: 3px;padding-bottom: 5px;\">损失自身350点体力，给对手造成500点<span class=\"smw-highlighter\" data-title=\"固定伤害\" style=\"border-bottom:1px solid;color:#FFEB3B;\">固定伤害<span class=\"smwttcontent\">以固定的点数表示的一种伤害的类型</span></span>，若自身体力不足350则剩下1点体力；4回合内免疫并<span class=\"smw-highlighter\" data-title=\"反弹\" style=\"border-bottom:1px solid;color:#FFEB3B;\">反弹<span class=\"smwttcontent\">一种特殊的附加，被反弹的效果不会被再次反弹</span></span>所有受到的异常状态；3回合内对手使用属性技能则随机附加2种异常状态；3回合内若对手使用攻击技能则自身<span class=\"smw-highlighter\" data-title=\"全属性\" style=\"border-bottom:1px solid;color:#FFEB3B;\">全属性<span class=\"smwttcontent\">即攻击、防御、特攻、特防、速度、命中共计6种能力的等级</span></span>+1</td></tr> \n</tbody></table><br /><div style=\"display:none;\">\n<p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p>\n</div>\n<table style=\"width:100%;border: 1px solid;color: #ffffff;border-collapse: collapse;\">\n<tbody><tr>\n<td style=\"width: 31px;padding-left: 5px;padding-top: 5px;\"><a href=\"/seer/%E8%BF%9C%E5%8F%A4%E7%B3%BB%E7%B3%BB\" title=\"远古系系\"><img alt=\"远古系.png\" src=\"https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/30px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" srcset=\"https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/45px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png 1.5x, https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/60px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png 2x\" data-file-width=\"318\" data-file-height=\"318\" /></a>\n</td>\n<td style=\"font-size: 19px;\"><div class=\"jnm1\"><a href=\"/seer/%E6%8A%80%E8%83%BD:32671\" title=\"技能:32671\">天霸斗气</a>&#160;&#160;</div><div style=\"display:none;\">32671</div>\n</td>\n<td style=\"text-align: right;\">（学习等级：76）\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"padding-left: calc(7px + 2em);font-size: smaller;padding-bottom: 3px;padding-top: 3px;\">先制：0&#160;&#160;&#160;&#160;威力：140&#160;&#160;&#160;&#160;PP：5&#160;&#160;&#160;&#160;命中：95%&#160;&#160;&#160;&#160;暴击：6.25%（1/16）&#160;&#160;&#160;&#160;<span style=\"border-radius: 12px;padding: 1px 10px;background: #bd29db\">特殊攻击</span><br />ID：32671&#160;&#160;&#160;&#160;效果ID：<a href=\"/seer/%E6%95%88%E6%9E%9C:39\" title=\"效果:39\">39</a><span style=\"display:none;\">39</span></td></tr><tr><td colspan=\"3\"><span class=\"jntag\" id=\"减PP\">减PP</span></td></tr><tr><td colspan=\"3\" style=\"padding-left: 7px;padding-right: 7px;padding-top: 3px;padding-bottom: 5px;\">30%降低对手所有技能3点PP值，<span class=\"smw-highlighter\" data-title=\"然后\" style=\"border-bottom:1px solid;color:#FFEB3B;\">然后<span class=\"smwttcontent\">表示与前述效果位于同一时点但无因果关联依次执行；无论前述效果满足/触发与否，后文的效果仍然会独立结算满足/触发</span></span>若对手所选择的技能PP值为0则<span class=\"smw-highlighter\" data-title=\"当回合\" style=\"border-bottom:1px solid;color:#FFEB3B;\">当回合<span class=\"smwttcontent\">在表示效果持续时间段时，此“当回合”与“1回合”基本同义；用“当回合”表述的效果不会因为后出手而延长1回合</span></span>对手无法行动</td></tr> \n</tbody></table><br /><div style=\"display:none;\">\n<p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p>\n</div>\n<table style=\"width:100%;border: 1px solid;color: #ffffff;border-collapse: collapse;\">\n<tbody><tr>\n<td style=\"width: 31px;padding-left: 5px;padding-top: 5px;\"><img alt=\"属性.png\" src=\"https://patchwiki.biligame.com/images/seer/thumb/0/0f/bgoweya0wzruguug42a0gm4k98bxzpe.png/30px-%E5%B1%9E%E6%80%A7.png\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" srcset=\"https://patchwiki.biligame.com/images/seer/thumb/0/0f/bgoweya0wzruguug42a0gm4k98bxzpe.png/45px-%E5%B1%9E%E6%80%A7.png 1.5x, https://patchwiki.biligame.com/images/seer/thumb/0/0f/bgoweya0wzruguug42a0gm4k98bxzpe.png/60px-%E5%B1%9E%E6%80%A7.png 2x\" data-file-width=\"318\" data-file-height=\"318\" />\n</td>\n<td style=\"font-size: 19px;\"><div class=\"jnm1\"><a href=\"/seer/%E6%8A%80%E8%83%BD:26430\" title=\"技能:26430\">上古魔尊</a>&#160;&#160;</div><div style=\"display:none;\">26430</div>\n</td>\n<td style=\"text-align: right;\">（学习等级：78）\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"padding-left: calc(7px + 2em);font-size: smaller;padding-bottom: 3px;padding-top: 3px;\">先制：0&#160;&#160;&#160;&#160;威力：0&#160;&#160;&#160;&#160;PP：5&#160;&#160;&#160;&#160;命中：必中（100%）&#160;&#160;&#160;&#160;暴击：--&#160;&#160;&#160;&#160;<span style=\"border-radius: 12px;padding: 1px 10px;background: #6ec435\">属性攻击</span><br />ID：26430&#160;&#160;&#160;&#160;效果ID：<a href=\"/seer/%E6%95%88%E6%9E%9C:885\" title=\"效果:885\">885</a><span style=\"display:none;\">885</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:478\" title=\"效果:478\">478</a><span style=\"display:none;\">478</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:1400\" title=\"效果:1400\">1400</a><span style=\"display:none;\">1400</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:619\" title=\"效果:619\">619</a><span style=\"display:none;\">619</span></td></tr><tr><td colspan=\"3\"><span class=\"jntag\" id=\"强化\">强化</span><span class=\"jntag\" id=\"效果无效\">效果无效</span><span class=\"jntag\" id=\"施加异常\">施加异常</span><span class=\"jntag\" id=\"消除回合\">消除回合</span></td></tr><tr><td colspan=\"3\" style=\"padding-left: 7px;padding-right: 7px;padding-top: 3px;padding-bottom: 5px;\"><span class=\"smw-highlighter\" data-title=\"全属性\" style=\"border-bottom:1px solid;color:#FFEB3B;\">全属性<span class=\"smwttcontent\">即攻击、防御、特攻、特防、速度、命中共计6种能力的等级</span></span>+1，自身当前体力高于对手时强化效果翻倍；4回合内令对手使用的属性<span class=\"smw-highlighter\" data-title=\"技能无效\" style=\"border-bottom:1px solid;color:#FFEB3B;\">技能无效<span class=\"smwttcontent\">无效的技能不会计为命中、取消技能原本的伤害值、无法触发命中效果</span></span>；3回合内若自身<span class=\"smw-highlighter\" data-title=\"回合类效果\" style=\"border-bottom:1px solid;color:#FFEB3B;\">回合类效果<span class=\"smwttcontent\">由技能效果附加的、以回合为计数的未命名效果；此类效果在后出手附加时，若当回合因此无法直接触发收益，则回合数+1</span></span>被消除则100%令对手<span class=\"smw-highlighter\" data-title=\"疲惫\" style=\"border-bottom:1px solid;color:#FFEB3B;\">疲惫<span class=\"smwttcontent\">控制类异常状态，该状态下精灵无法行动</span></span>；下2回合令对手所有<span class=\"smw-highlighter\" data-title=\"技能先制\" style=\"border-bottom:1px solid;color:#FFEB3B;\">技能先制<span class=\"smwttcontent\">战斗阶段开始时，若双方均选择了合法技能，则精灵的技能先制会转化为精灵先制</span></span>-2</td></tr> \n</tbody></table><br /><div style=\"display:none;\">\n<p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p>\n</div>\n<table style=\"width:100%;border: 1px solid;color: #ffffff;border-collapse: collapse;\">\n<tbody><tr>\n<td style=\"width: 31px;padding-left: 5px;padding-top: 5px;\"><a href=\"/seer/%E8%BF%9C%E5%8F%A4%E7%B3%BB%E7%B3%BB\" title=\"远古系系\"><img alt=\"远古系.png\" src=\"https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/30px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" srcset=\"https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/45px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png 1.5x, https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/60px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png 2x\" data-file-width=\"318\" data-file-height=\"318\" /></a>\n</td>\n<td style=\"font-size: 19px;\"><div class=\"jnm1\"><a href=\"/seer/%E6%8A%80%E8%83%BD:32672\" title=\"技能:32672\">异魔天威斩</a>&#160;&#160;</div><div style=\"display:none;\">32672</div>\n</td>\n<td style=\"text-align: right;\">（学习等级：80）\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"padding-left: calc(7px + 2em);font-size: smaller;padding-bottom: 3px;padding-top: 3px;\">先制：0&#160;&#160;&#160;&#160;威力：150&#160;&#160;&#160;&#160;PP：5&#160;&#160;&#160;&#160;命中：94%&#160;&#160;&#160;&#160;暴击：6.25%（1/16）&#160;&#160;&#160;&#160;<span style=\"border-radius: 12px;padding: 1px 10px;background: #ff5c14\">物理攻击</span><br />ID：32672&#160;&#160;&#160;&#160;效果ID：<a href=\"/seer/%E6%95%88%E6%9E%9C:1412\" title=\"效果:1412\">1412</a><span style=\"display:none;\">1412</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:447\" title=\"效果:447\">447</a><span style=\"display:none;\">447</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:101\" title=\"效果:101\">101</a><span style=\"display:none;\">101</span></td></tr><tr><td colspan=\"3\"><span class=\"jntag\" id=\"伤害限制\">伤害限制</span><span class=\"jntag\" id=\"恢复\">恢复</span></td></tr><tr><td colspan=\"3\" style=\"padding-left: 7px;padding-right: 7px;padding-top: 3px;padding-bottom: 5px;\">自身体力低于300时必定先手；造成的伤害不少于300；给对手造成伤害时，伤害数值的50%恢复自身体力</td></tr> \n</tbody></table><br /><div style=\"display:none;\">\n<p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p>\n</div>\n<table style=\"width:100%;border: 1px solid;color: #ffffff;border-collapse: collapse;\">\n<tbody><tr>\n<td style=\"width: 31px;padding-left: 5px;padding-top: 5px;\"><img alt=\"属性.png\" src=\"https://patchwiki.biligame.com/images/seer/thumb/0/0f/bgoweya0wzruguug42a0gm4k98bxzpe.png/30px-%E5%B1%9E%E6%80%A7.png\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" srcset=\"https://patchwiki.biligame.com/images/seer/thumb/0/0f/bgoweya0wzruguug42a0gm4k98bxzpe.png/45px-%E5%B1%9E%E6%80%A7.png 1.5x, https://patchwiki.biligame.com/images/seer/thumb/0/0f/bgoweya0wzruguug42a0gm4k98bxzpe.png/60px-%E5%B1%9E%E6%80%A7.png 2x\" data-file-width=\"318\" data-file-height=\"318\" />\n</td>\n<td style=\"font-size: 19px;\"><div class=\"jnm1\"><a href=\"/seer/%E6%8A%80%E8%83%BD:29246\" title=\"技能:29246\">荒予咒缚</a>（追加）</div><div style=\"display:none;\">29246</div>\n</td>\n<td style=\"text-align: right;\">\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"padding-left: calc(7px + 2em);font-size: smaller;padding-bottom: 3px;padding-top: 3px;\">先制：0&#160;&#160;&#160;&#160;威力：0&#160;&#160;&#160;&#160;PP：5&#160;&#160;&#160;&#160;命中：必中（100%）&#160;&#160;&#160;&#160;暴击：--&#160;&#160;&#160;&#160;<span style=\"border-radius: 12px;padding: 1px 10px;background: #6ec435\">属性攻击</span><br />ID：29246&#160;&#160;&#160;&#160;效果ID：<a href=\"/seer/%E6%95%88%E6%9E%9C:2395\" title=\"效果:2395\">2395</a><span style=\"display:none;\">2395</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:1978\" title=\"效果:1978\">1978</a><span style=\"display:none;\">1978</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:2393\" title=\"效果:2393\">2393</a><span style=\"display:none;\">2393</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:2388\" title=\"效果:2388\">2388</a><span style=\"display:none;\">2388</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:843\" title=\"效果:843\">843</a><span style=\"display:none;\">843</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:2394\" title=\"效果:2394\">2394</a><span style=\"display:none;\">2394</span></td></tr><tr><td colspan=\"3\"><span class=\"jntag\" id=\"先制\">先制</span><span class=\"jntag\" id=\"增伤\">增伤</span><span class=\"jntag\" id=\"效果无效\">效果无效</span><span class=\"jntag\" id=\"施加异常\">施加异常</span><span class=\"jntag\" id=\"消强\">消强</span><span class=\"jntag\" id=\"附加伤害\">附加伤害</span></td></tr><tr><td colspan=\"3\" style=\"padding-left: 7px;padding-right: 7px;padding-top: 3px;padding-bottom: 5px;\">携带此技能时，每次<span class=\"smw-highlighter\" data-title=\"登场时\" style=\"border-bottom:1px solid;color:#FFEB3B;\">登场时<span class=\"smwttcontent\">双方均完成操作后，若本回合为精灵来到场上的第一个回合，则此精灵在双方的回合开始之前额外执行一个登场阶段，触发登场时效果；双方均可以执行登场阶段的场合，先进行操作的一方会优先执行登场阶段</span></span>移除自身专属特性中的“<span class=\"smw-highlighter\" data-title=\"回合开始时\" style=\"border-bottom:1px solid;color:#FFEB3B;\">回合开始时<span class=\"smwttcontent\">表示回合正式开始的时点，被挑战方优先结算</span></span>”，<span class=\"smw-highlighter\" data-title=\"之后\" style=\"border-bottom:1px solid;color:#FFEB3B;\">之后<span class=\"smwttcontent\">表示从某个时点起，直到某个时间点为止，某个效果/改变会持续存在；未提及结束时点时，默认持续至精灵下场为止</span></span>自身的符文锁链效果改为<span class=\"smw-highlighter\" data-title=\"符文咒印\" style=\"border-bottom:1px solid;color:#FFEB3B;\">符文咒印<span class=\"smwttcontent\">3回合内令对手属性技能无效且对手攻击结束后自身附加等同于当次攻击伤害的真实伤害，任意一项触发后则符文咒印消失</span></span>；消除对手能力提升状态，消除成功则100%令对手<span class=\"smw-highlighter\" data-title=\"疲惫\" style=\"border-bottom:1px solid;color:#FFEB3B;\">疲惫<span class=\"smwttcontent\">控制类异常状态，该状态下精灵无法行动</span></span>，<span class=\"smw-highlighter\" data-title=\"未触发\" style=\"border-bottom:1px solid;color:#FFEB3B;\">未触发<span class=\"smwttcontent\">前置行为的结果未能正确发生，包括不限于未通过概率判定、被免疫、被修改等</span></span>则附加自身最大体力1/3的<span class=\"smw-highlighter\" data-title=\"百分比伤害\" style=\"border-bottom:1px solid;color:#FFEB3B;\">百分比伤害<span class=\"smwttcontent\">以分数、百分数表示的一种伤害的类型</span></span>；3回合内，双方每处于1种属性<span class=\"smw-highlighter\" data-title=\"技能无效\" style=\"border-bottom:1px solid;color:#FFEB3B;\">技能无效<span class=\"smwttcontent\">无效的技能不会计为命中、取消技能原本的伤害值、无法触发命中效果</span></span>状态，自身造成的技能<span class=\"smw-highlighter\" data-title=\"伤害额外提升\" style=\"border-bottom:1px solid;color:#FFEB3B;\">伤害额外提升<span class=\"smwttcontent\">攻击伤害提升一定的数额，与不含“额外”的伤害提升、其他的“伤害额外提升”均以乘法叠加</span></span>50%；解除自身所处的异常状态并消耗自身当前体力的35%，本次技能附加自身最大体力值50%的远古系属性伤害；下1回合令自身所有<span class=\"smw-highlighter\" data-title=\"技能先制\" style=\"border-bottom:1px solid;color:#FFEB3B;\">技能先制<span class=\"smwttcontent\">战斗阶段开始时，若双方均选择了合法技能，则精灵的技能先制会转化为精灵先制</span></span>+3；<span class=\"smw-highlighter\" data-title=\"技能无效\" style=\"border-bottom:1px solid;color:#FFEB3B;\">技能无效<span class=\"smwttcontent\">无效的技能不会计为命中、取消技能原本的伤害值、无法触发命中效果</span></span>时，触发1次符文锁链</td></tr> \n</tbody></table><br /><div style=\"display:none;\">\n<p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p><p><br />\n</p>\n</div>\n<table style=\"width:100%;border: 1px solid;color: #ffffff;border-collapse: collapse;\">\n<tbody><tr>\n<td style=\"width: 31px;padding-left: 5px;padding-top: 5px;\"><a href=\"/seer/%E8%BF%9C%E5%8F%A4%E7%B3%BB%E7%B3%BB\" title=\"远古系系\"><img alt=\"远古系.png\" src=\"https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/30px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" srcset=\"https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/45px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png 1.5x, https://patchwiki.biligame.com/images/seer/thumb/2/20/3mlkayvar7cpgfgbcws2u4drzjet8b9.png/60px-%E8%BF%9C%E5%8F%A4%E7%B3%BB.png 2x\" data-file-width=\"318\" data-file-height=\"318\" /></a>\n</td>\n<td style=\"font-size: 19px;\"><div class=\"jnm1\"><a href=\"/seer/%E6%8A%80%E8%83%BD:32673\" title=\"技能:32673\">魔·暴虐无道</a>（第五）</div><div style=\"display:none;\">32673</div>\n</td>\n<td style=\"text-align: right;\">\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"padding-left: calc(7px + 2em);font-size: smaller;padding-bottom: 3px;padding-top: 3px;\">先制：0&#160;&#160;&#160;&#160;威力：160&#160;&#160;&#160;&#160;PP：5&#160;&#160;&#160;&#160;命中：必中（95%）&#160;&#160;&#160;&#160;暴击：6.25%（1/16）&#160;&#160;&#160;&#160;<span style=\"border-radius: 12px;padding: 1px 10px;background: #ff5c14\">物理攻击</span><br />ID：32673&#160;&#160;&#160;&#160;效果ID：<a href=\"/seer/%E6%95%88%E6%9E%9C:797\" title=\"效果:797\">797</a><span style=\"display:none;\">797</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:1167\" title=\"效果:1167\">1167</a><span style=\"display:none;\">1167</span>、<a href=\"/seer/%E6%95%88%E6%9E%9C:1393\" title=\"效果:1393\">1393</a><span style=\"display:none;\">1393</span></td></tr><tr><td colspan=\"3\"><span class=\"jntag\" id=\"恢复\">恢复</span><span class=\"jntag\" id=\"消除回合\">消除回合</span><span class=\"jntag\" id=\"解弱\">解弱</span><span class=\"jntag\" id=\"附加伤害\">附加伤害</span><span class=\"jntag\" id=\"降疗\">降疗</span></td></tr><tr><td colspan=\"3\" style=\"padding-left: 7px;padding-right: 7px;padding-top: 3px;padding-bottom: 5px;\">消除对手<span class=\"smw-highlighter\" data-title=\"回合类效果\" style=\"border-bottom:1px solid;color:#FFEB3B;\">回合类效果<span class=\"smwttcontent\">由技能效果附加的、以回合为计数的未命名效果；此类效果在后出手附加时，若当回合因此无法直接触发收益，则回合数+1</span></span>，消除成功2回合内对手<span class=\"smw-highlighter\" data-title=\"无法通过自身技能恢复体力\" style=\"border-bottom:1px solid;color:#FFEB3B;\">无法通过自身技能恢复体力<span class=\"smwttcontent\">自行动开始至行动结束，此期间所有体力恢复效果减少100%</span></span>；解除自身能力下降状态，解除成功则恢复自身所有体力；3回合内每回合使用技能则造成伤害前令对手防御-1、速度-1，<span class=\"smw-highlighter\" data-title=\"未触发\" style=\"border-bottom:1px solid;color:#FFEB3B;\">未触发<span class=\"smwttcontent\">前置行为的结果未能正确发生，包括不限于未通过概率判定、被免疫、被修改等</span></span>则附加对手最大体力1/3的<span class=\"smw-highlighter\" data-title=\"百分比伤害\" style=\"border-bottom:1px solid;color:#FFEB3B;\">百分比伤害<span class=\"smwttcontent\">以分数、百分数表示的一种伤害的类型</span></span></td></tr> \n</tbody></table></div>\n</div>\n<div class=\"resp-tab-content\">\n<div class=\"bili-title-h1\">\n<table class=\"qnzl_character_talent_table\" style=\"width:100%;text-align:center;overflow-x:auto;font-size: 16px;color: #ffffff;\">\n\n<tbody><tr>\n<th style=\"width:10%;text-align: center;\">技能名称\n</th>\n<th style=\"width:9%;text-align: center;\">属性\n</th>\n<th style=\"width:6%;text-align: center;\">技能类型\n</th>\n<th style=\"width:6%;text-align: center;\">学习等级\n</th>\n<th style=\"width:5%;text-align: center;\">次数\n</th>\n<th style=\"width:5%;text-align: center;\">威力\n<