d #ccc;padding:6px;text-align:center;font-weight:bold}\n.info-table td{background:#fff;border:1px solid #ccc;padding:6px}\n.info-table tr:last-child th,   /* 简介整行 */\n.info-table tr:last-child td{background:#f8f8f8;border:1px solid #ccc;padding:8px;text-align:left}\ntr a.mw-selflink.selflink{color:#ffffff}\nspan.mw-editsection{display:none}\ndiv#bread-edit sup a{color:#03a9f4;font-size:14px}\n.seer_jl_title{background:#2196f3;color:#fff;font-size:20px;clip-path:polygon(0 0,100% 0,100% 0,95% 100%,0 100%);width:18vh;margin-bottom:10px;text-align:center}\n.xingxiang111{display:block!important}\n></style>\n<script>\n/* ========== 展开/收起：RLQ 延迟加载 + 调试 ========== */\n(window.RLQ = window.RLQ || []).push(['jquery', () => {\n  const btns = document.querySelectorAll('[data-toggle=\"zhankai\"]');\n  console.log('[ZH] 发现按钮数量：', btns.length);\n\n  btns.forEach((btn, i) => {\n    const target = btn.dataset.target;\n    console.log('[ZH] 按钮', i, 'target =', target);\n\n    const tgt = target ? document.querySelector(target) : null;\n    console.log('[ZH] 目标元素：', tgt);\n\n    if (!tgt) {\n      console.warn('[ZH] 目标不存在，跳过按钮', i);\n      return;\n    }\n\n    // 默认收起\n    tgt.style.display = 'none';\n    btn.textContent = btn.dataset.textoff || '展开';\n\n    // 绑定点击\n    btn.addEventListener('click', function () {\n      const isHide = tgt.style.display === 'none';\n      tgt.style.display = isHide ? '' : 'none';\n      this.textContent = isHide ?\n        (this.dataset.texton || '收起') :\n        (this.dataset.textoff || '展开');\n      console.log('[ZH] 已切换显示状态 →', !isHide);\n    });\n  });\n}]);\n</script>\n<style type=\"text/css\"> \n.zzval-box{display:grid;grid-template-columns:repeat(auto-fill,minmax(19vh,1fr));gap:2px;margin-bottom:0px;margin-top: 5px;}\n.attval{background:linear-gradient(135deg,rgba(30,30,60,0.7),rgba(25,25,50,0.7));border:1px solid rgba(80,80,160,0.3);border-radius:12px;padding:15px;transition:all 0.3s ease;position:relative;overflow:hidden}\n.nlz-val{color:#FF