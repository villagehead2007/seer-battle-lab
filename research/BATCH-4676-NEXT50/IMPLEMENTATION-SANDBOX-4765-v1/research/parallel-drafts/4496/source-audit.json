  "branchMapping": [
    {
      "branch": "哀霆之声",
      "original": "每次自身受到≥300的攻击伤害则会触发哀霆之声：免疫下1次受到的固定伤害、百分比伤害且附加对手最大体力1/3的百分比伤害；",
      "implementation": "完整结算红伤当回合累计>=300，每回合一次，免下一次固粉并附对方maxHP/3百分比；HP0不触。"
    },
    {
      "branch": "悲龙之鸣",
      "original": "每次自身受到≥300的固定伤害、百分比伤害则会触发悲龙之鸣：免疫下1次受到的攻击伤害且恢复自身最大体力的1/3；",
      "implementation": "每次完整固粉伤>=300保持原阈值和魂印回复；获得独立xiaoAttackImmunity整回合红伤免疫次数，不更改其他来源attackNullify。"
    },
    {
      "branch": "战阶",
      "original": "战斗阶段结束时，若当回合自身均未受到攻击伤害、固定伤害、百分比伤害，则消除对手回合类效果和能力提升状态，消除任意一项成功则随机附加麻痹或害怕中的1种异常状态",
      "implementation": "保留当回合红/固/粉正完整伤均未受到的三类判据及两清除不短路、任一成功一次限定异常。"
    }
  ],
