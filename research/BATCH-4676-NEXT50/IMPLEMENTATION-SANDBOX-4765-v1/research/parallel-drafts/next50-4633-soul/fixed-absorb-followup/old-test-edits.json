    "file": "tests/next50-4618-soul.test.cjs",
    "old": "test('1824自然未知伤害类型不提前回复，保留真实窥目与明确pending',()=>{const s=make({hp:5000});delete s.fighters[0].soulState.qualifiedGaze1824;let seen;const old=E.SOULS;E.SOULS={...old,run(e,c){try{return old.run(e,c);}catch(err){if(c.a.soulId===1824)seen={hp:c.a.hp,mark:gaze(c.t),pending:c.a.soulState.gazePending1824};throw err;}}};try{assert.throws(()=>E.resolveTurn(s,[key(neutral),key(stat)]),/Q-BATCH-004/);assert.equal(seen.hp,5000);assert.equal(seen.mark,true);assert.equal(seen.pending.at(-1).healExecuted,false);}finally{E.SOULS=old;}});",
    "replacement": "test('1824真实补源自然固定300吸取且理论回复300，不再需要伤害类型研究输入',()=>{const s=make({hp:5000,enemyType:'普通'});delete s.fighters[0].soulState.qualifiedGaze1824;const o=E.resolveTurn(s,[key(neutral),key(stat)]);assert.equal(gaze(o.fighters[1]),true);assert.equal(dmg(o,'fixed',1),300);assert.equal(o.fighters[0].hp,5300);assert.equal(o.fighters[1].hp,9000-dmg(o,'attack',1)-300);});"
  },
