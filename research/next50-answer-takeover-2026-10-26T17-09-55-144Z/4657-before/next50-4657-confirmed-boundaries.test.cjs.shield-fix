'use strict';const test=require('node:test'),assert=require('node:assert/strict'),H=require('./helpers/4657-soul-battle.cjs'),K=require('./helpers/4657-battle.cjs'),shield=require('../dist/shield-rules.js');
test('4657原生2424暖雪最后于回合反弹次数及概率抗性，之前免疫不扣暖雪',()=>{for(const kind of['round','count','resistance']){let resisted=false,failed=false;for(let seed=0;seed<(kind==='resistance'?150:1);seed++){const s=H.make();s.rng=Math.imul(seed+1,2654435761)>>>0;s.fighters[0].soulState.warmSnow1859={sourceHash:'2255679f',amount:40};if(kind==='round')H.timer(s,0,'reflect');if(kind==='count')s.fighters[0].counts.immune=1;if(kind==='resistance')s.fighters[0].build.resistance.major='冰封';H.turn(s,20177,20177,(name,c)=>{if(name==='afterUse'&&c.a.side===1)c.ailment(c.t,'冰封',c.a,false,false,2);});const a=s.fighters[0];assert.equal(a.ailments['冰封'],undefined);if(kind==='round'){assert.equal(a.soulState.warmSnow1859.amount,40);assert.ok(s.fighters[1].ailments['冰封']);}else if(kind==='count'){assert.equal(a.counts.immune,0);assert.equal(a.soulState.warmSnow1859.amount,40);}else if(a.resistUntil>=1){resisted=true;assert.equal(a.soulState.warmSnow1859.amount,40);}else{failed=true;assert.equal(a.soulState.warmSnow1859.amount,0);}if(resisted&&failed)break;}if(kind==='resistance')assert.ok(resisted&&failed);}});
test('1859原生2190概率回合初加减后截断，双携带不提前截断',()=>{for(const sun of[false,true])for(const moon of[false,true])for(const partner of[false,true]){const s=H.make();s.fighters[0].soulState.bladeCarries1859={sun,moon,partner};H.turn(s,20177,20177,(name,c)=>{if(name==='roundStart'&&c.a.side===0)c.a.soulState.bladeCarries1859={};});const f=s.fighters[0].soulState.bladeProbabilityFrame1859,clamp=n=>Math.max(0,Math.min(1,n));assert.equal(f.fire,clamp(.5+.5*Number(partner)+.5*Number(sun)-.5*Number(moon)));assert.equal(f.ice,clamp(.5+.5*Number(partner)+.5*Number(moon)-.5*Number(sun)));assert.equal(f.round,1);}});
test('4657原生1661刷新不触发，异源盾仍在时本源耗尽正确烧伤',()=>{const e=K.pick(1661)[0],s=K.make(e);shield.add(s.fighters[0],1000,'foreign');K.turn(s);assert.equal(s.fighters[0].suitState.shield,1300);K.turn(s);assert.equal(s.fighters[0].suitState.shield,1300);assert.equal(s.fighters[1].ailments['烧伤'],undefined);const old=K.E.SOULS;K.E.SOULS={...old,run(name,c){old.run(name,c);if(name==='afterUse'&&c.a.side===1)c.hurt(c.t,300,'本源盾耗尽','attack');}};try{K.turn(s,20177);}finally{K.E.SOULS=old;}assert.equal(s.fighters[0].suitState.shield,1000);assert.ok(s.fighters[1].ailments['烧伤']>=3);assert.equal(s.fighters[0].soulState.sourceShieldReactions['4657/e8739ed/1661/2'],undefined);});
