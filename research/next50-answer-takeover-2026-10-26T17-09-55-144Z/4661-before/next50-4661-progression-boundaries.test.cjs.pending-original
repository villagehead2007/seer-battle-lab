'use strict';
const test=require('node:test'),assert=require('node:assert/strict'),{E,source,key,keys,make,turn,timer,ops}=require('./helpers/4661-battle.cjs');
const sum=(s,type,side=1)=>(s.damageEvents??[]).filter(e=>e.targetSide===side&&e.type===type).reduce((n,e)=>n+e.settledDamage,0);

test('4661真实原第五PP0普通目标必命中执行六原效果并取消首条件，实际红伤百分和PP保留原源',()=>{const s=make({moveId:37460,index:null},{soul:true,full:true,bStats:{def:9999},enemyLoadout:[28778,28776,37451,28777,37460]});s.fighters[0].hp=1000;turn(s,37460,28778);assert.ok(sum(s,'attack')>0);assert.equal(sum(s,'percent'),3000);assert.equal(s.fighters[0].hp,4000);assert.equal(s.fighters[0].pp[key(37460)],0);assert.equal(s.fighters[1].pp[key(28776)],39);assert.equal(s.fighters[1].pp[key(28778)],8);assert.equal(s.fighters[1].ailments['臣服'],undefined);assert.deepEqual(s.fighters[0].soulState.wuwei1862.cancelled,[0]);assert.equal(s.fighters[0].soulState.wuwei1862.power,50);assert.equal(source.moves.find(m=>m.id===37460).accuracy,0);assert.equal(source.moves.find(m=>m.id===37460).alwaysHit,false);});

test('4661真实零PP六次独立用招逐轮取消第五原index并累计300，耗尽自然002与明确继续或停止真实差异',()=>{const s=make({moveId:37460,index:null},{soul:true,bStats:{def:9999}});s.fighters[1].build.resistance.percent=100;for(let i=0;i<6;i++){const before=s.fighters[1].hp;turn(s,37460,28776);assert.deepEqual(s.fighters[0].soulState.wuwei1862.cancelled,Array.from({length:i+1},(_,j)=>j));assert.equal(s.fighters[0].soulState.wuwei1862.power,50*(i+1));assert.equal(s.fighters[0].pp[key(37460)],0);assert.equal(s.fighters[0].soulState.skillUses[key(37460)],i+1);assert.ok(s.fighters[1].hp<before);}s.fighters[0].pp[key(37450)]=0;let w;assert.throws(()=>turn(s,37450,28776),e=>{assert.match(e.message,/4661-002/);w=e.wuweiExhausted1862;return true;});assert.equal(w.power,300);assert.deepEqual(w.cancelled,[0,1,2,3,4,5]);assert.equal(w.actorPP[key(37450)],40);assert.ok(w.targetHP<s.fighters[1].hp);for(const p of['increase50','stop']){const q=structuredClone(s);q.fighters[0].soulState.qualifiedExhausted1862=p;turn(q,37450,28776);assert.equal(q.fighters[0].soulState.wuwei1862.power,p==='increase50'?350:300);assert.deepEqual(q.fighters[0].soulState.wuwei1862.cancelled,[0,1,2,3,4,5]);assert.equal(q.fighters[0].soulState.skillUses[key(37450)],1);assert.equal(q.fighters[0].pp[key(37450)],40);}});

test('4661真实正PP直接红伤KO自然重置万相且当前阵亡敌消逝，PP反转仍实际40到0不误进阶',()=>{const s=make({moveId:37450,index:-1},{soul:true,targetHp:1});s.fighters[0].soulState.wuwei1862.cancelled=[0,1];s.fighters[0].soulState.wuwei1862.power=100;turn(s,37450,28776);assert.equal(s.fighters[1].hp,0);assert.equal(s.fighters[1].soulState.vanished,true);assert.ok(sum(s,'attack')>1);assert.equal(s.fighters[0].pp[key(37450)],0);assert.deepEqual(s.fighters[0].soulState.wuwei1862.cancelled,[]);assert.equal(s.fighters[0].soulState.wuwei1862.power,0);assert.equal(s.fighters[1].pp[key(28776)],40);assert.equal(s.fighters[0].soulState.skillUses[key(37450)],1);});

test('4661真实PP0已用整招失效自然003范围保护，明确use-end命中载荷只执行原626不伪造红伤',()=>{const s=make({moveId:37453,index:0},{soul:true});s.fighters[0].pp[key(37453)]=0;s.fighters[0].counts.nextSkillInvalid=1;let w;assert.throws(()=>turn(s),e=>{assert.match(e.message,/4604-003/);w=e.wuweiForced1862;return true;});assert.equal(w.zeroSnapshot,0);assert.equal(w.invalid,true);assert.equal(w.pp,0);assert.equal(w.targetHP,9000);const q=make({moveId:37453,index:0},{soul:true,policies:{qualifiedForced1862:'effects-only-at-use-end'}});q.fighters[0].pp[key(37453)]=0;q.fighters[0].counts.nextSkillInvalid=1;turn(q);assert.equal(sum(q,'attack'),0);assert.equal(keys.filter(k=>q.fighters[0].stages[k]===1).length,3);assert.equal(q.fighters[0].pp[key(37453)],10);assert.equal(q.fighters[0].soulState.skillUses[key(37453)],1);assert.deepEqual(q.fighters[0].soulState.wuwei1862.cancelled,[0]);assert.equal(q.fighters[0].soulState.wuwei1862.power,50);});

test('4661真实PP0命中免攻仍降敌最大HP50且不重复强制触发命中载荷',()=>{for(const policy of[undefined,'effects-only-at-use-end']){const q=make({moveId:37456,index:0},{soul:true,policies:policy?{qualifiedForced1862:policy}:{}});q.fighters[0].pp[key(37456)]=0;timer(q,1,'攻击伤害免疫');turn(q);assert.equal(sum(q,'attack'),0);assert.equal(q.fighters[1].stats.maxHp,8950);assert.equal(q.fighters[1].hp,8950);assert.equal(q.fighters[0].pp[key(37456)],10);assert.equal(q.fighters[0].soulState.wuwei1862.power,50);}});

test('4661真实1862遇敌原1463先手死亡全回时007准确保护实际HP9000与已KO重置，不把代码顺序当自然答案',()=>{const s=make({moveId:37450,index:-1},{soul:true,enemyLoadout:[37457,28776,37451,28777,37460],bStats:{spe:9999,def:1},targetHp:100});s.moveDefinitions[key(37457)].operations=ops(source.moves.find(m=>m.id===37457),0);s.fighters[0].soulState.wuwei1862.cancelled=[0,1];s.fighters[0].soulState.wuwei1862.power=100;let w;assert.throws(()=>turn(s,37450,37457),e=>{assert.match(e.message,/4604-007/);w=e.wuweiVanish1862;return true;});assert.equal(w.targetHP,9000);assert.equal(w.targetPP[key(37457)],9);assert.equal(w.actorPP[key(37450)],40);assert.deepEqual(w.reset.cancelled,[]);assert.equal(w.reset.power,0);assert.equal(w.vanished,false);assert.ok(w.actorHP<s.fighters[0].hp);assert.equal(s.fighters[1].hp,100);});
