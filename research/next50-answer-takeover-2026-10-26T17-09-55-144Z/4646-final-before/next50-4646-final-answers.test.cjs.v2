'use strict';const test=require('node:test'),assert=require('node:assert/strict'),H=require('./helpers/4646-battle.cjs'),{E,source,key,make,turn,timed,dmg}=H;
test('4646原生1008同源盾刷新300，异源100盾独立保留且合计400',()=>{const s=make(37372,0,{aStats:{atk:1200}});s.fighters[0].suitState.shield=100;turn(s);assert.ok(dmg(s)>300);assert.equal(s.fighters[0].suitState.shield,400);turn(s);assert.ok(dmg(s)>300);assert.equal(s.fighters[0].suitState.shield,400);});
test('4646原生1775未消费重授刷新一次，2182同源重复授予仍为一次',()=>{const s=make(37373,1);s.fighters[1].ailments['害怕']=3;turn(s);turn(s);assert.equal(s.fighters[1].counts.nextUsedSkillPPZero,1);assert.equal(s.fighters[1].pp[key(20030)],35);const x=make(37373,2),rawRun=E.WIKI.effectsEngine.run;turn(x,37373,null,{afterEffect(phase,c){if(phase==='afterHit'&&c.a.side===0){const op=c.m.operations.find(x=>x.effectId===2182);rawRun('afterHit',[op],c);assert.equal(c.a.soulState.clockPowerPP2182.count,1);}}});assert.equal(x.fighters[0].soulState.clockPowerPP2182.count,1);turn(x,12897);assert.equal(x.fighters[0].soulState.clockPowerPP2182,undefined);assert.equal(x.fighters[0].pp[key(12897)],0);});
test('4646原生998纯反转不触发属性封锁，正等级确实变负',()=>{const s=make(28731,3);s.fighters[0].stages.atk=2;turn(s);turn(s,12897,null,{afterEffect(phase,c){if(phase==='afterHit'&&c.a.side===0)c.rewriteStageValues(c.a,{...c.a.stages,atk:-2},'reverse');}});assert.equal(s.fighters[0].stages.atk,-2);assert.equal(s.fighters[1].effects['属性技能命中效果失效'],undefined);});
