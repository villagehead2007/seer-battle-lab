test('4608 741与972实际阈值免疫重叠只006，未超阈值正常消费972和无次数单741同判',()=>{let s=turn(make(e(741)));s.fighters[0].counts.attackNullify=1;s.fighters[0].soulState.saffron972=true;s.moveDefinitions[key(920040)].power=900;assert.throws(()=>turn(s,920031,920040),/4511-006/);const q=structuredClone(s);timer(q,0,'攻击伤害上限',{amount:200});const o=turn(q,920031,920040);assert.equal(sum(o,'attack',0),0);assert.equal(o.fighters[0].counts.attackNullify,0);});
test('4608 191四轮真实免异反弹、敌免异失败不加自身异常，第5轮到期正常异常',()=>{let s=turn(make(e(191)));for(let r=2;r<=5;r++){s=qualified(s,c=>c.ailment(c.a,'麻痹',c.t));assert.equal(!!s.fighters[0].ailments['麻痹'],r>4);if(r<=4)assert.ok(s.fighters[1].ailments['麻痹']);delete s.fighters[1].ailments['麻痹'];}let q=turn(make(e(191)));timer(q,1,'免异常');q=qualified(q,c=>c.ailment(c.a,'中毒',c.t));assert.equal(q.fighters[0].ailments['中毒'],undefined);assert.equal(q.fighters[1].ailments['中毒'],undefined);});
test('4608 191同源刷新4回合，1204剩1重授刷新2且不累加',()=>{let s=turn(make(e(191)));assert.equal(s.fighters[0].effects.reflect.end,4);s=turn(s);assert.equal(s.fighters[0].effects.reflect.end,5);assert.equal(s.fighters[0].effects.reflect.start,2);let q=turn(make(e(1204),{criticals:true}));q=turn(q,920030);assert.equal(q.fighters[0].counts.nextCrit,1);q=turn(q);assert.equal(q.fighters[0].counts.nextCrit,2);q=turn(q);assert.equal(q.fighters[0].counts.nextCrit,2);q=turn(q,920031);assert.equal(q.fighters[0].counts.nextCrit,2);for(let n=1;n>=0;n--){q=turn(q,920030);assert.equal(q.fighters[0].counts.nextCrit,n);assert.ok(q.turns.at(-1).events.some(v=>v.text.includes('致命一击')));}});
test('4608 191反弹优先于次数免异且不消费，972保留异源次数并后得先消耗',()=>{let s=turn(make(e(191)));s.fighters[0].counts.immune=1;s=qualified(s,c=>assert.equal(c.ailment(c.a,'中毒',c.t),false));assert.equal(s.fighters[0].counts.immune,1);assert.equal(s.fighters[0].ailments['中毒'],undefined);assert.ok(s.fighters[1].ailments['中毒']);let q=make(e(972),{hp:1000});q.fighters[0].counts.attackNullify=2;q=turn(q);assert.equal(q.fighters[0].counts.attackNullify,3);q=turn(q,920031,920040);assert.equal(sum(q,'attack',0),0);assert.equal(q.fighters[0].counts.attackNullify,2);assert.equal(q.fighters[0].soulState.saffron972,undefined);q=turn(q,920031,920040);assert.equal(q.fighters[0].counts.attackNullify,1);q=turn(q,920031,920040);assert.equal(q.fighters[0].counts.attackNullify,0);});
test('4608 1327红伤先击败后仍恢复理论1/3并授理论盾，不按敌剩余HP归零',()=>{const s=make(e(1327),{hp:1000,targetHp:1});let audit;const o=qualified(s,c=>{c.hurt(c.t,1,'明确本次红伤先击败','attack');const z=cm(c,s);z.dealt=1;z.settledDamage=1;reg(1327).execute(z,{threshold:300,denominator:3});audit={hp:c.a.hp,targetHp:c.t.hp};});assert.equal(audit.hp,4000);assert.equal(audit.targetHp,0);assert.equal(o.fighters[0].suitState.shield,3000);});
test('4608普通盾真实挡447的240并耗240，护罩与无447基础红伤同类别对照不造新问题',()=>{const s=make(e(447),{aStats:{atk:1}});s.fighters[1].suitState.shield=9000;const o=turn(s);assert.equal(sum(o),0);assert.equal(o.fighters[1].suitState.shield,8760);assert.equal(o.fighters[1].hp,9000);for(const omit of [false,true]){const q=make(e(447),{omit,aStats:{atk:1}});q.fighters[1].suitState.barrier=9000;const z=turn(q);assert.equal(sum(z),omit?2:240);assert.equal(z.fighters[1].suitState.barrier,9000);assert.equal(z.fighters[1].hp,omit?8998:8760);}});
test('4608真实1813新增200上限后839以实际9200计算2300理论回复，粉免与低敌HP仍同量',()=>{for(const mode of ['normal','immune','low']){const s=make(e(839),{soul:1813,hp:1000,targetHp:mode==='low'?1:9000});if(mode==='immune')timer(s,1,'固定百分比免疫');const o=turn(s);assert.equal(o.fighters[0].stats.maxHp,9200);assert.equal(o.fighters[0].hp,3300);assert.equal(sum(o,'percent'),mode==='normal'?2300:0);}});
test('4608真实1813敌高HP动态保护485清强与1127吸强，红伤使其跌到自身下方立即解除保护',()=>{for(const id of [485,1127])for(const mode of ['protected','low','cross']){const s=make(e(id),{enemySoul:H.source.souls.find(x=>x.id===1813),hp:mode==='low'?8000:mode==='cross'?500:1000,targetHp:mode==='low'?5000:mode==='cross'?600:8000,aStats:{atk:mode==='cross'?1200:180}});s.fighters[1].stages.atk=2;const o=turn(s);assert.equal(o.fighters[1].stats.maxHp,9200);assert.equal(o.fighters[1].stages.atk,mode==='protected'?2:0);if(id===1127){assert.equal(o.fighters[0].stages.atk,mode==='protected'?0:2);assert.equal(o.fighters[1].stages.def,0);}else assert.equal(o.fighters[0].hp,mode==='protected'?1000:9000);}});
test('4608真实1813与1497双方普通盾总和回复，新增最大HP只约束cap且不把护罩算盾',()=>{const s=make(e(1497),{soul:1813,hp:9000});const o=qualified(s,c=>{c.addShield(c.a,300);c.addShield(c.t,400);c.t.suitState.barrier=9000;reg(1497).execute(cm(c,s),[]);});assert.equal(o.fighters[0].stats.maxHp,9200);assert.equal(o.fighters[0].hp,9200);assert.equal(o.fighters[0].suitState.shield,300);assert.equal(o.fighters[1].suitState.shield,400);assert.equal(o.fighters[1].suitState.barrier,9000);});

test('4608 972同来源重复授予刷新1次，保留旧来源2次且真实攻击消耗一次',()=>{let s=make(e(972),{hp:1000});s.fighters[0].counts.attackNullify=2;s=turn(s);s=turn(s);assert.equal(s.fighters[0].counts.attackNullify,3);assert.equal(s.fighters[0].soulState.attackNullifySources.filter(x=>x.kind==='972').length,1);assert.equal(s.fighters[0].soulState.attackNullifySources.find(x=>x.kind==='972').count,1);s=turn(s,920031,920040);assert.equal(sum(s,'attack',0),0);assert.equal(s.fighters[0].counts.attackNullify,2);});

test('4608 1204同源刷新保留其他来源次数，控制未用不消耗',()=>{let s=make(e(1204),{criticals:true});s.fighters[0].counts.nextCrit=1;s=turn(s);assert.equal(s.fighters[0].counts.nextCrit,3);s=turn(s,920030);assert.equal(s.fighters[0].counts.nextCrit,2);s=turn(s);assert.equal(s.fighters[0].counts.nextCrit,3);s.fighters[0].ailments['疲惫']=s.round;s=turn(s,920030);assert.equal(s.fighters[0].counts.nextCrit,3);});