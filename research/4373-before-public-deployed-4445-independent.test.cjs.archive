'use strict';const test=require('node:test'),assert=require('node:assert/strict'),H=require('./helpers/4445-battle.cjs'),{make,pick,turn,timer,key,E}=H;const base={moveId:10003,index:null},sum=(s,type='attack',side=1)=>(s.damageEvents??[]).filter(e=>e.round===s.round-1&&e.targetSide===side&&e.type===type).reduce((n,e)=>n+e.settledDamage,0);
test('4445全17技能真实基础物特伤害PP命中与控制失败，原1660/hash和唯一第五36262保留',()=>{assert.equal(H.source.souls[0].hash,'9c0ed9b6');assert.equal(H.source.moves.length,17);for(const m of H.source.moves){const s=make({moveId:m.id,index:null},{omit:true}),o=turn(s);assert.equal(o.fighters[0].pp[key(m.id)],m.pp-1);assert.equal(sum(o)>0,m.kind!=='status'&&m.power>0);s.fighters[0].ailments['疲惫']=3;assert.equal(turn(s).fighters[0].pp[key(m.id)],m.pp);H.independentOperations(m);}});
test('4445魂印回合初中毒成功不回HP，战阶有毒寄生；毒免失败解除自身控制并360回复且非技能来源',()=>{let s=make(base,{soul:1660,omit:true,hp:1000});let o=turn(s,920031);assert.ok(o.fighters[1].ailments['中毒']);assert.ok(o.fighters[1].ailments['寄生']);assert.equal(o.fighters[0].hp,2125);s=make(base,{soul:1660,omit:true,hp:1000});timer(s,1,'免异常');timer(s,0,'技能禁疗');s.fighters[0].ailments['疲惫']=3;o=turn(s,920031);assert.equal(o.fighters[0].ailments['疲惫'],undefined);assert.equal(o.fighters[0].hp,1360);assert.equal(o.fighters[1].ailments['中毒'],undefined);});
test('4445战阶对手不再中毒清其回合与保护失败，解毒前后条件真实即时检查',()=>{for(const protect of [false,true]){const s=make(base,{soul:1660,omit:true});timer(s,1,'免异常');timer(s,1,'测试回合');if(protect)timer(s,1,'protect');const o=turn(s,920031);assert.equal(!!o.fighters[1].effects['测试回合'],protect);}const s=make(base,{soul:1660,omit:true});H.op(s,544,[],920042);const o=turn(s,920031,920042);assert.equal(o.fighters[1].ailments['中毒'],undefined);assert.equal(o.fighters[1].ailments['寄生'],undefined);});
test('4445 5两真实实例攻击特攻各减1，免弱保护失败且不影响自己；57五回技能回复与禁疗到期',()=>{let s=make(pick(5)[0]),o=turn(s);assert.equal(o.fighters[1].stages.atk,-1);s=make(pick(5)[1]);assert.equal(turn(s).fighters[1].stages.spa,-1);timer(s,1,'免弱');assert.equal(turn(s).fighters[1].stages.spa,0);s=make(pick(57)[0],{hp:1000});o=turn(s);assert.equal(o.fighters[0].hp,2500);assert.equal(o.fighters[0].effects.id57.end,5);timer(s,0,'技能禁疗');assert.equal(turn(s).fighters[0].hp,1000);});
test('4445 1292严格当前体力低于对手才先制2，相等不加，1777清后感染与保护和感染免疫',()=>{for(const [hp,want]of [[8999,0],[9000,1]]){const s=make(pick(1292)[0],{hp,aStats:{spe:1}});s.moveDefinitions[key(920041)].priority=2;const o=turn(s);assert.equal(o.turns[0].first,want);}for(const protect of [false,true]){const s=make(pick(1777)[0]);timer(s,1,'测试回合');if(protect)timer(s,1,'protect');const o=turn(s);assert.equal(!!o.fighters[1].effects['测试回合'],protect);assert.equal(!!o.fighters[1].ailments['感染'],!protect);}const s=make(pick(1777)[0]);s.fighters[1].counts.immune=1;assert.equal(turn(s).fighters[1].ailments['感染'],undefined);});
test('4445 48免异常5回合、10两个麻痹概率实例免疫与失败成功，544只清烧冻毒保留其他',()=>{let s=make(pick(48)[0]),o=turn(s);assert.equal(o.fighters[0].effects['免异常'].end,5);for(const e of pick(10)){const results=new Set();for(let seed=0;seed<100;seed++)results.add(!!turn(make(e,{seed})).fighters[1].ailments['麻痹']);assert.ok(results.has(true));if(e.params[0]<100)assert.ok(results.has(false));s=make(e);timer(s,1,'免异常');assert.equal(turn(s).fighters[1].ailments['麻痹'],undefined);}s=make(pick(544)[0]);for(const n of ['烧伤','冻伤','中毒','狂暴'])s.fighters[0].ailments[n]=3;o=turn(s);for(const n of ['烧伤','冻伤','中毒'])assert.equal(o.fighters[0].ailments[n],undefined);assert.ok(o.fighters[0].ailments['狂暴']);});
test('4445 986先手与1357后手额外60%只对应顺序、纯攻不影响固定，1103敌正级加60%',()=>{for(const id of [986,1357,1103]){const s=make(pick(id)[0],{aStats:{spe:id===1357?1:500}}),b=structuredClone(s);b.moveDefinitions[key(s.auditMoveId)].operations=[];if(id===1103){s.fighters[1].stages.atk=1;b.fighters[1].stages.atk=1;}assert.ok(Math.abs(sum(turn(s))-sum(turn(b))*1.6)<3);const q=make(pick(id)[0],{aStats:{spe:id===1357?500:1}}),z=structuredClone(q);z.moveDefinitions[key(q.auditMoveId)].operations=[];assert.equal(sum(turn(q)),sum(turn(z)));}});
test('4445 1387独立240护盾破裂240固定反击且免固定、1422单源240护罩耗尽240技能回复与禁疗',()=>{for(const immune of [false,true]){let s=turn(make(pick(1387)[0]));timer(s,1,'攻击最低伤害',{amount:300});if(immune)timer(s,1,'固定百分比免疫');const o=turn(s,920031,920040);assert.equal(sum(o,'fixed'),immune?0:240);}for(const ban of [false,true]){let s=turn(make(pick(1422)[0],{hp:1000}));assert.equal(s.fighters[0].suitState.barrier,240);H.op(s,29,[240],920040);if(ban)timer(s,0,'技能禁疗');const o=turn(s,920031,920040);assert.equal(o.fighters[0].suitState.barrier,0);assert.equal(o.fighters[0].hp,ban?1000-sum(o,'attack',0):1240-sum(o,'attack',0));}let s=turn(make(pick(1422)[0]));const o=turn(s);assert.equal(o.fighters[0].suitState.barrier,240);assert.equal(o.fighters[0].soulState.pendingBarrierRegrant.question,'Q-N20-4373-002');});
test('4445 1814四回用招中毒失败理论最大HP吸取2250免疫仍回，成功无吸取与禁疗',()=>{for(const immune of [false,true]){const s=make(pick(1814)[0],{hp:1000});if(immune)timer(s,1,'免异常');const o=turn(s);assert.equal(!!o.fighters[1].ailments['中毒'],!immune);assert.equal(sum(o,'percent'),immune?2250:1125);assert.equal(o.fighters[0].hp,immune?3250:1000);}const s=make(pick(1814)[0],{hp:1000});timer(s,1,'免异常');timer(s,1,'固定百分比免疫');assert.equal(turn(s).fighters[0].hp,3250);timer(s,0,'技能禁疗');assert.equal(turn(s).fighters[0].hp,1000);});
test('4445 1144随机固定60至360含边界并按结算等量回复，固定免疫0/禁疗与低HP完整值分离',()=>{let lo=Infinity,hi=-Infinity;for(let seed=0;seed<1500;seed++){const s=make(pick(1144)[0],{hp:1000,seed}),o=turn(s),n=sum(o,'fixed');lo=Math.min(lo,n);hi=Math.max(hi,n);assert.ok(n>=60&&n<=360);assert.equal(o.fighters[0].hp,1000+n);}assert.equal(lo,60);assert.equal(hi,360);const s=make(pick(1144)[0],{hp:1000});timer(s,1,'固定百分比免疫');assert.equal(turn(s).fighters[0].hp,1000);const a=make(pick(1144)[0],{hp:1000});timer(a,0,'技能禁疗');assert.equal(turn(a).fighters[0].hp,1000);});
test('4445 585防特攻特防命中2与禁强，191免反异常，791自己低于对手时回血翻倍且禁疗',()=>{const o=turn(make(pick(585)[0]));for(const k of ['def','spa','spd','acc'])assert.equal(o.fighters[0].stages[k],2);const q=make(pick(585)[0]);timer(q,0,'禁强化');assert.equal(turn(q).fighters[0].stages.def,0);let s=turn(make(pick(191)[0]));H.op(s,10,[100],920042);assert.ok(turn(s,920031,920042).fighters[1].ailments['麻痹']);for(const hp of [1000,8999]){const a=make(pick(791)[0],{hp});assert.equal(turn(a).fighters[0].hp,Math.min(9000,hp+4500));timer(a,0,'技能禁疗');assert.equal(turn(a).fighters[0].hp,hp);}});
test('4445 963有正级才理论吸取四分一敌最大HP，免疫不减回复；1767虚拟敌正防不修改真实等级',()=>{for(const positive of [false,true]){const s=make(pick(963)[0],{hp:1000});if(positive)s.fighters[0].stages.acc=1;timer(s,1,'固定百分比免疫');const o=turn(s);assert.equal(o.fighters[0].hp,positive?3250:1000);}const s=make(pick(1767)[0]),b=structuredClone(s);s.fighters[1].stages.def=2;b.fighters[1].stages.def=-2;assert.equal(sum(turn(s)),sum(turn(b)));assert.equal(turn(s).fighters[1].stages.def,2);});
test('4445第五1056反转负成功封属失败不封、863后手下轮封攻、1785自身理论吸取独立完成队友回复延期',()=>{for(const neg of [false,true]){const s=make(pick(1056)[0]);if(neg)s.fighters[0].stages.atk=-2;const o=turn(s);assert.equal(o.fighters[0].stages.atk,neg?2:0);assert.equal(o.turns[0].events.some(e=>e.text.includes('技能被封锁')),neg);}let s=turn(make(pick(863)[0],{aStats:{spe:1}}));assert.equal(s.fighters[1].effects.attackBlock.start,2);assert.equal(sum(turn(s,920031,920040),'attack',0),0);s=make(pick(1785)[0],{hp:1000});timer(s,1,'固定百分比免疫');assert.equal(turn(s).fighters[0].hp,3250);assert.match(E.WIKI.effectsEngine.registry[1785].deferred,/不在场/);});
test('4445全部独立效果实例控制未使用无PP消费及敌HP变化，完整第五按原顺序状态执行',()=>{for(const e of H.entries){const s=make(e);s.fighters[0].ailments['疲惫']=3;const p=s.fighters[0].pp[key(e.moveId)],o=turn(s);assert.equal(o.fighters[0].pp[key(e.moveId)],p);assert.equal(o.fighters[1].hp,9000);}const s=make({moveId:36262,index:null},{hp:1000});s.fighters[0].stages.atk=-2;const o=turn(s);assert.equal(o.fighters[0].stages.atk,2);assert.ok(o.fighters[0].hp>1000);});

test('4445源绑定新感染与中毒枚举仅真实hash/索引/参数，失明MISS与护罩已有存量保持原状待确认',()=>{for(const id of [1777,1814]){const e=pick(id)[0],m=structuredClone(H.source.moves.find(m=>m.id===e.moveId)),r=E.WIKI.effectsEngine.registry[id];r.validate(e.params,m,e.index);assert.throws(()=>r.validate(e.params,{...m,hash:'bad-source'},e.index));assert.throws(()=>r.validate(e.params,m,e.index+1));}const s=make(pick(1422)[0]);s.fighters[0].suitState.barrier=50;const o=turn(s);assert.equal(o.fighters[0].suitState.barrier,50);assert.ok(o.fighters[0].soulState.pendingBarrierRegrant);const q=make(pick(1144)[0],{hit:false,hp:1000});q.fighters[0].ailments['失明']=3;q.rng=0;assert.equal(sum(turn(q),'fixed'),0);assert.equal(turn(q).fighters[0].hp,1000);});
