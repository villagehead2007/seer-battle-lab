'use strict';'use strict';const test=require('node:test'),assert=require('node:assert/strict'),H=require('./helpers/4422-battle.cjs'),{make,pick,turn,timer,key,E}=H;
test('4422正式本地17真实ID搜索加载配招单魂印原第五与全效果执行',()=>{const store=require('../local-species.cjs'),saved=store.species(4422);assert.ok(store.search('4422').results.some(x=>x.id===4422));assert.equal(saved.source.storage,'local');assert.deepEqual(E.WIKI.assess(saved).issues,[]);assert.equal(H.source.moves.filter(m=>m.fifth).length,1);for(const move of H.source.moves){const a=structuredClone(saved),b=structuredClone(saved);b.id=920688;b.souls=[];const ids=[...new Set([move.id,36147,...a.moves.map(m=>m.id)])].slice(0,5),stats={maxHp:9000,atk:50,spa:50,def:9999,spd:9999,spe:100};const s=E.createBattle({wikiSnapshots:[a,b],wikiLoadouts:[ids,ids],criticals:false,builds:[{overrides:{...stats,spe:500}},{overrides:stats}]});assert.equal(s.fighters[0].soulId,saved.souls[0].id);assert.equal(E.SOULS.registry[s.fighters[0].soulId].sourceHash,saved.souls[0].hash);assert.equal(Number(s.fighters[0].number),4422);s.fighters[1].ailments['疲惫']=99;const o=E.resolveTurn(s,[key(move.id),key(ids[0])]);assert.equal(o.fighters[0].pp[key(move.id)],move.pp-1);assert.ok(o.moveDefinitions[key(move.id)].operations.length>0);}});
test('4422 36直接处决穿攻击固粉真伤免疫护罩，只有免死留1且不产生处决伤害事件',()=>{for(const mode of ['normal','immune','shield','floor']){let hit=false;for(let seed=0;seed<200&&!hit;seed++){const s=make(pick(36)[0],{seed});if(mode==='immune'){timer(s,1,'攻击伤害免疫');timer(s,1,'固定百分比免疫');timer(s,1,'真实伤害免疫');}if(mode==='shield'){s.fighters[1].suitState.shield=9000;s.fighters[1].suitState.barrier=9000;}if(mode==='floor')timer(s,1,'致命保留',{hp:1});const o=turn(s),event=(o.healthLossEvents??[]).find(e=>e.type==='execution');if(!event)continue;hit=true;assert.equal(o.fighters[1].hp,mode==='floor'?1:0);assert.equal((o.damageEvents??[]).filter(e=>e.type==='execution').length,0);assert.equal(o.fighters[1].soulState.lastDefeatRound,mode==='floor'?undefined:1);}assert.ok(hit,mode);}});
test('4422 36控制未使用和MISS不处决，实际PP消耗区分',()=>{for(const mode of ['control','miss']){const s=make(pick(36)[0],{seed:2,hit:false});if(mode==='control')s.fighters[0].ailments['疲惫']=2;else{s.moveDefinitions[key(s.auditMoveId)].accuracy=0;s.moveDefinitions[key(s.auditMoveId)].alwaysHit=false;}const o=turn(s);assert.ok(o.fighters[1].hp>0);assert.equal((o.healthLossEvents??[]).filter(e=>e.type==='execution').length,0);assert.equal(o.fighters[0].pp[key(s.auditMoveId)],H.source.moves.find(m=>m.id===36139).pp-(mode==='miss'?1:0));}});
test('4422 62真实八回合结束处决穿盾及伤免，免死留1无击败，使用者先死不处决',()=>{for(const mode of ['immune','floor','selfdead']){let s=turn(make(pick(62)[0]));for(let n=2;n<=7;n++)s=turn(s,920031);if(mode==='immune'){s.fighters[1].suitState.shield=9000;s.fighters[1].suitState.barrier=9000;timer(s,1,'当回合免伤');timer(s,1,'真实伤害免疫');}if(mode==='floor')timer(s,1,'致命保留',{hp:1});if(mode==='selfdead'){s.fighters[0].hp=1;H.op(s,29,[100],920042);}const o=turn(s,920031,mode==='selfdead'?920042:920041);assert.equal(o.fighters[1].hp,mode==='floor'?1:mode==='immune'?0:s.fighters[1].hp);const ev=(o.healthLossEvents??[]).filter(e=>e.type==='execution'&&e.round===8);assert.equal(ev.length,mode==='selfdead'?0:1);assert.equal((o.damageEvents??[]).filter(e=>e.type==='execution').length,0);assert.equal(o.fighters[1].soulState.lastDefeatRound,mode==='immune'?8:undefined);}});
test('4422 1861普通MISS整招封锁失明攻击免疫均触发，不能误要求清回合成功',()=>{for(const mode of ['miss','blocked','blind','immune'])for(const buff of [false,true]){const s=make(pick(1861)[0],{hit:false,seed:0});if(buff)timer(s,1,'测试回合');if(mode==='miss'){s.moveDefinitions[key(s.auditMoveId)].accuracy=0;s.moveDefinitions[key(s.auditMoveId)].alwaysHit=false;}if(mode==='blocked')s.fighters[0].counts.nextAttackInvalid=1;if(mode==='blind')s.fighters[0].ailments['失明']=3;if(mode==='immune')timer(s,1,'攻击伤害免疫');const o=turn(s);assert.equal(o.fighters[1].ailments['沉默'],3);assert.equal(o.fighters[1].effects['测试回合'],undefined);}});
test('4422最新封锁确认：1861技能补偿也封锁，控制未用不触发，独立免疫状态保留',()=>{for(const mode of ['control','seal','immune']){const s=make(pick(1861)[0],{seed:0});timer(s,1,'测试回合');if(mode==='control')s.fighters[0].ailments['疲惫']=2;else s.fighters[0].counts.nextAttackInvalid=1;if(mode==='seal')timer(s,0,'技能命中效果失效');if(mode==='immune')s.fighters[1].counts.immune=1;const o=turn(s);assert.equal(o.fighters[1].ailments['沉默'],undefined);assert.equal(!!o.fighters[1].effects['测试回合'],['control','seal'].includes(mode));}});
test('4422魂印对手真使用攻击的整招无效/普通MISS仍触发，控制未用不触且给盾来源补足',()=>{for(const mode of ['blocked','miss','control']){const s=make(pick(1860)[0],{soul:1639});timer(s,1,'测试回合');if(mode==='blocked')s.fighters[1].counts.nextAttackInvalid=1;if(mode==='miss'){s.moveDefinitions[key(920040)].alwaysHit=false;s.moveDefinitions[key(920040)].accuracy=0;}if(mode==='control')s.fighters[1].ailments['疲惫']=2;const o=turn(s,undefined,920040);assert.equal(o.fighters[0].suitState.shield??0,mode==='control'?0:3000);assert.equal(!!o.fighters[1].effects['测试回合'],mode==='control');}});
test('4422 1861精确保留补偿整招只执行一次，多段免攻仍仅消耗一次异常免疫',()=>{const s=make(pick(1861)[0]);H.op(s,31,[2,2],s.auditMoveId);s.moveDefinitions[key(s.auditMoveId)].operations.push(...H.independentOperations(H.source.moves.find(m=>m.id===36141),1));timer(s,1,'攻击伤害免疫');s.fighters[1].counts.immune=2;const o=turn(s);assert.equal(o.fighters[1].counts.immune,1);assert.equal(o.fighters[1].ailments['沉默'],undefined);assert.equal((o.damageEvents??[]).filter(e=>e.sourceSide===0&&e.type==='attack').length,2);});
test('4422 1861普通护盾全挡只产生0伤不算技能无效；正常命中不虚清回合或沉默',()=>{for(const shield of [false,true]){const s=make(pick(1861)[0]);timer(s,1,'测试回合');if(shield)s.fighters[1].suitState.shield=9000;const o=turn(s);assert.equal(o.fighters[1].ailments['沉默'],undefined);assert.ok(o.fighters[1].effects['测试回合']);if(shield)assert.equal(o.fighters[1].hp,9000);}});
test('4422 1861精确保留补偿拒绝错误原hash/revision/index且其他原实例不获得retained授权',()=>{const rule=E.WIKI.effectsEngine.registry[1861],move=H.source.moves.find(m=>m.id===36141);for(const change of [m=>m.hash='wrong',m=>m.revision='seerapi:wrong']){const m=structuredClone(move);change(m);assert.throws(()=>rule.validate([],m,1),/精确来源/);}assert.throws(()=>rule.validate([],move,0),/精确来源/);for(const change of [m=>m.revision='seerapi:wrong',m=>m.wikiId=991861,m=>m.operations.forEach(op=>op.index=2)]){const s=make(pick(1861)[0]);change(s.moveDefinitions[key(s.auditMoveId)]);timer(s,1,'攻击伤害免疫');timer(s,1,'测试回合');const o=turn(s);assert.equal(o.fighters[1].ailments['沉默'],undefined);assert.ok(o.fighters[1].effects['测试回合']);}});
test('4422 1860全部16原实例无正先制1必中，有正不触发且不把原静默先制3丢失',()=>{for(const entry of pick(1860))for(const positive of [false,true]){const s=make(entry,{aStats:{spe:1},hit:false}),m=s.moveDefinitions[key(s.auditMoveId)];m.accuracy=0;m.alwaysHit=false;s.moveDefinitions[key(920040)].priority=m.priority;if(positive)s.fighters[0].stages.def=1;const o=turn(s,undefined,920040);assert.equal(o.turns[0].first,positive?1:0,'move '+entry.moveId);assert.equal(o.fighters[0].pp[key(s.auditMoveId)],m.pp-1);if(m.kind!=='status'&&m.power>0)assert.equal((o.damageEvents??[]).some(e=>e.sourceSide===0&&e.type==='attack'&&e.settledDamage>0),!positive);}});


