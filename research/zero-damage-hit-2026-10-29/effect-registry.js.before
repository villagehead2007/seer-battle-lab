:[400,100,23],"description":"获得400点护盾，护盾消失时100%的概率使对手诅咒"},{"moveId":28768,"hash":"ac23206d","index":3,"id":1702,"args":[400],"description":"自身主动切换下场后令己方下只精灵出战时恢复400点体力"},{"moveId":28768,"hash":"ac23206d","index":4,"id":1882,"args":[1,100,23],"description":"令己方下只出战精灵抵挡下1次对手的攻击，且出战时100%诅咒"},{"moveId":37437,"hash":"6ddf5a21","index":0,"id":761,"args":[1,70],"description":"1回合内对手恢复体力时恢复效果减少70%"},{"moveId":37437,"hash":"6ddf5a21","index":1,"id":919,"args":[1],"description":"后出手时令对手下1回合属性技能无效"},{"moveId":28769,"hash":"812214a5","index":0,"id":1168,"args":[1],"description":"全属性+1，双方任意一方处于异常状态则强化效果翻倍"},{"moveId":28769,"hash":"812214a5","index":1,"id":717,"args":[4,3,2],"description":"4回合内每回合使用技能吸取对手最大体力的1/3，恢复体力时若自身体力低于最大体力的1/2则恢复效果翻倍"},{"moveId":28769,"hash":"812214a5","index":2,"id":693,"args":[2,100],"description":"下2回合造成的攻击伤害额外提升100%"},{"moveId":28769,"hash":"812214a5","index":3,"id":619,"args":[2,2],"description":"下2回合令对手所有技能先制-2"},{"moveId":37438,"hash":"a5d6359d","index":0,"id":699,"args":[],"description":"无视攻击免疫效果"},{"moveId":37438,"hash":"a5d6359d","index":1,"id":1850,"args":[1,100],"description":"消除双方回合类效果，消除任意一方成功则自身下1次攻击技能造成的伤害提升100%"},{"moveId":37438,"hash":"a5d6359d","index":2,"id":2200,"args":[16,23],"description":"令双方流血，任意一方未触发则额外令对手诅咒"},{"moveId":37439,"hash":"eb1ae773","index":0,"id":2020,"args":[],"description":"若自身处于异常状态则先制+3"},{"moveId":37439,"hash":"eb1ae773","index":1,"id":800,"args":[2,2,200],"description":"2回合内若对手使用属性技能，则下2回合自身受到的伤害不超过200"},{"moveId":37439,"hash":"eb1ae773","index":2,"id":1786,"args":[2,1],"description":"2回合内若自身回合类效果被消除则对手下1次使用的攻击技能命中效果失效"},{"moveId":37439,"hash":"eb1ae773","index":3,"id":1794,"args":[2,1,50],"description":"技能无效时，恢复自身最大体力的1/2且下1次受到的攻击伤害额外减少50%"}];

