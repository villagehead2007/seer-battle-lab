add(760,'攻击时造成的伤害不会出现微弱（克制关系为微弱时都变成普通）（BOSS有效）',0,/攻击时造成的伤害不会出现微弱（克制关系为微弱时都变成普通）/,'beforeDamage',()=>({}),(c)=>{c.affinity=Math.max(1,c.affinity);});
