'use strict';const test=require('node:test'),assert=require('node:assert/strict'),H=require('./helpers/remaining-4912.cjs'),{E,source,make,turn,timer,key,sum}=H,row=id=>source.moves.flatMap(m=>m.effectInstances.map((e,index)=>({move:m.id,index,id:e.id}))).find(e=>e.id===id);
function observe(fn,run){const old=E.SOULS;E.SOULS={...old,run(e,c){old.run(e,c);fn(e,c);}};try{return run();}finally{E.SOULS=old;}}
test('4912/1647当次起四回理论比例吸取，严格半体边界、免粉附真170和技能禁疗',()=>{for(const mode of['low','half','immune','ban']){const s=make({...row(1647),hp:mode==='half'?4500:1000});if(mode==='immune')timer(s,1,'固定百分比免疫');if(mode==='ban')timer(s,0,'技能禁疗');turn(s,s.auditMoveId,20117);assert.equal(sum(s,'percent'),mode==='immune'?0:mode==='half'?3000:6000);assert.equal(sum(s,'true'),mode==='immune'?170:0);assert.equal(s.fighters[0].hp,mode==='ban'?1000:mode==='half'?7500:7000);assert.equal(s.fighters[0].effects['灰蛾用招低体理论吸取'].end,4);}});
test('4912/1647真实MISS和整招无效仍用招吸取，控制及药剂不触发，到期停止',()=>{for(const mode of['invalid','miss','control','potion']){const s=make({...row(1647),hp:1000,loadout:[29373,10086,29372,38424,38426]});turn(s,29373,20309);s.fighters[0].hp=1000;if(mode==='invalid')timer(s,0,'skillBlock');if(mode==='control')s.fighters[0].ailments['害怕']=s.round;if(mode==='miss'){delete s.fighters[0].effects['攻击必中'];timer(s,1,'概率闪避',{chance:100});}turn(s,mode==='potion'?null:10086,20309);assert.equal(s.fighters[0].hp,mode==='potion'?1250:mode==='control'?1000:7000);}const s=make({...row(1647),hp:1000,loadout:[29373,10086,29372,38424,38426]});turn(s,29373,20309);for(let r=2;r<=5;r++){s.fighters[0].hp=1000;s.fighters[1].hp=9000;turn(s,10086,20309);assert.equal(s.fighters[0].hp,r<=4?7000:1000);}});
test('4912/1818当前源固粉免疫并原类型反弹，真实伤害不免疫',()=>{const s=make(row(1818));let delta;observe((e,c)=>{if(e==='beforeUse'&&c.a.side===1){const a=c.a.hp,t=c.t.hp;for(const type of['fixed','percent','true'])c.hurt(c.t,100,'反弹状态验证',type);delta=[a-c.a.hp,t-c.t.hp];}},()=>turn(s,s.auditMoveId,20117));assert.deepEqual(delta,[200,100]);assert.equal(sum(s,'fixed'),100);assert.equal(sum(s,'percent'),100);assert.equal(sum(s,'true',1),100);});
test('4912/2096新烧伤成功不授免攻，先前烧伤或施加失败授两回免攻',()=>{for(const mode of['new','existing','immune']){const s=make(row(2096));if(mode==='existing')s.fighters[1].ailments['烧伤']=3;if(mode==='immune')s.fighters[1].counts.immune=1;turn(s,s.auditMoveId,20117);assert.equal(!!s.fighters[0].effects['攻击伤害免疫'],mode!=='new');assert.equal(!!s.fighters[1].ailments['烧伤'],mode!=='immune');}});
test('4912/1823烧伤失败再焚烬，二者均失败才自身攻击特攻各负2',()=>{for(const n of[0,1,2]){const s=make(row(1823));s.fighters[1].counts.immune=n;turn(s,s.auditMoveId,20117);assert.equal(!!s.fighters[1].ailments['烧伤'],n===0);assert.equal(!!s.fighters[1].ailments['焚烬'],n===1);assert.equal(s.fighters[0].stages.atk,n===2?-2:0);assert.equal(s.fighters[0].stages.spa,n===2?-2:0);assert.equal(s.fighters[1].counts.immune,0);}});
test('4912/2248扣本招PP后剩余4乘170%四舍五入7回复其他技能，排除自身并受上限',()=>{const s=make({...row(2248),loadout:[29372,10086,20182,29373,38426]});for(const id of[10086,20182,29373,38426])s.fighters[0].pp[key(id)]=0;turn(s,29372,20117);assert.equal(s.fighters[0].pp[key(29372)],4);for(const id of[10086,20182])assert.equal(s.fighters[0].pp[key(id)],7);assert.equal(s.fighters[0].pp[key(29373)],5);assert.equal(s.fighters[0].pp[key(38426)],1);});
test('4912/2506命中消耗真实火系成为虫并把后来获得渐烬转2海，无火及上限0并存仍明确待答',()=>{const s=make(row(2506));turn(s,38426,20117);assert.equal(s.fighters[0].type,'虫');assert.equal(s.fighters[0].soulState.moth2099.fireConsumed,true);E.SOULS.registry[2099].abilities.gain({a:s.fighters[0],round:s.round});assert.equal(s.fighters[0].soulState.moth2099.sea,2);assert.equal(s.fighters[0].soulState.moth2099.embers,0);s.fighters[0].soulState.moth2099.capZero=true;assert.throws(()=>E.SOULS.registry[2099].abilities.gain({a:s.fighters[0],round:s.round}),/Q-4912-004/);const p=make(row(2506));p.fighters[0].type='虫';const before=structuredClone(p);assert.throws(()=>turn(p,38426,20117),/Q-4912-005/);assert.deepEqual(p,before);});
test('4912/2504命中含零红消费无视正先制资格，整招无效不消费',()=>{for(const mode of['hit','zero','invalid']){const s=make(row(2504));if(mode==='zero')timer(s,1,'攻击伤害免疫');if(mode==='invalid')timer(s,0,'skillBlock');turn(s,38426,20117);assert.equal(!!s.fighters[0].soulState.mothPriority2504Spent,mode!=='invalid');}});
