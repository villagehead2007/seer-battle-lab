'use strict';
const test=require('node:test'),assert=require('node:assert/strict'),source=require('../research/BATCH-4816-REMAINING/4854/snapshot.json'),H=require('./helpers/remaining-battle.cjs')(source),{E,key,keys,make,turn,timer,sum}=H;
const row=(id,n=0)=>source.moves.flatMap(m=>m.effectInstances.map((e,index)=>({move:m.id,index,id:e.id}))).filter(e=>e.id===id)[n];
function observe(fn,run){const old=E.SOULS;E.SOULS={...old,run(e,c){old.run(e,c);fn(e,c);}};try{return run();}finally{E.SOULS=old;}}
test('4854全部17招原生2043、有序重复实例、真实PP及64种子基础行为',()=>{
 for(const m of source.moves){const a=make({move:m.id,soul:true});const c=E.WIKI.effectsEngine.compileInstances(m.effectInstances,source.effects,m);assert.equal(c.issue,'');assert.deepEqual(a.moveDefinitions[key(m.id)].operations.map(x=>[x.effectId,x.index,x.params]),c.operations.map(x=>[x.effectId,x.index,x.params]));turn(a);assert.equal(a.fighters[0].pp[key(m.id)],m.pp-1);const z=make({move:m.id});z.fighters[0].pp[key(m.id)]=0;assert.throws(()=>turn(z),/有 PP/);}
 for(const m of source.moves){require('./helpers/next50-base-probe.cjs').verify({...H,source:{...source,moves:[m]}});console.log('# 4854 base verified '+m.id);}
});
test('4854真实2043当前自身存活贡献5%只减红，属性命中固定吸取50与理论回复，整招无效不触发',()=>{
 const a=make({move:10062,index:-1,soul:true}),base=make({move:10062,index:-1});const n=[];observe((e,c)=>{if(e==='beforeUse'&&c.a.side===1)for(const type of['fixed','percent','true'])n.push(c.hurt(c.t,100,'非红通道',type));},()=>turn(a,10062,10127));turn(base,10062,10127);assert.ok(Math.abs(sum(a,'attack',1)-sum(base,'attack',1)*.95)<=1);assert.deepEqual(n,[100,100,100]);
 const b=make({move:20249,index:-1,soul:true,hp:1000});timer(b,1,'固定百分比免疫');turn(b);assert.equal(b.fighters[0].hp,1050);assert.equal(sum(b,'fixed'),0);const c=make({move:20249,index:-1,soul:true,hp:1000});turn(c);assert.equal(c.fighters[0].hp,1050);assert.equal(sum(c,'fixed'),50);const d=make({move:20249,index:-1,soul:true,hp:1000});timer(d,0,'skillBlock');turn(d);assert.equal(d.fighters[0].hp,1000);assert.equal(sum(d,'fixed'),0);
});
test('4854真实2043完整红299及300中毒、301不触发，已有中毒改固定吸取300，免伤0不触发',()=>{
 for(const amount of[299,300,301]){const a=make({move:10062,index:-1,soul:true,bStats:{atk:9999}});timer(a,0,'攻击伤害上限',{amount});turn(a,10062,10127);assert.equal(sum(a,'attack',1),amount);assert.equal(!!a.fighters[1].ailments['中毒'],amount<=300);assert.equal(sum(a,'fixed'),0);}
 const b=make({move:10062,index:-1,soul:true,hp:1000});b.fighters[1].ailments['中毒']=4;turn(b,10062,10127);assert.equal(sum(b,'fixed'),300);assert.equal(b.fighters[0].hp,1000-sum(b,'attack',1)+300);const immune=make({move:10062,index:-1,soul:true,hp:1000});immune.fighters[1].ailments['中毒']=4;timer(immune,1,'固定百分比免疫');turn(immune,10062,10127);assert.equal(sum(immune,'fixed'),0);assert.equal(immune.fighters[0].hp,1000-sum(immune,'attack',1)+300);const zero=make({move:10062,index:-1,soul:true});timer(zero,0,'攻击伤害免疫');turn(zero,10062,10127);assert.equal(zero.fighters[1].ailments['中毒'],undefined);
});
test('4854/1164真实反转遵守保护，条件不满足或失败清强及回合，125首个红300封顶、无差异小额可继续，跨限额报待答',()=>{
 const a=make(row(1164));a.fighters[1].stages.def=2;turn(a);assert.equal(a.fighters[1].stages.def,-2);assert.ok(a.fighters[1].effects['攻击必中']);const b=make(row(1164));timer(b,1,'强化保护');b.fighters[1].stages.def=2;turn(b);assert.equal(b.fighters[1].stages.def,2);assert.equal(b.fighters[1].effects['攻击必中'],undefined);const both=make(row(1164));timer(both,1,'强化保护');timer(both,1,'protect');both.fighters[1].stages.def=2;turn(both);assert.ok(both.fighters[1].effects['攻击必中']);
 const c=make({...row(125),bStats:{atk:9999}});turn(c,38203,10127);assert.equal(sum(c,'attack',1),300);assert.equal(c.fighters[0].effects['攻击伤害上限'].end,2);const small=make(row(125));observe((e,x)=>{if(e==='beforeUse'&&x.a.side===1)x.hurt(x.t,1,'首个小红','attack');},()=>turn(small,38203,10127));assert.ok(sum(small,'attack',1)<300);const unknown=make({...row(125),bStats:{atk:9999}});assert.throws(()=>observe((e,x)=>{if(e==='beforeUse'&&x.a.side===1)x.hurt(x.t,1,'首个小红','attack');},()=>turn(unknown,38203,10127)),/Q-4854-002/);
});
test('4854/993中毒精确条件双强、2081无异常随机两不同槽含0不补抽，PP保护及异常条件阻挡',()=>{
 for(const poison of[false,true]){const a=make(row(993));if(poison)a.fighters[1].ailments['中毒']=3;turn(a);for(const k of keys)assert.equal(a.fighters[0].stages[k],poison?2:1);}const seen=new Set();for(let seed=1;seed<=24;seed++){const b=make({...row(2081),seed:Math.imul(seed,0x9e3779b1)>>>0});b.fighters[1].pp[key(10127)]=0;turn(b);seen.add(Object.values(b.fighters[1].pp).filter(x=>x===0).length-1);}assert.deepEqual([...seen].sort(),[1,2]);for(const kind of['immune','abnormal']){const c=make(row(2081));if(kind==='immune')timer(c,1,'PP保护');else c.fighters[1].ailments['中毒']=3;turn(c);assert.equal(Object.values(c.fighters[1].pp).filter(x=>x===0).length,0);}
 const d=make(row(162));d.fighters[1].ailments['中毒']=3;assert.throws(()=>turn(d),/Q-4854-001/);assert.equal(require('../local-species.cjs').save(source).saved,false);
});
test('4854/4与5各真实实例成功及概率失败、11和15概率异常与免异、37低体严格半血双威',()=>{
 for(const m of source.moves)for(let index=0;index<m.effectInstances.length;index++){const e=m.effectInstances[index];if(![4,5].includes(e.id))continue;const seen=new Set();for(let seed=1;seed<=(e.args[1]===100?1:32);seed++){const a=make({move:m.id,index,seed:Math.imul(seed,0x9e3779b1)>>>0});turn(a);const side=e.id===4?0:1,k=keys[e.args[0]],base=side===1&&k==='atk'?1:0;seen.add(a.fighters[side].stages[k]-base);}assert.ok(seen.has(e.args[2]));if(e.args[1]<100)assert.ok(seen.has(0));}
 for(const [id,name]of[[11,'中毒'],[15,'害怕']]){const seen=new Set();for(let seed=1;seed<=32;seed++){const a=make({...row(id),seed:Math.imul(seed,0x9e3779b1)>>>0});turn(a);seen.add(!!a.fighters[1].ailments[name]);const b=make({...row(id),seed:Math.imul(seed,0x9e3779b1)>>>0});b.fighters[1].counts.immune=1;turn(b);assert.equal(b.fighters[1].ailments[name],undefined);}assert.equal(seen.size,2);}
 for(const hp of[4499,4500]){const a=make({...row(37),hp});let c;observe((e,x)=>{if(e==='beforeDamage'&&x.a.side===0)c=x;},()=>turn(a));assert.equal(c.power,hp<4500?180:90);}
});
test('4854/48五回合免异第六回合失效，191反弹优先不消次数，1684两回合弱化锁到期解除',()=>{
 const a=make(row(48));a.moveDefinitions[key(21938)].operations=[];for(let r=1;r<=6;r++)observe((e,c)=>{if(e==='beforeUse'&&c.a.side===1)assert.equal(c.ailment(c.t,'中毒',c.a,false,false,2),r===6);},()=>turn(a,r===1?21936:21938));
 const b=make(row(191));b.fighters[0].counts.immune=2;observe((e,c)=>{if(e==='beforeUse'&&c.a.side===1){assert.equal(c.ailment(c.t,'中毒',c.a,false,false,2),false);assert.ok(c.a.ailments['中毒']);assert.equal(c.t.counts.immune,2);}},()=>turn(b));
 const c=make(row(1684));c.fighters[1].stages.def=-2;c.moveDefinitions[key(21938)].operations=[];turn(c);observe((e,x)=>{if(e==='beforeUse'&&x.a.side===1){x.clearNegative(x.a);assert.equal(x.a.stages.def,-2);}},()=>turn(c,21938));observe((e,x)=>{if(e==='beforeUse'&&x.a.side===1){x.clearNegative(x.a);assert.equal(x.a.stages.def,0);}},()=>turn(c,21938));
});
test('4854/43半血回复与技能禁疗，615严格四分之一低体回满、四回合用招时长和843下两回合先制',()=>{
 const a=make({...row(43),hp:1000});turn(a);assert.equal(a.fighters[0].hp,5500);const ban=make({...row(43),hp:1000});timer(ban,0,'技能禁疗');turn(ban);assert.equal(ban.fighters[0].hp,1000);
 for(const [hp,want]of[[2249,9000],[2250,2550],[8900,9000]]){const b=make({...row(615),hp});turn(b);assert.equal(b.fighters[0].hp,want);}const c=make({...row(615),hp:3000});c.moveDefinitions[key(21938)].operations=[];turn(c);assert.equal(c.fighters[0].hp,3300);for(let r=2;r<=5;r++){turn(c,21938);assert.equal(c.fighters[0].hp,3000+Math.min(r,4)*300);}const d=make(row(843));d.moveDefinitions[key(21938)].operations=[];turn(d);assert.equal(d.fighters[0].soulState.resolvedPriority.value,0);for(const expected of[2,2,0]){turn(d,21938);assert.equal(d.fighters[0].soulState.resolvedPriority.value,expected);}
});
test('4854/1255真实80%用招中毒或2250粉伤，免异失败不补抽、百分比免伤独立且三回合到期',()=>{
 const seen=new Set();for(let seed=1;seed<=24;seed++){const a=make({...row(1255),seed:Math.imul(seed,0x9e3779b1)>>>0});turn(a);const poisoned=!!a.fighters[1].ailments['中毒'];seen.add(poisoned);assert.equal(sum(a,'percent'),poisoned?1125:2250);assert.equal(a.fighters[1].hp,poisoned?7875:6750);const b=make({...row(1255),seed:Math.imul(seed,0x9e3779b1)>>>0});b.fighters[1].counts.immune=1;turn(b);assert.equal(b.fighters[1].ailments['中毒'],undefined);assert.equal(sum(b,'percent'),2250);}assert.equal(seen.size,2);
 const c=make(row(1255));c.fighters[1].counts.immune=9;c.moveDefinitions[key(21938)].operations=[];for(let r=1;r<=4;r++){turn(c,r===1?29227:21938);assert.equal(sum(c,'percent'),r<=3?2250:0);c.fighters[1].hp=9000;}const d=make(row(1255));timer(d,1,'固定百分比免疫');d.fighters[1].counts.immune=1;turn(d);assert.equal(sum(d,'percent'),0);
});
test('4854/835反转弱化成功才回满、1185按实际支付半当前HP附粉且被免伤仍支付；781清回合成功封当前属性、1772全部负等级固伤',()=>{
 const a=make({...row(835),hp:1000});a.fighters[0].stages.def=-2;turn(a);assert.equal(a.fighters[0].stages.def,2);assert.equal(a.fighters[0].hp,9000);const b=make({...row(835),hp:1000});timer(b,0,'弱化不可解除反转');b.fighters[0].stages.def=-2;turn(b);assert.equal(b.fighters[0].stages.def,-2);assert.equal(b.fighters[0].hp,1000);const c=make({...row(1185),hp:1000});turn(c);assert.equal(c.fighters[0].hp,500);assert.equal(sum(c,'percent'),500);const d=make({...row(1185),hp:1000});timer(d,1,'固定百分比免疫');turn(d);assert.equal(d.fighters[0].hp,500);assert.equal(sum(d,'percent'),0);
 const e=make(row(781));turn(e);assert.equal(e.fighters[1].stages.atk,0);const f=make(row(781));timer(f,1,'protect');turn(f);assert.equal(f.fighters[1].stages.atk,1);const g=make(row(1772));g.fighters[1].stages.def=-2;g.fighters[1].stages.spa=-3;g.fighters[1].stages.spe=4;turn(g);assert.equal(sum(g,'fixed'),150);
});
