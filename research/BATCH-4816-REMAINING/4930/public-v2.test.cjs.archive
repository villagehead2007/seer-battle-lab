'use strict';const test=require('node:test'),assert=require('node:assert/strict'),{E,source,make,turn,timer,key,sum,keys,observe}=require('./helpers/remaining-4930-audit.cjs'),row=id=>source.moves.flatMap(m=>m.effectInstances.map((e,index)=>({move:m.id,index,id:e.id}))).find(e=>e.id===id);
test('4930/879清回合成功技能回满，失败不回，技能禁疗保留清除',()=>{for(const mode of['success','none','ban']){const s=make({...row(879),hp:1000});if(mode==='none')s.fighters[1].effects={};if(mode==='ban')timer(s,0,'技能禁疗');turn(s,s.auditMoveId,20309);assert.equal(s.fighters[0].hp,mode==='success'?9000:1000);assert.equal(s.fighters[1].effects['攻击必中'],undefined);}});
test('4930/893满体全属性二级非满一级，843次两轮先制二到期归零',()=>{for(const hp of[8999,9000]){const s=make({...row(893),hp});turn(s,s.auditMoveId,20117);for(const k of keys)assert.equal(s.fighters[0].stages[k],hp===9000?2:1);}const s=make(row(843));turn(s,s.auditMoveId,20309);s.moveDefinitions[key(38483)].operations=[];for(const expected of[5,5,3]){turn(s,38483,20309);assert.equal(s.fighters[0].soulState.resolvedPriority.value,expected);}});
test('4930/1874仅攻击视图反转负级、不改实际等级，2316双方任一弱化才免攻',()=>{const damage=[];for(const n of[-2,2]){const s=make(row(1874));s.fighters[0].stages.atk=n;turn(s,s.auditMoveId,20309);damage.push(sum(s));assert.equal(s.fighters[0].stages.atk,n);}assert.equal(damage[0],damage[1]);for(const side of[-1,0,1]){const s=make(row(2316));if(side>=0)s.fighters[side].stages.def=-1;turn(s,s.auditMoveId,10127);assert.equal(sum(s,'attack',1)===0,side>=0);}});
test('4930/1926两次攻击越过免攻、属性不消费、同源刷新不累加',()=>{const s=make(row(1926));timer(s,1,'攻击伤害免疫');turn(s,29420,20117);assert.equal(s.fighters[0].counts.nextAttackIgnoreImmunity,2);turn(s,29420,20117);assert.equal(s.fighters[0].counts.nextAttackIgnoreImmunity,2);s.moveDefinitions[key(38483)].operations=[];for(const n of[1,0,0]){turn(s,38483,20117);assert.equal(s.fighters[0].counts.nextAttackIgnoreImmunity,n);assert.equal(sum(s)>0,s.round<=5);}});
test('4930/1818真实固定伤害免疫反弹保持伤害类型，191异常反弹且不相互递归',()=>{const s=make(row(1818));turn(s,s.auditMoveId,10716);assert.equal(sum(s,'fixed',1),0);assert.ok(sum(s,'fixed')>0);assert.ok(sum(s,'attack',1)>0);const p=make(row(191));turn(p,p.auditMoveId,20117);observe((e,c)=>{if(e==='beforeUse'&&c.a.side===1)c.ailment(c.t,'中毒',c.a,3);},()=>turn(p,p.auditMoveId,20117));assert.equal(p.fighters[0].ailments['中毒'],undefined);assert.ok(p.fighters[1].ailments['中毒']>0);});
test('4930/1803整招无效低体双回、高体多一回属性封锁，命中不执行补偿',()=>{for(const hp of[1000,4500,5000]){const s=make({...row(1803),hp});timer(s,0,'statusBlock');turn(s,s.auditMoveId,20117);assert.equal(s.fighters[0].hp,Math.min(9000,hp+(hp<4500?6000:3000)));assert.equal(s.fighters[1].stages.atk,1);turn(s,null,20117);assert.equal(s.fighters[1].stages.atk,1);const active=Object.values(s.fighters[1].effects).filter(e=>e.end===(hp>4500?4:3));assert.ok(active.length>0);}const s=make({...row(1803),hp:1000});turn(s,s.auditMoveId,20117);assert.equal(s.fighters[0].hp,1000);assert.equal(s.fighters[1].stages.atk,1);});
