'use strict';const test=require('node:test'),assert=require('node:assert/strict'),{E,source,make,turn,timer,key,sum,keys}=require('./helpers/remaining-4937.cjs'),row=id=>source.moves.flatMap(m=>m.effectInstances.map((e,index)=>({move:m.id,index,id:e.id}))).find(e=>e.id===id);
test('4937/178按实际攻击伤害比例技能回血，同属性二分之一异属性四分之一，攻击免疫零伤和禁疗均不回',()=>{for(const mode of['same','different','immune','ban']){const s=make({...row(178),hp:1000});if(mode==='same')s.fighters[1].type=s.fighters[0].type;if(mode==='immune')timer(s,1,'攻击伤害免疫');if(mode==='ban')timer(s,0,'技能禁疗');turn(s,s.auditMoveId,20309);assert.equal(s.fighters[0].hp,1000+(mode==='ban'?0:Math.floor(sum(s)/(mode==='same'?2:4))));}});
test('4937/179同属性威力增加20而非倍增，56真实属性复制五回到期还原',()=>{const a=make(row(179)),b=make({...row(179),index:-1});for(const s of[a,b])s.fighters[1].type=s.fighters[0].type;b.moveDefinitions[key(12981)].power+=20;turn(a,12981,20309);turn(b,12981,20309);assert.equal(sum(a),sum(b));const s=make(row(56)),own=s.fighters[0].type,foe=s.fighters[1].type;turn(s,20145,20117);assert.equal(s.fighters[0].type,foe);for(let i=0;i<4;i++)turn(s,null,20309);assert.equal(s.fighters[0].type,own);});
test('4937/2564真实逐槽PP吸取按实际扣除回复，零与不足不造PP、满槽不转移',()=>{const s=make(row(2564)),a=s.fighters[0],b=s.fighters[1];a.moves.forEach((k,i)=>a.pp[k]=i===0?5:0);b.moves.forEach((k,i)=>b.pp[k]=[2,0,1,3,4][i]);const before={...a.pp};turn(s,s.auditMoveId,20309);assert.deepEqual(a.moves.map(k=>s.fighters[0].pp[k]),[5,0,1,2,2]);assert.deepEqual(b.moves.map(k=>s.fighters[1].pp[k]),[0,0,0,0,2]);});
test('4937/2363无强化时断回合，有强化清成功仍明确复用原待答并回滚，强化保护时不另断',()=>{const a=make(row(2363));turn(a,a.auditMoveId,20309);assert.equal(a.fighters[1].effects['攻击必中'],undefined);const b=make(row(2363));b.fighters[1].stages.atk=1;assert.throws(()=>turn(b,b.auditMoveId,20309),/Q-4834-002/);assert.equal(b.round,1);assert.equal(b.fighters[1].stages.atk,1);timer(b,1,'强化保护');turn(b,b.auditMoveId,20309);assert.ok(b.fighters[1].effects['攻击必中']);assert.equal(b.fighters[1].stages.atk,1);});
test('4937/1065实际用招按低体阈值理论回血及等量粉伤，免粉照回、技能禁疗不回、药剂不触发',()=>{for(const [hp,n]of[[2999,9000],[3000,4500]])for(const mode of['normal','immune','ban']){const s=make({...row(1065),hp});if(mode==='immune')timer(s,1,'固定百分比免疫');if(mode==='ban')timer(s,0,'技能禁疗');turn(s,s.auditMoveId,20309);assert.equal(sum(s,'percent'),mode==='immune'?0:n);assert.equal(s.fighters[0].hp,mode==='ban'?hp:Math.min(9000,hp+n));if(s.fighters[1].hp>0){const before=s.fighters[0].hp;turn(s,null,20309);assert.equal(sum(s,'percent'),0);assert.equal(s.fighters[0].hp,Math.min(9000,before+250));}}});
test('4937/2366完整红伤严格高于300才减回复100%，未过阈值不封且技能禁疗不混同血药',()=>{for(const power of[1,2000]){const s=make(row(2366));s.moveDefinitions[key(s.auditMoveId)].power=power;turn(s,s.auditMoveId,20309);const triggered=sum(s)>300;assert.equal(!!s.fighters[1].effects['回复效果削减'],triggered);assert.equal(s.fighters[1].hp,triggered?9000-sum(s):9000);}});
