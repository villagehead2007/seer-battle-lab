        {
          "file": "tests/remaining-4000-public.test.cjs",
          "name": "4000/406受攻必回150且技能禁疗可阻，190受攻才清对手强化，101按普通攻击实际HP损失30%回血并受禁疗",
          "assertion": "test('4000/406受攻必回150且技能禁疗可阻，190受攻才清对手强化，101按普通攻击实际HP损失30%回血并受禁疗',()=>{for(const blocked of[false,true]){const s=make({move:22637,hp:1000});if(blocked)timer(s,0,'技能禁疗',{});turn(s,22637,10127);assert.equal(s.fighters[0].hp,1000-sum(s,'attack',1)+(blocked?0:150));}const clear=make({move:22638});clear.fighters[1].stages.atk=2;turn(clear,22638,10127);assert.equal(clear.fighters[1].stages.atk,0);for(const blocked of[false,true]){const s=make({move:14859,hp:1000});if(blocked)timer(s,0,'技能禁疗',{});turn(s,14859,20309);assert.equal(s.fighters[0].hp,1000+(blocked?0:Math.floor(sum(s)*.3)));}});\r"
        }
