      "sourceDigest": "0f8f4e3a304fc17c464591124d5e5b04c7098e8c62c4bc9b5a9189e4ebfb09fa",
      "scope": "single",
      "status": "known-branches-state-tested",
      "tests": [
        {
          "file": "tests/remaining-4000-public.test.cjs",
          "name": "4000/58两回攻击必暴，10/12/14五行之光25%独立异常成功失败及22疲惫30%，命中免疫不补抽",
          "assertion": "test('4000/58两回攻击必暴，10/12/14五行之光25%独立异常成功失败及22疲惫30%，命中免疫不补抽',()=>{const s=make({move:22662,loadout:[22662,10047,22660,14897,38423]});turn(s,22662,20309);const b=structuredClone(s);delete b.fighters[0].effects['必定暴击'];turn(s,10047,20309);turn(b,10047,20309);assert.ok(sum(s)>sum(b)*1.4);const found=new Set();for(let seed=1;seed<=32&&found.size<4;seed++){const x=make({move:14898,seed:seed*987654321});turn(x,14898,20309);for(const k of['麻痹','烧伤','冻伤'])if(x.fighters[1].ailments[k])found.add(k);if(Object.keys(x.fighters[1].ailments).length===0)found.add('none');}assert.deepEqual(new Set(found),new Set(['麻痹','烧伤','冻伤','none']));const seen=new Set();for(let seed=1;seed<=24&&seen.size<2;seed++){const x=make({move:14899,seed:seed*987654321});turn(x,14899,20309);seen.add(!!x.fighters[1].ailments['疲惫']);}assert.equal(seen.size,2);});"
        }
      ],
      "pendingQuestions": []
    },
