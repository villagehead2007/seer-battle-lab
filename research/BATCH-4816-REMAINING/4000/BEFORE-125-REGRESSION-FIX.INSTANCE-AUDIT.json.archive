        },
        "from": null,
        "intensifiedTo": null
      },
      "source": {
        "provider": "seerapi",
        "url": "https://api.seerapi.com/v1/pet/4000",
        "revision": "33bc3066",
        "loadedAt": "2026-11-03T17:24:58.559Z"
      },
      "sourceDigest": "b5cbefc575f73a644691d40b185d21f05b8e093ba2e465543cd6706afaaf8c0d",
      "scope": "mixed",
      "status": "known-branches-state-tested",
      "tests": [
        {
          "file": "tests/remaining-4000-core.test.cjs",
          "name": "4000/2098当前单宠首位自身存活时按整1%失体力增攻，末位自身令对手实际用技能后全PP回1，药剂与控制不触发",
          "assertion": "test('4000/2098当前单宠首位自身存活时按整1%失体力增攻，末位自身令对手实际用技能后全PP回1，药剂与控制不触发',()=>{const a=make({move:10047,soul:true,hp:4500}),b=make({move:10047,soul:false,hp:4500});turn(a,10047,20309);turn(b,10047,20309);assert.ok(Math.abs(red(a)/red(b)-1.5)<.05);assert.equal(a.fighters[0].pp[key(10047)],source.moves.find(m=>m.id===10047).pp);for(const hp of[8911,8910,8909]){const x=make({move:10047,soul:true,hp,aStats:{atk:1800}}),y=make({move:10047,soul:false,hp,aStats:{atk:1800}});turn(x,10047,20309);turn(y,10047,20309);assert.ok(Math.abs(red(x)/red(y)-(hp===8911?1:1.01))<.005);}for(const action of['potion','control']){const s=make({move:10047,soul:true});if(action==='control')s.fighters[1].ailments['疲惫']=2;turn(s,10047,action==='potion'?null:20309);assert.equal(s.fighters[0].pp[key(10047)],source.moves.find(m=>m.id===10047).pp-1);}});"
        },
        {
          "file": "tests/remaining-4000-core.test.cjs",
          "name": "4000/2098实际死亡记录自身首末死亡免固粉，黄金万象只记录给真实存活队友的延期请求；已持黄金入场当前清回合清强与一回免异",
          "assertion": "test('4000/2098实际死亡记录自身首末死亡免固粉，黄金万象只记录给真实存活队友的延期请求；已持黄金入场当前清回合清强与一回免异',()=>{const s=make({move:10047,soul:true,hp:1,aStats:{spe:1},bStats:{spe:500,atk:9999}});turn(s,10047,10127);assert.equal(s.fighters[0].hp,0);assert.equal(s.fighters[0].soulState.verse2098.fixedImmune,true);assert.equal(s.fighters[0].soulState.verse2098.percentImmune,true);assert.equal(s.fighters[1].soulState.verse2098,undefined);const old=E.SOULS;E.SOULS={...old,run(e,c){if(e==='beforeBattleStart'&&c.a.side===0){old.registry[2098].abilities.state(c.a).golden=true;c.t.effects['免弱']={start:1,end:3};c.t.stages.atk=2;}old.run(e,c);}};let x;try{x=make({move:10047,soul:true});}finally{E.SOULS=old;}assert.equal(x.fighters[0].soulState.verse2098.golden,false);assert.equal(x.fighters[1].stages.atk,0);assert.equal(x.fighters[1].effects['免弱'],undefined);assert.equal(x.fighters[0].effects['免异常'].end,1);});"
        }
      ],
      "pendingQuestions": []
    },
    {
      "key": "4000:move:10047",
      "kind": "move",
      "raw": {
