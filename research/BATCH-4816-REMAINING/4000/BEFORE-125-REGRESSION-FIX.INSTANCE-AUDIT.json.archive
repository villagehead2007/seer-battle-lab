      "tests": [
        {
          "file": "tests/remaining-4000-extra.test.cjs",
          "name": "4000/1440真实次数免异同源刷新异源独立，黄金万象回合免异先挡不耗次数，后得先消费的剩余量可实际验证",
          "assertion": "test('4000/1440真实次数免异同源刷新异源独立，黄金万象回合免异先挡不耗次数，后得先消费的剩余量可实际验证',()=>{const enemy=require('../research/BATCH-4816-REMAINING/4995/snapshot.json'),old=E.SOULS;E.SOULS={...old,run(e,c){if(e==='beforeBattleStart'&&c.a.side===0){old.registry[2098].abilities.state(c.a).golden=true;c.t.effects['免弱']={start:1,end:3};}old.run(e,c);}};let s;try{s=make({move:29371,index:5,soul:true,loadout:[29371,10047,22660,14897,38423],enemySource:enemy,enemyLoadout:[38549,20276,20565,11141,38550]});}finally{E.SOULS=old;}s.fighters[0].counts.immune=1;s.moveDefinitions[key(38549)].operations=s.moveDefinitions[key(38549)].operations.filter(o=>o.effectId===1447);const expected=[3,2,2,1,0,0];for(let i=0;i<6;i++){if(i===5){Object.assign(s,E.resolveTurn(s,[key(10047),'potion:pp']));assert.equal(s.fighters[0].counts.immune,0);assert.equal(s.fighters[0].ailments['束缚'],undefined);}turn(s,i===0||i===2?29371:10047,38549);assert.equal(s.fighters[0].counts.immune,expected[i]);assert.equal(!!s.fighters[0].ailments['束缚'],i===5);}});\r"
        }
      ],
      "pendingQuestions": []
    },
