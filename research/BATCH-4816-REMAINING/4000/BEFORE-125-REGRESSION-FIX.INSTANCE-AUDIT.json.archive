          "assertion": "test('4000/2500最优五系只改克制倍数，2501整招封锁重算伤害按260特攻翻倍且不恢复强化命中词条，已命中零红不重算',()=>{const s=make({move:38423,index:0}),m=s.moveDefinitions[key(38423)],b=make({move:38423,index:-1});const max=Math.max(...['自然','光','冰','超能','神灵'].map(t=>E.typeEffectiveness(t,s.fighters[1].type,s.typeChart)));turn(s,38423,20309);turn(b,38423,20309);const old=E.typeEffectiveness(m.type,s.fighters[1].type,s.typeChart);assert.ok(Math.abs(red(s)/red(b)-max/old)<.05);const x=make({move:38421,aStats:{spa:520}}),reference=make({move:38421,index:-1,aStats:{spa:520}});reference.moveDefinitions[key(38421)].power*=4;reference.moveDefinitions[key(38421)].type='神灵';timer(x,0,'attackBlock',{});turn(x,38421,20309);turn(reference,38421,20309);assert.equal(red(x),red(reference));assert.ok(red(x)>0);assert.equal(x.fighters[0].stages.atk,0);assert.equal(x.fighters[0].effects['低体固定吸取失败真伤'],undefined);const y=make({move:38421,index:4});timer(y,1,'攻击伤害免疫',{});turn(y,38421,20309);assert.equal(red(y),0);});"
        }
      ],
