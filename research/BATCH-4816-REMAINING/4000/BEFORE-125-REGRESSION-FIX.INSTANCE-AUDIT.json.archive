        },
        "index": 4,
        "description": "此技能微弱对手时技能先制+3、获得本系属性加成并以神灵系进行伤害结算；全属性+1，若自身当前体力低于对手则强化效果翻倍；4回合内每回合使用技能吸取对手300点体力，吸取体力时若自身体力低于最大体力的1/2则吸取效果翻倍，若对手未受到固定伤害则额外附加260点真实伤害；下2回合令自身所有技能先制+2；技能无效时，重新进行伤害结算且自身每有260点特攻值威力翻倍1次",
        "metadata": {
          "id": 2501,
          "argsNum": 0,
          "template": "技能无效时，重新进行伤害结算且自身每有260点特攻值威力翻倍1次",
          "revision": "seerapi:1157471a"
        }
      },
      "source": {
        "snapshot": {
          "provider": "seerapi",
          "url": "https://api.seerapi.com/v1/pet/4000",
          "revision": "33bc3066",
          "loadedAt": "2026-11-03T17:24:58.559Z"
        },
        "skillRevision": "seerapi:b49c66c1"
      },
      "sourceDigest": "d45a7b8eea281594ab40367a3e4e34ccb798bdf2a72b2d2c9224a7534760c124",
      "scope": "single",
      "status": "partial-awaiting-confirmation",
      "tests": [
        {
          "file": "tests/remaining-4000-core.test.cjs",
          "name": "4000/2500最优五系只改克制倍数，2501整招封锁重算伤害按260特攻翻倍且不恢复强化命中词条，已命中零红不重算",
          "assertion": "test('4000/2500最优五系只改克制倍数，2501整招封锁重算伤害按260特攻翻倍且不恢复强化命中词条，已命中零红不重算',()=>{const s=make({move:38423,index:0}),m=s.moveDefinitions[key(38423)],b=make({move:38423,index:-1});const max=Math.max(...['自然','光','冰','超能','神灵'].map(t=>E.typeEffectiveness(t,s.fighters[1].type,s.typeChart)));turn(s,38423,20309);turn(b,38423,20309);const old=E.typeEffectiveness(m.type,s.fighters[1].type,s.typeChart);assert.ok(Math.abs(red(s)/red(b)-max/old)<.05);const x=make({move:38421,aStats:{spa:520}}),reference=make({move:38421,index:-1,aStats:{spa:520}});reference.moveDefinitions[key(38421)].power*=4;reference.moveDefinitions[key(38421)].type='神灵';timer(x,0,'attackBlock',{});turn(x,38421,20309);turn(reference,38421,20309);assert.equal(red(x),red(reference));assert.ok(red(x)>0);assert.equal(x.fighters[0].stages.atk,0);assert.equal(x.fighters[0].effects['低体固定吸取失败真伤'],undefined);const y=make({move:38421,index:4});timer(y,1,'攻击伤害免疫',{});turn(y,38421,20309);assert.equal(red(y),0);});"
        },
        {
          "file": "tests/remaining-4000-interactions.test.cjs",
          "name": "4000/2493隔离额外参数后负先制及真实汲取残血差异仍不猜，2494不同对应攻击值、2501非零特攻等级及MISS均明确回滚",
          "assertion": "test('4000/2493隔离额外参数后负先制及真实汲取残血差异仍不猜，2494不同对应攻击值、2501非零特攻等级及MISS均明确回滚',()=>{const s=make({move:38422,index:4,hp:1000});assert.throws(()=>known2493(s,-1),/Q-4000-002/);assert.equal(s.round,1);const low=make({move:38422,index:4,hp:1000,targetHp:1000});for(const k of low.fighters[0].moves)low.fighters[0].pp[k]=1;assert.throws(()=>known2493(low,4),/Q-4946-002/);assert.equal(low.round,1);const x=make({move:38421,index:4});x.fighters[0].stages.spa=1;timer(x,0,'attackBlock',{});assert.throws(()=>turn(x,38421,20309),/Q-4000-003/);const miss=make({move:38421,index:4,hit:false});delete miss.fighters[0].effects['攻击必中'];miss.moveDefinitions[key(38421)].alwaysHit=false;timer(miss,0,'攻击必失',{});assert.throws(()=>turn(miss,38421,20309),/Q-4000-004/);});"
        }
      ],
      "pendingQuestions": [
        "Q-4000-003",
        "Q-4000-004"
      ]
    },
