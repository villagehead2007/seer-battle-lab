          "assertion": "test('4000全部17招基础组件以不同双攻面板验证真实分类、源威力公式、HP变化及PP，明确隔离另行验证的效果指令',()=>{for(const m of source.moves){const s=make({move:m.id,index:-1,aStats:{atk:180,spa:18}});turn(s,m.id,20117);assert.equal(s.fighters[0].pp[key(m.id)],m.pp-1,m.name);const events=(s.damageEvents??[]).filter(e=>e.sourceSide===0&&e.targetSide===1&&e.type==='attack');if(m.kind==='status'){assert.equal(events.length,0);assert.equal(s.fighters[1].hp,9000);continue;}assert.equal(events.length,1);const event=events[0],attack=m.kind==='physical'?180:18,defense=m.kind==='physical'?s.fighters[1].stats.def:s.fighters[1].stats.spd;assert.equal(event.attackValue,attack,m.name);const log=s.turns[0].events.find(e=>e.damage?.sourceSide===0&&e.damage?.type==='attack'),roll=Number(log.detail.match(/浮动 (\\d+)%/)[1]),base=Math.floor(Math.floor((2*s.fighters[0].level/5+2)*m.power*attack/defense)/50)+2,affinity=E.typeEffectiveness(m.type,s.fighters[1].type,s.typeChart),expected=affinity===0?0:Math.max(1,Math.floor(base*E.sameTypeBonus(m.type,s.fighters[0].type,s.typeChart)*affinity*roll/100));assert.equal(event.settledDamage,expected,m.name);assert.equal(event.hpLoss,expected);assert.equal(s.fighters[1].hp,9000-expected);}});"
        },
        {
          "file": "tests/remaining-4000-native.test.cjs",
          "name": "4000原始17招各16种子真实魂印完整已知链，38420先经真实白皑授等额盾罩，2493未知整招回滚并隔离已知其余四词条",
          "assertion": "test('4000原始17招各16种子真实魂印完整已知链，38420先经真实白皑授等额盾罩，2493未知整招回滚并隔离已知其余四词条',()=>{for(const m of source.moves){if(m.id===38422){const x=make({move:m.id,soul:true});assert.throws(()=>turn(x,m.id,20309),/Q-4000-005/);assert.equal(x.round,1);}for(let seed=1;seed<=16;seed++){const s=make({move:m.id,soul:true,seed:seed*987654321,...(m.id===38420?{loadout:[38420,29371,38421,32106,38423]}:{})});if(m.id===38420)turn(s,29371,20309);if(m.id===38422)s.moveDefinitions[key(m.id)].operations=s.moveDefinitions[key(m.id)].operations.filter(o=>o.effectId!==2493);const ownBefore=s.fighters[0].pp[key(m.id)],enemyBefore=s.fighters[1].pp[key(20309)];turn(s,m.id,20309);const used=s.fighters[1].pp[key(20309)]===enemyBefore-1;assert.equal(s.fighters[0].pp[key(m.id)],ownBefore-1+(used?1:0),m.name);assert.ok(s.fighters.every(f=>f.hp>=0&&f.hp<=f.stats.maxHp));}const p=make({move:m.id,index:-1,soul:true});p.fighters[0].pp[key(m.id)]=0;assert.throws(()=>turn(p,m.id,20309),/有 PP/);assert.equal(p.round,1);}});\r"
        }
