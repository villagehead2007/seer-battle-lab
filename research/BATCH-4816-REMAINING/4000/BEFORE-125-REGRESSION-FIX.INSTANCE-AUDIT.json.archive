          "name": "4000/2489真实非控制异常和2490微弱条件提升先制3，正常条件不提升",
          "assertion": "test('4000/2489真实非控制异常和2490微弱条件提升先制3，正常条件不提升',()=>{for(const ail of[false,true]){const s=make({move:29371,index:0});if(ail)s.fighters[0].ailments['中毒']=3;turn(s,29371,20309);assert.equal(s.fighters[0].soulState.resolvedPriority.value,ail?3:0);}const m=source.moves.find(m=>m.id===38421),single=Object.entries(source.typeChart.aliases).filter(([k,v])=>v.length===1).map(([k])=>k),weak=single.find(t=>{const n=E.typeEffectiveness(m.type,t,source.typeChart);return n>0&&n<1;});assert.ok(weak);for(const type of[weak,'普通']){const s=make({move:38421,index:0});s.fighters[1].type=type;turn(s,38421,20309);assert.equal(s.fighters[0].soulState.resolvedPriority.value,type===weak?3:0);}});"
        },
        {
          "file": "tests/remaining-4000-extra.test.cjs",
          "name": "4000/2490神灵投影参与真实系别无效判定，原自然封锁不挡、神灵封锁才挡，原始技能类型保持自然",
          "assertion": "test('4000/2490神灵投影参与真实系别无效判定，原自然封锁不挡、神灵封锁才挡，原始技能类型保持自然',()=>{for(const type of['自然','神灵']){const s=make({move:38421,index:0});timer(s,1,'指定系别攻击无效',{type});turn(s,38421,20309);assert.equal(red(s)>0,type==='自然');assert.equal(s.moveDefinitions[key(38421)].type,'自然');}});"
        }
      ],
