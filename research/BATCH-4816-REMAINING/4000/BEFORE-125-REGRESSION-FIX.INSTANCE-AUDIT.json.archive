      "raw": {
        "id": 38420,
        "name": "沙海之萌芽",
        "type": "光",
        "kind": "special",
        "power": 100,
        "pp": 5,
        "priority": 3,
        "accuracy": 100,
        "alwaysHit": false,
        "critical": "1/16",
        "effectIds": [
          2488,
          2498,
          1347,
          2492,
          2228
        ],
        "effectInstances": [
          {
            "id": 2488,
            "args": [],
            "description": "上回合任意一方受到过真实伤害时此技能先制+3、获得本系属性加成并以神灵系进行伤害结算"
          },
          {
            "id": 2498,
            "args": [
              2,
              5,
              1,
              1
            ],
            "description": "消除对手回合类效果，消除成功则令对手烧伤、冻伤，每未触发1种当次攻击造成的伤害翻倍1次"
          },
          {
            "id": 1347,
            "args": [
              8
            ],
            "description": "反转对手能力提升状态，反转成功则令对手睡眠，反转失败则消除对手能力提升状态"
          },
          {
            "id": 2492,
            "args": [
              2
            ],
            "description": "消除双方的护盾、护罩效果，若消除的护盾数额与护罩相等则对手2回合内无法主动切换精灵且属性技能无效"
          },
          {
            "id": 2228,
            "args": [
              2,
              80
            ],
            "description": "2回合内对手造成的固定伤害和百分比伤害减少80%"
          }
        ],
        "description": "上回合任意一方受到过真实伤害时此技能先制+3、获得本系属性加成并以神灵系进行伤害结算；消除对手回合类效果，消除成功则令对手烧伤、冻伤，每未触发1种当次攻击造成的伤害翻倍1次；反转对手能力提升状态，反转成功则令对手睡眠，反转失败则消除对手能力提升状态；消除双方的护盾、护罩效果，若消除的护盾数额与护罩相等则对手2回合内无法主动切换精灵且属性技能无效；2回合内对手造成的固定伤害和百分比伤害减少80%",
        "revision": "seerapi:2d88be15",
