      "sourceDigest": "d45a10be04f27c5f5ab873781372b501562e181049106ec2330f8a1b7f722bd0",
      "scope": "single",
      "status": "known-branches-state-tested",
      "tests": [
        {
          "file": "tests/remaining-4000-limits.test.cjs",
          "name": "4000/697真实编译指令决定2494属性附伤是否穿过限伤，剥离697对照限100、完整组合按历史攻击值附680",
          "assertion": "test('4000/697真实编译指令决定2494属性附伤是否穿过限伤，剥离697对照限100、完整组合按历史攻击值附680',()=>{for(const ignore of[false,true]){const s=make({move:29371,loadout:[29371,10047,22660,14897,38423],bStats:{atk:520}});s.moveDefinitions[key(29371)].operations=s.moveDefinitions[key(29371)].operations.filter(op=>op.effectId===2494||ignore&&op.effectId===697);turn(s,10047,10127);timer(s,1,'攻击伤害上限',{amount:100});turn(s,29371,20309);const e=s.damageEvents.find(e=>e.round===2&&e.sourceSide===0&&e.redCategory==='attribute');assert.equal(e.settledDamage,ignore?680:100);assert.equal(e.hpLoss,ignore?680:100);assert.equal(s.fighters[1].effects['攻击伤害上限'].amount,100);}});\r"
        },
        {
          "file": "tests/remaining-4000-limits.test.cjs",
          "name": "4000/697无视限伤时不受125单位待答误挡，未忽限且第二包可能被盾抵光也不能用零伤绕过未知单位",
          "assertion": "test('4000/697无视限伤时不受125单位待答误挡，未忽限且第二包可能被盾抵光也不能用零伤绕过未知单位',()=>{const E=require('./helpers/remaining-4000.cjs').E;for(const ignore of[false,true]){const s=make({move:29371,loadout:[29371,10047,22660,14897,38423],bStats:{atk:520}});s.moveDefinitions[key(29371)].operations=s.moveDefinitions[key(29371)].operations.filter(op=>op.effectId===2494||ignore&&op.effectId===697);turn(s,10047,10127);timer(s,1,'攻击伤害上限',{amount:100,pending1254854:true});if(!ignore)s.fighters[1].suitState.shield=2000;const before={hp:s.fighters[1].hp,shield:s.fighters[1].suitState.shield},old=E.SOULS;E.SOULS={...old,run(e,c){old.run(e,c);if(e==='beforeUse'&&c.a.side===0)c.hurt(c.t,1,'本回合先前真实正红','attack');}};try{if(ignore){turn(s,29371,20309);const e=s.damageEvents.find(e=>e.round===2&&e.sourceSide===0&&e.redCategory==='attribute');assert.equal(e.settledDamage,680);assert.equal(e.hpLoss,680);}else{assert.throws(()=>turn(s,29371,20309),/Q-4854-002/);assert.equal(s.round,2);assert.equal(s.fighters[1].hp,before.hp);assert.equal(s.fighters[1].suitState.shield,before.shield);}}finally{E.SOULS=old;}}});\r"
        }
      ],
      "pendingQuestions": []
    },
    {
      "key": "4000:skill:29371:2",
      "kind": "skill",
      "raw": {
        "instance": {
          "id": 2494,
          "args": [
            170,
            9,
            260,
            1
          ],
          "description": "若自身于上回合受到了攻击伤害则附加170点的冰系伤害，此攻击伤害对应的攻击值每有260点效果翻倍1次"
        },
        "index": 2,
        "description": "任意一方处于异常状态时此技能先制+3、获得本系属性加成并以神灵系进行伤害结算；无视伤害限制效果；若自身于上回合受到了攻击伤害则附加170点的冰系伤害，此攻击伤害对应的攻击值每有260点效果翻倍1次；若自身未于上回合受到攻击伤害则获得自身最大体力的26%的护盾、护罩；解除自身所处的异常状态，若解除的异常状态中存在自身上次登场效果所免疫的异常状态，则本场战斗己方免疫此异常状态；免疫下2次自身受到的异常状态",
        "metadata": {
          "id": 2494,
          "argsNum": 4,
          "template": "若自身于上回合受到了攻击伤害则附加{0}点的{1}系伤害，此攻击伤害对应的攻击值每有{2}点效果翻倍{3}次",
          "revision": "seerapi:c462d9b0"
        }
      },
      "source": {
        "snapshot": {
          "provider": "seerapi",
          "url": "https://api.seerapi.com/v1/pet/4000",
          "revision": "33bc3066",
          "loadedAt": "2026-11-03T17:24:58.559Z"
        },
        "skillRevision": "seerapi:6ea7f2c9"
      },
      "sourceDigest": "42bf7a10442b9a00ade304d2455057a3508bb979b5b45d06ef2766b840b14118",
      "scope": "single",
      "status": "partial-awaiting-confirmation",
      "tests": [
        {
          "file": "tests/remaining-4000-core.test.cjs",
          "name": "4000/2494前轮实际攻击值260阈值产生冰系属性伤害，2495未受攻则26%盾罩同源刷新，属性伤害不当作攻击历史",
          "assertion": "test('4000/2494前轮实际攻击值260阈值产生冰系属性伤害，2495未受攻则26%盾罩同源刷新，属性伤害不当作攻击历史',()=>{for(const atk of[259,260,520]){const s=make({move:29371,index:2,loadout:[29371,10047,22660,14897,38423],bStats:{atk}});turn(s,10047,10127);assert.equal(s.damageEvents.find(e=>e.sourceSide===1&&e.type==='attack').attackValue,atk);turn(s,29371,20309);const e=es(s).find(e=>e.redCategory==='attribute');assert.ok(e);assert.equal(e.settledDamage,Math.floor(170*2**Math.floor(atk/260)*E.typeEffectiveness('冰',s.fighters[1].type,s.typeChart)));assert.equal(e.hpLoss,e.settledDamage);}const x=make({move:29371,index:3});turn(x,29371,20309);assert.equal(x.fighters[0].suitState.shield,2340);assert.equal(x.fighters[0].suitState.barrier,2340);turn(x,29371,20309);assert.equal(x.fighters[0].suitState.shield,2340);assert.equal(x.fighters[0].suitState.barrier,2340);});"
        },
        {
          "file": "tests/remaining-4000-extra.test.cjs",
          "name": "4000/2494引用上一回合的实际攻击值，当前对手能力等级提高不回写历史伤害基数",
          "assertion": "test('4000/2494引用上一回合的实际攻击值，当前对手能力等级提高不回写历史伤害基数',()=>{const s=make({move:29371,index:2,loadout:[29371,10047,22660,14897,38423],bStats:{atk:260}});turn(s,10047,10127);assert.equal(s.damageEvents.find(e=>e.sourceSide===1&&e.type==='attack').attackValue,260);const old=E.SOULS;E.SOULS={...old,run(e,c){old.run(e,c);if(e==='roundStart'&&c.a.side===1)c.stage(c.a,3,['atk']);}};try{turn(s,29371,20309);}finally{E.SOULS=old;}assert.equal(s.fighters[1].stages.atk,3);const e=s.damageEvents.find(e=>e.round===2&&e.sourceSide===0&&e.redCategory==='attribute');assert.equal(e.settledDamage,Math.floor(340*E.typeEffectiveness('冰',s.fighters[1].type,s.typeChart)));});"
        },
        {
          "file": "tests/remaining-4000-interactions.test.cjs",
          "name": "4000/2493隔离额外参数后负先制及真实汲取残血差异仍不猜，2494不同对应攻击值、2501非零特攻等级及MISS均明确回滚",
          "assertion": "test('4000/2493隔离额外参数后负先制及真实汲取残血差异仍不猜，2494不同对应攻击值、2501非零特攻等级及MISS均明确回滚',()=>{const s=make({move:38422,index:4,hp:1000});assert.throws(()=>known2493(s,-1),/Q-4000-002/);assert.equal(s.round,1);const low=make({move:38422,index:4,hp:1000,targetHp:1000});for(const k of low.fighters[0].moves)low.fighters[0].pp[k]=1;assert.throws(()=>known2493(low,4),/Q-4946-002/);assert.equal(low.round,1);const x=make({move:38421,index:4});x.fighters[0].stages.spa=1;timer(x,0,'attackBlock',{});assert.throws(()=>turn(x,38421,20309),/Q-4000-003/);const miss=make({move:38421,index:4,hit:false});delete miss.fighters[0].effects['攻击必中'];miss.moveDefinitions[key(38421)].alwaysHit=false;timer(miss,0,'攻击必失',{});assert.throws(()=>turn(miss,38421,20309),/Q-4000-004/);});"
        },
        {
          "file": "tests/remaining-4000-interactions.test.cjs",
          "name": "4000/2489与2494真实同招：异常条件把冰系属性附伤改神灵且强制本系1.5，状态招仍无凭空主攻击伤害",
          "assertion": "test('4000/2489与2494真实同招：异常条件把冰系属性附伤改神灵且强制本系1.5，状态招仍无凭空主攻击伤害',()=>{const s=make({move:29371,loadout:[29371,10047,22660,14897,38423]});turn(s,10047,10127);s.fighters[0].ailments['中毒']=4;turn(s,29371,20309);const events=es(s);assert.equal(events.length,1);assert.equal(events[0].redCategory,'attribute');assert.equal(events[0].settledDamage,Math.floor(170*1.5*E.typeEffectiveness('神灵',s.fighters[1].type,s.typeChart)));assert.equal(s.fighters[0].ailments['中毒'],undefined);});"
        },
        {
          "file": "tests/remaining-4000-interactions.test.cjs",
          "name": "4000/2494实际多段中对应攻击值不同不猜最后一次，整个下一回合保持回滚",
          "assertion": "test('4000/2494实际多段中对应攻击值不同不猜最后一次，整个下一回合保持回滚',()=>{const enemy=require('../research/BATCH-4816-REMAINING/4995/snapshot.json'),s=make({move:29371,index:2,loadout:[29371,10047,22660,14897,38423],enemySource:enemy,enemyLoadout:[10703,20276,20565,11141,38550]}),old=E.SOULS;E.SOULS={...old,run(e,c){old.run(e,c);if(e==='beforeDamage'&&c.a.side===1)c.stage(c.a,1,['spa']);}};try{turn(s,10047,10703);}finally{E.SOULS=old;}const values=s.damageEvents.filter(e=>e.sourceSide===1&&e.type==='attack').map(e=>e.attackValue);assert.ok(new Set(values).size>1);assert.throws(()=>turn(s,29371,20276),/Q-4000-001/);assert.equal(s.round,2);});\r"
        },
        {
          "file": "tests/remaining-4000-limits.test.cjs",
          "name": "4000/697真实编译指令决定2494属性附伤是否穿过限伤，剥离697对照限100、完整组合按历史攻击值附680",
          "assertion": "test('4000/697真实编译指令决定2494属性附伤是否穿过限伤，剥离697对照限100、完整组合按历史攻击值附680',()=>{for(const ignore of[false,true]){const s=make({move:29371,loadout:[29371,10047,22660,14897,38423],bStats:{atk:520}});s.moveDefinitions[key(29371)].operations=s.moveDefinitions[key(29371)].operations.filter(op=>op.effectId===2494||ignore&&op.effectId===697);turn(s,10047,10127);timer(s,1,'攻击伤害上限',{amount:100});turn(s,29371,20309);const e=s.damageEvents.find(e=>e.round===2&&e.sourceSide===0&&e.redCategory==='attribute');assert.equal(e.settledDamage,ignore?680:100);assert.equal(e.hpLoss,ignore?680:100);assert.equal(s.fighters[1].effects['攻击伤害上限'].amount,100);}});\r"
        }
      ],
      "pendingQuestions": [
        "Q-4000-001"
      ]
    },
