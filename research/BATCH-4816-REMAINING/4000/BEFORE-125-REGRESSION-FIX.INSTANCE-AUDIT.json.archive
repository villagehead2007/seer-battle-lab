      "tests": [
        {
          "file": "tests/remaining-4000-public.test.cjs",
          "name": "4000/426真实40%闪避成败但必中例外，29附固定50、125单次攻击上限250不误挡固定，连续正红单位仍待答",
          "assertion": "test('4000/426真实40%闪避成败但必中例外，29附固定50、125单次攻击上限250不误挡固定，连续正红单位仍待答',()=>{const seen=new Set();for(let seed=1;seed<=32&&seen.size<2;seed++){const s=make({move:22660,hit:false,seed:seed*987654321});turn(s,22660,10127);seen.add(sum(s,'attack',1)===0);}assert.equal(seen.size,2);const fixed=make({move:14897});turn(fixed,14897,20309);assert.equal(sum(fixed,'fixed'),50);const cap=make({move:22661,bStats:{atk:9999}});turn(cap,22661,10127);assert.equal(sum(cap,'attack',1),250);const enemy=require('../research/BATCH-4816-REMAINING/4995/snapshot.json'),x=make({move:22661,enemySource:enemy,enemyLoadout:[10703,20276,20565,11141,38550],bStats:{spa:9999}});assert.throws(()=>turn(x,22661,10703),/Q-4854-002/);assert.equal(x.round,1);});"
        }
      ],
