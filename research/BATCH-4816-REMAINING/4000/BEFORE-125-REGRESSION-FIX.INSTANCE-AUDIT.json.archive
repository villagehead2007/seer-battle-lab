      "tests": [
        {
          "file": "tests/remaining-4000-public.test.cjs",
          "name": "4000/2498真实清回合后烧伤冻伤独立施加，每失败一种本次攻击翻倍，按各自实际随机浮动核对真实HP损失",
          "assertion": "test('4000/2498真实清回合后烧伤冻伤独立施加，每失败一种本次攻击翻倍，按各自实际随机浮动核对真实HP损失',()=>{for(const immune of[0,1,2]){const s=make({move:38420,index:1});s.fighters[1].counts.immune=immune;turn(s,38420,20309);const event=s.turns[0].events.find(e=>e.kind==='damage'&&e.damage?.sourceSide===0&&e.damage?.type==='attack'),roll=Number(event.detail.match(/浮动 (\\d+)%/)[1]),expected=Math.floor(52*2**immune*roll/100);assert.equal(sum(s),expected);assert.equal(event.damage.hpLoss,expected);assert.equal(Object.keys(s.fighters[1].ailments).filter(k=>['烧伤','冻伤'].includes(k)).length,2-immune);}const x=make({move:38420,index:1});x.fighters[1].effects={};turn(x,38420,20309);assert.equal(x.fighters[1].ailments['烧伤'],undefined);assert.equal(x.fighters[1].ailments['冻伤'],undefined);});"
        }
      ],
