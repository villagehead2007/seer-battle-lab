      "tests": [
        {
          "file": "tests/remaining-4000-public.test.cjs",
          "name": "4000/1892实际用技能固定吸取300低半600，目标未受固定伤害才追加260真伤，免伤与残血不减少理论回复，血药不触发",
          "assertion": "test('4000/1892实际用技能固定吸取300低半600，目标未受固定伤害才追加260真伤，免伤与残血不减少理论回复，血药不触发',()=>{for(const hp of[4499,4500])for(const immune of[false,true]){const s=make({move:38421,index:2,hp});if(immune)timer(s,1,'固定百分比免疫',{});turn(s,38421,20309);const n=hp<4500?600:300;assert.equal(s.fighters[0].hp,hp+n);assert.equal(sum(s,'fixed'),immune?0:n);assert.equal(sum(s,'true'),immune?260:0);}const x=make({move:38421,index:2,hp:1000});turn(x,38421,20309);const before=x.fighters[1].hp;turn(x,null,20309);assert.equal(sum(x,'fixed'),0);assert.equal(sum(x,'true'),0);});"
        }
      ],
      "pendingQuestions": []
    },
