          "file": "tests/remaining-4000-public.test.cjs",
          "name": "4000/2228对手固粉输出减少80%不影响真实，946低于对手HP全强翻倍及843下两回先制2",
          "assertion": "test('4000/2228对手固粉输出减少80%不影响真实，946低于对手HP全强翻倍及843下两回先制2',()=>{const s=make({move:38420,index:4}),old=E.SOULS,out={};E.SOULS={...old,run(e,c){old.run(e,c);if(e==='beforeUse'&&c.a.side===1)for(const type of['fixed','percent','true']){const hp=c.t.hp;c.hurt(c.t,500,'减伤实测',type);out[type]=hp-c.t.hp;}}};try{turn(s,38420,20309);}finally{E.SOULS=old;}assert.deepEqual(out,{fixed:100,percent:100,true:500});const baseline=make({move:38421,index:-1});turn(baseline,38421,20309);const afterHitHp=9000-sum(baseline);for(const hp of[afterHitHp-1,afterHitHp,afterHitHp+1]){const x=make({move:38421,index:1,hp});turn(x,38421,20309);for(const n of Object.values(x.fighters[0].stages))assert.equal(n,hp<afterHitHp?2:1);}const p=make({move:38421,index:3});turn(p,38421,20309);assert.equal(p.fighters[0].effects.id984.amount,2);assert.equal(p.fighters[0].effects.id984.start,2);});"
        }
      ],
      "pendingQuestions": []
    },
