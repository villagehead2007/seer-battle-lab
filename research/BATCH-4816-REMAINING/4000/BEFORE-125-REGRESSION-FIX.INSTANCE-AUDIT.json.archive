        "skillRevision": "seerapi:67226d38"
      },
      "sourceDigest": "203595bb0f05cf385aaa3392ffbd8c767af995e5a57123c93f0cf0227eef73e4",
      "scope": "single",
      "status": "partial-awaiting-confirmation",
      "tests": [
        {
          "file": "tests/remaining-4000-core.test.cjs",
          "name": "4000/2493真实7参保留且额外两参明确待答回滚，2492零盾罩不猜0相等补偿",
          "assertion": "test('4000/2493真实7参保留且额外两参明确待答回滚，2492零盾罩不猜0相等补偿',()=>{const s=make({move:38422,index:4});assert.deepEqual(s.moveDefinitions[key(38422)].operations[0].sourceArgs,[4,1,17,1,1,1,1]);assert.throws(()=>turn(s,38422,20309),/Q-4000-005/);assert.equal(s.round,1);const x=make({move:38420,index:3});assert.throws(()=>turn(x,38420,20309),/Q-4940-001/);assert.equal(x.round,1);});\r"
        },
        {
          "file": "tests/remaining-4000-interactions.test.cjs",
          "name": "4000/2493仅隔离未确认额外两参数：真实恢复每点PP汲取17真伤并等量技能回复，实际先制2使伤害乘4，满PP仅补本招消耗1点",
          "assertion": "test('4000/2493仅隔离未确认额外两参数：真实恢复每点PP汲取17真伤并等量技能回复，实际先制2使伤害乘4，满PP仅补本招消耗1点',()=>{for(const priority of[0,2]){const s=make({move:38422,index:4,hp:1000});for(const k of s.fighters[0].moves)s.fighters[0].pp[k]=1;known2493(s,priority);const n=20*17*2**priority;assert.equal(es(s,'true').reduce((n,e)=>n+e.settledDamage,0),n);assert.equal(s.fighters[0].hp,1000+n);assert.equal(s.fighters[0].soulState.resolvedPriority.value,priority);for(const k of s.fighters[0].moves)assert.equal(s.fighters[0].pp[k],k===key(38422)?4:5);}const x=make({move:38422,index:4,hp:1000});known2493(x);assert.equal(es(x,'true')[0].settledDamage,17);assert.equal(x.fighters[0].hp,1017);});"
        },
        {
          "file": "tests/remaining-4000-interactions.test.cjs",
          "name": "4000/2493隔离额外参数后负先制及真实汲取残血差异仍不猜，2494不同对应攻击值、2501非零特攻等级及MISS均明确回滚",
          "assertion": "test('4000/2493隔离额外参数后负先制及真实汲取残血差异仍不猜，2494不同对应攻击值、2501非零特攻等级及MISS均明确回滚',()=>{const s=make({move:38422,index:4,hp:1000});assert.throws(()=>known2493(s,-1),/Q-4000-002/);assert.equal(s.round,1);const low=make({move:38422,index:4,hp:1000,targetHp:1000});for(const k of low.fighters[0].moves)low.fighters[0].pp[k]=1;assert.throws(()=>known2493(low,4),/Q-4946-002/);assert.equal(low.round,1);const x=make({move:38421,index:4});x.fighters[0].stages.spa=1;timer(x,0,'attackBlock',{});assert.throws(()=>turn(x,38421,20309),/Q-4000-003/);const miss=make({move:38421,index:4,hit:false});delete miss.fighters[0].effects['攻击必中'];miss.moveDefinitions[key(38421)].alwaysHit=false;timer(miss,0,'攻击必失',{});assert.throws(()=>turn(miss,38421,20309),/Q-4000-004/);});"
        },
        {
          "file": "tests/remaining-4000-native.test.cjs",
          "name": "4000原始17招各16种子真实魂印完整已知链，38420先经真实白皑授等额盾罩，2493未知整招回滚并隔离已知其余四词条",
          "assertion": "test('4000原始17招各16种子真实魂印完整已知链，38420先经真实白皑授等额盾罩，2493未知整招回滚并隔离已知其余四词条',()=>{for(const m of source.moves){if(m.id===38422){const x=make({move:m.id,soul:true});assert.throws(()=>turn(x,m.id,20309),/Q-4000-005/);assert.equal(x.round,1);}for(let seed=1;seed<=16;seed++){const s=make({move:m.id,soul:true,seed:seed*987654321,...(m.id===38420?{loadout:[38420,29371,38421,32106,38423]}:{})});if(m.id===38420)turn(s,29371,20309);if(m.id===38422)s.moveDefinitions[key(m.id)].operations=s.moveDefinitions[key(m.id)].operations.filter(o=>o.effectId!==2493);const ownBefore=s.fighters[0].pp[key(m.id)],enemyBefore=s.fighters[1].pp[key(20309)];turn(s,m.id,20309);const used=s.fighters[1].pp[key(20309)]===enemyBefore-1;assert.equal(s.fighters[0].pp[key(m.id)],ownBefore-1+(used?1:0),m.name);assert.ok(s.fighters.every(f=>f.hp>=0&&f.hp<=f.stats.maxHp));}const p=make({move:m.id,index:-1,soul:true});p.fighters[0].pp[key(m.id)]=0;assert.throws(()=>turn(p,m.id,20309),/有 PP/);assert.equal(p.round,1);}});\r"
        }
      ],
      "pendingQuestions": [
