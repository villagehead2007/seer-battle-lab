      "sourceDigest": "bc8268562a113fa7a3471e428e0435f38a6ca81e6ae545b32535f1ea129faa84",
      "scope": "mixed",
      "status": "known-branches-state-tested",
      "tests": [
        {
          "file": "tests/remaining-4000-extra.test.cjs",
          "name": "4000/2497技能授予的本场特定免异不依赖之后仍持原魂印，给定上次入场免异历史后真实学习并挡后续同名异常",
          "assertion": "test('4000/2497技能授予的本场特定免异不依赖之后仍持原魂印，给定上次入场免异历史后真实学习并挡后续同名异常',()=>{const enemy=require('../research/BATCH-4816-REMAINING/4995/snapshot.json'),s=make({move:29371,index:4,soul:true,enemySource:enemy,enemyLoadout:[38549,20276,20565,11141,38550]});s.fighters[0].soulState.verse2098.entryImmuneHistory=['束缚'];s.fighters[0].ailments['束缚']=3;s.moveDefinitions[key(38549)].operations=s.moveDefinitions[key(38549)].operations.filter(o=>o.effectId===1447);turn(s,29371,38549);assert.deepEqual(s.fighters[0].soulState.permanentAilments2497,['束缚']);s.fighters[0].soulId=null;turn(s,29371,38549);assert.equal(s.fighters[0].ailments['束缚'],undefined);assert.deepEqual(s.fighters[0].soulState.permanentAilments2497,['束缚']);});"
        },
        {
          "file": "tests/remaining-4000-interactions.test.cjs",
          "name": "4000/2497已知上次入场免异历史前态下真实净异，仅被记免异进入本场自身永久免疫，其余异常仍可附加",
          "assertion": "test('4000/2497已知上次入场免异历史前态下真实净异，仅被记免异进入本场自身永久免疫，其余异常仍可附加',()=>{const enemy=require('../research/BATCH-4816-REMAINING/4995/snapshot.json'),s=make({move:29371,index:4,soul:true,enemySource:enemy,enemyLoadout:[38549,20276,20565,11141,38550]});s.fighters[0].soulState.verse2098.entryImmuneHistory=['束缚'];s.fighters[0].ailments['束缚']=3;s.fighters[0].ailments['冻伤']=3;s.moveDefinitions[key(38549)].operations=s.moveDefinitions[key(38549)].operations.filter(o=>o.effectId===1447);const old=E.SOULS;E.SOULS={...old,run(e,c){old.run(e,c);if(e==='beforeUse'&&c.a.side===1)c.ailment(c.t,'冻伤',c.a,false,false,2);}};try{turn(s,29371,38549);}finally{E.SOULS=old;}assert.deepEqual(s.fighters[0].soulState.verse2098.permanentAilments,['束缚']);assert.equal(s.fighters[0].ailments['束缚'],undefined);assert.ok(s.fighters[0].ailments['冻伤']>=1);assert.ok(s.fighters[0].soulState.verse2098.teamPermanentRequests.some(x=>x.requiresActualAllies));});"
        }
