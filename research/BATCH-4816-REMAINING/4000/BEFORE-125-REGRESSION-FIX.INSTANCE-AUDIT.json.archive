          "assertion": "test('4000/881自身有弱化才先制3，1767对手正防御视负不改变真实等级，1524反馈成功回满失败净弱且免弱互动',()=>{for(const weak of[false,true]){const s=make({move:38422,index:1});if(weak)s.fighters[0].stages.atk=-1;turn(s,38422,20309);assert.equal(s.fighters[0].soulState.resolvedPriority.value,weak?3:0);}const a=make({move:38422,index:2}),b=make({move:38422,index:-1});a.fighters[1].stages.spd=2;b.fighters[1].stages.spd=-2;turn(a,38422,20309);turn(b,38422,20309);assert.equal(sum(a),sum(b));assert.equal(a.fighters[1].stages.spd,2);for(const immune of[false,true]){const s=make({move:38422,index:3,hp:1000});s.fighters[0].stages.atk=-2;if(immune)timer(s,1,'免弱',{});turn(s,38422,20309);assert.equal(s.fighters[0].stages.atk,0);assert.equal(s.fighters[0].hp,immune?1000:9000);assert.equal(s.fighters[1].stages.atk,immune?0:-2);}});"
