      "tests": [
        {
          "file": "tests/remaining-4000-core.test.cjs",
          "name": "4000/2488上一回合任意方真实伤害才本招先制3加3并投影神灵，本源定义不变且伤害含本系加成",
          "assertion": "test('4000/2488上一回合任意方真实伤害才本招先制3加3并投影神灵，本源定义不变且伤害含本系加成',()=>{const s=make({move:38420,index:0,loadout:[38420,10047,22660,14897,38423]}),old=E.SOULS;E.SOULS={...old,run(e,c){old.run(e,c);if(e==='beforeUse'&&c.a.side===1)c.hurt(c.t,100,'上轮真实伤害测试','true');}};try{turn(s,10047,20309);}finally{E.SOULS=old;}const orig=s.moveDefinitions[key(38420)].type;turn(s,38420,20309);assert.equal(s.fighters[0].soulState.resolvedPriority.value,6);assert.equal(s.fighters[0].soulState.god4000.effectId,2488);assert.equal(s.moveDefinitions[key(38420)].type,orig);assert.ok(red(s)>0);const x=make({move:38420,index:0});turn(x,38420,20309);assert.equal(x.fighters[0].soulState.resolvedPriority.value,3);assert.equal(x.fighters[0].soulState.god4000,undefined);});"
        }
      ],
      "pendingQuestions": []
    },
