'use strict';const test=require('node:test'),assert=require('node:assert/strict'),H=require('./helpers/remaining-4000.cjs'),enemy=require('../research/BATCH-4816-REMAINING/4995/snapshot.json'),{E,make,turn,timer,key,source}=H;
const attacks=s=>(s.damageEvents??[]).filter(e=>e.round===s.round-1&&e.type==='attack'&&e.targetSide===0),sum=s=>attacks(s).reduce((n,e)=>n+e.settledDamage,0),create=()=>make({move:22661,enemySource:enemy,enemyLoadout:[10703,20276,20565,11141,38550],bStats:{spa:9999}});
test('4000/125同版22661已确认整回合完整红250，多段累计、真实HP与PP、次回重置及三回到期',()=>{const s=create(),pp=s.fighters[0].pp[key(22661)];turn(s,22661,10703);assert.equal(s.fighters[0].pp[key(22661)],pp-1);assert.equal(s.fighters[0].hp,8750);assert.equal(sum(s),250);assert.equal(s.fighters[0].effects['攻击伤害上限'].cumulativeRoundRed,true);assert.equal(s.fighters[0].effects['攻击伤害上限'].pending1254854,undefined);turn(s,10047,10703);assert.equal(sum(s),250);assert.equal(s.fighters[0].hp,8500);turn(s,10047,10703);assert.equal(sum(s),250);assert.equal(s.fighters[0].hp,8250);turn(s,10047,10703);assert.ok(sum(s)>250);});
test('4000/125同源盾100后完整红150加100，保1实际失血0仍消耗完整250预算',()=>{for(const mode of['shield','floor']){const s=create();if(mode==='shield')s.fighters[0].suitState.shield=100;else{s.fighters[0].hp=1;timer(s,0,'致命保留',{hp:1});}turn(s,22661,10703);assert.equal(sum(s),250);if(mode==='shield'){assert.equal(s.fighters[0].suitState.shield,0);assert.equal(s.fighters[0].hp,8750);assert.deepEqual(attacks(s).filter(e=>e.settledDamage>0).map(e=>e.settledDamage),[150,100]);}else{assert.equal(s.fighters[0].hp,1);assert.ok(attacks(s).filter(e=>e.settledDamage>0).every(e=>e.hpLoss===0));}}});
test('4000/125只限红伤，真实来源14897附加50固定独立结算；已确认版本可编译但不解除其他125待答',()=>{const s=make({move:22661,enemySource:source,enemyLoadout:[14897,10047,22660,22661,38423],bStats:{atk:9999}});turn(s,22661,14897);assert.equal(sum(s),250);const fixed=s.damageEvents.filter(e=>e.round===1&&e.sourceSide===1&&e.targetSide===0&&e.type==='fixed').reduce((n,e)=>n+e.settledDamage,0);assert.equal(fixed,50);assert.equal(s.fighters[0].hp,8700);const m=source.moves.find(m=>m.id===22661);assert.equal(E.WIKI.effectsEngine.compileInstances(m.effectInstances,source.effects,m).issue,'');const unresolved=require('../research/BATCH-4816-REMAINING/4854/snapshot.json'),u=unresolved.moves.find(m=>m.effectInstances.some(e=>e.id===125));assert.match(E.WIKI.assess(unresolved,[u.id]).issues.join(';'),/Q-4854-002|待确认/);});
