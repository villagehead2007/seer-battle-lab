        {
          "file": "tests/remaining-4912-interactions.test.cjs",
          "name": "4912当前双方固粉反弹不再反弹，PP恢复禁制阻挡2248，正式保存仍被待答保护",
          "assertion": "test('4912当前双方固粉反弹不再反弹，PP恢复禁制阻挡2248，正式保存仍被待答保护',()=>{const s=make({...row(1818),enemySource:source,enemyLoadout:[38424,10086,20182,29373,38426]});let delta;observe((e,c)=>{if(e==='afterUse'&&c.a.side===1){const a=c.a.hp,t=c.t.hp;c.hurt(c.t,100,'双方真实固粉反弹','fixed');delta=[a-c.a.hp,t-c.t.hp];}},()=>turn(s,38424,38424));assert.deepEqual(delta,[0,0]);const p=make({...row(2248),loadout:[29372,10086,20182,29373,38426]});p.fighters[0].pp[key(10086)]=0;p.fighters[1].soulState.bedPartnerPP=true;timer(p,1,'机械领域');turn(p,29372,20117);assert.equal(p.fighters[0].pp[key(10086)],0);const r=require('../local-species.cjs').save(source);assert.equal(r.saved,false);});\r"
        }
