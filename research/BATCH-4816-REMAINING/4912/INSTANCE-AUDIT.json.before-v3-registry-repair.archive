  "items": [
    {
      "key": "4912:soul:2099",
      "kind": "soul",
      "raw": {
        "id": 2099,
        "description": "自身每次在场首次使用攻击技能时获得1层渐烬并吸取对手最大体力的1/3，若对手免疫受到的固定伤害、百分比伤害则本场战斗此效果无视时点条件|自身每次在场对手首次使用攻击技能时当回合自身受到的攻击伤害减少50%，若对手当次攻击微弱自身则对手下次属性技能无效|自身受到致死伤害时，消耗自身的渐烬以主动恢复全部体力，恢复成功自身解除所处的异常状态、能力下降状态，免疫下1次受到的攻击，每消耗1层渐烬，己方获得1层天烬海，之后本场战斗自身渐烬的上限视为0|（boss无效）",
        "desc_formatting_adjustment": null,
        "analyze_desc": "[sprite name=dot4]自身每次在场[color=#52a5f2]首次[/color]使用攻击技能时获得1层[color=#f35555]渐烬[/color]并[color=#52a5f2]吸取[/color][color=#52a5f2]对手[/color]最大体力的1/3，若[color=#52a5f2]对手[/color][color=#57c975]免疫[/color]受到的[color=#52a5f2]固定伤害[/color]、[color=#52a5f2]百分比伤害[/color]则本场战斗此效果无视时点条件|[sprite name=dot4]自身每次在场[color=#52a5f2]对手[/color][color=#52a5f2]首次[/color]使用攻击技能时[color=#52a5f2]当回合[/color]自身受到的攻击伤害减少50%，若[color=#52a5f2]对手[/color]当次攻击微弱自身则[color=#52a5f2]对手[/color]下次属性[color=#52a5f2]技能无效[/color]|[sprite name=dot4]自身受到[color=#52a5f2]致死伤害[/color]时，消耗自身的[color=#f35555]渐烬[/color][color=#52a5f2]以[/color]主动恢复全部体力，恢复成功自身解除所处的[color=#52a5f2]异常状态[/color]、[color=#52a5f2]能力下降状态[/color]，[color=#57c975]免疫[/color]下1次受到的攻击，每消耗1层[color=#f35555]渐烬[/color]，[color=#52a5f2]己方[/color]获得1层[color=#f35555]天烬海[/color]，[color=#52a5f2]之后[/color]本场战斗自身[color=#f35555]渐烬[/color]的上限视为0",
        "hash": "5827a832",
        "eid": 2519,
        "args": [
          1,
          0
        ],
        "isAdvanced": false,
        "source": {
          "url": "https://api.seerapi.com/v1/soulmark/2099",
          "revision": "5827a832",
          "loadedAt": "2026-11-03T05:27:17.154Z"
        },
        "from": null,
        "intensifiedTo": null
      },
      "source": {
        "provider": "seerapi",
        "url": "https://api.seerapi.com/v1/pet/4912",
        "revision": "1119e482",
        "loadedAt": "2026-11-03T05:27:11.066Z"
      },
      "sourceDigest": "3e72da75da71b151120bc3ad607de5200cba30908b57dc8cf6024d9251ea8bb2",
      "scope": "mixed",
      "reviewedAt": "2026-11-03T07:53:10.361Z",
      "status": "partial-awaiting-confirmation",
      "tests": [
        {
          "file": "tests/remaining-4912-soul.test.cjs",
          "name": "4912真实2099首次实际攻击得1渐烬并最大HP三分一百分比吸取理论魂印回复，属性/血药/控制不消费，MISS和红免疫仍属使用",
          "assertion": "test('4912真实2099首次实际攻击得1渐烬并最大HP三分一百分比吸取理论魂印回复，属性/血药/控制不消费，MISS和红免疫仍属使用',()=>{for(const mode of['hit','status','potion','control','miss','redimmune']){const s=make({move:10086,soul:true,hp:1000,loadout:[10086,20182,29372,29373,38426]});if(mode==='control')s.fighters[0].ailments['害怕']=1;if(mode==='miss'){delete s.fighters[0].effects['攻击必中'];timer(s,1,'概率闪避',{chance:100});}if(mode==='redimmune')timer(s,1,'攻击伤害免疫');turn(s,mode==='status'?20182:mode==='potion'?null:10086,20309);const yes=['hit','miss','redimmune'].includes(mode);assert.equal(st(s).embers,yes?1:0);assert.equal(st(s).ownFirst,yes);assert.equal(sum(s,'percent'),yes?3000:0);assert.equal(s.fighters[0].hp,yes?4000:mode==='potion'?1250:1000);}});"
        },
        {
          "file": "tests/remaining-4912-soul.test.cjs",
          "name": "4912真实2099普通不免疫首次后不重复，渐烬每层红伤10%与每5层全技能先制1，5层基底上限与0上限",
          "assertion": "test('4912真实2099普通不免疫首次后不重复，渐烬每层红伤10%与每5层全技能先制1，5层基底上限与0上限',()=>{const s=make({move:10086,soul:true,hp:1000});turn(s,10086,20309);turn(s,10086,20309);assert.equal(st(s).embers,1);assert.equal(sum(s,'percent'),0);for(const n of[1,5]){const a=make({move:10086,soul:true}),b=make({move:10086});Object.assign(st(a),{embers:n,ownFirst:true});turn(a,10086,20309);turn(b,10086,20309);assert.ok(sum(a)>=Math.floor(sum(b)*(1+.1*n)));assert.ok(sum(a)<=Math.ceil(sum(b)*(1+.1*n)));assert.equal(a.fighters[0].soulState.resolvedPriority.value,n===5?1:0);}const cap=make({move:10086,soul:true});st(cap).embers=5;assert.equal(E.SOULS.registry[2099].abilities.gain({a:cap.fighters[0],round:1}),0);assert.equal(st(cap).embers,5);st(cap).embers=0;st(cap).capZero=true;assert.equal(E.SOULS.registry[2099].abilities.gain({a:cap.fighters[0],round:1}),0);assert.equal(st(cap).embers,0);});"
        },
        {
          "file": "tests/remaining-4912-soul.test.cjs",
          "name": "4912真实2099对手首次实际攻击本回红伤减半、后续不减，弱属性时源计次封下一次属性且保留异源",
          "assertion": "test('4912真实2099对手首次实际攻击本回红伤减半、后续不减，弱属性时源计次封下一次属性且保留异源',()=>{const a=make({move:10086,soul:true}),b=make({move:10086});turn(a,10086,10127);turn(b,10086,10127);assert.ok(sum(a,'attack',1)>=Math.floor(sum(b,'attack',1)*.5));assert.ok(sum(a,'attack',1)<=Math.ceil(sum(b,'attack',1)*.5));turn(a,10086,10127);turn(b,10086,10127);assert.equal(sum(a,'attack',1),sum(b,'attack',1));const weak=make({move:10086,soul:true,enemySource:require('../research/BATCH-4816-REMAINING/4908/snapshot.json'),enemyLoadout:[11961,20030,29362,38411,29364]});weak.fighters[1].counts.nextStatusInvalid=2;turn(weak,10086,11961);assert.equal(st(weak).events.find(e=>e.kind==='foe-first').weak,true);assert.equal(weak.fighters[1].counts.nextStatusInvalid,3);const speed=weak.fighters[1].stages.spe;turn(weak,10086,20030);assert.equal(weak.fighters[1].counts.nextStatusInvalid,2);assert.equal(weak.fighters[1].stages.spe,speed);});"
        },
        {
          "file": "tests/remaining-4912-soul.test.cjs",
          "name": "4912真实2099成功致死魂印主动回满消耗全部已备渐烬、解除异常负级、授源免攻1、天海等层及上限0，技能禁疗不封锁",
          "assertion": "test('4912真实2099成功致死魂印主动回满消耗全部已备渐烬、解除异常负级、授源免攻1、天海等层及上限0，技能禁疗不封锁',()=>{const s=make({move:10086,soul:true,aStats:{def:1},bStats:{atk:9999},loadout:[10086,20182,29372,29373,38426]});turn(s,10086,20309);assert.equal(st(s).embers,1);s.fighters[0].hp=1;s.fighters[0].stages.spa=-2;s.fighters[0].ailments['烧伤']=3;timer(s,0,'技能禁疗');turn(s,10086,10127);assert.equal(s.fighters[0].hp,9000);assert.equal(st(s).embers,0);assert.equal(st(s).capZero,true);assert.equal(st(s).sea,1);assert.equal(s.fighters[0].ailments['烧伤'],undefined);assert.equal(s.fighters[0].stages.spa,0);assert.equal(s.fighters[0].counts.attackNullify,1);assert.equal(s.fighters[0].soulState.deathResolved,undefined);const loss=s.damageEvents.find(e=>e.round===2&&e.type==='attack'&&e.targetSide===0);assert.ok(loss.settledDamage>9000);assert.equal(loss.hpLoss,1);turn(s,20182,10127);assert.equal(s.fighters[0].hp,9000);assert.equal(s.fighters[0].counts.attackNullify,0);turn(s,20182,10127);assert.equal(s.fighters[0].hp,0);assert.equal(s.fighters[0].stats.maxHp,0);assert.equal(s.fighters[0].soulState.vanished,true);assert.ok(s.vanishEvents.some(e=>Number(e.species)===4912));});"
        },
        {
          "file": "tests/remaining-4912-soul.test.cjs",
          "name": "4912天烬海当前双方烧伤每回合数不减少、其他异常正常到期且烧伤实际持续扣HP，双来源海不重复延长",
          "assertion": "test('4912天烬海当前双方烧伤每回合数不减少、其他异常正常到期且烧伤实际持续扣HP，双来源海不重复延长',()=>{const s=make({move:20182,soul:true});st(s).sea=1;s.fighters[1].soulState.moth2099={sea:2};for(const f of s.fighters){f.ailments['烧伤']=2;f.ailments['中毒']=2;}let last=9000;for(let r=1;r<=3;r++){turn(s,20182,20309);for(const f of s.fighters)assert.equal(f.ailments['烧伤']-s.round+1,2);assert.ok(s.fighters[0].hp<last);last=s.fighters[0].hp;if(r>=2)for(const f of s.fighters)assert.equal(f.ailments['中毒'],undefined);}assert.ok(s.fighters.every(f=>f.hp>0));});"
        },
        {
          "file": "tests/remaining-4912-soul.test.cjs",
          "name": "4912天烬海当前真正击败敌方后消逝，瞬时主动恢复不是击败，已备5层致死全消费为5海与普通回复倍率",
          "assertion": "test('4912天烬海当前真正击败敌方后消逝，瞬时主动恢复不是击败，已备5层致死全消费为5海与普通回复倍率',()=>{const s=make({move:10086,soul:true,targetHp:1});Object.assign(st(s),{sea:1,ownFirst:true,capZero:true});turn(s,10086,20309);assert.equal(s.fighters[1].hp,0);assert.equal(s.fighters[1].stats.maxHp,0);assert.equal(s.fighters[1].soulState.vanished,true);const p=make({move:10086,soul:true,hp:1,aStats:{def:1},bStats:{atk:9999}});Object.assign(st(p),{embers:5,ownFirst:true});timer(p,0,'回复效果削减',{fraction:.5});turn(p,10086,10127);assert.equal(p.fighters[0].hp,4500);assert.equal(st(p).embers,0);assert.equal(st(p).sea,5);assert.equal(p.fighters[0].soulState.vanished,undefined);});"
        },
        {
          "file": "tests/remaining-4912-soul.test.cjs",
          "name": "4912免疫拓时点、主动恢复失败和并存保命重生明确当前待答并回滚，不吞未实现行为",
          "assertion": "test('4912免疫拓时点、主动恢复失败和并存保命重生明确当前待答并回滚，不吞未实现行为',()=>{for(const mode of['immune','heal-fail','floor','rebirth']){const s=make({move:10086,soul:true,hp:1,aStats:{def:1},bStats:{atk:9999}});Object.assign(st(s),{embers:1,ownFirst:mode!=='immune'});if(mode==='immune')timer(s,1,'固定百分比免疫');if(mode==='heal-fail')timer(s,0,'回复效果削减',{fraction:1});if(mode==='floor')timer(s,0,'致命保留',{hp:1});if(mode==='rebirth')s.fighters[0].soulState.rebirth2243={armed:true};const before=structuredClone(s);assert.throws(()=>turn(s,10086,10127),mode==='immune'?/Q-4912-001/:mode==='heal-fail'?/Q-4912-002/:/Q-4912-003/);assert.deepEqual(s,before);}});\r"
        },
        {
          "file": "tests/remaining-4912-native.test.cjs",
          "name": "4912全部17招各64种子真实HP和PP，原生2099全部17招首轮执行与火系消费",
          "assertion": "test('4912全部17招各64种子真实HP和PP，原生2099全部17招首轮执行与火系消费',()=>{for(const m of source.moves)for(let seed=1;seed<=64;seed++){const s=make({move:m.id,seed:Math.imul(seed,2654435761)>>>0}),pp=s.fighters[0].pp[key(m.id)];turn(s,m.id,20309);assert.equal(s.round,2);assert.equal(s.fighters[0].pp[key(m.id)],pp-1);assert.ok(s.fighters.every(f=>Number.isFinite(f.hp)&&f.hp>=0&&f.hp<=f.stats.maxHp));}for(const m of source.moves){const s=make({move:m.id,soul:true}),pp=s.fighters[0].pp[key(m.id)];turn(s,m.id,20309);assert.equal(s.round,2);assert.equal(s.fighters[0].pp[key(m.id)],pp-1);assert.equal(s.fighters[0].soulState.moth2099.ownFirst,['physical','special'].includes(m.kind));assert.equal(s.fighters[0].type,m.fifth?'虫':source.type);assert.ok(s.fighters.every(f=>Number.isFinite(f.hp)));}});\r"
        }
      ],
      "pendingQuestions": [
        "Q-4912-001",
        "Q-4912-002",
        "Q-4912-003",
        "Q-4912-004"
      ]
    },
