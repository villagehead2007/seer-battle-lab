      "status": "known-branch-state-tested-awaiting-final-regression",
      "tests": [
        {
          "file": "tests/remaining-4912-public.test.cjs",
          "name": "4912基础重复降攻特攻与降速真实生效、免弱阻挡；魔眼害怕必附且免异消费",
