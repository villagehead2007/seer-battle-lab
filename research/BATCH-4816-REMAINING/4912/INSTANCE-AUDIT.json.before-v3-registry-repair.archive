          "assertion": "test('4912/1823烧伤失败再焚烬，二者均失败才自身攻击特攻各负2',()=>{for(const n of[0,1,2]){const s=make(row(1823));s.fighters[1].counts.immune=n;turn(s,s.auditMoveId,20117);assert.equal(!!s.fighters[1].ailments['烧伤'],n===0);assert.equal(!!s.fighters[1].ailments['焚烬'],n===1);assert.equal(s.fighters[0].stages.atk,n===2?-2:0);assert.equal(s.fighters[0].stages.spa,n===2?-2:0);assert.equal(s.fighters[1].counts.immune,0);}});"
