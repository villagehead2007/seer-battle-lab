          "assertion": "test('4912/2506命中消耗真实火系成为虫并把后来获得渐烬转2海，无火及上限0并存仍明确待答',()=>{const s=make(row(2506));turn(s,38426,20117);assert.equal(s.fighters[0].type,'虫');assert.equal(s.fighters[0].soulState.moth2099.fireConsumed,true);E.SOULS.registry[2099].abilities.gain({a:s.fighters[0],round:s.round});assert.equal(s.fighters[0].soulState.moth2099.sea,2);assert.equal(s.fighters[0].soulState.moth2099.embers,0);s.fighters[0].soulState.moth2099.capZero=true;assert.throws(()=>E.SOULS.registry[2099].abilities.gain({a:s.fighters[0],round:s.round}),/Q-4912-004/);const p=make(row(2506));p.fighters[0].type='虫';const before=structuredClone(p);assert.throws(()=>turn(p,38426,20117),/Q-4912-005/);assert.deepEqual(p,before);});"
        }
