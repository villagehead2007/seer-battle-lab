          "assertion": "test('4912/1647当次起四回理论比例吸取，严格半体边界、免粉附真170和技能禁疗',()=>{for(const mode of['low','half','immune','ban']){const s=make({...row(1647),hp:mode==='half'?4500:1000});if(mode==='immune')timer(s,1,'固定百分比免疫');if(mode==='ban')timer(s,0,'技能禁疗');turn(s,s.auditMoveId,20117);assert.equal(sum(s,'percent'),mode==='immune'?0:mode==='half'?3000:6000);assert.equal(sum(s,'true'),mode==='immune'?170:0);assert.equal(s.fighters[0].hp,mode==='ban'?1000:mode==='half'?7500:7000);assert.equal(s.fighters[0].effects['灰蛾用招低体理论吸取'].end,4);}});"
        },
        {
          "file": "tests/remaining-4912-skills.test.cjs",
          "name": "4912/1647真实MISS和整招无效仍用招吸取，控制及药剂不触发，到期停止",
          "assertion": "test('4912/1647真实MISS和整招无效仍用招吸取，控制及药剂不触发，到期停止',()=>{for(const mode of['invalid','miss','control','potion']){const s=make({...row(1647),hp:1000,loadout:[29373,10086,29372,38424,38426]});turn(s,29373,20309);s.fighters[0].hp=1000;if(mode==='invalid')timer(s,0,'skillBlock');if(mode==='control')s.fighters[0].ailments['害怕']=s.round;if(mode==='miss'){delete s.fighters[0].effects['攻击必中'];timer(s,1,'概率闪避',{chance:100});}turn(s,mode==='potion'?null:10086,20309);assert.equal(s.fighters[0].hp,mode==='potion'?1250:mode==='control'?1000:7000);}const s=make({...row(1647),hp:1000,loadout:[29373,10086,29372,38424,38426]});turn(s,29373,20309);for(let r=2;r<=5;r++){s.fighters[0].hp=1000;s.fighters[1].hp=9000;turn(s,10086,20309);assert.equal(s.fighters[0].hp,r<=4?7000:1000);}});"
        }
