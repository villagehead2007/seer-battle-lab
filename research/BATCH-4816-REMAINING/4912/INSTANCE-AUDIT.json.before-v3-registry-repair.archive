          "name": "4912/919后手才封敌下轮属性，1664先手封低威力攻击而实际击败延长次轮",
          "assertion": "test('4912/919后手才封敌下轮属性，1664先手封低威力攻击而实际击败延长次轮',()=>{for(const last of[false,true]){const s=make({...row(919),aStats:{spe:last?50:500}});turn(s,s.auditMoveId,20117);const old=s.fighters[1].stages.atk;turn(s,s.auditMoveId,20117);assert.equal(s.fighters[1].stages.atk,last?old:old+1);}const s=make(row(1664));let granted;observe((e,c)=>{if(e==='afterAttack'&&c.a.side===0)granted=c.a.effects['低威力攻击无效']?.power;},()=>turn(s,s.auditMoveId,10127));assert.equal(sum(s,'attack',1),0);assert.equal(granted,120);assert.equal(s.fighters[0].effects['低威力攻击无效'],undefined);const ko=make({...row(1664),targetHp:1});turn(ko,38426,20117);assert.equal(ko.fighters[1].hp,0);assert.equal(ko.fighters[0].effects['低威力攻击无效'].end,2);});"
