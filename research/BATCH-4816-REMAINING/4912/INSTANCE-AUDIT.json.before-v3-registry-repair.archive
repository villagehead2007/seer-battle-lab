      "source": {
        "snapshot": {
          "provider": "seerapi",
          "url": "https://api.seerapi.com/v1/pet/4912",
          "revision": "1119e482",
          "loadedAt": "2026-11-03T05:27:11.066Z"
        },
        "skillRevision": "seerapi:20e63013"
      },
      "sourceDigest": "1a8f83dff85c26603f617d8fd73769ecc2d9f7522acda431ac768a12f27cf628",
      "scope": "single",
      "reviewedAt": "2026-11-03T07:53:10.361Z",
      "status": "known-branch-state-tested-awaiting-final-regression",
      "tests": [
        {
          "file": "tests/remaining-4912-soul.test.cjs",
          "name": "4912真实2099普通不免疫首次后不重复，渐烬每层红伤10%与每5层全技能先制1，5层基底上限与0上限",
          "assertion": "test('4912真实2099普通不免疫首次后不重复，渐烬每层红伤10%与每5层全技能先制1，5层基底上限与0上限',()=>{const s=make({move:10086,soul:true,hp:1000});turn(s,10086,20309);turn(s,10086,20309);assert.equal(st(s).embers,1);assert.equal(sum(s,'percent'),0);for(const n of[1,5]){const a=make({move:10086,soul:true}),b=make({move:10086});Object.assign(st(a),{embers:n,ownFirst:true});turn(a,10086,20309);turn(b,10086,20309);assert.ok(sum(a)>=Math.floor(sum(b)*(1+.1*n)));assert.ok(sum(a)<=Math.ceil(sum(b)*(1+.1*n)));assert.equal(a.fighters[0].soulState.resolvedPriority.value,n===5?1:0);}const cap=make({move:10086,soul:true});st(cap).embers=5;assert.equal(E.SOULS.registry[2099].abilities.gain({a:cap.fighters[0],round:1}),0);assert.equal(st(cap).embers,5);st(cap).embers=0;st(cap).capZero=true;assert.equal(E.SOULS.registry[2099].abilities.gain({a:cap.fighters[0],round:1}),0);assert.equal(st(cap).embers,0);});"
        },
        {
          "file": "tests/remaining-4912-soul.test.cjs",
          "name": "4912天烬海当前真正击败敌方后消逝，瞬时主动恢复不是击败，已备5层致死全消费为5海与普通回复倍率",
          "assertion": "test('4912天烬海当前真正击败敌方后消逝，瞬时主动恢复不是击败，已备5层致死全消费为5海与普通回复倍率',()=>{const s=make({move:10086,soul:true,targetHp:1});Object.assign(st(s),{sea:1,ownFirst:true,capZero:true});turn(s,10086,20309);assert.equal(s.fighters[1].hp,0);assert.equal(s.fighters[1].stats.maxHp,0);assert.equal(s.fighters[1].soulState.vanished,true);const p=make({move:10086,soul:true,hp:1,aStats:{def:1},bStats:{atk:9999}});Object.assign(st(p),{embers:5,ownFirst:true});timer(p,0,'回复效果削减',{fraction:.5});turn(p,10086,10127);assert.equal(p.fighters[0].hp,4500);assert.equal(st(p).embers,0);assert.equal(st(p).sea,5);assert.equal(p.fighters[0].soulState.vanished,undefined);});"
        },
        {
          "file": "tests/remaining-4912-public.test.cjs",
          "name": "4912基础重复降攻特攻与降速真实生效、免弱阻挡；魔眼害怕必附且免异消费",
          "assertion": "test('4912基础重复降攻特攻与降速真实生效、免弱阻挡；魔眼害怕必附且免异消费',()=>{for(const move of[20182,32116])for(const immune of[false,true]){const s=make({move});if(immune)timer(s,1,'免弱');turn(s,move,20309);for(const k of keys)assert.equal(s.fighters[1].stages[k],!immune&&(move===20182?['atk','spa'].includes(k):k==='spe')?-1:0);}for(const immune of[false,true]){const s=make({move:20231});if(immune)s.fighters[1].counts.immune=1;turn(s,20231,20309);assert.equal(!!s.fighters[1].ailments['害怕'],!immune);if(immune)assert.equal(s.fighters[1].counts.immune,0);}});"
        },
        {
          "file": "tests/remaining-4912-interactions.test.cjs",
          "name": "4912/1616克制时获本系1.5，2331真实穿透攻击免疫且成功才清敌回合",
          "assertion": "test('4912/1616克制时获本系1.5，2331真实穿透攻击免疫且成功才清敌回合',()=>{const m=source.moves.find(m=>m.id===38424),strong=Object.keys(source.typeChart.rows).find(t=>E.typeEffectiveness(m.type,t,source.typeChart)>1);assert.ok(strong);for(const type of[strong,'普通']){const a=make(row(1616)),b=make({...row(1616),index:-1});for(const s of[a,b]){s.fighters[0].type='普通';s.fighters[1].type=type;}turn(a,38424,20117);turn(b,38424,20117);if(type===strong){assert.ok(sum(a)>=Math.floor(sum(b)*1.5));assert.ok(sum(a)<=Math.ceil(sum(b)*1.5));}else assert.equal(sum(a),sum(b));}for(const immune of[false,true]){const s=make(row(2331));timer(s,1,'强化保护');if(immune)timer(s,1,'攻击伤害免疫');turn(s,38424,20117);assert.ok(sum(s)>0);assert.equal(!!s.fighters[1].effects['强化保护'],!immune);}});"
        }
      ],
      "pendingQuestions": []
    },
