          "assertion": "test('4912/2248扣本招PP后剩余4乘170%四舍五入7回复其他技能，排除自身并受上限',()=>{const s=make({...row(2248),loadout:[29372,10086,20182,29373,38426]});for(const id of[10086,20182,29373,38426])s.fighters[0].pp[key(id)]=0;turn(s,29372,20117);assert.equal(s.fighters[0].pp[key(29372)],4);for(const id of[10086,20182])assert.equal(s.fighters[0].pp[key(id)],7);assert.equal(s.fighters[0].pp[key(29373)],5);assert.equal(s.fighters[0].pp[key(38426)],1);});"
