          "name": "4912概率毒25%和10%固伤100覆盖真实成功失败，150至300随机回血上下界及禁疗",
          "assertion": "test('4912概率毒25%和10%固伤100覆盖真实成功失败，150至300随机回血上下界及禁疗',()=>{const poison=new Set(),fixed=new Set(),heals=[];for(let n=1;n<=32;n++){for(const id of[11,93,450]){const s=make({...row(id),hp:1000,seed:Math.imul(n,2654435761)>>>0});turn(s,s.auditMoveId,20309);if(id===11)poison.add(!!s.fighters[1].ailments['中毒']);if(id===93)fixed.add(sum(s,'fixed'));if(id===450)heals.push(s.fighters[0].hp-1000);}}assert.deepEqual(poison,new Set([false,true]));assert.deepEqual(fixed,new Set([0,100]));assert.ok(heals.every(n=>n>=150&&n<=300));assert.ok(new Set(heals).size>10);const s=make({...row(450),hp:1000});timer(s,0,'技能禁疗');turn(s,s.auditMoveId,20309);assert.equal(s.fighters[0].hp,1000);});"
        }
