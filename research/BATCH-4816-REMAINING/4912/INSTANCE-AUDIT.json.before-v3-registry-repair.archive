        {
          "file": "tests/remaining-4912-public.test.cjs",
          "name": "4912/1978清强成功焚烬否则最大HP三分一百分比，保护失败保留强化；1675反强成功才技能禁疗",
          "assertion": "test('4912/1978清强成功焚烬否则最大HP三分一百分比，保护失败保留强化；1675反强成功才技能禁疗',()=>{for(const mode of['none','boost','protected','immune']){const s=make(row(1978));if(mode!=='none')s.fighters[1].stages.def=2;if(mode==='protected')timer(s,1,'强化保护');if(mode==='immune')s.fighters[1].counts.immune=1;turn(s,s.auditMoveId,20309);assert.equal(!!s.fighters[1].ailments['焚烬'],mode==='boost');assert.equal(sum(s,'percent'),mode==='boost'?0:3000);assert.equal(s.fighters[1].stages.def,mode==='protected'?2:0);}for(const boost of[false,true]){const s=make(row(1675));if(boost)s.fighters[1].stages.atk=2;turn(s,s.auditMoveId,20309);assert.equal(s.fighters[1].stages.atk,boost?-2:0);assert.equal(!!s.fighters[1].effects['技能禁疗'],boost);}});"
        }
      ],
