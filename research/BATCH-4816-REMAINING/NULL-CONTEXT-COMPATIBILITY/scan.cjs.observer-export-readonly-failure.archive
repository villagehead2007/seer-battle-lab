'use strict';
const fs=require('fs'),path=require('path'),Module=require('module'),root=process.cwd(),range=path.resolve('dist/range-effects.js'),body=fs.readFileSync(range,'utf8'),marker='// 4816: exact SeerAPI instances; do not relax other sources\' enum ranges.';if(!body.includes(marker))throw Error('observer location missing');const mod=new Module(range,module);mod.filename=range;mod.paths=Module._nodeModulePaths(path.dirname(range));require.cache[range]=mod;mod._compile(body.replace(marker,'global.__beforeFixed52Registry={...registry};\n'+marker),range);const effects=require(path.resolve('dist/effect-registry.js')),rows=[];let checked=0;for(const file of fs.readdirSync('data/species').filter(n=>/^\d+\.json$/.test(n))){const s=JSON.parse(fs.readFileSync(path.join('data/species',file))).snapshot;for(const m of s.moves)for(const e of m.effectInstances){checked++;const r=effects.compileInstances([e],s.effects);if(!/Cannot read properties of (?:null|undefined)/.test(r.issue??''))continue;const final=effects.registry[e.id],prior=global.__beforeFixed52Registry[e.id];let before=null;if(prior){effects.registry[e.id]=prior;before=effects.compileInstances([e],s.effects).issue;effects.registry[e.id]=final;}rows.push({speciesId:s.id,moveId:m.id,moveHash:m.hash,effectId:e.id,args:e.args,afterIssue:r.issue,beforeIssue:before,introduced:before===''});}}const report={at:new Date().toISOString(),kind:'read-only in-memory observer before current fixed52 additions, not historical engine or completion proof',checked,affectedEffectIds:[...new Set(rows.map(r=>r.effectId))],introducedEffectIds:[...new Set(rows.filter(r=>r.introduced).map(r=>r.effectId))],rows};fs.writeFileSync('research/BATCH-4816-REMAINING/NULL-CONTEXT-COMPATIBILITY/scan-before.json',JSON.stringify(report,null,2)+'\n',{flag:'wx'});console.log({checked,rows:rows.length,ids:report.affectedEffectIds,introduced:report.introducedEffectIds});
