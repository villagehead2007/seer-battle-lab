const fs=require('fs'),path=require('path'),crypto=require('crypto'),assert=require('assert/strict'),b=__dirname,root=path.resolve(b,'../..'),rel=f=>path.relative(root,f).replaceAll('\\','/'),sha=data=>crypto.createHash('sha256').update(data).digest('hex'),read=f=>JSON.parse(fs.readFileSync(path.join(b,f))),write=(f,v)=>fs.writeFileSync(path.join(b,f),JSON.stringify(v,null,2)+'\n'),gate=read('FINAL-GATES/result-v3.json'),manifest=read('FINAL-GATES/inputs-v3.json');
