'use strict';const test=require('node:test'),assert=require('node:assert/strict'),{E,source,make,turn,timer,key,sum,keys}=require('./helpers/remaining-4933.cjs'),row=id=>source.moves.flatMap(m=>m.effectInstances.map((e,index)=>({move:m.id,index,id:e.id}))).find(e=>e.id===id);
test('4933/2554物特攻均按双攻有效值合计计算，双攻等级各自生效不改实际阶段',()=>{for(const move of[38492,38493,38494]){const values=[];for(const mode of['sum','reference']){const s=make({move,index:mode==='sum'?0:-1,aStats:{atk:mode==='sum'?200:500,spa:300}});turn(s,move,20309);values.push(sum(s));}assert.equal(values[0],values[1]);const a=make({move,index:0,aStats:{atk:200,spa:300}}),b=make({move,index:-1,aStats:{atk:750,spa:750}});a.fighters[0].stages.atk=2;a.fighters[0].stages.spa=-1;turn(a,move,20309);turn(b,move,20309);assert.equal(a.fighters[0].stages.atk,2);assert.equal(a.fighters[0].stages.spa,-1);assert.ok(sum(a)>0);}});
test('4933/2302实际每个低于3PP技能追加先制，3不计，基础先制3保留',()=>{for(const n of[0,2,5]){const s=make(row(2302));s.fighters[1].moves.forEach((k,i)=>s.fighters[1].pp[k]=i<n?2:3);turn(s,s.auditMoveId,20117);assert.equal(s.fighters[0].soulState.resolvedPriority.value,3+n);}});
test('4933/1058害怕成功、真实免异失败封攻；1471清强后害怕失败回复与禁疗',()=>{for(const blocked of[false,true]){const s=make(row(1058));if(blocked)s.fighters[1].counts.immune=1;turn(s,s.auditMoveId,10127);assert.equal(!!s.fighters[1].ailments['害怕'],!blocked);assert.equal(sum(s,'attack',1),0);}for(const mode of['success','immune','ban','noBoost']){const s=make({...row(1471),hp:1000});if(mode!=='noBoost')s.fighters[1].stages.atk=1;if(['immune','ban'].includes(mode))s.fighters[1].counts.immune=1;if(mode==='ban')timer(s,0,'技能禁疗');turn(s,s.auditMoveId,20309);assert.equal(s.fighters[0].hp,mode==='immune'?4000:1000);assert.equal(!!s.fighters[1].ailments['害怕'],mode==='success');}});
test('4933/2498清回合成功依失败异常数当次红伤倍增，免异不补抽，无回合不发动',()=>{const damage=[];for(const immune of[0,1,2]){const s=make(row(2498));s.fighters[1].counts.immune=immune;turn(s,s.auditMoveId,20309);damage.push(sum(s));assert.equal(Number(!!s.fighters[1].ailments['束缚'])+Number(!!s.fighters[1].ailments['臣服']),2-immune);}assert.ok(Math.abs(damage[1]/damage[0]-2)<.03);assert.ok(Math.abs(damage[2]/damage[0]-4)<.04);const s=make(row(2498));s.fighters[1].effects={};turn(s,s.auditMoveId,20309);assert.equal(s.fighters[1].ailments['束缚'],undefined);assert.equal(s.fighters[1].ailments['臣服'],undefined);});
test('4933/2555真实击败授3回意念不减，未击败不授',()=>{for(const hp of[1,9000]){const s=make({...row(2555),targetHp:hp});turn(s,s.auditMoveId,20117);assert.equal(!!s.fighters[0].effects['修罗意念不减'],hp===1);if(hp===1)assert.equal(s.fighters[0].effects['修罗意念不减'].end,3);}});
